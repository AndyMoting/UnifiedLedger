-- P7-02.C lending counterparty catalog + positions, and P7-02.B/D product pairs/pins:
-- v28 -> v29. Purely additive: eight new non-rgXX_ product tables plus their indexes and
-- controlled-supersede / immutability / append-only triggers. Zero data backfill; the caller
-- wraps Schema.migrate in one outer transaction (26.sqm discipline), so any guard failure rolls
-- the whole migration back and the v28 file is left untouched. Every CREATE statement below
-- matches the fresh Ledger.sq terminal definitions byte for byte.
PRAGMA defer_foreign_keys = 1;

-- P7-02.B manual transfer claim-first pair.
CREATE TABLE manual_transfer_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  source_account_id TEXT NOT NULL,
  destination_account_id TEXT NOT NULL,
  destination_credit_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  fee_minor INTEGER NOT NULL CHECK (fee_minor >= 0),
  fee_category_id TEXT,
  occurred_at TEXT NOT NULL,
  note TEXT NOT NULL,
  confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id)
);
CREATE TABLE confirmed_transfer_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL UNIQUE,
  transaction_id TEXT NOT NULL UNIQUE,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id)
    REFERENCES manual_transfer_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

-- P7-02.C stable counterparty catalog: current row plus append-only superseded name history.
CREATE TABLE counterparty (
  ledger_id TEXT NOT NULL,
  counterparty_id TEXT NOT NULL,
  current_name TEXT NOT NULL,
  receivable_account_id TEXT NOT NULL,
  active INTEGER NOT NULL CHECK (active IN (0, 1)),
  PRIMARY KEY (ledger_id, counterparty_id)
);
CREATE TABLE counterparty_name_history (
  ledger_id TEXT NOT NULL,
  counterparty_id TEXT NOT NULL,
  version_number INTEGER NOT NULL CHECK (version_number > 0),
  name TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('CURRENT','SUPERSEDED')),
  PRIMARY KEY (ledger_id, counterparty_id, version_number)
);
CREATE TRIGGER counterparty_name_history_guard_update BEFORE UPDATE ON counterparty_name_history BEGIN
  SELECT CASE WHEN old.status != 'CURRENT' OR new.status != 'SUPERSEDED'
      OR new.ledger_id != old.ledger_id OR new.counterparty_id != old.counterparty_id
      OR new.version_number != old.version_number OR new.name != old.name
    THEN RAISE(ABORT, 'cannot update counterparty name history') END;
END;

-- P7-02.C per-object lending position and append-only history. The read/rebuild order is
-- (occurred_at, entry_id) ascending (G-D same-instant determinism).
CREATE TABLE lending_position (
  ledger_id TEXT NOT NULL,
  counterparty_id TEXT NOT NULL,
  receivable_account_id TEXT NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  principal_balance_minor INTEGER NOT NULL CHECK (principal_balance_minor >= 0),
  PRIMARY KEY (ledger_id, counterparty_id),
  FOREIGN KEY (ledger_id, counterparty_id)
    REFERENCES counterparty(ledger_id, counterparty_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, receivable_account_id)
    REFERENCES catalog_account(ledger_id, account_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE lending_position_history (
  ledger_id TEXT NOT NULL,
  counterparty_id TEXT NOT NULL,
  entry_id TEXT NOT NULL,
  behavior_code TEXT NOT NULL CHECK (behavior_code IN ('LEND','COLLECT')),
  amount_minor INTEGER NOT NULL CHECK (amount_minor >= 0),
  principal_balance_after_minor INTEGER NOT NULL CHECK (principal_balance_after_minor >= 0),
  transaction_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL,
  PRIMARY KEY (ledger_id, counterparty_id, entry_id),
  FOREIGN KEY (ledger_id, counterparty_id)
    REFERENCES lending_position(ledger_id, counterparty_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE INDEX lending_position_history_by_object ON lending_position_history(ledger_id, counterparty_id, occurred_at, entry_id);
CREATE TRIGGER lending_position_history_guard_update BEFORE UPDATE ON lending_position_history BEGIN
  SELECT RAISE(ABORT, 'cannot update lending position history'); END;
CREATE TRIGGER lending_position_history_guard_delete BEFORE DELETE ON lending_position_history BEGIN
  SELECT RAISE(ABORT, 'cannot delete lending position history'); END;

-- P7-02.C manual lending claim-first pair.
CREATE TABLE manual_lending_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  behavior_code TEXT NOT NULL CHECK (behavior_code IN ('LEND','COLLECT')),
  counterparty_id TEXT NOT NULL,
  principal_account_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL,
  interest_minor INTEGER NOT NULL CHECK (interest_minor >= 0),
  fee_minor INTEGER NOT NULL CHECK (fee_minor = 0),
  total_received_minor INTEGER,
  interest_category_id TEXT,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  occurred_at TEXT NOT NULL,
  note TEXT NOT NULL,
  confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id)
);
CREATE TABLE confirmed_lending_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL UNIQUE,
  transaction_id TEXT NOT NULL UNIQUE,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id)
    REFERENCES manual_lending_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

-- P7-02.D manual pin preference (account/category), additive and ledger-scoped.
CREATE TABLE entry_pin (
  ledger_id TEXT NOT NULL,
  target_kind TEXT NOT NULL CHECK (target_kind IN ('account','category')),
  target_id TEXT NOT NULL,
  pinned_at TEXT NOT NULL,
  PRIMARY KEY (ledger_id, target_kind, target_id)
);

-- Late-stage failure hook (26.sqm sentinel discipline): created after the table set, so a
-- test-occupied entry_pin_v29_late_sentinel name aborts the migration post-build and proves the
-- whole transaction rolls back together. Dropped again before the version advances to 29.
CREATE TABLE entry_pin_v29_late_sentinel (ok INTEGER NOT NULL CHECK (ok = 1));
DROP TABLE entry_pin_v29_late_sentinel;
