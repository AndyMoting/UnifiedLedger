-- D-348 (docs/DECISIONS.md): the production review read's evidence probe index, v37 -> v38.
-- Purely additive: one covering index on the existing import_evidence table, so the read path's
-- per-output-row probes by (ledger_id, source_id) — the min(evidence_id) projection scalar and the
-- active-link EXISTS, in importReviewRowsForLedgerPage and its four sibling reads — stop scanning
-- the table. No staged rebuild, no backfill, and no change to any existing table, column, query,
-- view, trigger or index. The caller wraps Schema.migrate in one outer transaction (26.sqm
-- discipline), so any failure rolls the whole migration back and the v37 file is left untouched.
-- The CREATE INDEX below matches the fresh Ledger.sq terminal definition byte for byte, so
-- fresh = migrated holds for this edge by construction.
CREATE INDEX import_evidence_by_source ON import_evidence(ledger_id, source_id);
