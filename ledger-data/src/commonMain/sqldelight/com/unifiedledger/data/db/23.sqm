-- P4-07 duplicate candidates and reviews: v23 -> v24.
-- The caller wraps Schema.migrate in one outer transaction. Deferring FK checks lets
-- the parent be replaced while all v23 import/P4-08 descendants retain their rows.
PRAGMA defer_foreign_keys = 1;
CREATE TABLE import_source_record_stage AS SELECT * FROM import_source_record;
DROP TRIGGER import_source_record_guard_update;
DROP TRIGGER import_source_record_guard_delete;
DROP TABLE import_source_record;
CREATE TABLE import_source_record (
  ledger_id TEXT NOT NULL, source_id TEXT NOT NULL, owner_request_id TEXT NOT NULL,
  input_ref TEXT NOT NULL, record_ordinal INTEGER NOT NULL CHECK (record_ordinal >= 0),
  record_kind TEXT NOT NULL CHECK (record_kind IN ('ordinary_flow_source', 'transfer_flow_source', 'transfer_flow_source_missing_leg')),
  content_hash TEXT NOT NULL, contract_version INTEGER NOT NULL CHECK (contract_version IN (1, 2)),
  completeness TEXT NOT NULL CHECK (completeness IN ('valid_complete', 'valid_incomplete')),
  amount_minor INTEGER, currency_code TEXT, currency_precision INTEGER CHECK (currency_precision IS NULL OR currency_precision >= 0),
  occurred_at TEXT, direction_token TEXT, status_token TEXT,
  funding_state TEXT NOT NULL DEFAULT 'UNRESOLVED', funding_rule_id TEXT NOT NULL DEFAULT 'migration-v24-unresolved',
  funding_rule_version INTEGER NOT NULL DEFAULT 1, candidate_generated_at TEXT NOT NULL DEFAULT 'migration-v24-unresolved',
  PRIMARY KEY (ledger_id, source_id), UNIQUE (ledger_id, input_ref, record_ordinal), UNIQUE (ledger_id, owner_request_id),
  FOREIGN KEY (ledger_id, owner_request_id) REFERENCES import_request(ledger_id, request_id),
  CHECK (completeness != 'valid_complete' OR (amount_minor IS NOT NULL AND currency_code IS NOT NULL AND currency_precision IS NOT NULL AND occurred_at IS NOT NULL AND direction_token IS NOT NULL AND status_token IS NOT NULL)),
  CHECK (amount_minor IS NULL OR (currency_code IS NOT NULL AND currency_precision IS NOT NULL)),
  CHECK ((record_kind = 'ordinary_flow_source' AND contract_version = 1) OR (record_kind IN ('transfer_flow_source', 'transfer_flow_source_missing_leg') AND contract_version = 2))
);
INSERT INTO import_source_record(ledger_id, source_id, owner_request_id, input_ref, record_ordinal, record_kind, content_hash, contract_version, completeness, amount_minor, currency_code, currency_precision, occurred_at, direction_token, status_token)
SELECT ledger_id, source_id, owner_request_id, input_ref, record_ordinal, record_kind, content_hash, contract_version, completeness, amount_minor, currency_code, currency_precision, occurred_at, direction_token, status_token FROM import_source_record_stage;
DROP TABLE import_source_record_stage;
CREATE TRIGGER import_source_record_guard_update BEFORE UPDATE ON import_source_record BEGIN SELECT RAISE(ABORT, 'cannot update import source record'); END;
CREATE TRIGGER import_source_record_guard_delete BEFORE DELETE ON import_source_record BEGIN SELECT RAISE(ABORT, 'cannot delete import source record'); END;
CREATE TABLE import_duplicate_candidate (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, subject_source_id TEXT NOT NULL, possible_existing_source_id TEXT,
  kind TEXT NOT NULL CHECK (kind IN ('EXACT_BUSINESS_TUPLE', 'CLOSED_OR_FAILED_NO_FUNDS')), comparison_fingerprint TEXT NOT NULL,
  comparison_snapshot TEXT NOT NULL, provenance TEXT NOT NULL, confidence TEXT NOT NULL CHECK (confidence = 'exact'),
  rule_id TEXT NOT NULL CHECK (rule_id = 'p407_exact_business_tuple_v1'), rule_version INTEGER NOT NULL CHECK (rule_version = 1),
  generated_at TEXT NOT NULL, creation_request_id TEXT NOT NULL, PRIMARY KEY (ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, subject_source_id) REFERENCES import_source_record(ledger_id, source_id),
  FOREIGN KEY (ledger_id, possible_existing_source_id) REFERENCES import_source_record(ledger_id, source_id),
  FOREIGN KEY (ledger_id, creation_request_id) REFERENCES import_request(ledger_id, request_id),
  CHECK ((kind = 'EXACT_BUSINESS_TUPLE' AND possible_existing_source_id IS NOT NULL) OR (kind = 'CLOSED_OR_FAILED_NO_FUNDS' AND possible_existing_source_id IS NULL))
);
CREATE UNIQUE INDEX import_duplicate_exact_unique ON import_duplicate_candidate(ledger_id, subject_source_id, possible_existing_source_id, kind, comparison_fingerprint) WHERE kind = 'EXACT_BUSINESS_TUPLE';
CREATE UNIQUE INDEX import_duplicate_no_funds_unique ON import_duplicate_candidate(ledger_id, subject_source_id, kind) WHERE kind = 'CLOSED_OR_FAILED_NO_FUNDS';
CREATE TABLE import_duplicate_status_history (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, sequence INTEGER NOT NULL CHECK (sequence >= 1), history_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('DEFERRED', 'CONFIRMED_DUPLICATE', 'CONFIRMED_DISTINCT', 'DISMISSED_LOOKALIKE', 'REJECTED')),
  request_id TEXT NOT NULL, operation_class TEXT NOT NULL CHECK (operation_class IN ('creation', 'status_transition')), PRIMARY KEY (ledger_id, candidate_id, sequence), UNIQUE (ledger_id, history_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_duplicate_candidate(ledger_id, candidate_id)
);
CREATE TABLE import_duplicate_review_request (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, operation TEXT NOT NULL CHECK (operation = 'review_duplicate'), input_fingerprint TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('PENDING', 'ACCEPTED', 'CONFLICT')), reason_code TEXT, PRIMARY KEY (ledger_id, request_id)
);
CREATE TABLE import_duplicate_review_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, candidate_id TEXT NOT NULL, expected_comparison_fingerprint TEXT NOT NULL,
  decision TEXT NOT NULL CHECK (decision IN ('CONFIRMED_DUPLICATE', 'CONFIRMED_DISTINCT', 'DISMISSED_LOOKALIKE', 'REJECTED')),
  reason_token TEXT NOT NULL, reviewed_at TEXT NOT NULL, reviewer_reference TEXT NOT NULL, generated_at TEXT NOT NULL, review_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id), UNIQUE (ledger_id, review_id), FOREIGN KEY (ledger_id, request_id) REFERENCES import_duplicate_review_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_duplicate_candidate(ledger_id, candidate_id)
);
CREATE TABLE import_duplicate_review_receipt (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, candidate_id TEXT NOT NULL, review_id TEXT NOT NULL, history_id TEXT NOT NULL, outcome TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id), FOREIGN KEY (ledger_id, request_id) REFERENCES import_duplicate_review_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_duplicate_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, review_id) REFERENCES import_duplicate_review_snapshot(ledger_id, review_id),
  FOREIGN KEY (ledger_id, history_id) REFERENCES import_duplicate_status_history(ledger_id, history_id)
);
CREATE TRIGGER import_duplicate_candidate_guard_update BEFORE UPDATE ON import_duplicate_candidate BEGIN SELECT RAISE(ABORT, 'cannot update duplicate candidate'); END;
CREATE TRIGGER import_duplicate_candidate_guard_delete BEFORE DELETE ON import_duplicate_candidate BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate candidate'); END;
CREATE TRIGGER import_duplicate_history_guard_update BEFORE UPDATE ON import_duplicate_status_history BEGIN SELECT RAISE(ABORT, 'cannot update duplicate history'); END;
CREATE TRIGGER import_duplicate_history_guard_delete BEFORE DELETE ON import_duplicate_status_history BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate history'); END;
CREATE TRIGGER import_duplicate_review_request_guard_update BEFORE UPDATE ON import_duplicate_review_request BEGIN
 SELECT CASE WHEN old.outcome != 'PENDING' OR new.ledger_id != old.ledger_id OR new.request_id != old.request_id
 OR new.operation != old.operation OR new.input_fingerprint != old.input_fingerprint OR new.outcome != 'ACCEPTED'
 THEN RAISE(ABORT, 'cannot update duplicate review request') END;
END;
CREATE TRIGGER import_duplicate_review_request_guard_delete BEFORE DELETE ON import_duplicate_review_request BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate review request'); END;
CREATE TRIGGER import_duplicate_review_snapshot_guard_update BEFORE UPDATE ON import_duplicate_review_snapshot BEGIN SELECT RAISE(ABORT, 'cannot update duplicate review snapshot'); END;
CREATE TRIGGER import_duplicate_review_snapshot_guard_delete BEFORE DELETE ON import_duplicate_review_snapshot BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate review snapshot'); END;
CREATE TRIGGER import_duplicate_review_receipt_guard_update BEFORE UPDATE ON import_duplicate_review_receipt BEGIN SELECT RAISE(ABORT, 'cannot update duplicate review receipt'); END;
CREATE TRIGGER import_duplicate_review_receipt_guard_delete BEFORE DELETE ON import_duplicate_review_receipt BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate review receipt'); END;
CREATE TRIGGER import_duplicate_history_sequence BEFORE INSERT ON import_duplicate_status_history BEGIN
 SELECT CASE WHEN (SELECT COALESCE(MAX(sequence), 0) FROM import_duplicate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id) + 1 != new.sequence
 OR (new.sequence = 1 AND (new.status != 'DEFERRED' OR new.operation_class != 'creation'))
 OR (new.sequence > 1 AND (new.status = 'DEFERRED' OR new.operation_class != 'status_transition'))
 THEN RAISE(ABORT, 'duplicate history sequence') END;
END;
CREATE TRIGGER import_duplicate_history_terminal BEFORE INSERT ON import_duplicate_status_history BEGIN
 SELECT CASE WHEN EXISTS (SELECT 1 FROM import_duplicate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id AND status != 'DEFERRED') THEN RAISE(ABORT, 'duplicate history terminal') END;
END;
CREATE TRIGGER import_duplicate_history_creation_owner BEFORE INSERT ON import_duplicate_status_history WHEN new.operation_class = 'creation' BEGIN
 SELECT CASE WHEN NOT EXISTS (
   SELECT 1 FROM import_duplicate_candidate candidate
   JOIN import_request request ON request.ledger_id = candidate.ledger_id AND request.request_id = candidate.creation_request_id
   WHERE candidate.ledger_id = new.ledger_id AND candidate.candidate_id = new.candidate_id
     AND candidate.creation_request_id = new.request_id
 ) THEN RAISE(ABORT, 'duplicate history creation owner') END;
END;
CREATE TRIGGER import_duplicate_history_review_owner BEFORE INSERT ON import_duplicate_status_history WHEN new.operation_class = 'status_transition' BEGIN
 SELECT CASE WHEN NOT EXISTS (
   SELECT 1 FROM import_duplicate_review_request request
   JOIN import_duplicate_review_snapshot snapshot
     ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
   WHERE request.ledger_id = new.ledger_id AND request.request_id = new.request_id
     AND request.outcome = 'ACCEPTED'
     AND snapshot.candidate_id = new.candidate_id AND snapshot.decision = new.status
 ) THEN RAISE(ABORT, 'duplicate history review owner') END;
END;
CREATE TRIGGER import_duplicate_review_receipt_consistency BEFORE INSERT ON import_duplicate_review_receipt BEGIN
 SELECT CASE WHEN NOT EXISTS (
   SELECT 1 FROM import_duplicate_review_request request
   JOIN import_duplicate_review_snapshot snapshot
     ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
   JOIN import_duplicate_status_history history
     ON history.ledger_id = new.ledger_id AND history.history_id = new.history_id
   WHERE request.ledger_id = new.ledger_id AND request.request_id = new.request_id
     AND request.outcome = 'ACCEPTED'
     AND snapshot.candidate_id = new.candidate_id AND snapshot.review_id = new.review_id
     AND history.candidate_id = new.candidate_id AND history.request_id = new.request_id
     AND history.status = new.outcome
 ) THEN RAISE(ABORT, 'duplicate review receipt consistency') END;
END;
