CREATE TABLE rg05_operation_request (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL,
  action_type TEXT NOT NULL CHECK (action_type IN ('MANUAL_MERGED_PAYMENT', 'INGEST_MERGED_PAYMENT_FACTS', 'CONFIRM_MERGED_PAYMENT_CANDIDATE', 'MERGE_ITEM_RECEIPT_EVIDENCE')),
  PRIMARY KEY (ledger_id, request_id)
);
CREATE TABLE rg05_source_record (
  ledger_id TEXT NOT NULL, source_id TEXT NOT NULL, source_type TEXT NOT NULL CHECK (source_type IN ('BANK_FACT', 'ITEM_FACT')),
  evidence_id TEXT NOT NULL, item_id TEXT, evidence_kind TEXT NOT NULL CHECK (evidence_kind IN ('BANK_PAYMENT', 'ITEM_RECEIPT', 'ITEM_SUMMARY')),
  observed_at TEXT NOT NULL, details TEXT NOT NULL, amount_minor INTEGER NOT NULL, currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0), suggested_category_id TEXT,
  completeness TEXT NOT NULL CHECK (completeness IN ('COMPLETE', 'SUMMARY_ONLY')),
  PRIMARY KEY (ledger_id, source_id), UNIQUE (ledger_id, evidence_id), UNIQUE (ledger_id, source_id, evidence_id),
  CHECK ((source_type = 'BANK_FACT' AND item_id IS NULL AND evidence_kind = 'BANK_PAYMENT' AND amount_minor < 0 AND suggested_category_id IS NULL AND completeness = 'COMPLETE')
      OR (source_type = 'ITEM_FACT' AND item_id IS NOT NULL AND evidence_kind != 'BANK_PAYMENT' AND amount_minor > 0 AND suggested_category_id IS NOT NULL))
);
CREATE TABLE rg05_evidence (
  ledger_id TEXT NOT NULL, evidence_id TEXT NOT NULL, source_id TEXT NOT NULL, evidence_type TEXT NOT NULL CHECK (evidence_type IN ('BANK_PAYMENT', 'ITEM_RECEIPT', 'ITEM_SUMMARY')), observed_at TEXT NOT NULL,
  PRIMARY KEY (ledger_id, evidence_id), FOREIGN KEY (ledger_id, source_id, evidence_id) REFERENCES rg05_source_record(ledger_id, source_id, evidence_id)
);
CREATE TABLE rg05_candidate (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, bank_source_id TEXT NOT NULL, payment_total_minor INTEGER NOT NULL CHECK (payment_total_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0), rule_name TEXT NOT NULL CHECK (rule_name = 'merged_payment_facts'),
  rule_version INTEGER NOT NULL CHECK (rule_version = 1), confidence TEXT NOT NULL CHECK (confidence = '1.00'), PRIMARY KEY (ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, bank_source_id) REFERENCES rg05_source_record(ledger_id, source_id)
);
CREATE TABLE rg05_candidate_item (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, item_index INTEGER NOT NULL CHECK (item_index IN (0, 1)), item_id TEXT NOT NULL,
  source_id TEXT NOT NULL, evidence_id TEXT NOT NULL, amount_minor INTEGER NOT NULL CHECK (amount_minor > 0), currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL, suggested_category_id TEXT NOT NULL, PRIMARY KEY (ledger_id, candidate_id, item_index),
  UNIQUE (ledger_id, candidate_id, item_id), FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg05_candidate(ledger_id, candidate_id) ON DELETE CASCADE,
  FOREIGN KEY (ledger_id, source_id, evidence_id) REFERENCES rg05_source_record(ledger_id, source_id, evidence_id)
);
CREATE TABLE rg05_candidate_status_history (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, status_sequence INTEGER NOT NULL CHECK (status_sequence IN (1, 2)), status_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION', 'CONFIRMED')), request_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, candidate_id, status_sequence), UNIQUE (ledger_id, status_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg05_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg05_operation_request(ledger_id, request_id)
);
CREATE TABLE rg05_confirmation_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, candidate_id TEXT NOT NULL, funding_account_id TEXT NOT NULL,
  payment_at TEXT NOT NULL, statistics_at TEXT NOT NULL, confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_candidate_confirmation'),
  PRIMARY KEY (ledger_id, request_id), FOREIGN KEY (ledger_id, request_id) REFERENCES rg05_operation_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg05_candidate(ledger_id, candidate_id)
);
CREATE TABLE rg05_confirmation_allocation (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, allocation_index INTEGER NOT NULL CHECK (allocation_index IN (0, 1)), item_id TEXT NOT NULL,
  category_id TEXT NOT NULL, amount_minor INTEGER NOT NULL CHECK (amount_minor > 0), currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, request_id, allocation_index), UNIQUE (ledger_id, request_id, item_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg05_confirmation_snapshot(ledger_id, request_id) ON DELETE CASCADE
);
CREATE TABLE rg05_confirmation (
  ledger_id TEXT NOT NULL, confirmation_id TEXT NOT NULL, request_id TEXT NOT NULL, candidate_id TEXT, transaction_id TEXT NOT NULL,
  confirmation_kind TEXT NOT NULL CHECK (confirmation_kind IN ('EXPLICIT_MANUAL_SAVE', 'CANDIDATE_CONFIRMATION')),
  PRIMARY KEY (ledger_id, confirmation_id), UNIQUE (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg05_operation_request(ledger_id, request_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg05_merged_payment_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, occurred_at TEXT NOT NULL, statistics_at TEXT NOT NULL,
  total_minor INTEGER NOT NULL CHECK (total_minor > 0), currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0), funding_account_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL UNIQUE, relation_id TEXT NOT NULL UNIQUE, confirmation_id TEXT NOT NULL UNIQUE,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg05_operation_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg05_item_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, item_index INTEGER NOT NULL CHECK (item_index IN (0, 1)),
  item_id TEXT NOT NULL, amount_minor INTEGER NOT NULL CHECK (amount_minor > 0), currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0), category_id TEXT NOT NULL, details TEXT NOT NULL,
  source_observed_at TEXT NOT NULL, consumption_id TEXT NOT NULL UNIQUE, allocation_id TEXT NOT NULL UNIQUE,
  source_id TEXT, evidence_id TEXT, expense_posting_id TEXT NOT NULL UNIQUE,
  PRIMARY KEY (ledger_id, request_id, item_index), UNIQUE (ledger_id, request_id, item_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg05_operation_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (expense_posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg05_posting_semantic (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('expense', 'payment_asset')), item_id TEXT, category_id TEXT,
  reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)),
  PRIMARY KEY (ledger_id, posting_id), FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  CHECK ((role = 'expense' AND item_id IS NOT NULL AND category_id IS NOT NULL AND reconciliation_eligible = 0)
      OR (role = 'payment_asset' AND item_id IS NULL AND category_id IS NULL AND reconciliation_eligible = 1))
);
CREATE TABLE rg05_relation (
  ledger_id TEXT NOT NULL, relation_id TEXT NOT NULL, transaction_id TEXT NOT NULL, payment_posting_id TEXT NOT NULL,
  display_name TEXT NOT NULL CHECK (display_name = '合并付款'), payment_total_minor INTEGER NOT NULL CHECK (payment_total_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  PRIMARY KEY (ledger_id, relation_id), UNIQUE (ledger_id, transaction_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (payment_posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg05_relation_item (
  ledger_id TEXT NOT NULL, relation_id TEXT NOT NULL, item_index INTEGER NOT NULL CHECK (item_index IN (0, 1)),
  item_id TEXT NOT NULL, expense_posting_id TEXT NOT NULL, amount_minor INTEGER NOT NULL CHECK (amount_minor > 0), category_id TEXT NOT NULL,
  business_evidence_completeness TEXT NOT NULL CHECK (business_evidence_completeness IN ('NONE', 'PARTIAL', 'COMPLETE')),
  PRIMARY KEY (ledger_id, relation_id, item_index), UNIQUE (ledger_id, relation_id, item_id),
  FOREIGN KEY (ledger_id, relation_id) REFERENCES rg05_relation(ledger_id, relation_id) ON DELETE CASCADE,
  FOREIGN KEY (expense_posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg05_receipt_evidence (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, relation_id TEXT NOT NULL, source_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  item_id TEXT NOT NULL, allocation_id TEXT NOT NULL, evidence_link_id TEXT NOT NULL UNIQUE,
  item_index INTEGER NOT NULL CHECK (item_index IN (0, 1)), observed_at TEXT NOT NULL, details TEXT NOT NULL,
  amount_minor INTEGER NOT NULL CHECK (amount_minor > 0), currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  PRIMARY KEY (ledger_id, request_id), UNIQUE (ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, relation_id) REFERENCES rg05_relation(ledger_id, relation_id)
);
CREATE TABLE rg05_evidence_link (
  ledger_id TEXT NOT NULL, link_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  target_kind TEXT NOT NULL CHECK (target_kind IN ('POSTING', 'ITEM_ALLOCATION')), target_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('PAYMENT_ASSET_POSTING', 'ITEM_ALLOCATION_FACT')),
  PRIMARY KEY (ledger_id, link_id), UNIQUE (ledger_id, evidence_id), UNIQUE (ledger_id, target_kind, target_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg05_evidence(ledger_id, evidence_id),
  CHECK ((target_kind = 'POSTING' AND role = 'PAYMENT_ASSET_POSTING') OR (target_kind = 'ITEM_ALLOCATION' AND role = 'ITEM_ALLOCATION_FACT'))
);
CREATE TABLE rg05_posting_reconciliation (
  ledger_id TEXT NOT NULL, reconciliation_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'MATCHED', 'HAS_DIFFERENCE')),
  PRIMARY KEY (ledger_id, reconciliation_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg05_operation_receipt (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, outcome TEXT NOT NULL CHECK (outcome IN ('ACCEPTED', 'NO_CHANGE')),
  confirmation_id TEXT, transaction_id TEXT, relation_id TEXT, PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg05_operation_request(ledger_id, request_id) ON DELETE CASCADE
);
