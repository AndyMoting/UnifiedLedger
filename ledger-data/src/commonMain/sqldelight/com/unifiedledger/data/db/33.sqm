-- P7-08 08.A (D-187; spec docs/specs/2026-09-30-p7-08-tag-merchant-design.md sections 2 and 3)
-- tag/merchant catalog and the transaction annotation aggregate: v33 -> v34. Purely additive:
-- non-rgXX_ product tables only (a tag catalog family, a merchant catalog family, one shared
-- append-only name history, one claim-first command pair for both catalog kinds, and the
-- versioned annotation aggregate with its tag association, current-pointer, claim-first request
-- and receipt). Zero data backfill; the caller wraps Schema.migrate in one outer transaction
-- (26.sqm discipline), so any guard failure rolls the whole migration back and the v33 file is
-- left untouched.
-- Every CREATE statement below matches the fresh Ledger.sq terminal definitions byte for byte.
-- Declaration order (tag, merchant, name history, request, receipt, annotation revision, tag
-- association, current pointer, annotation request, annotation receipt) puts each foreign key's
-- target table before its referrer, which SQLDelight requires.
PRAGMA defer_foreign_keys = 1;

CREATE TABLE catalog_item_version (
  ledger_id TEXT NOT NULL,
  version INTEGER NOT NULL CHECK (version >= 0),
  PRIMARY KEY (ledger_id)
);
CREATE TRIGGER catalog_item_version_guard_update BEFORE UPDATE ON catalog_item_version BEGIN
  SELECT CASE WHEN new.ledger_id != old.ledger_id OR new.version != old.version + 1
    THEN RAISE(ABORT, 'catalog item version must increase by one') END;
END;

CREATE TABLE catalog_tag (
  ledger_id TEXT NOT NULL,
  tag_id TEXT NOT NULL,
  active INTEGER NOT NULL CHECK (active IN (0, 1)),
  tombstoned INTEGER NOT NULL CHECK (tombstoned IN (0, 1)),
  revision INTEGER NOT NULL CHECK (revision >= 0),
  PRIMARY KEY (ledger_id, tag_id),
  CHECK (tombstoned = 0 OR active = 0)
);
CREATE TRIGGER catalog_tag_guard_update BEFORE UPDATE ON catalog_tag BEGIN
  SELECT CASE WHEN new.ledger_id != old.ledger_id OR new.tag_id != old.tag_id
      OR new.revision != old.revision + 1
      OR old.tombstoned = 1
      OR new.tombstoned < old.tombstoned
      OR new.tombstoned > 1
      OR (new.tombstoned = 1 AND new.active != 0)
    THEN RAISE(ABORT, 'catalog tag row is immutable except a forward revision') END;
END;
CREATE TRIGGER catalog_tag_guard_delete BEFORE DELETE ON catalog_tag BEGIN SELECT RAISE(ABORT, 'cannot delete catalog tag'); END;

CREATE TABLE catalog_merchant (
  ledger_id TEXT NOT NULL,
  merchant_id TEXT NOT NULL,
  active INTEGER NOT NULL CHECK (active IN (0, 1)),
  tombstoned INTEGER NOT NULL CHECK (tombstoned IN (0, 1)),
  revision INTEGER NOT NULL CHECK (revision >= 0),
  PRIMARY KEY (ledger_id, merchant_id),
  CHECK (tombstoned = 0 OR active = 0)
);
CREATE TRIGGER catalog_merchant_guard_update BEFORE UPDATE ON catalog_merchant BEGIN
  SELECT CASE WHEN new.ledger_id != old.ledger_id OR new.merchant_id != old.merchant_id
      OR new.revision != old.revision + 1
      OR old.tombstoned = 1
      OR new.tombstoned < old.tombstoned
      OR new.tombstoned > 1
      OR (new.tombstoned = 1 AND new.active != 0)
    THEN RAISE(ABORT, 'catalog merchant row is immutable except a forward revision') END;
END;
CREATE TRIGGER catalog_merchant_guard_delete BEFORE DELETE ON catalog_merchant BEGIN SELECT RAISE(ABORT, 'cannot delete catalog merchant'); END;

CREATE TABLE catalog_item_name_history (
  ledger_id TEXT NOT NULL,
  owner_kind TEXT NOT NULL CHECK (owner_kind IN ('tag', 'merchant')),
  owner_id TEXT NOT NULL,
  version_number INTEGER NOT NULL CHECK (version_number > 0),
  name TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('CURRENT', 'SUPERSEDED')),
  PRIMARY KEY (ledger_id, owner_kind, owner_id, version_number)
);
CREATE TRIGGER catalog_item_name_history_guard_update BEFORE UPDATE ON catalog_item_name_history BEGIN
  SELECT CASE WHEN old.status != 'CURRENT' OR new.status != 'SUPERSEDED'
      OR new.ledger_id != old.ledger_id OR new.owner_kind != old.owner_kind
      OR new.owner_id != old.owner_id OR new.version_number != old.version_number
      OR new.name != old.name
    THEN RAISE(ABORT, 'cannot update catalog item name history') END;
END;
CREATE TRIGGER catalog_item_name_history_guard_delete BEFORE DELETE ON catalog_item_name_history BEGIN SELECT RAISE(ABORT, 'cannot delete catalog item name history'); END;

CREATE TABLE catalog_item_command_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  command TEXT NOT NULL,
  owner_kind TEXT NOT NULL CHECK (owner_kind IN ('tag', 'merchant')),
  owner_id TEXT NOT NULL,
  request_snapshot TEXT NOT NULL,
  input_fingerprint TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('ACCEPTED', 'NO_CHANGE')),
  reason_code TEXT,
  expected_revision INTEGER NOT NULL CHECK (expected_revision >= 0),
  result_revision INTEGER,
  PRIMARY KEY (ledger_id, request_id)
);

CREATE TABLE catalog_item_command_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('ACCEPTED', 'NO_CHANGE')),
  owner_kind TEXT NOT NULL CHECK (owner_kind IN ('tag', 'merchant')),
  owner_id TEXT NOT NULL,
  new_revision INTEGER NOT NULL CHECK (new_revision >= 0),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES catalog_item_command_request(ledger_id, request_id)
);
CREATE TRIGGER catalog_item_command_receipt_guard_update BEFORE UPDATE ON catalog_item_command_receipt BEGIN SELECT RAISE(ABORT, 'cannot update catalog item command receipt'); END;
CREATE TRIGGER catalog_item_command_receipt_guard_delete BEFORE DELETE ON catalog_item_command_receipt BEGIN SELECT RAISE(ABORT, 'cannot delete catalog item command receipt'); END;

CREATE TABLE transaction_annotation_revision (
  ledger_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  annotation_revision INTEGER NOT NULL CHECK (annotation_revision > 0),
  observed_transaction_version_id TEXT NOT NULL,
  merchant_id TEXT,
  request_id TEXT NOT NULL,
  created_at TEXT NOT NULL,
  PRIMARY KEY (ledger_id, transaction_id, annotation_revision),
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, observed_transaction_version_id, ledger_id)
    REFERENCES transaction_version(transaction_id, version_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, merchant_id)
    REFERENCES catalog_merchant(ledger_id, merchant_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE INDEX transaction_annotation_revision_by_merchant ON transaction_annotation_revision(ledger_id, merchant_id);
CREATE TRIGGER transaction_annotation_revision_guard_update BEFORE UPDATE ON transaction_annotation_revision BEGIN SELECT RAISE(ABORT, 'cannot update annotation revision'); END;
CREATE TRIGGER transaction_annotation_revision_guard_delete BEFORE DELETE ON transaction_annotation_revision BEGIN SELECT RAISE(ABORT, 'cannot delete annotation revision'); END;

CREATE TABLE transaction_annotation_tag (
  ledger_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  annotation_revision INTEGER NOT NULL CHECK (annotation_revision > 0),
  tag_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, transaction_id, annotation_revision, tag_id),
  FOREIGN KEY (ledger_id, transaction_id, annotation_revision)
    REFERENCES transaction_annotation_revision(ledger_id, transaction_id, annotation_revision) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, tag_id)
    REFERENCES catalog_tag(ledger_id, tag_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE INDEX transaction_annotation_tag_by_tag ON transaction_annotation_tag(ledger_id, tag_id);
CREATE TRIGGER transaction_annotation_tag_cardinality_guard BEFORE INSERT ON transaction_annotation_tag BEGIN
  SELECT CASE WHEN (
    SELECT count(*) FROM transaction_annotation_tag
    WHERE ledger_id = new.ledger_id AND transaction_id = new.transaction_id
      AND annotation_revision = new.annotation_revision
  ) >= 20
    THEN RAISE(ABORT, 'annotation tag cardinality exceeds 20') END;
END;
CREATE TRIGGER transaction_annotation_tag_guard_update BEFORE UPDATE ON transaction_annotation_tag BEGIN SELECT RAISE(ABORT, 'cannot update annotation tag'); END;
CREATE TRIGGER transaction_annotation_tag_guard_delete BEFORE DELETE ON transaction_annotation_tag BEGIN SELECT RAISE(ABORT, 'cannot delete annotation tag'); END;

CREATE TABLE transaction_annotation_current (
  ledger_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  annotation_revision INTEGER NOT NULL CHECK (annotation_revision > 0),
  PRIMARY KEY (ledger_id, transaction_id),
  FOREIGN KEY (ledger_id, transaction_id, annotation_revision)
    REFERENCES transaction_annotation_revision(ledger_id, transaction_id, annotation_revision) DEFERRABLE INITIALLY DEFERRED
);
CREATE TRIGGER transaction_annotation_current_guard_update BEFORE UPDATE ON transaction_annotation_current BEGIN
  SELECT CASE WHEN new.ledger_id != old.ledger_id OR new.transaction_id != old.transaction_id
      OR new.annotation_revision <= old.annotation_revision
    THEN RAISE(ABORT, 'annotation pointer must advance') END;
END;
CREATE TRIGGER transaction_annotation_current_guard_delete BEFORE DELETE ON transaction_annotation_current BEGIN SELECT RAISE(ABORT, 'cannot delete annotation pointer'); END;

CREATE TABLE transaction_annotation_command_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  request_snapshot TEXT NOT NULL,
  input_fingerprint TEXT NOT NULL,
  expected_annotation_revision INTEGER NOT NULL CHECK (expected_annotation_revision >= 0),
  expected_current_version_id TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('ACCEPTED', 'NO_CHANGE')),
  reason_code TEXT,
  result_annotation_revision INTEGER,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE transaction_annotation_command_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('ACCEPTED', 'NO_CHANGE')),
  transaction_id TEXT NOT NULL,
  new_annotation_revision INTEGER NOT NULL CHECK (new_annotation_revision > 0),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES transaction_annotation_command_request(ledger_id, request_id)
);
CREATE TRIGGER transaction_annotation_command_receipt_guard_update BEFORE UPDATE ON transaction_annotation_command_receipt BEGIN SELECT RAISE(ABORT, 'cannot update annotation command receipt'); END;
CREATE TRIGGER transaction_annotation_command_receipt_guard_delete BEFORE DELETE ON transaction_annotation_command_receipt BEGIN SELECT RAISE(ABORT, 'cannot delete annotation command receipt'); END;

-- Late-stage failure hook (26.sqm sentinel discipline): created after the table set, so a
-- test-occupied catalog_annotation_v34_late_sentinel name aborts the migration post-build and
-- proves the whole transaction rolls back together. Dropped again before the version advances to 34.
CREATE TABLE catalog_annotation_v34_late_sentinel (ok INTEGER NOT NULL CHECK (ok = 1));
DROP TABLE catalog_annotation_v34_late_sentinel;
