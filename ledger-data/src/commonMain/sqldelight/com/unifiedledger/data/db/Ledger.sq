  ledger_id, settlement_id, component_index, component_id, kind, amount_minor, posting_id
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg08SettlementHistory:
INSERT INTO rg08_settlement_history(
  ledger_id, settlement_id, history_sequence, history_id, status,
  occurred_at, transaction_id, formal_effect_count
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg08Candidate:
INSERT INTO rg08_candidate(
  ledger_id, candidate_id, type, status, proposed_total_received_minor,
  proposed_principal_amount_minor, proposed_interest_amount_minor, proposed_fee_amount_minor,
  currency_code, currency_precision, proposed_destination_account_id,
  proposed_actual_receipt_at,
  proposed_behavior_code, proposed_counterparty_id,
  bank_evidence_proves_component_split, expected_interest_may_confirm_split,
  name_match_may_confirm_counterparty, rule_version, confidence
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRg08CandidateConfirmed:
UPDATE rg08_candidate
SET status = ?, proposed_principal_amount_minor = ?, proposed_interest_amount_minor = ?,
    proposed_fee_amount_minor = ?, proposed_destination_account_id = ?,
    proposed_actual_receipt_at = ?,
    proposed_behavior_code = ?, proposed_counterparty_id = ?
WHERE ledger_id = ? AND candidate_id = ?;

insertRg08CandidateStatusHistory:
INSERT INTO rg08_candidate_status_history(
  ledger_id, candidate_id, status_sequence, history_id, status, occurred_at, formal_effect_count
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg08CandidateSource:
INSERT INTO rg08_candidate_source(ledger_id, candidate_id, source_index, source_id)
VALUES (?, ?, ?, ?);

insertRg08Confirmation:
