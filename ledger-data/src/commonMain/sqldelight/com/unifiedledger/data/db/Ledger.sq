CREATE TRIGGER rg04_import_candidate_delete BEFORE DELETE ON rg04_import_candidate BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import candidate'); END;
CREATE TRIGGER rg04_import_status_update BEFORE UPDATE ON rg04_import_candidate_status_fact BEGIN SELECT RAISE(ABORT, 'cannot update RG04 import status'); END;
CREATE TRIGGER rg04_import_status_delete BEFORE DELETE ON rg04_import_candidate_status_fact BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import status'); END;
CREATE TRIGGER rg04_import_confirmation_update BEFORE UPDATE ON rg04_import_confirmation BEGIN SELECT RAISE(ABORT, 'cannot update RG04 import confirmation'); END;
CREATE TRIGGER rg04_import_confirmation_delete BEFORE DELETE ON rg04_import_confirmation BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import confirmation'); END;
CREATE TRIGGER rg04_import_match_update BEFORE UPDATE ON rg04_import_evidence_match BEGIN SELECT RAISE(ABORT, 'cannot update RG04 import match'); END;
CREATE TRIGGER rg04_import_match_delete BEFORE DELETE ON rg04_import_evidence_match BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import match'); END;
CREATE TRIGGER rg04_import_source_snapshot_update BEFORE UPDATE ON rg04_import_source_snapshot BEGIN SELECT RAISE(ABORT, 'cannot update RG04 import source snapshot'); END;
CREATE TRIGGER rg04_import_source_snapshot_delete BEFORE DELETE ON rg04_import_source_snapshot BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import source snapshot'); END;
CREATE TRIGGER rg04_import_source_component_snapshot_update BEFORE UPDATE ON rg04_import_source_component_snapshot BEGIN SELECT RAISE(ABORT, 'cannot update RG04 import source component snapshot'); END;
CREATE TRIGGER rg04_import_source_component_snapshot_delete BEFORE DELETE ON rg04_import_source_component_snapshot BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import source component snapshot'); END;
