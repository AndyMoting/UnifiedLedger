CREATE TRIGGER rg06_guard_posting_set_update AFTER UPDATE ON posting_set BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg06_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid accepted RG06 aggregate') END; END;
CREATE TRIGGER rg06_guard_posting_set_delete AFTER DELETE ON posting_set BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg06_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid accepted RG06 aggregate') END; END;
CREATE TRIGGER rg06_guard_posting_insert AFTER INSERT ON posting BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg06_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid accepted RG06 aggregate') END; END;
CREATE TRIGGER rg06_guard_posting_update AFTER UPDATE ON posting BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg06_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid accepted RG06 aggregate') END; END;
CREATE TRIGGER rg06_guard_posting_delete AFTER DELETE ON posting BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg06_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid accepted RG06 aggregate') END; END;

