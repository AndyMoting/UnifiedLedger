CREATE TRIGGER rg04_import_confirmation_snapshot_delete BEFORE DELETE ON rg04_import_confirmation_snapshot BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import confirmation snapshot'); END;
CREATE TRIGGER rg04_import_confirmation_component_snapshot_update BEFORE UPDATE ON rg04_import_confirmation_component_snapshot BEGIN SELECT RAISE(ABORT, 'cannot update RG04 import confirmation component snapshot'); END;
CREATE TRIGGER rg04_import_confirmation_component_snapshot_delete BEFORE DELETE ON rg04_import_confirmation_component_snapshot BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import confirmation component snapshot'); END;
CREATE TRIGGER rg04_import_mirror_snapshot_update BEFORE UPDATE ON rg04_import_mirror_snapshot BEGIN SELECT RAISE(ABORT, 'cannot update RG04 import mirror snapshot'); END;
CREATE TRIGGER rg04_import_mirror_snapshot_delete BEFORE DELETE ON rg04_import_mirror_snapshot BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import mirror snapshot'); END;

CREATE VIEW rg04_accepted_aggregate_violation AS
SELECT receipt.ledger_id, receipt.request_id
FROM rg04_operation_receipt AS receipt
LEFT JOIN rg04_operation_request AS request
  ON request.ledger_id = receipt.ledger_id AND request.request_id = receipt.request_id
LEFT JOIN ledger_transaction AS transaction_row
  ON transaction_row.ledger_id = receipt.ledger_id AND transaction_row.transaction_id = receipt.transaction_id
WHERE request.request_id IS NULL
   OR transaction_row.transaction_id IS NULL
   OR NOT EXISTS (
        SELECT 1 FROM rg04_confirmation AS confirmation
        WHERE confirmation.ledger_id = receipt.ledger_id
          AND confirmation.confirmation_id = receipt.confirmation_id
          AND confirmation.request_id = receipt.request_id
          AND confirmation.transaction_id = receipt.transaction_id
          AND confirmation.confirmation_kind = 'EXPLICIT_MANUAL_SAVE'
      )
   OR NOT EXISTS (
        SELECT 1
        FROM ledger_transaction_current_version AS current_version
        JOIN transaction_version AS version
          ON version.ledger_id = current_version.ledger_id
         AND version.transaction_id = current_version.transaction_id
         AND version.version_id = current_version.current_version_id
        JOIN posting_set
          ON posting_set.ledger_id = version.ledger_id
         AND posting_set.posting_set_id = version.posting_set_id
        WHERE current_version.ledger_id = receipt.ledger_id
          AND current_version.transaction_id = receipt.transaction_id
          AND version.version_number = 1
      )
   OR EXISTS (
        SELECT 1
        FROM ledger_transaction_current_version AS current_version
        JOIN transaction_version AS accepted_version
          ON accepted_version.ledger_id = current_version.ledger_id
         AND accepted_version.transaction_id = current_version.transaction_id
         AND accepted_version.version_id = current_version.current_version_id
        JOIN transaction_version AS other_version
          ON other_version.ledger_id = accepted_version.ledger_id
         AND other_version.posting_set_id = accepted_version.posting_set_id
         AND other_version.transaction_id != receipt.transaction_id
        WHERE current_version.ledger_id = receipt.ledger_id
          AND current_version.transaction_id = receipt.transaction_id
      )
   OR (request.action_type = 'MANUAL_MIXED_EXPENSE' AND (
        transaction_row.kind != 'EXPENSE'
        OR EXISTS (SELECT 1 FROM rg04_repayment_snapshot AS repayment WHERE repayment.ledger_id = receipt.ledger_id AND repayment.request_id = receipt.request_id)
        OR NOT EXISTS (
          SELECT 1 FROM rg04_mixed_expense_snapshot AS snapshot
          JOIN ledger_transaction_current_version AS current_version
            ON current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
          JOIN transaction_version AS version
            ON version.ledger_id = current_version.ledger_id
           AND version.transaction_id = current_version.transaction_id
           AND version.version_id = current_version.current_version_id
          JOIN rg04_mixed_composition AS composition
            ON composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id
          JOIN rg04_settlement_explanation AS settlement
            ON settlement.ledger_id = receipt.ledger_id AND settlement.transaction_id = receipt.transaction_id
          JOIN posting AS expense_posting
            ON expense_posting.ledger_id = version.ledger_id AND expense_posting.posting_set_id = version.posting_set_id
           AND expense_posting.posting_index = 0
          JOIN rg04_posting_semantic AS expense_semantic
            ON expense_semantic.ledger_id = expense_posting.ledger_id
           AND expense_semantic.posting_id = expense_posting.posting_id
           AND expense_semantic.role = 'expense'
           AND expense_semantic.reconciliation_eligible = 0
          WHERE snapshot.ledger_id = receipt.ledger_id AND snapshot.request_id = receipt.request_id
            AND snapshot.occurred_at = version.occurred_at
            AND snapshot.occurred_at = version.statistics_at
            AND snapshot.occurred_at = version.effective_at
            AND snapshot.total_minor = composition.total_minor
            AND snapshot.total_minor = settlement.settled_minor
            AND snapshot.total_minor = expense_posting.amount_minor
            AND snapshot.currency_code = composition.currency_code
            AND snapshot.currency_code = settlement.currency_code
            AND snapshot.currency_code = expense_posting.currency_code
            AND snapshot.currency_precision = composition.currency_precision
            AND snapshot.currency_precision = settlement.currency_precision
            AND snapshot.currency_precision = expense_posting.currency_precision
            AND snapshot.category_id = expense_semantic.category_id
            AND snapshot.original_minor = settlement.original_minor
            AND snapshot.discount_minor = settlement.discount_minor
            AND snapshot.settled_minor = settlement.settled_minor
            AND snapshot.confirmation_marker = 'explicit_manual_save'
            AND composition.system_managed = 1
            AND composition.generic_order_lifecycle = 0
            AND settlement.accounting_effect_count = 0
        )
        OR NOT EXISTS (
          SELECT 1 FROM rg04_accepted_composition_snapshot AS accepted_composition
          JOIN rg04_mixed_composition AS composition
            ON composition.ledger_id = accepted_composition.ledger_id
           AND composition.relation_id = accepted_composition.relation_id
           AND composition.transaction_id = accepted_composition.transaction_id
           AND composition.display_name = accepted_composition.display_name
           AND composition.total_minor = accepted_composition.total_minor
           AND composition.currency_code = accepted_composition.currency_code
           AND composition.currency_precision = accepted_composition.currency_precision
           AND composition.system_managed = accepted_composition.system_managed
           AND composition.generic_order_lifecycle = accepted_composition.generic_order_lifecycle
          WHERE accepted_composition.ledger_id = receipt.ledger_id
            AND accepted_composition.request_id = receipt.request_id
        )
        OR 1 != (SELECT count(*) FROM rg04_mixed_composition AS composition WHERE composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id)
        OR 2 != (SELECT count(*) FROM rg04_mixed_expense_component_snapshot AS component WHERE component.ledger_id = receipt.ledger_id AND component.request_id = receipt.request_id)
        OR 2 != (SELECT count(*) FROM rg04_mixed_composition_component AS component JOIN rg04_mixed_composition AS composition ON composition.ledger_id = component.ledger_id AND composition.relation_id = component.relation_id WHERE composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id)
        OR 1 != (SELECT count(*) FROM formal_relation_member AS member JOIN rg04_mixed_composition AS composition ON composition.ledger_id = member.ledger_id AND composition.relation_id = member.relation_id WHERE composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id AND member.member_kind = 'TRANSACTION' AND member.transaction_id = receipt.transaction_id)
        OR 2 != (SELECT count(DISTINCT member.posting_id) FROM formal_relation_member AS member JOIN rg04_mixed_composition AS composition ON composition.ledger_id = member.ledger_id AND composition.relation_id = member.relation_id WHERE composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id AND member.member_kind = 'POSTING')
        OR EXISTS (
          SELECT 1 FROM rg04_mixed_expense_component_snapshot AS snapshot_component
          WHERE snapshot_component.ledger_id = receipt.ledger_id AND snapshot_component.request_id = receipt.request_id
            AND NOT EXISTS (
              SELECT 1 FROM rg04_mixed_composition AS composition
              JOIN rg04_mixed_composition_component AS component
                ON component.ledger_id = composition.ledger_id
               AND component.relation_id = composition.relation_id
               AND component.component_index = snapshot_component.component_index
              JOIN formal_relation_member AS member
                ON member.ledger_id = component.ledger_id
               AND member.relation_id = component.relation_id
               AND member.member_kind = 'POSTING'
               AND member.posting_id = component.posting_id
              JOIN posting
                ON posting.ledger_id = component.ledger_id AND posting.posting_id = component.posting_id
              JOIN ledger_transaction_current_version AS current_version
                ON current_version.ledger_id = receipt.ledger_id
               AND current_version.transaction_id = receipt.transaction_id
              JOIN transaction_version AS version
                ON version.ledger_id = current_version.ledger_id
               AND version.transaction_id = current_version.transaction_id
               AND version.version_id = current_version.current_version_id
               AND version.posting_set_id = posting.posting_set_id
              JOIN rg04_posting_semantic AS semantic
                ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
              WHERE composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id
                AND component.account_id = snapshot_component.account_id
                AND component.amount_minor = snapshot_component.amount_minor
                AND component.currency_code = snapshot_component.currency_code
                AND component.currency_precision = snapshot_component.currency_precision
                AND posting.account_id = snapshot_component.account_id
                AND posting.posting_index = snapshot_component.component_index + 1
                AND posting.amount_minor = -snapshot_component.amount_minor
                AND posting.currency_code = snapshot_component.currency_code
                AND posting.currency_precision = snapshot_component.currency_precision
                AND semantic.reconciliation_eligible = 1
                AND semantic.category_id IS NULL
                AND semantic.role = CASE snapshot_component.component_index WHEN 0 THEN 'mixed_expense_asset_funding' ELSE 'mixed_expense_credit_funding' END
            )
        )
      ))
   OR (request.action_type = 'CREDIT_PRINCIPAL_REPAYMENT' AND (
        transaction_row.kind != 'CREDIT_REPAYMENT'
        OR EXISTS (SELECT 1 FROM rg04_mixed_expense_snapshot AS snapshot WHERE snapshot.ledger_id = receipt.ledger_id AND snapshot.request_id = receipt.request_id)
        OR EXISTS (SELECT 1 FROM rg04_accepted_composition_snapshot AS snapshot WHERE snapshot.ledger_id = receipt.ledger_id AND snapshot.request_id = receipt.request_id)
        OR EXISTS (SELECT 1 FROM rg04_mixed_composition AS composition WHERE composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id)
        OR EXISTS (SELECT 1 FROM rg04_settlement_explanation AS settlement WHERE settlement.ledger_id = receipt.ledger_id AND settlement.transaction_id = receipt.transaction_id)
        OR EXISTS (
          SELECT 1 FROM formal_relation_member AS member
          WHERE member.ledger_id = receipt.ledger_id
            AND member.member_kind = 'TRANSACTION'
            AND member.transaction_id = receipt.transaction_id
        )
        OR EXISTS (
          SELECT 1 FROM formal_relation_member AS member
          JOIN posting ON posting.ledger_id = member.ledger_id AND posting.posting_id = member.posting_id
          JOIN ledger_transaction_current_version AS current_version
            ON current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
          JOIN transaction_version AS version
            ON version.ledger_id = current_version.ledger_id
           AND version.transaction_id = current_version.transaction_id
           AND version.version_id = current_version.current_version_id
           AND version.posting_set_id = posting.posting_set_id
          WHERE member.ledger_id = receipt.ledger_id AND member.member_kind = 'POSTING'
        )
        OR EXISTS (
          SELECT 1 FROM rg04_mixed_composition_component AS component
          JOIN posting ON posting.ledger_id = component.ledger_id AND posting.posting_id = component.posting_id
          JOIN ledger_transaction_current_version AS current_version
            ON current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
          JOIN transaction_version AS version
            ON version.ledger_id = current_version.ledger_id
           AND version.transaction_id = current_version.transaction_id
           AND version.version_id = current_version.current_version_id
           AND version.posting_set_id = posting.posting_set_id
          WHERE component.ledger_id = receipt.ledger_id
        )
        OR NOT EXISTS (
          SELECT 1 FROM rg04_repayment_snapshot AS snapshot
          JOIN ledger_transaction_current_version AS current_version
            ON current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
          JOIN transaction_version AS version
            ON version.ledger_id = current_version.ledger_id
           AND version.transaction_id = current_version.transaction_id
           AND version.version_id = current_version.current_version_id
          WHERE snapshot.ledger_id = receipt.ledger_id AND snapshot.request_id = receipt.request_id
            AND snapshot.occurred_at = version.occurred_at
            AND snapshot.occurred_at = version.statistics_at
            AND snapshot.occurred_at = version.effective_at
            AND snapshot.confirmation_marker = 'explicit_manual_save'
            AND EXISTS (
              SELECT 1 FROM posting JOIN rg04_posting_semantic AS semantic
                ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
              WHERE posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
                AND posting.posting_index = 0
                AND posting.account_id = snapshot.asset_account_id
                AND posting.amount_minor = -snapshot.principal_minor
                AND posting.currency_code = snapshot.currency_code
                AND posting.currency_precision = snapshot.currency_precision
                AND semantic.role = 'credit_repayment_asset_outflow'
                AND semantic.category_id IS NULL AND semantic.reconciliation_eligible = 1
            )
            AND EXISTS (
              SELECT 1 FROM posting JOIN rg04_posting_semantic AS semantic
                ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
              WHERE posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
                AND posting.posting_index = 1
                AND posting.account_id = snapshot.liability_account_id
                AND posting.amount_minor = snapshot.principal_minor
                AND posting.currency_code = snapshot.currency_code
                AND posting.currency_precision = snapshot.currency_precision
                AND semantic.role = 'credit_repayment_liability_principal'
                AND semantic.category_id IS NULL AND semantic.reconciliation_eligible = 1
            )
        )
      ))
   OR 2 != (
        SELECT count(*) FROM rg04_initial_reconciliation_identity AS identity
        WHERE identity.ledger_id = receipt.ledger_id AND identity.request_id = receipt.request_id
      )
   OR 2 != (
        SELECT count(*) FROM ledger_transaction_current_version AS current_version
        JOIN transaction_version AS version
          ON version.ledger_id = current_version.ledger_id
         AND version.transaction_id = current_version.transaction_id
         AND version.version_id = current_version.current_version_id
        JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
        JOIN rg04_posting_semantic AS semantic
          ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
         AND semantic.reconciliation_eligible = 1
        JOIN rg04_posting_reconciliation AS reconciliation
          ON reconciliation.ledger_id = posting.ledger_id AND reconciliation.posting_id = posting.posting_id
        JOIN rg04_initial_reconciliation_identity AS identity
          ON identity.ledger_id = receipt.ledger_id
         AND identity.request_id = receipt.request_id
         AND identity.reconciliation_id = reconciliation.reconciliation_id
         AND identity.posting_id = reconciliation.posting_id
        WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
      )
   OR CASE request.action_type WHEN 'MANUAL_MIXED_EXPENSE' THEN 3 ELSE 2 END != (
        SELECT count(*) FROM ledger_transaction_current_version AS current_version
        JOIN transaction_version AS version
          ON version.ledger_id = current_version.ledger_id
         AND version.transaction_id = current_version.transaction_id
         AND version.version_id = current_version.current_version_id
        JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
        WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
      )
   OR CASE request.action_type WHEN 'MANUAL_MIXED_EXPENSE' THEN 3 ELSE 2 END != (
        SELECT count(*) FROM ledger_transaction_current_version AS current_version
        JOIN transaction_version AS version
          ON version.ledger_id = current_version.ledger_id
         AND version.transaction_id = current_version.transaction_id
         AND version.version_id = current_version.current_version_id
        JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
        JOIN rg04_posting_semantic AS semantic
          ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
        WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
      )
   OR EXISTS (
         SELECT 1 FROM ledger_transaction_current_version AS current_version
        JOIN transaction_version AS version
          ON version.ledger_id = current_version.ledger_id
         AND version.transaction_id = current_version.transaction_id
         AND version.version_id = current_version.current_version_id
        JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
        WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
        GROUP BY posting.currency_code, posting.currency_precision
        HAVING sum(posting.amount_minor) != 0
      )
   OR EXISTS (
        SELECT 1 FROM ledger_transaction_current_version AS current_version
        JOIN transaction_version AS version
          ON version.ledger_id = current_version.ledger_id
         AND version.transaction_id = current_version.transaction_id
         AND version.version_id = current_version.current_version_id
        JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
        JOIN rg04_posting_semantic AS semantic
          ON semantic.ledger_id = posting.ledger_id
         AND semantic.posting_id = posting.posting_id
         AND semantic.reconciliation_eligible = 0
        JOIN rg04_posting_reconciliation AS reconciliation
          ON reconciliation.ledger_id = posting.ledger_id AND reconciliation.posting_id = posting.posting_id
         WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
       );

CREATE VIEW rg04_import_accepted_aggregate_violation AS
SELECT receipt.ledger_id, receipt.request_id
FROM rg04_import_receipt AS receipt
JOIN rg04_import_request AS request
  ON request.ledger_id = receipt.ledger_id AND request.request_id = receipt.request_id
LEFT JOIN rg04_import_confirmation AS confirmation
  ON confirmation.ledger_id = receipt.ledger_id AND confirmation.confirmation_id = receipt.confirmation_id
LEFT JOIN rg04_import_confirmation_snapshot AS snapshot
  ON snapshot.ledger_id = receipt.ledger_id AND snapshot.request_id = receipt.request_id
LEFT JOIN ledger_transaction AS transaction_row
  ON transaction_row.ledger_id = receipt.ledger_id AND transaction_row.transaction_id = receipt.transaction_id
WHERE (request.action_type = 'CONFIRM_CANDIDATE'
  AND (
    receipt.confirmation_id IS NULL
    OR confirmation.request_id IS NULL
    OR confirmation.request_id != receipt.request_id
    OR confirmation.transaction_id != receipt.transaction_id
    OR snapshot.request_id IS NULL
    OR transaction_row.kind != 'EXPENSE'
    OR NOT EXISTS (
      SELECT 1 FROM formal_relation AS relation
      WHERE relation.ledger_id = receipt.ledger_id AND relation.relation_id = snapshot.relation_id
    )
    OR NOT EXISTS (
      SELECT 1
      FROM ledger_transaction_current_version AS current_version
      JOIN transaction_version AS version
        ON version.ledger_id = current_version.ledger_id
       AND version.transaction_id = current_version.transaction_id
       AND version.version_id = current_version.current_version_id
      JOIN posting_set
        ON posting_set.ledger_id = version.ledger_id AND posting_set.posting_set_id = version.posting_set_id
      WHERE current_version.ledger_id = receipt.ledger_id
        AND current_version.transaction_id = receipt.transaction_id
        AND version.version_number = 1
    )
    OR 3 != (
      SELECT count(*)
      FROM ledger_transaction_current_version AS current_version
      JOIN transaction_version AS version
        ON version.ledger_id = current_version.ledger_id
       AND version.transaction_id = current_version.transaction_id
       AND version.version_id = current_version.current_version_id
      JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
      WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
    )
    OR EXISTS (
      SELECT 1
      FROM ledger_transaction_current_version AS current_version
      JOIN transaction_version AS version
        ON version.ledger_id = current_version.ledger_id
       AND version.transaction_id = current_version.transaction_id
       AND version.version_id = current_version.current_version_id
      JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
      WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
      GROUP BY posting.currency_code, posting.currency_precision
      HAVING sum(posting.amount_minor) != 0
    )
    OR 3 != (
      SELECT count(*)
      FROM ledger_transaction_current_version AS current_version
      JOIN transaction_version AS version
        ON version.ledger_id = current_version.ledger_id
       AND version.transaction_id = current_version.transaction_id
       AND version.version_id = current_version.current_version_id
      JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
      JOIN rg04_posting_semantic AS semantic
        ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
      WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
    )
    OR EXISTS (
      SELECT 1
      FROM ledger_transaction_current_version AS current_version
      JOIN transaction_version AS version
        ON version.ledger_id = current_version.ledger_id
       AND version.transaction_id = current_version.transaction_id
       AND version.version_id = current_version.current_version_id
      JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
      JOIN rg04_posting_semantic AS semantic
        ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
      WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
        AND (
          semantic.role != CASE posting.posting_index
            WHEN 0 THEN 'expense'
            WHEN 1 THEN 'mixed_expense_asset_funding'
            ELSE 'mixed_expense_credit_funding'
          END
          OR (posting.posting_index = 0 AND semantic.category_id != snapshot.category_id)
        )
    )
    OR 3 != (
      SELECT count(*)
      FROM formal_relation_member AS member
      JOIN rg04_mixed_composition AS composition
        ON composition.ledger_id = member.ledger_id AND composition.relation_id = member.relation_id
      WHERE composition.ledger_id = receipt.ledger_id
        AND composition.transaction_id = receipt.transaction_id
    )
    OR 2 != (
      SELECT count(*)
      FROM rg04_mixed_composition_component AS component
      JOIN rg04_mixed_composition AS composition
        ON composition.ledger_id = component.ledger_id AND composition.relation_id = component.relation_id
      WHERE composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id
    )
    OR EXISTS (
      SELECT 1 FROM rg04_import_confirmation_component_snapshot AS expected
      WHERE expected.ledger_id = receipt.ledger_id AND expected.request_id = receipt.request_id
        AND NOT EXISTS (
          SELECT 1
          FROM rg04_mixed_composition AS composition
          JOIN rg04_mixed_composition_component AS component
            ON component.ledger_id = composition.ledger_id
           AND component.relation_id = composition.relation_id
           AND component.component_index = expected.component_index
          WHERE composition.ledger_id = receipt.ledger_id
            AND composition.transaction_id = receipt.transaction_id
            AND component.account_id = expected.account_id
            AND component.amount_minor = expected.amount_minor
            AND component.currency_code = expected.currency_code
            AND component.currency_precision = expected.currency_precision
        )
    )
    OR 2 != (
      SELECT count(*)
      FROM ledger_transaction_current_version AS current_version
      JOIN transaction_version AS version
        ON version.ledger_id = current_version.ledger_id
       AND version.transaction_id = current_version.transaction_id
       AND version.version_id = current_version.current_version_id
      JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
      JOIN rg04_posting_semantic AS semantic
        ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
       AND semantic.reconciliation_eligible = 1
      JOIN rg04_posting_reconciliation AS reconciliation
        ON reconciliation.ledger_id = posting.ledger_id AND reconciliation.posting_id = posting.posting_id
      WHERE current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
    )
    OR NOT EXISTS (
      SELECT 1
      FROM rg04_mixed_composition AS composition
      WHERE composition.ledger_id = receipt.ledger_id
        AND composition.relation_id = snapshot.relation_id
        AND composition.transaction_id = receipt.transaction_id
    )
  ))
  OR (request.action_type = 'IMPORT_SOURCE' AND (
    receipt.source_id IS NULL OR receipt.evidence_id IS NULL OR receipt.candidate_id IS NULL
    OR receipt.confirmation_id IS NOT NULL OR receipt.transaction_id IS NOT NULL OR receipt.evidence_link_id IS NOT NULL
    OR NOT EXISTS (
      SELECT 1 FROM rg04_import_source_snapshot AS source_snapshot
      WHERE source_snapshot.ledger_id = receipt.ledger_id AND source_snapshot.request_id = receipt.request_id
        AND source_snapshot.source_id = receipt.source_id AND source_snapshot.evidence_id = receipt.evidence_id
        AND source_snapshot.candidate_id = receipt.candidate_id
    )
    OR NOT EXISTS (
      SELECT 1 FROM rg04_import_source AS source
      JOIN rg04_import_evidence AS evidence
        ON evidence.ledger_id = source.ledger_id AND evidence.source_id = source.source_id
      JOIN rg04_import_candidate AS candidate
        ON candidate.ledger_id = source.ledger_id AND candidate.source_id = source.source_id
      WHERE source.ledger_id = receipt.ledger_id AND source.source_id = receipt.source_id
        AND source.owner_request_id = receipt.request_id AND source.evidence_id = receipt.evidence_id
        AND evidence.evidence_id = receipt.evidence_id AND candidate.candidate_id = receipt.candidate_id
    )
    OR 2 != (SELECT count(*) FROM rg04_import_source_component_snapshot AS component WHERE component.ledger_id = receipt.ledger_id AND component.request_id = receipt.request_id)
    OR NOT EXISTS (
      SELECT 1 FROM rg04_import_candidate_status_fact AS status
      WHERE status.ledger_id = receipt.ledger_id AND status.candidate_id = receipt.candidate_id
        AND status.status_sequence = 1 AND status.status = 'PENDING_CONFIRMATION'
    )
  ))
  OR (request.action_type = 'MERGE_MIRROR' AND (
    receipt.source_id IS NULL OR receipt.evidence_id IS NULL OR receipt.evidence_link_id IS NULL
    OR receipt.confirmation_id IS NOT NULL
    OR NOT EXISTS (
      SELECT 1 FROM rg04_import_mirror_snapshot AS mirror
      WHERE mirror.ledger_id = receipt.ledger_id AND mirror.request_id = receipt.request_id
        AND mirror.source_id = receipt.source_id AND mirror.evidence_id = receipt.evidence_id
        AND mirror.evidence_link_id = receipt.evidence_link_id
    )
    OR NOT EXISTS (
      SELECT 1 FROM rg04_import_source AS source
      JOIN rg04_import_evidence AS evidence
        ON evidence.ledger_id = source.ledger_id AND evidence.source_id = source.source_id
      JOIN rg04_import_evidence_match AS match
        ON match.ledger_id = evidence.ledger_id AND match.evidence_id = evidence.evidence_id
      WHERE source.ledger_id = receipt.ledger_id AND source.source_id = receipt.source_id
        AND source.owner_request_id = receipt.request_id AND source.evidence_id = receipt.evidence_id
        AND evidence.evidence_id = receipt.evidence_id AND match.match_id = receipt.evidence_link_id
        AND match.match_kind = 'LIABILITY_MIRROR'
    )
    OR NOT EXISTS (
      SELECT 1 FROM rg04_import_evidence_match AS match
      JOIN rg04_posting_reconciliation AS reconciliation
        ON reconciliation.ledger_id = match.ledger_id AND reconciliation.posting_id = match.posting_id
      WHERE match.ledger_id = receipt.ledger_id AND match.match_id = receipt.evidence_link_id
        AND reconciliation.status = 'MATCHED'
    )
  ));

CREATE VIEW rg04_import_accepted_aggregate_owner AS
SELECT receipt.ledger_id, receipt.request_id, receipt.transaction_id, snapshot.relation_id
FROM rg04_import_receipt AS receipt
JOIN rg04_import_request AS request
  ON request.ledger_id = receipt.ledger_id AND request.request_id = receipt.request_id
JOIN rg04_import_confirmation AS confirmation
  ON confirmation.ledger_id = receipt.ledger_id
 AND confirmation.confirmation_id = receipt.confirmation_id
JOIN rg04_import_confirmation_snapshot AS snapshot
  ON snapshot.ledger_id = receipt.ledger_id AND snapshot.request_id = receipt.request_id
WHERE request.action_type = 'CONFIRM_CANDIDATE';

CREATE TRIGGER rg04_validate_import_confirmation_receipt AFTER INSERT ON rg04_import_receipt
BEGIN
  SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation)
    THEN RAISE(ABORT, 'invalid accepted RG04 import aggregate') END;
END;

CREATE TRIGGER rg04_import_guard_transaction_update AFTER UPDATE ON ledger_transaction
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 transaction') END; END;
CREATE TRIGGER rg04_import_guard_transaction_delete AFTER DELETE ON ledger_transaction
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 transaction') END; END;
CREATE TRIGGER rg04_import_guard_current_version_update AFTER UPDATE ON ledger_transaction_current_version
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 current version') END; END;
CREATE TRIGGER rg04_import_guard_current_version_delete AFTER DELETE ON ledger_transaction_current_version
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 current version') END; END;
CREATE TRIGGER rg04_import_guard_version_update AFTER UPDATE ON transaction_version
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 version') END; END;
CREATE TRIGGER rg04_import_guard_version_delete AFTER DELETE ON transaction_version
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 version') END; END;
CREATE TRIGGER rg04_import_guard_posting_set_update AFTER UPDATE ON posting_set
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 posting set') END; END;
CREATE TRIGGER rg04_import_guard_posting_set_delete AFTER DELETE ON posting_set
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 posting set') END; END;
CREATE TRIGGER rg04_import_guard_posting_update AFTER UPDATE ON posting
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 posting') END; END;
CREATE TRIGGER rg04_import_guard_posting_delete AFTER DELETE ON posting
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 posting') END; END;
CREATE TRIGGER rg04_import_guard_relation_update AFTER UPDATE ON formal_relation
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 relation') END; END;
CREATE TRIGGER rg04_import_guard_relation_delete AFTER DELETE ON formal_relation
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 relation') END; END;
CREATE TRIGGER rg04_import_guard_relation_member_update AFTER UPDATE ON formal_relation_member
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 relation member') END; END;
CREATE TRIGGER rg04_import_guard_relation_member_delete AFTER DELETE ON formal_relation_member
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 relation member') END; END;
CREATE TRIGGER rg04_import_guard_composition_update AFTER UPDATE ON rg04_mixed_composition
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 composition') END; END;
CREATE TRIGGER rg04_import_guard_composition_delete AFTER DELETE ON rg04_mixed_composition
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 composition') END; END;
CREATE TRIGGER rg04_import_guard_component_update AFTER UPDATE ON rg04_mixed_composition_component
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 composition component') END; END;
CREATE TRIGGER rg04_import_guard_component_delete AFTER DELETE ON rg04_mixed_composition_component
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 composition component') END; END;
CREATE TRIGGER rg04_import_guard_semantic_update AFTER UPDATE ON rg04_posting_semantic
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 posting semantic') END; END;
CREATE TRIGGER rg04_import_guard_semantic_delete AFTER DELETE ON rg04_posting_semantic
BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_import_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid imported RG04 posting semantic') END; END;
CREATE TRIGGER rg04_import_guard_reconciliation_update BEFORE UPDATE ON rg04_posting_reconciliation
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM rg04_reconciliation_transition AS transition
    JOIN rg04_import_request AS request
      ON request.ledger_id = transition.ledger_id
     AND request.request_id = transition.request_id
      WHERE transition.ledger_id = old.ledger_id
      AND request.action_type IN ('CONFIRM_CANDIDATE', 'MERGE_MIRROR')
      AND transition.reconciliation_id = old.reconciliation_id
      AND transition.posting_id = old.posting_id
      AND new.ledger_id = old.ledger_id
      AND new.reconciliation_id = old.reconciliation_id
      AND new.posting_id = old.posting_id
  ) THEN RAISE(ABORT, 'cannot update accepted RG04 reconciliation directly') END;
END;
CREATE TRIGGER rg04_import_guard_reconciliation_status AFTER UPDATE OF status ON rg04_posting_reconciliation
BEGIN
  SELECT CASE WHEN new.status = 'MATCHED' AND NOT EXISTS (
    SELECT 1
    FROM rg04_reconciliation_transition AS transition
    WHERE transition.ledger_id = new.ledger_id
      AND transition.reconciliation_id = new.reconciliation_id
      AND transition.posting_id = new.posting_id
  ) THEN RAISE(ABORT, 'invalid RG04 reconciliation transition') END;
END;
CREATE TRIGGER rg04_import_guard_reconciliation_delete BEFORE DELETE ON rg04_posting_reconciliation
BEGIN SELECT RAISE(ABORT, 'cannot delete accepted RG04 reconciliation'); END;
CREATE TRIGGER rg04_validate_mixed_receipt
AFTER INSERT ON rg04_operation_receipt
BEGIN
  SELECT CASE WHEN EXISTS (
      SELECT 1 FROM rg04_operation_receipt AS receipt
      JOIN rg04_operation_request AS request
        ON request.ledger_id = receipt.ledger_id AND request.request_id = receipt.request_id
      LEFT JOIN rg04_mixed_expense_component_snapshot AS component
        ON component.ledger_id = receipt.ledger_id AND component.request_id = receipt.request_id
      WHERE request.action_type = 'MANUAL_MIXED_EXPENSE'
      GROUP BY receipt.ledger_id, receipt.request_id HAVING count(component.component_index) != 2
    ) THEN RAISE(ABORT, 'invalid mixed request components') END;
  SELECT CASE WHEN EXISTS (
      SELECT 1 FROM rg04_operation_receipt AS receipt
      JOIN rg04_operation_request AS request
        ON request.ledger_id = receipt.ledger_id AND request.request_id = receipt.request_id
      LEFT JOIN rg04_mixed_composition AS composition
        ON composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id
      LEFT JOIN formal_relation_member AS member
        ON member.ledger_id = composition.ledger_id AND member.relation_id = composition.relation_id
       AND member.member_kind = 'TRANSACTION' AND member.transaction_id = receipt.transaction_id
      WHERE request.action_type = 'MANUAL_MIXED_EXPENSE'
      GROUP BY receipt.ledger_id, receipt.request_id HAVING count(member.member_index) != 1
    ) THEN RAISE(ABORT, 'invalid mixed transaction member') END;
  SELECT CASE WHEN EXISTS (
      SELECT 1 FROM rg04_operation_receipt AS receipt
      JOIN rg04_operation_request AS request
        ON request.ledger_id = receipt.ledger_id AND request.request_id = receipt.request_id
      LEFT JOIN rg04_mixed_composition AS composition
        ON composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id
      LEFT JOIN formal_relation_member AS member
        ON member.ledger_id = composition.ledger_id AND member.relation_id = composition.relation_id
       AND member.member_kind = 'POSTING'
      LEFT JOIN posting AS posting
        ON posting.ledger_id = member.ledger_id AND posting.posting_id = member.posting_id
      LEFT JOIN ledger_transaction_current_version AS current_version
        ON current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
      LEFT JOIN transaction_version AS version
        ON version.ledger_id = current_version.ledger_id
       AND version.transaction_id = current_version.transaction_id
       AND version.version_id = current_version.current_version_id
       AND version.posting_set_id = posting.posting_set_id
      WHERE request.action_type = 'MANUAL_MIXED_EXPENSE'
      GROUP BY receipt.ledger_id, receipt.request_id
      HAVING count(version.version_id) != 2 OR count(DISTINCT member.posting_id) != 2
    ) THEN RAISE(ABORT, 'invalid mixed posting members') END;
  SELECT CASE WHEN EXISTS (
      SELECT 1 FROM rg04_operation_receipt AS receipt
      JOIN rg04_operation_request AS request
        ON request.ledger_id = receipt.ledger_id AND request.request_id = receipt.request_id
      LEFT JOIN rg04_mixed_composition AS composition
        ON composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id
      LEFT JOIN rg04_mixed_composition_component AS component
        ON component.ledger_id = composition.ledger_id AND component.relation_id = composition.relation_id
      LEFT JOIN formal_relation_member AS member
        ON member.ledger_id = component.ledger_id AND member.relation_id = component.relation_id
       AND member.member_kind = 'POSTING' AND member.posting_id = component.posting_id
      WHERE request.action_type = 'MANUAL_MIXED_EXPENSE'
      GROUP BY receipt.ledger_id, receipt.request_id
      HAVING count(DISTINCT component.posting_id) != 2 OR count(DISTINCT member.posting_id) != 2
    ) THEN RAISE(ABORT, 'invalid mixed composition components') END;
  SELECT CASE WHEN EXISTS (
      SELECT 1 FROM rg04_operation_receipt AS receipt
      JOIN ledger_transaction_current_version AS current_version
        ON current_version.ledger_id = receipt.ledger_id AND current_version.transaction_id = receipt.transaction_id
      JOIN transaction_version AS version
        ON version.ledger_id = current_version.ledger_id
       AND version.transaction_id = current_version.transaction_id
       AND version.version_id = current_version.current_version_id
      LEFT JOIN posting AS posting
        ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
      LEFT JOIN rg04_posting_semantic AS semantic
        ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
       AND semantic.reconciliation_eligible = 1
      LEFT JOIN rg04_posting_reconciliation AS reconciliation
        ON reconciliation.ledger_id = semantic.ledger_id AND reconciliation.posting_id = semantic.posting_id
      LEFT JOIN rg04_initial_reconciliation_identity AS identity
        ON identity.ledger_id = receipt.ledger_id AND identity.request_id = receipt.request_id
       AND identity.reconciliation_id = reconciliation.reconciliation_id
       AND identity.posting_id = reconciliation.posting_id
      GROUP BY receipt.ledger_id, receipt.request_id
      HAVING count(DISTINCT semantic.posting_id) != 2
          OR count(DISTINCT reconciliation.reconciliation_id) != 2
          OR count(DISTINCT identity.reconciliation_index) != 2
    ) THEN RAISE(ABORT, 'invalid RG04 reconciliations') END;
  INSERT INTO rg04_accepted_composition_snapshot
  SELECT receipt.ledger_id, receipt.request_id, composition.relation_id, composition.transaction_id,
         composition.display_name, composition.total_minor, composition.currency_code, composition.currency_precision,
         composition.system_managed, composition.generic_order_lifecycle
  FROM rg04_operation_receipt AS receipt
  JOIN rg04_operation_request AS request
    ON request.ledger_id = receipt.ledger_id AND request.request_id = receipt.request_id
  JOIN rg04_mixed_composition AS composition
    ON composition.ledger_id = receipt.ledger_id AND composition.transaction_id = receipt.transaction_id
  WHERE request.action_type = 'MANUAL_MIXED_EXPENSE'
    AND NOT EXISTS (
      SELECT 1 FROM rg04_accepted_composition_snapshot AS accepted_composition
      WHERE accepted_composition.ledger_id = receipt.ledger_id AND accepted_composition.request_id = receipt.request_id
    );
  SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_accepted_aggregate_violation)
    THEN RAISE(ABORT, 'invalid accepted RG04 aggregate') END;
END;

CREATE TRIGGER rg04_protect_accepted_request_update
AFTER UPDATE ON rg04_operation_request BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg04_accepted_aggregate_violation) THEN RAISE(ABORT, 'cannot update accepted RG04 request') END; END;

