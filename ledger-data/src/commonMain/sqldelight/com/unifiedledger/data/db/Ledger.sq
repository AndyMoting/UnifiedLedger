selectCommittedRequest:
SELECT
  request.amount_minor,
  request.currency_code,
  request.currency_precision,
  request.category_id,
  request.payment_account_id,
  request.occurred_at,
  request.note,
  request.confirmation_marker,
  receipt.confirmation_id,
  receipt.transaction_id
FROM manual_expense_request AS request
JOIN confirmed_expense_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id
 AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

selectCommittedManualIncomeRequest:
SELECT request.amount_minor, request.currency_code, request.currency_precision, request.category_id,
  request.receiving_account_id, request.occurred_at, request.note, request.confirmation_marker,
  receipt.confirmation_id, receipt.transaction_id
FROM manual_income_request AS request JOIN confirmed_income_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

claimRg04Request:
INSERT INTO rg04_operation_request(ledger_id, request_id, action_type) VALUES (?, ?, ?)
ON CONFLICT (ledger_id, request_id) DO NOTHING;

selectRg04Action:
SELECT action_type FROM rg04_operation_request WHERE ledger_id = ? AND request_id = ?;

insertRg04MixedSnapshot:
INSERT INTO rg04_mixed_expense_snapshot VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg04MixedSnapshotComponent:
INSERT INTO rg04_mixed_expense_component_snapshot VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg04RepaymentSnapshot:
INSERT INTO rg04_repayment_snapshot VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg04Confirmation:
INSERT INTO rg04_confirmation VALUES (?, ?, ?, ?, 'EXPLICIT_MANUAL_SAVE');

insertRg04Receipt:
INSERT INTO rg04_operation_receipt VALUES (?, ?, ?, ?, 'ACCEPTED');

insertRg04PostingSemantic:
INSERT INTO rg04_posting_semantic VALUES (?, ?, ?, ?, ?);

insertRg04Settlement:
INSERT INTO rg04_settlement_explanation VALUES (?, ?, ?, ?, ?, 0, ?, ?);

insertFormalRelation:
INSERT INTO formal_relation VALUES (?, ?, 'mixed_payment');

insertFormalRelationMember:
INSERT INTO formal_relation_member VALUES (?, ?, ?, ?, ?, ?);

insertRg04MixedComposition:
INSERT INTO rg04_mixed_composition VALUES (?, ?, ?, ?, ?, ?, ?, 1, 0);

insertRg04MixedCompositionComponent:
INSERT INTO rg04_mixed_composition_component VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg04PostingReconciliation:
INSERT INTO rg04_posting_reconciliation VALUES (?, ?, ?, 'PENDING');

insertRg04ReconciliationTransition:
INSERT INTO rg04_reconciliation_transition VALUES (?, ?, ?, ?);

deleteRg04ReconciliationTransition:
DELETE FROM rg04_reconciliation_transition
WHERE ledger_id = ? AND request_id = ? AND reconciliation_id = ?;

insertRg04InitialReconciliationIdentity:
INSERT INTO rg04_initial_reconciliation_identity VALUES (?, ?, ?, ?, ?);

selectRg04ManualCommit:
SELECT request.occurred_at, request.total_minor, request.currency_code, request.currency_precision,
  request.category_id, request.original_minor, request.discount_minor, request.settled_minor, request.confirmation_marker,
  receipt.confirmation_id, receipt.transaction_id
FROM rg04_mixed_expense_snapshot AS request
JOIN rg04_operation_receipt AS receipt ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = ? AND request.request_id = ?;

selectRg04ManualSnapshotComponents:
SELECT component_index, account_id, amount_minor, currency_code, currency_precision
FROM rg04_mixed_expense_component_snapshot WHERE ledger_id = ? AND request_id = ? ORDER BY component_index;

selectRg04RepaymentCommit:
SELECT request.occurred_at, request.asset_account_id, request.liability_account_id,
  request.principal_minor, request.currency_code, request.currency_precision, request.confirmation_marker,
  receipt.confirmation_id, receipt.transaction_id
FROM rg04_repayment_snapshot AS request
JOIN rg04_operation_receipt AS receipt ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = ? AND request.request_id = ?;

deleteRg04Request:
DELETE FROM rg04_operation_request WHERE ledger_id = ? AND request_id = ?;

countRg04OperationRequests:
SELECT count(*) FROM rg04_operation_request;
countRg04Receipts:
SELECT count(*) FROM rg04_operation_receipt;
countRg04Relations:
SELECT count(*) FROM formal_relation;
countRg04RelationMembers:
SELECT count(*) FROM formal_relation_member;
countRg04CompositionComponents:
SELECT count(*) FROM rg04_mixed_composition_component;
countRg04PostingReconciliations:
SELECT count(*) FROM rg04_posting_reconciliation;
selectRg04PostingReconciliations:
SELECT reconciliation_id, posting_id, status FROM rg04_posting_reconciliation ORDER BY posting_id;
selectRg04PostingSemantics:
SELECT posting_id, role, category_id, reconciliation_eligible FROM rg04_posting_semantic ORDER BY posting_id;

selectRg04Confirmations:
SELECT confirmation_id FROM rg04_confirmation ORDER BY confirmation_id;

selectRg04Relations:
SELECT relation_id FROM formal_relation ORDER BY relation_id;

claimRg04ImportRequest:
INSERT INTO rg04_import_request VALUES (?, ?, ?) ON CONFLICT (ledger_id, request_id) DO NOTHING;

deleteRg04ImportRequest:
DELETE FROM rg04_import_request WHERE ledger_id = ? AND request_id = ?;

selectRg04ImportAction:
SELECT action_type FROM rg04_import_request WHERE ledger_id = ? AND request_id = ?;

insertRg04ImportSourceSnapshot:
INSERT INTO rg04_import_source_snapshot VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg04ImportSourceComponentSnapshot:
INSERT INTO rg04_import_source_component_snapshot VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg04ImportSource:
INSERT INTO rg04_import_source VALUES (?, ?, ?, ?, ?, ?);

insertRg04ImportEvidence:
INSERT INTO rg04_import_evidence VALUES (?, ?, ?, ?, ?);

insertRg04ImportCandidate:
INSERT INTO rg04_import_candidate VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg04ImportCandidateStatus:
INSERT INTO rg04_import_candidate_status_fact VALUES (?, ?, ?, ?, ?, ?);

insertRg04ImportConfirmationSnapshot:
INSERT INTO rg04_import_confirmation_snapshot VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg04ImportConfirmationComponentSnapshot:
INSERT INTO rg04_import_confirmation_component_snapshot VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg04ImportConfirmation:
INSERT INTO rg04_import_confirmation VALUES (?, ?, ?, ?, ?);

insertRg04ImportMirrorSnapshot:
INSERT INTO rg04_import_mirror_snapshot VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg04ImportEvidenceMatch:
INSERT INTO rg04_import_evidence_match VALUES (?, ?, ?, ?, ?);

insertRg04ImportReceipt:
INSERT INTO rg04_import_receipt VALUES (?, ?, 'ACCEPTED', ?, ?, ?, ?, ?, ?);

markRg04PostingReconciliationMatched:
UPDATE rg04_posting_reconciliation SET status = 'MATCHED'
WHERE ledger_id = ? AND reconciliation_id = ? AND status = 'PENDING';

selectRg04PostingReconciliationStatus:
SELECT status FROM rg04_posting_reconciliation WHERE ledger_id = ? AND posting_id = ?;

selectRg04ImportAssetPosting:
SELECT posting.posting_id
FROM rg04_import_confirmation AS confirmation
JOIN ledger_transaction_current_version AS current_version
  ON current_version.ledger_id = confirmation.ledger_id AND current_version.transaction_id = confirmation.transaction_id
JOIN transaction_version AS version
  ON version.ledger_id = current_version.ledger_id AND version.transaction_id = current_version.transaction_id
 AND version.version_id = current_version.current_version_id
JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
JOIN rg04_posting_semantic AS semantic
  ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
WHERE confirmation.ledger_id = ? AND confirmation.candidate_id = ?
  AND semantic.role = 'mixed_expense_asset_funding';

selectRg04ImportSourceCommit:
SELECT request.action_type, snapshot.source_id, snapshot.evidence_id, snapshot.observed_at,
 snapshot.total_minor, snapshot.currency_code, snapshot.currency_precision, snapshot.suggested_category_id,
 snapshot.completeness, snapshot.confidence, snapshot.candidate_kind, snapshot.candidate_id,
 snapshot.candidate_status_id, receipt.source_id, receipt.evidence_id, receipt.candidate_id
FROM rg04_import_request AS request
JOIN rg04_import_source_snapshot AS snapshot ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
JOIN rg04_import_receipt AS receipt ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = ? AND request.request_id = ?;

selectRg04ImportSourceComponents:
SELECT component_index, account_id, amount_minor, currency_code, currency_precision, evidence_available
FROM rg04_import_source_component_snapshot WHERE ledger_id = ? AND request_id = ? ORDER BY component_index;

selectRg04ImportConfirmationCommit:
SELECT request.action_type, snapshot.candidate_id, snapshot.category_id, snapshot.confirmed, snapshot.relation_id,
 snapshot.version_id, snapshot.posting_set_id, snapshot.expense_posting_id, snapshot.asset_posting_id,
 snapshot.liability_posting_id, snapshot.confirmed_status_id, snapshot.relation_display_name,
 snapshot.asset_evidence_link_id, snapshot.asset_reconciliation_id, snapshot.liability_reconciliation_id,
 receipt.confirmation_id, receipt.transaction_id
FROM rg04_import_request AS request
JOIN rg04_import_confirmation_snapshot AS snapshot ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
JOIN rg04_import_receipt AS receipt ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = ? AND request.request_id = ?;

selectRg04ImportConfirmationByCandidate:
SELECT snapshot.liability_reconciliation_id
FROM rg04_import_confirmation_snapshot AS snapshot
WHERE snapshot.ledger_id = ? AND snapshot.candidate_id = ?;

selectRg04ImportConfirmationComponents:
SELECT component_index, account_id, amount_minor, currency_code, currency_precision
FROM rg04_import_confirmation_component_snapshot WHERE ledger_id = ? AND request_id = ? ORDER BY component_index;

selectRg04ImportMirrorCommit:
SELECT request.action_type, snapshot.source_id, snapshot.evidence_id, snapshot.observed_at, snapshot.account_id,
 snapshot.amount_minor, snapshot.currency_code, snapshot.currency_precision, snapshot.evidence_link_id,
 receipt.source_id, receipt.evidence_id, receipt.evidence_link_id
FROM rg04_import_request AS request
JOIN rg04_import_mirror_snapshot AS snapshot ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
JOIN rg04_import_receipt AS receipt ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = ? AND request.request_id = ?;

selectRg04ImportSourceOwner:
SELECT owner_request_id FROM rg04_import_source WHERE ledger_id = ? AND source_id = ?;

selectRg04ImportEvidenceOwner:
SELECT source_id FROM rg04_import_evidence WHERE ledger_id = ? AND evidence_id = ?;

selectRg04ImportCandidateOwner:
SELECT source_id FROM rg04_import_candidate WHERE ledger_id = ? AND candidate_id = ?;

selectRg04ImportMatchOwner:
SELECT evidence_id, posting_id FROM rg04_import_evidence_match WHERE ledger_id = ? AND match_id = ?;

selectRg04ImportStatusOwner:
SELECT candidate_id, request_id FROM rg04_import_candidate_status_fact WHERE ledger_id = ? AND status_id = ?;

selectRg04ImportConfirmationOwner:
SELECT request_id, candidate_id, transaction_id FROM rg04_import_confirmation WHERE ledger_id = ? AND confirmation_id = ?;

selectRg04ImportRelationOwner:
SELECT transaction_id FROM rg04_mixed_composition WHERE ledger_id = ? AND relation_id = ?;

selectRg04ImportTransactionOwner:
SELECT transaction_id FROM ledger_transaction WHERE ledger_id = ? AND transaction_id = ?;

selectRg04ImportPostingOwner:
SELECT posting_id FROM posting WHERE ledger_id = ? AND posting_id = ?;

selectRg04ImportVersionOwner:
SELECT version_id FROM transaction_version WHERE ledger_id = ? AND version_id = ?;

selectRg04ImportPostingSetOwner:
SELECT posting_set_id FROM posting_set WHERE ledger_id = ? AND posting_set_id = ?;

selectRg04ImportReconciliationOwner:
SELECT posting_id FROM rg04_posting_reconciliation WHERE ledger_id = ? AND reconciliation_id = ?;

selectRg04ImportCandidateState:
SELECT candidate.candidate_id, candidate.source_id, candidate.candidate_kind, candidate.confidence,
 status.status, source.owner_request_id
FROM rg04_import_candidate AS candidate
JOIN rg04_import_source AS source ON source.ledger_id = candidate.ledger_id AND source.source_id = candidate.source_id
JOIN rg04_import_candidate_status_fact AS status ON status.ledger_id = candidate.ledger_id AND status.candidate_id = candidate.candidate_id
WHERE candidate.ledger_id = ? AND candidate.candidate_id = ?
ORDER BY status.status_sequence DESC LIMIT 1;

selectRg04ImportCandidateSourceSnapshot:
SELECT snapshot.observed_at, snapshot.total_minor, snapshot.currency_code, snapshot.currency_precision,
 snapshot.suggested_category_id, snapshot.completeness, snapshot.evidence_id, snapshot.request_id
FROM rg04_import_candidate AS candidate
JOIN rg04_import_source AS source ON source.ledger_id = candidate.ledger_id AND source.source_id = candidate.source_id
JOIN rg04_import_source_snapshot AS snapshot ON snapshot.ledger_id = source.ledger_id AND snapshot.request_id = source.owner_request_id
WHERE candidate.ledger_id = ? AND candidate.candidate_id = ?;

selectRg04ImportMirrorTargets:
SELECT confirmation.candidate_id, confirmation.transaction_id, posting.posting_id, posting.account_id,
 posting.amount_minor, posting.currency_code, posting.currency_precision, version.occurred_at
FROM rg04_import_confirmation AS confirmation
JOIN ledger_transaction_current_version AS current_version
  ON current_version.ledger_id = confirmation.ledger_id AND current_version.transaction_id = confirmation.transaction_id
JOIN transaction_version AS version
  ON version.ledger_id = current_version.ledger_id AND version.transaction_id = current_version.transaction_id
 AND version.version_id = current_version.current_version_id
JOIN posting ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
JOIN rg04_posting_semantic AS semantic ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
WHERE confirmation.ledger_id = ? AND semantic.role = 'mixed_expense_credit_funding';

countRg04ImportMatchesForPosting:
SELECT count(*) FROM rg04_import_evidence_match WHERE ledger_id = ? AND posting_id = ?;

countRg04ReconciliationForPosting:
SELECT count(*) FROM rg04_posting_reconciliation WHERE ledger_id = ? AND posting_id = ?;

countRg04ImportRequests:
SELECT count(*) FROM rg04_import_request;
countRg04ImportSources:
SELECT count(*) FROM rg04_import_source;
countRg04ImportEvidence:
SELECT count(*) FROM rg04_import_evidence;
countRg04ImportCandidates:
SELECT count(*) FROM rg04_import_candidate;
countRg04ImportConfirmations:
SELECT count(*) FROM rg04_import_confirmation;
countRg04ImportMatches:
SELECT count(*) FROM rg04_import_evidence_match;
selectRg04ImportEvidenceMatches:
SELECT match_id, evidence_id, posting_id, match_kind
FROM rg04_import_evidence_match
ORDER BY match_id;
countRg04ImportReceipts:
SELECT count(*) FROM rg04_import_receipt;

insertTransaction:
INSERT INTO ledger_transaction(
  transaction_id,
  ledger_id,
  kind,
  canonical_kind
) VALUES (?, ?, CASE WHEN :kind = 'REFUND_RECEIPT' THEN 'EXPENSE' ELSE :kind END, CASE WHEN :kind = 'REFUND_RECEIPT' THEN :kind ELSE NULL END);

insertTransactionCurrentVersion:
INSERT INTO ledger_transaction_current_version(
  transaction_id,
  ledger_id,
  current_version_id
) VALUES (?, ?, ?);

insertPostingSet:
INSERT INTO posting_set(posting_set_id, ledger_id) VALUES (?, ?);

insertTransactionVersion:
INSERT INTO transaction_version(
  version_id,
  transaction_id,
  ledger_id,
  version_number,
  posting_set_id,
  occurred_at,
  statistics_at,
  effective_at,
  note
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertPosting:
INSERT INTO posting(
  posting_id,
  posting_set_id,
  ledger_id,
  posting_index,
  account_id,
  amount_minor,
  currency_code,
  currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

claimManualExpenseRequest:
INSERT INTO manual_expense_request(
  ledger_id,
  request_id,
  amount_minor,
  currency_code,
  currency_precision,
  category_id,
  payment_account_id,
  occurred_at,
  note,
  confirmation_marker
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (ledger_id, request_id) DO NOTHING;

claimManualIncomeRequest:
INSERT INTO manual_income_request(ledger_id, request_id, amount_minor, currency_code, currency_precision,
 category_id, receiving_account_id, occurred_at, note, confirmation_marker)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT (ledger_id, request_id) DO NOTHING;

lastStatementChangedRowCount:
SELECT changes();

deleteManualExpenseRequest:
DELETE FROM manual_expense_request
WHERE ledger_id = :ledger_id AND request_id = :request_id;

deleteManualIncomeRequest:
DELETE FROM manual_income_request WHERE ledger_id = :ledger_id AND request_id = :request_id;

insertConfirmedIncomeReceipt:
INSERT INTO confirmed_income_receipt(ledger_id, request_id, confirmation_id, transaction_id) VALUES (?, ?, ?, ?);

insertConfirmedExpenseReceipt:
INSERT INTO confirmed_expense_receipt(
  ledger_id,
  request_id,
  confirmation_id,
  transaction_id
) VALUES (?, ?, ?, ?);

updateCurrentVersion:
UPDATE ledger_transaction_current_version
SET current_version_id = :current_version_id
WHERE transaction_id = :transaction_id;

claimTransactionNoteUpdateRequest:
INSERT INTO transaction_note_update_request(
  ledger_id, request_id, transaction_id, note, confirmation_marker
) VALUES (?, ?, ?, ?, ?)
ON CONFLICT (ledger_id, request_id) DO NOTHING;

deleteTransactionNoteUpdateRequest:
DELETE FROM transaction_note_update_request
WHERE ledger_id = :ledger_id AND request_id = :request_id;

selectCommittedTransactionNoteUpdateRequest:
SELECT request.transaction_id, request.note, request.confirmation_marker,
  receipt.confirmation_id, receipt.version_id, receipt.expected_current_version_id
FROM transaction_note_update_request AS request
JOIN confirmed_transaction_note_update_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

copyCurrentVersionWithNewNote:
INSERT INTO transaction_version(
  version_id, transaction_id, ledger_id, version_number, posting_set_id,
  occurred_at, statistics_at, effective_at, note
)
SELECT :version_id, version.transaction_id, version.ledger_id, version.version_number + 1,
  version.posting_set_id, version.occurred_at, version.statistics_at, version.effective_at, :note
FROM transaction_version AS version
JOIN ledger_transaction_current_version AS current_version
  ON current_version.transaction_id = version.transaction_id
 AND current_version.ledger_id = version.ledger_id
 AND current_version.current_version_id = version.version_id
WHERE version.transaction_id = :transaction_id
  AND version.ledger_id = :ledger_id
  AND version.version_id = :expected_current_version_id;

compareAndSetCurrentVersion:
UPDATE ledger_transaction_current_version
SET current_version_id = :replacement_version_id
WHERE transaction_id = :transaction_id
  AND ledger_id = :ledger_id
  AND current_version_id = :expected_current_version_id;

insertConfirmedTransactionNoteUpdateReceipt:
INSERT INTO confirmed_transaction_note_update_receipt(
  ledger_id, request_id, confirmation_id, transaction_id, version_id, expected_current_version_id
) VALUES (?, ?, ?, ?, ?, ?);

countTransactionNoteUpdateRequests:
SELECT count(*) FROM transaction_note_update_request;

countTransactionNoteUpdateReceipts:
SELECT count(*) FROM confirmed_transaction_note_update_receipt;

countRequests:
SELECT count(*) FROM manual_expense_request;

countReceipts:
SELECT count(*) FROM confirmed_expense_receipt;

countManualIncomeRequests:
SELECT count(*) FROM manual_income_request;

countIncomeReceipts:
SELECT count(*) FROM confirmed_income_receipt;

claimRg03OperationRequest:
INSERT INTO rg03_operation_request(ledger_id, request_id, action_type) VALUES (?, ?, ?)
ON CONFLICT (ledger_id, request_id) DO NOTHING;

insertRg03ManualTransferSnapshot:
INSERT INTO rg03_manual_transfer_request_snapshot(
  ledger_id, request_id, occurred_at, source_account_id, destination_account_id,
  source_debit_minor, destination_credit_minor, fee_minor, currency_code,
  currency_precision, fee_category_id, confirmation_marker
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectRg03ManualCommit:
SELECT request.action_type, snapshot.occurred_at, snapshot.source_account_id,
  snapshot.destination_account_id, snapshot.source_debit_minor,
  snapshot.destination_credit_minor, snapshot.fee_minor, snapshot.currency_code,
  snapshot.currency_precision, snapshot.fee_category_id, snapshot.confirmation_marker,
  receipt.confirmation_id, receipt.transaction_id
FROM rg03_operation_request AS request
JOIN rg03_manual_transfer_request_snapshot AS snapshot
  ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
JOIN rg03_operation_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

insertRg03Confirmation:
INSERT INTO rg03_confirmation(
  ledger_id, confirmation_id, request_id, candidate_id, transaction_id, confirmation_kind
) VALUES (?, ?, ?, ?, ?, ?);

insertRg03OperationReceipt:
INSERT INTO rg03_operation_receipt(
  ledger_id, request_id, outcome, confirmation_id, candidate_id, transaction_id, source_id, evidence_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg03CandidateConfirmationSnapshot:
INSERT INTO rg03_candidate_confirmation_request_snapshot(ledger_id, request_id, candidate_id, confirmed)
VALUES (?, ?, ?, ?);

insertRg03MirrorSnapshot:
INSERT INTO rg03_mirror_request_snapshot(
  ledger_id, request_id, source_id, evidence_id, observed_at, account_id,
  credit_minor, currency_code, currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg03EvidenceLink:
INSERT INTO rg03_evidence_link(ledger_id, link_id, evidence_id, posting_id, target_kind, target_role, status)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg03TransferPostingSemantic:
INSERT INTO rg03_transfer_posting_semantic(
  ledger_id, posting_id, role, category_id, reconciliation_eligible
) VALUES (?, ?, ?, ?, ?);

updateRg03PostingReconciliationStatus:
UPDATE rg03_posting_reconciliation SET status = :status
WHERE ledger_id = :ledger_id AND posting_id = :posting_id;

deleteRg03OperationRequest:
DELETE FROM rg03_operation_request WHERE ledger_id = :ledger_id AND request_id = :request_id;

countRg03OperationRequests:
SELECT count(*) FROM rg03_operation_request;

countRg03OperationReceipts:
SELECT count(*) FROM rg03_operation_receipt;

countRg03Confirmations:
SELECT count(*) FROM rg03_confirmation;

countRg03SourceRecords:
SELECT count(*) FROM rg03_source_record;

countRg03CompleteSourceDetails:
