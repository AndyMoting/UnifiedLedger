VALUES (?, ?, ?, ?, ?);

selectRg08ReturnedIds:
SELECT id_kind, id_value FROM rg08_returned_id
WHERE ledger_id = ? AND identity_value = ? ORDER BY sequence;

insertRg08Position:
INSERT INTO rg08_position(
  ledger_id, position_id, counterparty_id, receivable_account_id,
  currency_code, currency_precision, principal_balance_minor,
  allocation_scope, contract_allocation_enabled
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRg08PositionBalance:
UPDATE rg08_position SET principal_balance_minor = ?
WHERE ledger_id = ? AND position_id = ?;

insertRg08PositionHistory:
INSERT INTO rg08_position_history(
  ledger_id, position_id, history_sequence, history_id, behavior_code,
  amount_minor, principal_balance_after_minor, transaction_id, occurred_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg08Settlement:
INSERT INTO rg08_settlement(
  ledger_id, settlement_id, behavior_code, counterparty_id, linked_position_id,
  allocated_lend_transaction_id, transaction_id, destination_account_id,
  interest_category_id, total_received_minor, currency_code, currency_precision,
  actual_receipt_at, confirmed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg08SettlementComponent:
