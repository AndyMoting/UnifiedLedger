CREATE TRIGGER rg06_guard_transaction_version_update AFTER UPDATE ON transaction_version BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg06_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid accepted RG06 aggregate') END; END;
CREATE TRIGGER rg06_guard_transaction_version_delete AFTER DELETE ON transaction_version BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM rg06_accepted_aggregate_violation) THEN RAISE(ABORT, 'invalid accepted RG06 aggregate') END; END;
