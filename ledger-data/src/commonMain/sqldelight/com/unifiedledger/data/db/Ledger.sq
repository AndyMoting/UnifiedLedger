CREATE TABLE ledger_transaction (
  transaction_id TEXT NOT NULL PRIMARY KEY,
  ledger_id TEXT NOT NULL,
  kind TEXT NOT NULL CHECK (kind IN ('OPENING_BALANCE', 'EXPENSE', 'INCOME', 'ACCOUNT_TRANSFER', 'CREDIT_REPAYMENT')),
  UNIQUE (transaction_id, ledger_id)
);

CREATE TABLE posting_set (
  posting_set_id TEXT NOT NULL PRIMARY KEY,
  ledger_id TEXT NOT NULL,
  UNIQUE (posting_set_id, ledger_id)
);

CREATE TABLE transaction_version (
  version_id TEXT NOT NULL PRIMARY KEY,
  transaction_id TEXT NOT NULL,
  ledger_id TEXT NOT NULL,
  version_number INTEGER NOT NULL CHECK (version_number > 0),
  posting_set_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL,
  statistics_at TEXT NOT NULL,
  effective_at TEXT NOT NULL,
  note TEXT,
  UNIQUE (transaction_id, version_number),
  UNIQUE (transaction_id, version_id, ledger_id),
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (posting_set_id, ledger_id)
    REFERENCES posting_set(posting_set_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE posting (
  posting_id TEXT NOT NULL PRIMARY KEY,
  posting_set_id TEXT NOT NULL,
  ledger_id TEXT NOT NULL,
  posting_index INTEGER NOT NULL CHECK (posting_index >= 0),
  account_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  UNIQUE (posting_set_id, posting_index),
  UNIQUE (posting_id, ledger_id),
  FOREIGN KEY (posting_set_id, ledger_id)
    REFERENCES posting_set(posting_set_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE ledger_transaction_current_version (
  transaction_id TEXT NOT NULL,
  ledger_id TEXT NOT NULL,
  current_version_id TEXT NOT NULL,
  PRIMARY KEY (transaction_id, ledger_id),
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, current_version_id, ledger_id)
    REFERENCES transaction_version(transaction_id, version_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE manual_expense_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  category_id TEXT NOT NULL,
  payment_account_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL,
  note TEXT NOT NULL,
  confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id)
);

CREATE TABLE confirmed_expense_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL UNIQUE,
  transaction_id TEXT NOT NULL UNIQUE,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id)
    REFERENCES manual_expense_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE transaction_note_update_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  note TEXT NOT NULL,
  confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id),
  UNIQUE (ledger_id, request_id, transaction_id),
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE confirmed_transaction_note_update_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL UNIQUE,
  transaction_id TEXT NOT NULL,
  version_id TEXT NOT NULL UNIQUE,
  expected_current_version_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id)
    REFERENCES transaction_note_update_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (ledger_id, request_id, transaction_id)
    REFERENCES transaction_note_update_request(ledger_id, request_id, transaction_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, version_id, ledger_id)
    REFERENCES transaction_version(transaction_id, version_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, expected_current_version_id, ledger_id)
    REFERENCES transaction_version(transaction_id, version_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE manual_income_request (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  category_id TEXT NOT NULL, receiving_account_id TEXT NOT NULL, occurred_at TEXT NOT NULL,
  note TEXT NOT NULL, confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id)
);
CREATE TABLE confirmed_income_receipt (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, confirmation_id TEXT NOT NULL UNIQUE,
  transaction_id TEXT NOT NULL UNIQUE, PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES manual_income_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg03_operation_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  action_type TEXT NOT NULL CHECK (action_type IN (
    'MANUAL_ACCOUNT_TRANSFER', 'IMPORT_SOURCE_RECORD',
    'EXPLICIT_CANDIDATE_CONFIRMATION', 'IMPORT_MIRROR_RECORD'
  )),
  PRIMARY KEY (ledger_id, request_id)
);

CREATE TABLE rg03_manual_transfer_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, occurred_at TEXT NOT NULL,
  source_account_id TEXT NOT NULL, destination_account_id TEXT NOT NULL,
  source_debit_minor INTEGER NOT NULL, destination_credit_minor INTEGER NOT NULL,
  fee_minor INTEGER NOT NULL, currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  fee_category_id TEXT NOT NULL, confirmation_marker TEXT NOT NULL
    CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_source_intake_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, source_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL, observed_at TEXT NOT NULL, source_account_id TEXT NOT NULL,
  source_debit_minor INTEGER NOT NULL, currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  completeness TEXT NOT NULL CHECK (completeness IN ('COMPLETE', 'MISSING_DESTINATION')),
  fee_category_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_complete_source_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, destination_account_id TEXT NOT NULL,
  destination_credit_minor INTEGER NOT NULL, fee_minor INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_source_intake_request_snapshot(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_candidate_confirmation_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, candidate_id TEXT NOT NULL,
  confirmed INTEGER NOT NULL CHECK (confirmed = 1),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_mirror_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, source_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL, observed_at TEXT NOT NULL, account_id TEXT NOT NULL,
  credit_minor INTEGER NOT NULL, currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_source_record (
  ledger_id TEXT NOT NULL, source_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  source_kind TEXT NOT NULL CHECK (source_kind IN ('COMPLETE_TRANSFER_SOURCE', 'INCOMPLETE_TRANSFER_SOURCE', 'ACCOUNT_CREDIT_OBSERVATION')),
  observed_at TEXT NOT NULL, observed_account_id TEXT NOT NULL, observed_amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  PRIMARY KEY (ledger_id, source_id), UNIQUE (ledger_id, source_id, evidence_id)
);

CREATE TABLE rg03_complete_transfer_source_detail (
  ledger_id TEXT NOT NULL, source_id TEXT NOT NULL, destination_account_id TEXT NOT NULL,
  destination_credit_minor INTEGER NOT NULL, fee_minor INTEGER NOT NULL, fee_category_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, source_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg03_source_record(ledger_id, source_id) ON DELETE CASCADE
);

CREATE TABLE rg03_evidence (
  ledger_id TEXT NOT NULL, evidence_id TEXT NOT NULL, source_id TEXT NOT NULL,
  observed_at TEXT NOT NULL, evidence_role TEXT NOT NULL CHECK (evidence_role IN ('SOURCE_DEBIT', 'DESTINATION_MIRROR')),
  PRIMARY KEY (ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, source_id, evidence_id) REFERENCES rg03_source_record(ledger_id, source_id, evidence_id)
);

CREATE TABLE rg03_transfer_candidate (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, source_id TEXT NOT NULL,
  candidate_kind TEXT NOT NULL CHECK (candidate_kind IN ('ACCOUNT_TRANSFER_WITH_FEE', 'ONE_SIDED_DEBIT')),
  fee_category_id TEXT NOT NULL, confidence TEXT NOT NULL, rule_name TEXT NOT NULL, rule_version INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg03_source_record(ledger_id, source_id)
);

CREATE TABLE rg03_candidate_status_history (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, status_sequence INTEGER NOT NULL, status_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION', 'CONFIRMED')),
  request_id TEXT NOT NULL, PRIMARY KEY (ledger_id, candidate_id, status_sequence), UNIQUE (ledger_id, status_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg03_transfer_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id)
);

CREATE TABLE rg03_confirmation (
  ledger_id TEXT NOT NULL, confirmation_id TEXT NOT NULL, request_id TEXT NOT NULL,
  candidate_id TEXT, transaction_id TEXT NOT NULL, confirmation_kind TEXT NOT NULL,
  PRIMARY KEY (ledger_id, confirmation_id), UNIQUE (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg03_transfer_candidate(ledger_id, candidate_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg03_operation_receipt (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, outcome TEXT NOT NULL CHECK (outcome = 'ACCEPTED'),
  confirmation_id TEXT, candidate_id TEXT, transaction_id TEXT, source_id TEXT, evidence_id TEXT,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (ledger_id, confirmation_id) REFERENCES rg03_confirmation(ledger_id, confirmation_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg03_transfer_candidate(ledger_id, candidate_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg03_evidence_link (
  ledger_id TEXT NOT NULL, link_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  posting_id TEXT NOT NULL, target_kind TEXT NOT NULL CHECK (target_kind = 'POSTING'),
  target_role TEXT NOT NULL CHECK (target_role IN ('REAL_ACCOUNT_POSTING', 'DESTINATION_ASSET_POSTING')),
  status TEXT NOT NULL CHECK (status = 'MATCHED'),
  PRIMARY KEY (ledger_id, link_id), UNIQUE (ledger_id, evidence_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg03_evidence(ledger_id, evidence_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg03_transfer_posting_semantic (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('TRANSFER_PRINCIPAL_OUT', 'TRANSFER_PRINCIPAL_IN', 'TRANSFER_FEE')),
  category_id TEXT,
  reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)),
  PRIMARY KEY (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  CHECK ((role = 'TRANSFER_FEE' AND category_id IS NOT NULL AND reconciliation_eligible = 0)
      OR (role != 'TRANSFER_FEE' AND category_id IS NULL AND reconciliation_eligible = 1))
);

CREATE TABLE rg03_posting_reconciliation (
  ledger_id TEXT NOT NULL, reconciliation_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'MATCHED')),
  PRIMARY KEY (ledger_id, reconciliation_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg04_operation_request (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL,
  action_type TEXT NOT NULL CHECK (action_type IN ('MANUAL_MIXED_EXPENSE', 'CREDIT_PRINCIPAL_REPAYMENT')),
  PRIMARY KEY (ledger_id, request_id)
);
CREATE TABLE rg04_mixed_expense_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, occurred_at TEXT NOT NULL,
  total_minor INTEGER NOT NULL, currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL,
  category_id TEXT NOT NULL, original_minor INTEGER NOT NULL, discount_minor INTEGER NOT NULL,
  settled_minor INTEGER NOT NULL, confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_operation_request(ledger_id, request_id) ON DELETE CASCADE
);
CREATE TABLE rg04_mixed_expense_component_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, component_index INTEGER NOT NULL CHECK (component_index IN (0, 1)),
  account_id TEXT NOT NULL, amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, request_id, component_index), UNIQUE (ledger_id, request_id, account_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_mixed_expense_snapshot(ledger_id, request_id) ON DELETE CASCADE
);
CREATE TABLE rg04_repayment_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, occurred_at TEXT NOT NULL,
  asset_account_id TEXT NOT NULL, liability_account_id TEXT NOT NULL,
  principal_minor INTEGER NOT NULL CHECK (principal_minor > 0), currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL, confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_operation_request(ledger_id, request_id) ON DELETE CASCADE
);
CREATE TABLE rg04_confirmation (
  ledger_id TEXT NOT NULL, confirmation_id TEXT NOT NULL, request_id TEXT NOT NULL, transaction_id TEXT NOT NULL,
  confirmation_kind TEXT NOT NULL CHECK (confirmation_kind = 'EXPLICIT_MANUAL_SAVE'),
  PRIMARY KEY (ledger_id, confirmation_id), UNIQUE (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_operation_request(ledger_id, request_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg04_operation_receipt (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, confirmation_id TEXT NOT NULL, transaction_id TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome = 'ACCEPTED'), PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_operation_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (ledger_id, confirmation_id) REFERENCES rg04_confirmation(ledger_id, confirmation_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg04_posting_semantic (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('expense', 'mixed_expense_asset_funding', 'mixed_expense_credit_funding', 'credit_repayment_asset_outflow', 'credit_repayment_liability_principal')),
  category_id TEXT, reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)),
  PRIMARY KEY (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  CHECK ((role = 'expense' AND category_id IS NOT NULL AND reconciliation_eligible = 0)
      OR (role != 'expense' AND category_id IS NULL AND reconciliation_eligible = 1))
);
CREATE TABLE rg04_settlement_explanation (
  ledger_id TEXT NOT NULL, transaction_id TEXT NOT NULL, original_minor INTEGER NOT NULL,
  discount_minor INTEGER NOT NULL, settled_minor INTEGER NOT NULL, accounting_effect_count INTEGER NOT NULL CHECK (accounting_effect_count = 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, transaction_id),
  CHECK (original_minor - discount_minor = settled_minor),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE formal_relation (
  ledger_id TEXT NOT NULL, relation_id TEXT NOT NULL, relation_type TEXT NOT NULL CHECK (relation_type = 'mixed_payment'),
  PRIMARY KEY (ledger_id, relation_id)
);
CREATE TABLE formal_relation_member (
  ledger_id TEXT NOT NULL, relation_id TEXT NOT NULL, member_index INTEGER NOT NULL CHECK (member_index BETWEEN 0 AND 2),
  member_kind TEXT NOT NULL CHECK (member_kind IN ('TRANSACTION', 'POSTING')), transaction_id TEXT, posting_id TEXT,
  PRIMARY KEY (ledger_id, relation_id, member_index),
  FOREIGN KEY (ledger_id, relation_id) REFERENCES formal_relation(ledger_id, relation_id) ON DELETE CASCADE,
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  CHECK ((member_kind = 'TRANSACTION' AND transaction_id IS NOT NULL AND posting_id IS NULL)
      OR (member_kind = 'POSTING' AND posting_id IS NOT NULL AND transaction_id IS NULL))
);
CREATE TABLE rg04_mixed_composition (
  ledger_id TEXT NOT NULL, relation_id TEXT NOT NULL, transaction_id TEXT NOT NULL,
  display_name TEXT NOT NULL, total_minor INTEGER NOT NULL CHECK (total_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL,
  system_managed INTEGER NOT NULL CHECK (system_managed = 1), generic_order_lifecycle INTEGER NOT NULL CHECK (generic_order_lifecycle = 0),
  PRIMARY KEY (ledger_id, relation_id),
  FOREIGN KEY (ledger_id, relation_id) REFERENCES formal_relation(ledger_id, relation_id) ON DELETE CASCADE,
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg04_mixed_composition_component (
  ledger_id TEXT NOT NULL, relation_id TEXT NOT NULL, component_index INTEGER NOT NULL CHECK (component_index IN (0, 1)),
  posting_id TEXT NOT NULL, account_id TEXT NOT NULL, amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, relation_id, component_index), UNIQUE (ledger_id, relation_id, posting_id),
  FOREIGN KEY (ledger_id, relation_id) REFERENCES rg04_mixed_composition(ledger_id, relation_id) ON DELETE CASCADE,
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg04_accepted_composition_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, relation_id TEXT NOT NULL, transaction_id TEXT NOT NULL,
  display_name TEXT NOT NULL, total_minor INTEGER NOT NULL, currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL,
  system_managed INTEGER NOT NULL, generic_order_lifecycle INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, request_id), UNIQUE (ledger_id, relation_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_operation_receipt(ledger_id, request_id)
);
CREATE TABLE rg04_posting_reconciliation (
  ledger_id TEXT NOT NULL, reconciliation_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'MATCHED')),
  PRIMARY KEY (ledger_id, reconciliation_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg04_initial_reconciliation_identity (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, reconciliation_index INTEGER NOT NULL CHECK (reconciliation_index IN (0, 1)),
  reconciliation_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id, reconciliation_index),
  UNIQUE (ledger_id, reconciliation_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_operation_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, reconciliation_id) REFERENCES rg04_posting_reconciliation(ledger_id, reconciliation_id)
);
CREATE TABLE rg04_reconciliation_transition (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, reconciliation_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id, reconciliation_id),
  UNIQUE (ledger_id, request_id, posting_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_import_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (ledger_id, reconciliation_id) REFERENCES rg04_posting_reconciliation(ledger_id, reconciliation_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id)
);
CREATE TABLE rg04_import_request (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL,
  action_type TEXT NOT NULL CHECK (action_type IN ('IMPORT_SOURCE', 'CONFIRM_CANDIDATE', 'MERGE_MIRROR')),
  PRIMARY KEY (ledger_id, request_id)
);
CREATE TRIGGER rg04_reconciliation_transition_insert BEFORE INSERT ON rg04_reconciliation_transition
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM rg04_import_request AS request
    JOIN rg04_posting_reconciliation AS reconciliation
      ON reconciliation.ledger_id = new.ledger_id
     AND reconciliation.reconciliation_id = new.reconciliation_id
     AND reconciliation.posting_id = new.posting_id
    WHERE request.ledger_id = new.ledger_id
      AND request.request_id = new.request_id
      AND reconciliation.status = 'PENDING'
      AND (
        (request.action_type = 'CONFIRM_CANDIDATE' AND EXISTS (
          SELECT 1
          FROM rg04_import_confirmation_snapshot AS confirmation
          WHERE confirmation.ledger_id = new.ledger_id
            AND confirmation.request_id = new.request_id
            AND confirmation.confirmed = 1
            AND confirmation.asset_reconciliation_id = new.reconciliation_id
            AND confirmation.asset_posting_id = new.posting_id
        ))
        OR (request.action_type = 'MERGE_MIRROR' AND EXISTS (
          SELECT 1
          FROM rg04_import_mirror_snapshot AS mirror
          JOIN rg04_import_evidence_match AS match
            ON match.ledger_id = mirror.ledger_id
           AND match.match_id = mirror.evidence_link_id
           AND match.evidence_id = mirror.evidence_id
           AND match.posting_id = new.posting_id
           AND match.match_kind = 'LIABILITY_MIRROR'
          JOIN rg04_import_confirmation_snapshot AS confirmation
            ON confirmation.ledger_id = mirror.ledger_id
           AND confirmation.liability_reconciliation_id = new.reconciliation_id
           AND confirmation.liability_posting_id = new.posting_id
          WHERE mirror.ledger_id = new.ledger_id
            AND mirror.request_id = new.request_id
        ))
      )
  ) THEN RAISE(ABORT, 'invalid RG04 reconciliation transition') END;
END;
CREATE TRIGGER rg04_reconciliation_transition_update BEFORE UPDATE ON rg04_reconciliation_transition
BEGIN SELECT RAISE(ABORT, 'cannot update RG04 reconciliation transition'); END;
CREATE TRIGGER rg04_reconciliation_transition_delete BEFORE DELETE ON rg04_reconciliation_transition
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg04_posting_reconciliation AS reconciliation
    WHERE reconciliation.ledger_id = old.ledger_id
      AND reconciliation.reconciliation_id = old.reconciliation_id
      AND reconciliation.posting_id = old.posting_id
      AND reconciliation.status = 'MATCHED'
  ) THEN RAISE(ABORT, 'invalid RG04 reconciliation transition deletion') END;
END;

CREATE TABLE rg04_import_source_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, source_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  observed_at TEXT NOT NULL, total_minor INTEGER NOT NULL CHECK (total_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL, suggested_category_id TEXT,
  completeness TEXT NOT NULL CHECK (completeness IN ('COMPLETE', 'MISSING_FUNDING_LEG')),
  confidence TEXT NOT NULL CHECK (confidence IN ('1.00', '0.58')), candidate_kind TEXT NOT NULL,
  candidate_id TEXT NOT NULL, candidate_status_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_import_request(ledger_id, request_id) ON DELETE CASCADE
);
CREATE TABLE rg04_import_source_component_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, component_index INTEGER NOT NULL CHECK (component_index IN (0, 1)),
  account_id TEXT, amount_minor INTEGER NOT NULL CHECK (amount_minor > 0), currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL, evidence_available INTEGER NOT NULL CHECK (evidence_available IN (0, 1)),
  PRIMARY KEY (ledger_id, request_id, component_index),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_import_source_snapshot(ledger_id, request_id) ON DELETE CASCADE
);
CREATE TABLE rg04_import_source (
  ledger_id TEXT NOT NULL, source_id TEXT NOT NULL, owner_request_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  observed_at TEXT NOT NULL, source_kind TEXT NOT NULL, PRIMARY KEY (ledger_id, source_id),
  UNIQUE (ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, owner_request_id) REFERENCES rg04_import_request(ledger_id, request_id)
);
CREATE TABLE rg04_import_evidence (
  ledger_id TEXT NOT NULL, evidence_id TEXT NOT NULL, source_id TEXT NOT NULL,
  evidence_role TEXT NOT NULL CHECK (evidence_role IN ('ASSET_FUNDING_DEBIT', 'KNOWN_ASSET_FUNDING_DEBIT', 'LIABILITY_MIRROR')),
  observed_at TEXT NOT NULL, PRIMARY KEY (ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg04_import_source(ledger_id, source_id)
);
CREATE TABLE rg04_import_candidate (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, source_id TEXT NOT NULL,
  candidate_kind TEXT NOT NULL, confidence TEXT NOT NULL, provenance_rule TEXT NOT NULL,
  provenance_rule_version INTEGER NOT NULL CHECK (provenance_rule_version = 1),
  PRIMARY KEY (ledger_id, candidate_id), UNIQUE (ledger_id, source_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg04_import_source(ledger_id, source_id)
);
CREATE TABLE rg04_import_candidate_status_fact (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, status_sequence INTEGER NOT NULL CHECK (status_sequence IN (1, 2)),
  status_id TEXT NOT NULL, status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION', 'CONFIRMED')),
  request_id TEXT NOT NULL, PRIMARY KEY (ledger_id, candidate_id, status_sequence), UNIQUE (ledger_id, status_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg04_import_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_import_request(ledger_id, request_id)
);
CREATE TABLE rg04_import_confirmation_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, candidate_id TEXT NOT NULL, category_id TEXT NOT NULL,
  confirmed INTEGER NOT NULL CHECK (confirmed = 1), relation_id TEXT NOT NULL,
  version_id TEXT NOT NULL, posting_set_id TEXT NOT NULL, expense_posting_id TEXT NOT NULL,
  asset_posting_id TEXT NOT NULL, liability_posting_id TEXT NOT NULL, confirmed_status_id TEXT NOT NULL,
  relation_display_name TEXT NOT NULL, asset_evidence_link_id TEXT NOT NULL,
  asset_reconciliation_id TEXT NOT NULL, liability_reconciliation_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_import_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg04_import_candidate(ledger_id, candidate_id)
);
CREATE TABLE rg04_import_confirmation_component_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, component_index INTEGER NOT NULL CHECK (component_index IN (0, 1)),
  account_id TEXT NOT NULL, amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, request_id, component_index), UNIQUE (ledger_id, request_id, account_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_import_confirmation_snapshot(ledger_id, request_id) ON DELETE CASCADE
);
CREATE TABLE rg04_import_confirmation (
  ledger_id TEXT NOT NULL, confirmation_id TEXT NOT NULL, request_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL, transaction_id TEXT NOT NULL, PRIMARY KEY (ledger_id, confirmation_id),
  UNIQUE (ledger_id, request_id), UNIQUE (ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_import_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg04_import_candidate(ledger_id, candidate_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg04_import_mirror_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, source_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  observed_at TEXT NOT NULL, account_id TEXT NOT NULL, amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL, evidence_link_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_import_request(ledger_id, request_id) ON DELETE CASCADE
);
CREATE TABLE rg04_import_evidence_match (
  ledger_id TEXT NOT NULL, match_id TEXT NOT NULL, evidence_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  match_kind TEXT NOT NULL CHECK (match_kind IN ('ASSET_SOURCE', 'LIABILITY_MIRROR')),
  PRIMARY KEY (ledger_id, match_id), UNIQUE (ledger_id, evidence_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg04_import_evidence(ledger_id, evidence_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg04_import_receipt (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, outcome TEXT NOT NULL CHECK (outcome = 'ACCEPTED'),
  source_id TEXT, evidence_id TEXT, candidate_id TEXT, confirmation_id TEXT, transaction_id TEXT, evidence_link_id TEXT,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg04_import_request(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TRIGGER rg04_import_request_update BEFORE UPDATE ON rg04_import_request BEGIN SELECT RAISE(ABORT, 'cannot update RG04 import request'); END;
CREATE TRIGGER rg04_import_request_delete BEFORE DELETE ON rg04_import_request BEGIN SELECT RAISE(ABORT, 'cannot delete RG04 import request'); END;
