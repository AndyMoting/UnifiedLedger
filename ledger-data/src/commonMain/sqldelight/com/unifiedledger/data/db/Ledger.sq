  ledger_id, confirmation_id, confirmation_request_id, role, transaction_id,
  counterparty_id, confirmed_at, candidate_id, settlement_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg08SourceRecord:
INSERT INTO rg08_source_record(
  ledger_id, source_id, source_record_id, kind, observed_at,
  booking_at, value_at, account_id, counterparty_id, amount_minor,
  currency_code, currency_precision, original_source_payload_hash,
  immutable_payload_hash, mirror_of_source_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg08Evidence:
INSERT INTO rg08_evidence(ledger_id, evidence_id, source_id, evidence_type, observed_at)
VALUES (?, ?, ?, ?, ?);

insertRg08EvidenceLink:
INSERT INTO rg08_evidence_link(
  ledger_id, link_id, source_id, evidence_id, target_kind, target_id, role, status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg08AuditLink:
INSERT INTO rg08_audit_link(ledger_id, audit_link_id, kind, from_id, to_id)
VALUES (?, ?, ?, ?, ?);

insertRg08PostingSemantic:
INSERT INTO rg08_posting_semantic(ledger_id, posting_id, role, reconciliation_eligible)
VALUES (?, ?, ?, ?);

insertRg08PostingReconciliation:
INSERT INTO rg08_posting_reconciliation(ledger_id, posting_id, status, latest_sequence)
VALUES (?, ?, ?, ?);

insertRg08ReconciliationHistory:
INSERT INTO rg08_reconciliation_history(
  ledger_id, posting_id, status_sequence, status, evidence_link_id
) VALUES (?, ?, ?, ?, ?);

updateRg08PostingReconciliation:
UPDATE rg08_posting_reconciliation
SET status = ?, latest_sequence = ?
WHERE ledger_id = ? AND posting_id = ?;

insertRg08FormalTransactionSource:
INSERT INTO rg08_formal_transaction_metadata(ledger_id, transaction_id, source_record_id)
VALUES (?, ?, ?)
ON CONFLICT (ledger_id, transaction_id) DO NOTHING;

insertRg08NameHistory:
INSERT INTO rg08_name_history(ledger_id, counterparty_id, history_sequence, name_history_id, display_name)
VALUES (?, ?, ?, ?, ?);

selectRg08FormalTransactionSources:
SELECT transaction_id, source_record_id
FROM rg08_formal_transaction_metadata WHERE ledger_id = ?;

selectRg08AllOperations:
SELECT * FROM rg08_operation WHERE ledger_id = ? ORDER BY identity_value;

selectRg08AllSourceRecords:
SELECT * FROM rg08_source_record WHERE ledger_id = ? ORDER BY source_id;

selectRg08AllEvidence:
SELECT * FROM rg08_evidence WHERE ledger_id = ? ORDER BY evidence_id;

selectRg08AllEvidenceLinks:
SELECT * FROM rg08_evidence_link WHERE ledger_id = ? ORDER BY link_id;

selectRg08AllPositions:
SELECT * FROM rg08_position WHERE ledger_id = ? ORDER BY position_id;

selectRg08AllPositionHistory:
SELECT * FROM rg08_position_history WHERE ledger_id = ? ORDER BY position_id, history_sequence;

selectRg08AllSettlements:
SELECT * FROM rg08_settlement WHERE ledger_id = ? ORDER BY settlement_id;

selectRg08AllSettlementComponents:
SELECT * FROM rg08_settlement_component WHERE ledger_id = ? ORDER BY settlement_id, component_index;

selectRg08AllSettlementHistory:
SELECT * FROM rg08_settlement_history WHERE ledger_id = ? ORDER BY settlement_id, history_sequence;

selectRg08AllCandidates:
SELECT * FROM rg08_candidate WHERE ledger_id = ? ORDER BY candidate_id;

selectRg08AllCandidateStatusHistory:
SELECT * FROM rg08_candidate_status_history WHERE ledger_id = ? ORDER BY candidate_id, status_sequence;

selectRg08AllCandidateSources:
SELECT * FROM rg08_candidate_source WHERE ledger_id = ? ORDER BY candidate_id, source_index;

selectRg08AllConfirmations:
SELECT * FROM rg08_confirmation WHERE ledger_id = ? ORDER BY confirmation_id;

selectRg08AllAuditLinks:
SELECT * FROM rg08_audit_link WHERE ledger_id = ? ORDER BY audit_link_id;

selectRg08AllPostingSemantics:
SELECT * FROM rg08_posting_semantic WHERE ledger_id = ? ORDER BY posting_id;

selectRg08AllPostingReconciliations:
SELECT * FROM rg08_posting_reconciliation WHERE ledger_id = ? ORDER BY posting_id;

selectRg08AllReconciliationHistory:
SELECT * FROM rg08_reconciliation_history WHERE ledger_id = ? ORDER BY posting_id, status_sequence;

selectRg08AllNameHistory:
SELECT * FROM rg08_name_history WHERE ledger_id = ? ORDER BY counterparty_id, history_sequence;

countRg08Operations:
SELECT count(*) FROM rg08_operation WHERE ledger_id = ?;

countRg08FormalTransactions:
SELECT count(*)
FROM ledger_transaction WHERE ledger_id = ?;

selectRg08FormalTransactions:
SELECT tx.transaction_id, tx.ledger_id, COALESCE(tx.canonical_kind, tx.kind) AS kind,
       current_row.current_version_id
FROM ledger_transaction AS tx
JOIN ledger_transaction_current_version AS current_row
  ON current_row.ledger_id = tx.ledger_id AND current_row.transaction_id = tx.transaction_id
WHERE tx.ledger_id = ? ORDER BY tx.transaction_id;

selectRg08FormalVersions:
SELECT version_id, transaction_id, version_number, posting_set_id,
       occurred_at, statistics_at, effective_at, note
FROM transaction_version WHERE ledger_id = ? AND transaction_id = ? ORDER BY version_number;

selectRg08FormalPostingSets:
SELECT posting_set_id FROM posting_set WHERE ledger_id = ? ORDER BY posting_set_id;

selectRg08FormalPostings:
SELECT posting_id, posting_set_id, posting_index, account_id, amount_minor, currency_code, currency_precision
FROM posting WHERE ledger_id = ? AND posting_set_id = ? ORDER BY posting_index;

-- RG-11 additive owner (v16, D-085): mirrors 15.sqm byte for byte. The two
-- transaction_version confirmation guards below were extended by 16.sqm (v17) to
-- also allow EXPENSE transactions (RG-12 reuses the shared confirmation_id column).
CREATE TABLE rg11_operation (
  ledger_id TEXT NOT NULL,
  identity_value TEXT NOT NULL,
  action TEXT NOT NULL,
  operation_class TEXT NOT NULL,
  input_fingerprint TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('PENDING', 'ACCEPTED', 'NO_CHANGE', 'REJECTED')),
  reason_code TEXT,
  field_path TEXT,
  PRIMARY KEY (ledger_id, identity_value)
);
CREATE TABLE rg11_returned_id (
  ledger_id TEXT NOT NULL, identity_value TEXT NOT NULL, sequence INTEGER NOT NULL CHECK (sequence >= 0),
  id_kind TEXT NOT NULL, id_value TEXT NOT NULL,
  PRIMARY KEY (ledger_id, identity_value, sequence),
  FOREIGN KEY (ledger_id, identity_value) REFERENCES rg11_operation(ledger_id, identity_value) ON DELETE CASCADE
);
CREATE TABLE rg11_schedule (
  ledger_id TEXT NOT NULL, schedule_id TEXT NOT NULL PRIMARY KEY,
  payment_transaction_id TEXT NOT NULL,
  prepaid_account_id TEXT NOT NULL,
  category_id TEXT NOT NULL,
  total_amount_minor INTEGER NOT NULL CHECK (total_amount_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  cadence TEXT NOT NULL CHECK (cadence IN ('MONTHLY')),
  start_at TEXT NOT NULL,
  anchor_kind TEXT NOT NULL CHECK (anchor_kind IN ('MONTH_END', 'DAY_OF_MONTH')),
  anchor_day INTEGER CHECK (anchor_day IS NULL OR (anchor_day >= 1 AND anchor_day <= 28)),
  UNIQUE (ledger_id, schedule_id),
  CHECK ((anchor_kind = 'MONTH_END' AND anchor_day IS NULL)
      OR (anchor_kind = 'DAY_OF_MONTH' AND anchor_day IS NOT NULL)),
  FOREIGN KEY (payment_transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg11_revision (
  ledger_id TEXT NOT NULL, revision_id TEXT NOT NULL PRIMARY KEY,
  schedule_id TEXT NOT NULL,
  revision_number INTEGER NOT NULL CHECK (revision_number > 0),
  recognized_through TEXT,
  remaining_amount_minor INTEGER NOT NULL CHECK (remaining_amount_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  UNIQUE (ledger_id, revision_id),
  CHECK (revision_number = 1 OR recognized_through IS NOT NULL),
  FOREIGN KEY (ledger_id, schedule_id) REFERENCES rg11_schedule(ledger_id, schedule_id)
);
CREATE TABLE rg11_installment (
  ledger_id TEXT NOT NULL, installment_id TEXT NOT NULL PRIMARY KEY,
  schedule_id TEXT NOT NULL,
  revision_id TEXT NOT NULL,
  installment_sequence INTEGER NOT NULL CHECK (installment_sequence > 0),
  scheduled_at TEXT NOT NULL,
  amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  UNIQUE (ledger_id, installment_id),
  FOREIGN KEY (ledger_id, schedule_id) REFERENCES rg11_schedule(ledger_id, schedule_id),
  FOREIGN KEY (ledger_id, revision_id) REFERENCES rg11_revision(ledger_id, revision_id)
);
CREATE TABLE rg11_revision_installment (
  ledger_id TEXT NOT NULL, revision_id TEXT NOT NULL, installment_index INTEGER NOT NULL CHECK (installment_index >= 0),
  installment_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, revision_id, installment_index),
  UNIQUE (ledger_id, installment_id),
  FOREIGN KEY (ledger_id, revision_id) REFERENCES rg11_revision(ledger_id, revision_id),
  FOREIGN KEY (ledger_id, installment_id) REFERENCES rg11_installment(ledger_id, installment_id)
);
CREATE TABLE rg11_confirmation (
  ledger_id TEXT NOT NULL, confirmation_id TEXT NOT NULL PRIMARY KEY,
  operation_id TEXT NOT NULL,
  subject_kind TEXT NOT NULL CHECK (subject_kind = 'operation'),
  subject_id TEXT NOT NULL,
  confirmed_at TEXT NOT NULL,
  payload TEXT NOT NULL CHECK (payload = '{}'),
  UNIQUE (ledger_id, confirmation_id), UNIQUE (ledger_id, operation_id),
  CHECK (subject_id = operation_id)
);
CREATE TABLE rg11_audit_link (
  ledger_id TEXT NOT NULL, audit_link_id TEXT NOT NULL PRIMARY KEY,
  link_type TEXT NOT NULL CHECK (link_type IN ('periodic_allocation_recognition')),
  from_kind TEXT NOT NULL CHECK (from_kind IN ('domain_entity')),
  from_id TEXT NOT NULL,
  to_kind TEXT NOT NULL CHECK (to_kind IN ('transaction')),
  to_id TEXT NOT NULL,
  UNIQUE (ledger_id, audit_link_id), UNIQUE (ledger_id, from_id)
);
CREATE TABLE rg11_posting_semantic (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL PRIMARY KEY,
  role TEXT NOT NULL CHECK (role IN ('payment_asset', 'prepaid_asset', 'expense')),
  reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)),
  category_id TEXT,
  UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES posting(ledger_id, posting_id) DEFERRABLE INITIALLY DEFERRED,
  CHECK ((role = 'payment_asset' AND reconciliation_eligible = 1 AND category_id IS NULL)
      OR (role = 'prepaid_asset' AND reconciliation_eligible = 0 AND category_id IS NULL)
      OR (role = 'expense' AND reconciliation_eligible = 0 AND category_id IS NOT NULL))
);
CREATE TABLE rg11_posting_reconciliation (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL PRIMARY KEY,
  status TEXT NOT NULL CHECK (status IN ('PENDING')),
  UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES rg11_posting_semantic(ledger_id, posting_id)
);
-- Shared formal-transaction metadata (DATA-001 schema unification, D-091):
-- every RG (08/09/10/11/12) reads and writes the statistics time text here;
-- rg08/09/10 keep their source-only private tables, rg11/12 have no private
-- metadata table anymore.
CREATE TABLE formal_transaction_metadata (
  ledger_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  created_at TEXT NOT NULL,
  statistics_at_text TEXT NOT NULL,
  PRIMARY KEY (ledger_id, transaction_id),
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);
-- The frozen corrected v2 version carries confirmation_id and stays write-once:
-- only a later version of a PREPAID_RECOGNITION (RG-11) or EXPENSE (RG-12, v17
-- extension of 16.sqm) transaction may carry it.
CREATE TRIGGER rg11_transaction_version_confirmation_guard_insert BEFORE INSERT ON transaction_version WHEN new.confirmation_id IS NOT NULL BEGIN
  SELECT CASE WHEN new.version_number = 1 OR NOT EXISTS (
    SELECT 1 FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) IN ('PREPAID_RECOGNITION', 'EXPENSE')
  ) THEN RAISE(ABORT, 'rg11 version confirmation ownership') END;
END;
CREATE TRIGGER rg11_transaction_version_confirmation_guard_update BEFORE UPDATE OF confirmation_id ON transaction_version BEGIN
  SELECT CASE WHEN old.confirmation_id IS NOT NULL OR new.confirmation_id IS NULL
    OR new.version_id != old.version_id OR new.transaction_id != old.transaction_id
    OR new.ledger_id != old.ledger_id OR new.version_number != old.version_number
    OR new.posting_set_id != old.posting_set_id
    OR new.occurred_at != old.occurred_at OR new.statistics_at != old.statistics_at
    OR new.effective_at != old.effective_at OR new.note IS NOT old.note
    OR new.version_number = 1
    OR NOT EXISTS (
      SELECT 1 FROM ledger_transaction AS transaction_row
      WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
        AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) IN ('PREPAID_RECOGNITION', 'EXPENSE')
    )
    THEN RAISE(ABORT, 'rg11 version confirmation ownership') END;
END;
CREATE TRIGGER rg11_operation_guard_delete BEFORE DELETE ON rg11_operation BEGIN SELECT RAISE(ABORT, 'rg11 operation immutable'); END;
CREATE TRIGGER rg11_operation_guard_update BEFORE UPDATE ON rg11_operation BEGIN
  SELECT CASE WHEN old.outcome = 'PENDING' AND new.outcome IN ('ACCEPTED', 'NO_CHANGE', 'REJECTED')
    AND new.ledger_id = old.ledger_id AND new.identity_value = old.identity_value
    AND new.action = old.action AND new.operation_class = old.operation_class
    AND new.input_fingerprint = old.input_fingerprint
    THEN NULL ELSE RAISE(ABORT, 'rg11 operation immutable') END;
END;
CREATE TRIGGER rg11_returned_id_guard_update BEFORE UPDATE ON rg11_returned_id BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_returned_id_guard_delete BEFORE DELETE ON rg11_returned_id BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_schedule_guard_update BEFORE UPDATE ON rg11_schedule BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_schedule_guard_delete BEFORE DELETE ON rg11_schedule BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_revision_guard_update BEFORE UPDATE ON rg11_revision BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_revision_guard_delete BEFORE DELETE ON rg11_revision BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_installment_guard_update BEFORE UPDATE ON rg11_installment BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_installment_guard_delete BEFORE DELETE ON rg11_installment BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_revision_installment_guard_update BEFORE UPDATE ON rg11_revision_installment BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_revision_installment_guard_delete BEFORE DELETE ON rg11_revision_installment BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_confirmation_guard_update BEFORE UPDATE ON rg11_confirmation BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_confirmation_guard_delete BEFORE DELETE ON rg11_confirmation BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_audit_guard_update BEFORE UPDATE ON rg11_audit_link BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_audit_guard_delete BEFORE DELETE ON rg11_audit_link BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_semantic_guard_update BEFORE UPDATE ON rg11_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_semantic_guard_delete BEFORE DELETE ON rg11_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_reconciliation_guard_update BEFORE UPDATE ON rg11_posting_reconciliation BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER rg11_reconciliation_guard_delete BEFORE DELETE ON rg11_posting_reconciliation BEGIN SELECT RAISE(ABORT, 'rg11 immutable'); END;
CREATE TRIGGER formal_metadata_guard_update BEFORE UPDATE ON formal_transaction_metadata BEGIN
  SELECT CASE WHEN old.ledger_id = new.ledger_id AND old.transaction_id = new.transaction_id
    AND old.created_at = new.created_at
    AND new.statistics_at_text != old.statistics_at_text
    THEN NULL ELSE RAISE(ABORT, 'formal metadata immutable') END;
END;
CREATE TRIGGER formal_metadata_guard_delete BEFORE DELETE ON formal_transaction_metadata BEGIN SELECT RAISE(ABORT, 'formal metadata immutable'); END;
-- The schedule is a typed edge onto its PREPAID_PURCHASE payment transaction.
CREATE TRIGGER rg11_schedule_formal_owner_guard_insert BEFORE INSERT ON rg11_schedule BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.payment_transaction_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'PREPAID_PURCHASE'
  ) THEN RAISE(ABORT, 'rg11 schedule formal ownership') END;
END;
-- Revisions are append-only with consecutive revision numbers per schedule.
CREATE TRIGGER rg11_revision_number_sequence BEFORE INSERT ON rg11_revision BEGIN SELECT CASE WHEN (new.revision_number = 1 AND EXISTS (SELECT 1 FROM rg11_revision WHERE ledger_id = new.ledger_id AND schedule_id = new.schedule_id)) OR (new.revision_number > 1 AND NOT EXISTS (SELECT 1 FROM rg11_revision WHERE ledger_id = new.ledger_id AND schedule_id = new.schedule_id AND revision_number = new.revision_number - 1)) THEN RAISE(ABORT, 'rg11 revision number sequence') END; END;
-- Installment sequences are continuous per schedule across revisions.
CREATE TRIGGER rg11_installment_sequence BEFORE INSERT ON rg11_installment BEGIN SELECT CASE WHEN (new.installment_sequence = 1 AND EXISTS (SELECT 1 FROM rg11_installment WHERE ledger_id = new.ledger_id AND schedule_id = new.schedule_id)) OR (new.installment_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg11_installment WHERE ledger_id = new.ledger_id AND schedule_id = new.schedule_id AND installment_sequence = new.installment_sequence - 1)) THEN RAISE(ABORT, 'rg11 installment sequence') END; END;
-- The recognition audit link is a typed edge from an exact installment onto an
-- exact PREPAID_RECOGNITION transaction (design doc line 42).
CREATE TRIGGER rg11_audit_link_target_guard_insert BEFORE INSERT ON rg11_audit_link BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg11_installment AS installment
    WHERE installment.ledger_id = new.ledger_id AND installment.installment_id = new.from_id
  ) OR NOT EXISTS (
    SELECT 1 FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.to_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'PREPAID_RECOGNITION'
  ) THEN RAISE(ABORT, 'rg11 audit link target mismatch') END;
END;
-- Posting semantics own postings of the matching formal kind: the payment
-- posting of a PREPAID_PURCHASE, the expense posting of a PREPAID_RECOGNITION
-- and the prepaid asset posting of either.
CREATE TRIGGER rg11_posting_semantic_formal_owner_guard_insert BEFORE INSERT ON rg11_posting_semantic BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM posting AS posting_row
    JOIN transaction_version AS version_row
      ON version_row.ledger_id = posting_row.ledger_id AND version_row.posting_set_id = posting_row.posting_set_id
    JOIN ledger_transaction_current_version AS current_row
      ON current_row.ledger_id = version_row.ledger_id AND current_row.transaction_id = version_row.transaction_id
     AND current_row.current_version_id = version_row.version_id
    JOIN ledger_transaction AS transaction_row
      ON transaction_row.ledger_id = current_row.ledger_id AND transaction_row.transaction_id = current_row.transaction_id
    WHERE posting_row.ledger_id = new.ledger_id AND posting_row.posting_id = new.posting_id
      AND (
        (new.role = 'payment_asset' AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'PREPAID_PURCHASE')
        OR (new.role = 'prepaid_asset' AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) IN ('PREPAID_PURCHASE', 'PREPAID_RECOGNITION'))
        OR (new.role = 'expense' AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'PREPAID_RECOGNITION')
      )
  ) THEN RAISE(ABORT, 'rg11 posting formal ownership') END;
END;
-- RG-11 has no matching action: every eligible posting starts and stays PENDING.
CREATE TRIGGER rg11_reconciliation_current_guard_insert BEFORE INSERT ON rg11_posting_reconciliation BEGIN
  SELECT CASE WHEN new.status != 'PENDING' OR NOT EXISTS (
    SELECT 1 FROM rg11_posting_semantic AS semantic
    WHERE semantic.ledger_id = new.ledger_id AND semantic.posting_id = new.posting_id
      AND semantic.reconciliation_eligible = 1
  ) THEN RAISE(ABORT, 'rg11 reconciliation current ownership') END;
END;

claimRg11Operation:
INSERT INTO rg11_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome
) VALUES (?, ?, ?, ?, ?, 'PENDING')
ON CONFLICT (ledger_id, identity_value) DO NOTHING;

insertRg11Operation:
INSERT INTO rg11_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome,
  reason_code, field_path
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateRg11OperationResult:
UPDATE rg11_operation
SET outcome = ?, reason_code = ?, field_path = ?
WHERE ledger_id = ? AND identity_value = ?;

selectRg11Operation:
SELECT * FROM rg11_operation WHERE ledger_id = ? AND identity_value = ?;

insertRg11ReturnedId:
INSERT INTO rg11_returned_id(ledger_id, identity_value, sequence, id_kind, id_value)
VALUES (?, ?, ?, ?, ?);

selectRg11ReturnedIds:
SELECT id_kind, id_value FROM rg11_returned_id
WHERE ledger_id = ? AND identity_value = ? ORDER BY sequence;

insertRg11Schedule:
INSERT INTO rg11_schedule(
  ledger_id, schedule_id, payment_transaction_id, prepaid_account_id, category_id,
  total_amount_minor, currency_code, currency_precision, cadence, start_at,
  anchor_kind, anchor_day
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg11Revision:
INSERT INTO rg11_revision(
  ledger_id, revision_id, schedule_id, revision_number, recognized_through,
  remaining_amount_minor, currency_code, currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg11Installment:
INSERT INTO rg11_installment(
  ledger_id, installment_id, schedule_id, revision_id, installment_sequence,
  scheduled_at, amount_minor, currency_code, currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg11RevisionInstallment:
INSERT INTO rg11_revision_installment(ledger_id, revision_id, installment_index, installment_id)
VALUES (?, ?, ?, ?);

insertRg11Confirmation:
INSERT INTO rg11_confirmation(
  ledger_id, confirmation_id, operation_id, subject_kind, subject_id, confirmed_at, payload
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg11AuditLink:
INSERT INTO rg11_audit_link(
  ledger_id, audit_link_id, link_type, from_kind, from_id, to_kind, to_id
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg11PostingSemantic:
INSERT INTO rg11_posting_semantic(ledger_id, posting_id, role, reconciliation_eligible, category_id)
VALUES (?, ?, ?, ?, ?);

insertRg11PostingReconciliation:
INSERT INTO rg11_posting_reconciliation(ledger_id, posting_id, status)
VALUES (?, ?, ?);

insertFormalTransactionMetadata:
INSERT INTO formal_transaction_metadata(ledger_id, transaction_id, created_at, statistics_at_text)
VALUES (?, ?, ?, ?)
ON CONFLICT (ledger_id, transaction_id) DO NOTHING;

updateFormalTransactionStatisticsAtText:
UPDATE formal_transaction_metadata SET statistics_at_text = ?
WHERE ledger_id = ? AND transaction_id = ?;

updateTransactionVersionConfirmationId:
UPDATE transaction_version SET confirmation_id = ?
WHERE ledger_id = ? AND version_id = ?;

selectRg11AllSchedules:
SELECT * FROM rg11_schedule WHERE ledger_id = ? ORDER BY schedule_id;

selectRg11AllRevisions:
SELECT * FROM rg11_revision WHERE ledger_id = ? ORDER BY schedule_id, revision_number;

selectRg11AllRevisionInstallments:
SELECT * FROM rg11_revision_installment WHERE ledger_id = ? ORDER BY revision_id, installment_index;

selectRg11AllInstallments:
SELECT * FROM rg11_installment WHERE ledger_id = ? ORDER BY installment_id;

selectRg11AllConfirmations:
SELECT * FROM rg11_confirmation WHERE ledger_id = ? ORDER BY confirmation_id;

selectRg11AllAuditLinks:
SELECT * FROM rg11_audit_link WHERE ledger_id = ? ORDER BY audit_link_id;

selectRg11AllPostingSemantics:
SELECT * FROM rg11_posting_semantic WHERE ledger_id = ? ORDER BY posting_id;

selectRg11AllPostingReconciliations:
SELECT * FROM rg11_posting_reconciliation WHERE ledger_id = ? ORDER BY posting_id;

selectFormalTransactionMetadata:
SELECT * FROM formal_transaction_metadata WHERE ledger_id = ? ORDER BY transaction_id;

countRg11Operations:
SELECT count(*) FROM rg11_operation WHERE ledger_id = ?;

countRg11FormalTransactions:
SELECT count(*)
FROM ledger_transaction WHERE ledger_id = ?;

selectRg11FormalTransactions:
SELECT tx.transaction_id, tx.ledger_id, COALESCE(tx.canonical_kind, tx.kind) AS kind,
       current_row.current_version_id
FROM ledger_transaction AS tx
JOIN ledger_transaction_current_version AS current_row
  ON current_row.ledger_id = tx.ledger_id AND current_row.transaction_id = tx.transaction_id
WHERE tx.ledger_id = ? ORDER BY tx.transaction_id;

selectRg11FormalVersions:
SELECT version_id, transaction_id, version_number, posting_set_id,
       occurred_at, statistics_at, effective_at, note, confirmation_id
FROM transaction_version WHERE ledger_id = ? AND transaction_id = ? ORDER BY version_number;

selectRg11FormalPostingSets:
SELECT posting_set_id FROM posting_set WHERE ledger_id = ? ORDER BY posting_set_id;

selectRg11FormalPostings:
SELECT posting_id, posting_set_id, posting_index, account_id, amount_minor, currency_code, currency_precision
FROM posting WHERE ledger_id = ? AND posting_set_id = ? ORDER BY posting_index;

-- RG-12 additive owner (v17, D-085): mirrors 16.sqm byte for byte.
CREATE TABLE rg12_operation (
  ledger_id TEXT NOT NULL,
  identity_value TEXT NOT NULL,
  action TEXT NOT NULL,
  operation_class TEXT NOT NULL,
  input_fingerprint TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('PENDING', 'ACCEPTED', 'NO_CHANGE', 'REJECTED')),
  reason_code TEXT,
  field_path TEXT,
  PRIMARY KEY (ledger_id, identity_value)
);
CREATE TABLE rg12_returned_id (
  ledger_id TEXT NOT NULL, identity_value TEXT NOT NULL, sequence INTEGER NOT NULL CHECK (sequence >= 0),
  id_kind TEXT NOT NULL, id_value TEXT NOT NULL,
  PRIMARY KEY (ledger_id, identity_value, sequence),
  FOREIGN KEY (ledger_id, identity_value) REFERENCES rg12_operation(ledger_id, identity_value) ON DELETE CASCADE
);
CREATE TABLE rg12_confirmation (
  ledger_id TEXT NOT NULL, confirmation_id TEXT NOT NULL PRIMARY KEY,
  operation_id TEXT NOT NULL,
  subject_kind TEXT NOT NULL CHECK (subject_kind = 'operation'),
  subject_id TEXT NOT NULL,
  confirmed_at TEXT NOT NULL,
  payload TEXT NOT NULL CHECK (payload = '{}'),
  UNIQUE (ledger_id, confirmation_id), UNIQUE (ledger_id, operation_id),
  CHECK (subject_id = operation_id)
);
-- Per-version creation time of the frozen contract (the corrected v2 version is
-- created at corrected_at while the economic times are preserved).
CREATE TABLE rg12_transaction_version_metadata (
  ledger_id TEXT NOT NULL, transaction_id TEXT NOT NULL, version_id TEXT NOT NULL,
  created_at TEXT NOT NULL,
  PRIMARY KEY (ledger_id, version_id),
  FOREIGN KEY (transaction_id, version_id, ledger_id) REFERENCES transaction_version(transaction_id, version_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg12_posting_semantic (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL PRIMARY KEY,
  role TEXT NOT NULL CHECK (role IN ('expense', 'mixed_expense_asset_funding', 'mixed_expense_credit_funding')),
  reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)),
  category_id TEXT,
  UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES posting(ledger_id, posting_id) DEFERRABLE INITIALLY DEFERRED,
  CHECK ((role = 'expense' AND reconciliation_eligible = 0 AND category_id IS NOT NULL)
      OR (role IN ('mixed_expense_asset_funding', 'mixed_expense_credit_funding') AND reconciliation_eligible = 1 AND category_id IS NULL))
);
CREATE TABLE rg12_posting_reconciliation (
  ledger_id TEXT NOT NULL, reconciliation_id TEXT NOT NULL PRIMARY KEY,
  posting_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('MATCHED', 'PENDING')),
  UNIQUE (ledger_id, reconciliation_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES rg12_posting_semantic(ledger_id, posting_id)
);
CREATE TABLE rg12_reconciliation_match (
  ledger_id TEXT NOT NULL, match_id TEXT NOT NULL PRIMARY KEY,
  posting_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL,
  UNIQUE (ledger_id, match_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES posting(ledger_id, posting_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg12_reconciliation_match_history (
  ledger_id TEXT NOT NULL, match_id TEXT NOT NULL, entry_sequence INTEGER NOT NULL CHECK (entry_sequence > 0),
  entry_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('MATCHED', 'INVALIDATED')),
  entry_at TEXT NOT NULL,
  reason TEXT NOT NULL CHECK (reason IN ('EXACT_EVIDENCE', 'POSTING_REPLACED')),
  PRIMARY KEY (ledger_id, match_id, entry_sequence),
  UNIQUE (ledger_id, match_id, entry_id),
  FOREIGN KEY (ledger_id, match_id) REFERENCES rg12_reconciliation_match(ledger_id, match_id)
);
CREATE TABLE rg12_posting_replacement (
  ledger_id TEXT NOT NULL, replacement_id TEXT NOT NULL PRIMARY KEY,
  from_posting_id TEXT NOT NULL,
  to_posting_id TEXT NOT NULL,
  reconciliation_effect TEXT NOT NULL CHECK (reconciliation_effect IN ('PRESERVED', 'INVALIDATED', 'NOT_APPLICABLE')),
  UNIQUE (ledger_id, replacement_id),
  CHECK (from_posting_id != to_posting_id),
  FOREIGN KEY (ledger_id, from_posting_id) REFERENCES posting(ledger_id, posting_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, to_posting_id) REFERENCES posting(ledger_id, posting_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg12_consumption_record (
  ledger_id TEXT NOT NULL, record_id TEXT NOT NULL PRIMARY KEY,
  expense_posting_id TEXT NOT NULL,
  category_id TEXT,
  amount_text TEXT NOT NULL,
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  statistics_at_text TEXT NOT NULL,
  UNIQUE (ledger_id, record_id),
  FOREIGN KEY (ledger_id, expense_posting_id) REFERENCES posting(ledger_id, posting_id) DEFERRABLE INITIALLY DEFERRED
);
-- Day-period report registry of the frozen reports collection; values are always
-- recomputed from the current postings, only the period seed list is stored.
CREATE TABLE rg12_report_period (
  ledger_id TEXT NOT NULL, period TEXT NOT NULL,
  PRIMARY KEY (ledger_id, period)
);
CREATE TRIGGER rg12_operation_guard_delete BEFORE DELETE ON rg12_operation BEGIN SELECT RAISE(ABORT, 'rg12 operation immutable'); END;
CREATE TRIGGER rg12_operation_guard_update BEFORE UPDATE ON rg12_operation BEGIN
  SELECT CASE WHEN old.outcome = 'PENDING' AND new.outcome IN ('ACCEPTED', 'NO_CHANGE', 'REJECTED')
    AND new.ledger_id = old.ledger_id AND new.identity_value = old.identity_value
    AND new.action = old.action AND new.operation_class = old.operation_class
    AND new.input_fingerprint = old.input_fingerprint
    THEN NULL ELSE RAISE(ABORT, 'rg12 operation immutable') END;
END;
CREATE TRIGGER rg12_returned_id_guard_update BEFORE UPDATE ON rg12_returned_id BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_returned_id_guard_delete BEFORE DELETE ON rg12_returned_id BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_confirmation_guard_update BEFORE UPDATE ON rg12_confirmation BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_confirmation_guard_delete BEFORE DELETE ON rg12_confirmation BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_version_metadata_guard_update BEFORE UPDATE ON rg12_transaction_version_metadata BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_version_metadata_guard_delete BEFORE DELETE ON rg12_transaction_version_metadata BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_semantic_guard_update BEFORE UPDATE ON rg12_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_semantic_guard_delete BEFORE DELETE ON rg12_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_reconciliation_guard_update BEFORE UPDATE ON rg12_posting_reconciliation BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_reconciliation_guard_delete BEFORE DELETE ON rg12_posting_reconciliation BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_match_guard_update BEFORE UPDATE ON rg12_reconciliation_match BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_match_guard_delete BEFORE DELETE ON rg12_reconciliation_match BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_match_history_guard_update BEFORE UPDATE ON rg12_reconciliation_match_history BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_match_history_guard_delete BEFORE DELETE ON rg12_reconciliation_match_history BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_replacement_guard_update BEFORE UPDATE ON rg12_posting_replacement BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_replacement_guard_delete BEFORE DELETE ON rg12_posting_replacement BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_consumption_guard_update BEFORE UPDATE ON rg12_consumption_record BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_consumption_guard_delete BEFORE DELETE ON rg12_consumption_record BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_report_period_guard_update BEFORE UPDATE ON rg12_report_period BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
CREATE TRIGGER rg12_report_period_guard_delete BEFORE DELETE ON rg12_report_period BEGIN SELECT RAISE(ABORT, 'rg12 immutable'); END;
-- A match owns an eligible real posting (the runtime only matches eligible real legs),
-- and a posting that already owns a reconciliation fact cannot acquire a match.
CREATE TRIGGER rg12_match_current_guard_insert BEFORE INSERT ON rg12_reconciliation_match BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg12_posting_semantic AS semantic
    WHERE semantic.ledger_id = new.ledger_id AND semantic.posting_id = new.posting_id
      AND semantic.reconciliation_eligible = 1
  ) THEN RAISE(ABORT, 'rg12 match current ownership')
  WHEN EXISTS (
    -- a posting that already owns a reconciliation fact cannot acquire a match:
    -- the runtime always writes match history before the fact, so a pre-existing
    -- fact means the pair (fact, match-without-history) is not representable
    SELECT 1 FROM rg12_posting_reconciliation AS fact
    WHERE fact.ledger_id = new.ledger_id AND fact.posting_id = new.posting_id
  ) THEN RAISE(ABORT, 'rg12 match current ownership') END;
END;
-- History is append-only with consecutive sequences and the frozen transition:
-- entry 1 is matched/exact_evidence and every later entry is invalidated/posting_replaced
-- directly after a matched entry (an invalidated match is terminal).
CREATE TRIGGER rg12_match_history_sequence BEFORE INSERT ON rg12_reconciliation_match_history BEGIN SELECT CASE WHEN (new.entry_sequence = 1 AND EXISTS (SELECT 1 FROM rg12_reconciliation_match_history WHERE ledger_id = new.ledger_id AND match_id = new.match_id)) OR (new.entry_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg12_reconciliation_match_history WHERE ledger_id = new.ledger_id AND match_id = new.match_id AND entry_sequence = new.entry_sequence - 1)) THEN RAISE(ABORT, 'rg12 match history sequence') END; END;
CREATE TRIGGER rg12_match_history_transition BEFORE INSERT ON rg12_reconciliation_match_history BEGIN
  SELECT CASE WHEN new.entry_sequence = 1 THEN
    CASE WHEN new.status != 'MATCHED' OR new.reason != 'EXACT_EVIDENCE' THEN RAISE(ABORT, 'rg12 match history transition') END
  ELSE
    CASE WHEN new.status != 'INVALIDATED' OR new.reason != 'POSTING_REPLACED' OR NOT EXISTS (
      SELECT 1 FROM rg12_reconciliation_match_history AS previous
      WHERE previous.ledger_id = new.ledger_id AND previous.match_id = new.match_id
        AND previous.entry_sequence = new.entry_sequence - 1
        AND previous.status = 'MATCHED'
    ) THEN RAISE(ABORT, 'rg12 match history transition') END
  END;
END;
-- Defense-in-depth (RG12-001): a matched history entry cannot be appended to a
-- match whose posting already owns a pending reconciliation fact. The contradiction
-- order is already closed by the current-state guards above and below; this guard
-- is the backstop in case any of them is relaxed by a future migration.
CREATE TRIGGER rg12_match_history_fact_consistency BEFORE INSERT ON rg12_reconciliation_match_history BEGIN
  SELECT CASE WHEN new.status = 'MATCHED' AND EXISTS (
    SELECT 1 FROM rg12_reconciliation_match AS match_row
    JOIN rg12_posting_reconciliation AS fact
      ON fact.ledger_id = match_row.ledger_id AND fact.posting_id = match_row.posting_id
    WHERE match_row.ledger_id = new.ledger_id AND match_row.match_id = new.match_id
      AND fact.status = 'PENDING'
  ) THEN RAISE(ABORT, 'rg12 match history fact consistency') END;
END;
-- Reconciliation facts are write-once per posting with the frozen current-state rule:
-- an eligible real posting owns exactly one fact whose status agrees with its match
-- state (matched facts require an active match, pending facts forbid one); a match
-- that never received its entry-1 history owns the posting, so no fact may be built
-- on it either.
CREATE TRIGGER rg12_reconciliation_current_guard_insert BEFORE INSERT ON rg12_posting_reconciliation BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg12_posting_semantic AS semantic
    WHERE semantic.ledger_id = new.ledger_id AND semantic.posting_id = new.posting_id
      AND semantic.reconciliation_eligible = 1
  ) THEN RAISE(ABORT, 'rg12 reconciliation current ownership')
  WHEN EXISTS (
    -- a match that never received its entry-1 history owns the posting: the
    -- match is not representable in the domain and no fact may be built on it
    SELECT 1 FROM rg12_reconciliation_match AS match_row
    WHERE match_row.ledger_id = new.ledger_id AND match_row.posting_id = new.posting_id
      AND NOT EXISTS (
        SELECT 1 FROM rg12_reconciliation_match_history AS history_row
        WHERE history_row.ledger_id = match_row.ledger_id AND history_row.match_id = match_row.match_id
      )
  ) THEN RAISE(ABORT, 'rg12 reconciliation current ownership')
  WHEN EXISTS (
    SELECT 1 FROM rg12_reconciliation_match AS match_row
    JOIN rg12_reconciliation_match_history AS latest
      ON latest.ledger_id = match_row.ledger_id AND latest.match_id = match_row.match_id
    WHERE match_row.ledger_id = new.ledger_id AND match_row.posting_id = new.posting_id
      AND latest.entry_sequence = (
        SELECT MAX(history_row.entry_sequence)
        FROM rg12_reconciliation_match_history AS history_row
        WHERE history_row.ledger_id = match_row.ledger_id AND history_row.match_id = match_row.match_id
      )
      AND latest.status = 'MATCHED'
      AND new.status != 'MATCHED'
  ) THEN RAISE(ABORT, 'rg12 reconciliation current ownership')
  WHEN new.status = 'MATCHED' AND NOT EXISTS (
    SELECT 1 FROM rg12_reconciliation_match AS match_row
    JOIN rg12_reconciliation_match_history AS latest
      ON latest.ledger_id = match_row.ledger_id AND latest.match_id = match_row.match_id
    WHERE match_row.ledger_id = new.ledger_id AND match_row.posting_id = new.posting_id
      AND latest.entry_sequence = (
        SELECT MAX(history_row.entry_sequence)
        FROM rg12_reconciliation_match_history AS history_row
        WHERE history_row.ledger_id = match_row.ledger_id AND history_row.match_id = match_row.match_id
      )
      AND latest.status = 'MATCHED'
  ) THEN RAISE(ABORT, 'rg12 reconciliation current ownership')
  END;
END;
-- The frozen contract transactions are always EXPENSE; semantics own postings of
-- the current version of an EXPENSE transaction.
CREATE TRIGGER rg12_posting_semantic_formal_owner_guard_insert BEFORE INSERT ON rg12_posting_semantic BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM posting AS posting_row
    JOIN transaction_version AS version_row
      ON version_row.ledger_id = posting_row.ledger_id AND version_row.posting_set_id = posting_row.posting_set_id
    JOIN ledger_transaction_current_version AS current_row
      ON current_row.ledger_id = version_row.ledger_id AND current_row.transaction_id = version_row.transaction_id
     AND current_row.current_version_id = version_row.version_id
    JOIN ledger_transaction AS transaction_row
      ON transaction_row.ledger_id = current_row.ledger_id AND transaction_row.transaction_id = current_row.transaction_id
    WHERE posting_row.ledger_id = new.ledger_id AND posting_row.posting_id = new.posting_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'EXPENSE'
  ) THEN RAISE(ABORT, 'rg12 posting formal ownership') END;
END;

claimRg12Operation:
INSERT INTO rg12_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome
) VALUES (?, ?, ?, ?, ?, 'PENDING')
ON CONFLICT (ledger_id, identity_value) DO NOTHING;

insertRg12Operation:
INSERT INTO rg12_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome,
  reason_code, field_path
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateRg12OperationResult:
UPDATE rg12_operation
SET outcome = ?, reason_code = ?, field_path = ?
WHERE ledger_id = ? AND identity_value = ?;

selectRg12Operation:
SELECT * FROM rg12_operation WHERE ledger_id = ? AND identity_value = ?;

insertRg12ReturnedId:
INSERT INTO rg12_returned_id(ledger_id, identity_value, sequence, id_kind, id_value)
VALUES (?, ?, ?, ?, ?);

selectRg12ReturnedIds:
SELECT id_kind, id_value FROM rg12_returned_id
WHERE ledger_id = ? AND identity_value = ? ORDER BY sequence;

insertRg12TransactionVersionMetadata:
INSERT INTO rg12_transaction_version_metadata(ledger_id, transaction_id, version_id, created_at)
VALUES (?, ?, ?, ?);

insertRg12PostingSemantic:
INSERT INTO rg12_posting_semantic(ledger_id, posting_id, role, reconciliation_eligible, category_id)
VALUES (?, ?, ?, ?, ?);

insertRg12ReconciliationMatch:
INSERT INTO rg12_reconciliation_match(ledger_id, match_id, posting_id, evidence_id)
VALUES (?, ?, ?, ?);

insertRg12ReconciliationMatchHistory:
INSERT INTO rg12_reconciliation_match_history(
  ledger_id, match_id, entry_sequence, entry_id, status, entry_at, reason
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg12PostingReconciliation:
INSERT INTO rg12_posting_reconciliation(ledger_id, reconciliation_id, posting_id, status)
VALUES (?, ?, ?, ?);

insertRg12PostingReplacement:
INSERT INTO rg12_posting_replacement(
  ledger_id, replacement_id, from_posting_id, to_posting_id, reconciliation_effect
) VALUES (?, ?, ?, ?, ?);

insertRg12Confirmation:
INSERT INTO rg12_confirmation(
  ledger_id, confirmation_id, operation_id, subject_kind, subject_id, confirmed_at, payload
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg12ConsumptionRecord:
INSERT INTO rg12_consumption_record(
  ledger_id, record_id, expense_posting_id, category_id, amount_text,
  currency_code, currency_precision, statistics_at_text
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg12ReportPeriod:
INSERT INTO rg12_report_period(ledger_id, period)
VALUES (?, ?);

selectRg12AllPostingSemantics:
SELECT * FROM rg12_posting_semantic WHERE ledger_id = ? ORDER BY posting_id;

selectRg12AllMatches:
SELECT * FROM rg12_reconciliation_match WHERE ledger_id = ? ORDER BY match_id;

selectRg12MatchHistory:
SELECT * FROM rg12_reconciliation_match_history
WHERE ledger_id = ? AND match_id = ? ORDER BY entry_sequence;

selectRg12AllPostingReconciliations:
SELECT * FROM rg12_posting_reconciliation WHERE ledger_id = ? ORDER BY reconciliation_id;

selectRg12AllPostingReplacements:
SELECT * FROM rg12_posting_replacement WHERE ledger_id = ? ORDER BY replacement_id;

selectRg12AllConfirmations:
SELECT * FROM rg12_confirmation WHERE ledger_id = ? ORDER BY confirmation_id;

selectRg12AllConsumptionRecords:
SELECT * FROM rg12_consumption_record WHERE ledger_id = ? ORDER BY record_id;

selectRg12AllReportPeriods:
SELECT * FROM rg12_report_period WHERE ledger_id = ? ORDER BY period;

selectRg12TransactionVersionMetadata:
SELECT * FROM rg12_transaction_version_metadata WHERE ledger_id = ? ORDER BY version_id;

countRg12Operations:
SELECT count(*) FROM rg12_operation WHERE ledger_id = ?;

countRg12FormalTransactions:
SELECT count(*)
FROM ledger_transaction WHERE ledger_id = ?;

selectRg12FormalTransactions:
SELECT tx.transaction_id, tx.ledger_id, COALESCE(tx.canonical_kind, tx.kind) AS kind,
       current_row.current_version_id
FROM ledger_transaction AS tx
JOIN ledger_transaction_current_version AS current_row
  ON current_row.ledger_id = tx.ledger_id AND current_row.transaction_id = tx.transaction_id
WHERE tx.ledger_id = ? ORDER BY tx.transaction_id;

selectRg12FormalVersions:
SELECT version_id, transaction_id, version_number, posting_set_id,
       occurred_at, statistics_at, effective_at, note, confirmation_id
FROM transaction_version WHERE ledger_id = ? AND transaction_id = ? ORDER BY version_number;

selectRg12FormalPostings:
SELECT posting_id, posting_set_id, posting_index, account_id, amount_minor, currency_code, currency_precision
FROM posting WHERE ledger_id = ? AND posting_set_id = ? ORDER BY posting_index;

-- P4-02 shared import spine (D-098, D-092 scheme A): non-rgXX shared owners.
-- Fresh-schema DDL must stay structurally identical to the 20.sqm v20 -> v21
-- final state (fresh = migrated).
CREATE TABLE import_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  operation TEXT NOT NULL CHECK (operation IN ('intake', 'confirm_candidate', 'reject_candidate')),
  PRIMARY KEY (ledger_id, request_id)
);
CREATE TABLE import_source_record (
  ledger_id TEXT NOT NULL,
  source_id TEXT NOT NULL,
  owner_request_id TEXT NOT NULL,
  input_ref TEXT NOT NULL,
  record_ordinal INTEGER NOT NULL CHECK (record_ordinal >= 0),
  record_kind TEXT NOT NULL CHECK (record_kind IN ('ordinary_flow_source', 'transfer_flow_source', 'transfer_flow_source_missing_leg')),
  content_hash TEXT NOT NULL,
  contract_version INTEGER NOT NULL CHECK (contract_version IN (1, 2)),
  completeness TEXT NOT NULL CHECK (completeness IN ('valid_complete', 'valid_incomplete')),
  amount_minor INTEGER,
  currency_code TEXT,
  currency_precision INTEGER CHECK (currency_precision IS NULL OR currency_precision >= 0),
  occurred_at TEXT,
  direction_token TEXT,
  status_token TEXT,
  funding_state TEXT NOT NULL DEFAULT 'UNRESOLVED',
  funding_rule_id TEXT NOT NULL DEFAULT 'migration-v24-unresolved',
  funding_rule_version INTEGER NOT NULL DEFAULT 1,
  candidate_generated_at TEXT NOT NULL DEFAULT 'migration-v24-unresolved',
  PRIMARY KEY (ledger_id, source_id),
  UNIQUE (ledger_id, input_ref, record_ordinal),
  UNIQUE (ledger_id, owner_request_id),
  FOREIGN KEY (ledger_id, owner_request_id) REFERENCES import_request(ledger_id, request_id),
  CHECK (completeness != 'valid_complete' OR (amount_minor IS NOT NULL AND currency_code IS NOT NULL AND currency_precision IS NOT NULL AND occurred_at IS NOT NULL AND direction_token IS NOT NULL AND status_token IS NOT NULL)),
  CHECK (amount_minor IS NULL OR (currency_code IS NOT NULL AND currency_precision IS NOT NULL)),
  CHECK ((record_kind = 'ordinary_flow_source' AND contract_version = 1) OR (record_kind IN ('transfer_flow_source', 'transfer_flow_source_missing_leg') AND contract_version = 2))
);
CREATE TABLE import_evidence (
  ledger_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL,
  source_id TEXT NOT NULL,
  evidence_kind TEXT NOT NULL CHECK (evidence_kind IN ('source_observation')),
  observed_at TEXT,
  PRIMARY KEY (ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES import_source_record(ledger_id, source_id)
);
CREATE TABLE import_candidate (
  ledger_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL,
  source_id TEXT NOT NULL,
  candidate_kind TEXT NOT NULL CHECK (candidate_kind IN ('ordinary_flow', 'transfer_flow', 'transfer_flow_missing_leg')),
  confidence TEXT NOT NULL,
  rule TEXT NOT NULL,
  rule_version INTEGER NOT NULL CHECK (rule_version = 1),
  PRIMARY KEY (ledger_id, candidate_id),
  UNIQUE (ledger_id, source_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES import_source_record(ledger_id, source_id)
);
CREATE TABLE import_candidate_requires_confirmation (
  ledger_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL,
  requirement_index INTEGER NOT NULL CHECK (requirement_index >= 0),
  requirement TEXT NOT NULL CHECK (requirement IN ('formal_transaction_creation')),
  PRIMARY KEY (ledger_id, candidate_id, requirement_index),
  UNIQUE (ledger_id, candidate_id, requirement),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_candidate(ledger_id, candidate_id)
);
CREATE TABLE import_candidate_status_history (
  ledger_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL,
  sequence INTEGER NOT NULL CHECK (sequence >= 1),
  status_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('pending_confirmation', 'confirmed', 'rejected', 'incomplete')),
  request_id TEXT NOT NULL,
  operation_class TEXT NOT NULL CHECK (operation_class IN ('creation', 'status_transition')),
  PRIMARY KEY (ledger_id, candidate_id, sequence),
  UNIQUE (ledger_id, status_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES import_request(ledger_id, request_id)
);
CREATE TABLE import_candidate_decision_snapshot (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  decision TEXT NOT NULL CHECK (decision IN ('confirm', 'reject')),
  candidate_id TEXT NOT NULL,
  expected_content_hash TEXT NOT NULL,
  category_id TEXT,
  funding_account_id TEXT,
  from_account_id TEXT,
  to_account_id TEXT,
  explicit_confirmed_at TEXT,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES import_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_candidate(ledger_id, candidate_id),
  CHECK (decision != 'confirm' OR
         (category_id IS NOT NULL AND funding_account_id IS NOT NULL
          AND from_account_id IS NULL AND to_account_id IS NULL)
         OR
         (category_id IS NULL AND funding_account_id IS NULL
          AND from_account_id IS NOT NULL AND to_account_id IS NOT NULL)),
  CHECK (decision != 'reject' OR
         (category_id IS NULL AND funding_account_id IS NULL
          AND from_account_id IS NULL AND to_account_id IS NULL))
);
CREATE TABLE import_confirmation (
  ledger_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL,
  status_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  operation_class TEXT NOT NULL CHECK (operation_class IN ('creation')),
  confirmed_at TEXT,
  PRIMARY KEY (ledger_id, confirmation_id),
  UNIQUE (ledger_id, request_id),
  UNIQUE (ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES import_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, status_id) REFERENCES import_candidate_status_history(ledger_id, status_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE import_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('accepted')),
  source_id TEXT,
  evidence_id TEXT,
  candidate_id TEXT NOT NULL,
  confirmation_id TEXT,
  transaction_id TEXT,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES import_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_candidate(ledger_id, candidate_id)
);

-- P4-07 duplicate review is deliberately separate from import_request and P4-08.
CREATE TABLE import_duplicate_candidate (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, subject_source_id TEXT NOT NULL,
  possible_existing_source_id TEXT, kind TEXT NOT NULL CHECK (kind IN ('EXACT_BUSINESS_TUPLE', 'CLOSED_OR_FAILED_NO_FUNDS')),
  comparison_fingerprint TEXT NOT NULL, comparison_snapshot TEXT NOT NULL,
  provenance TEXT NOT NULL, confidence TEXT NOT NULL CHECK (confidence = 'exact'),
  rule_id TEXT NOT NULL CHECK (rule_id = 'p407_exact_business_tuple_v1'), rule_version INTEGER NOT NULL CHECK (rule_version = 1),
  generated_at TEXT NOT NULL, creation_request_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, subject_source_id) REFERENCES import_source_record(ledger_id, source_id),
  FOREIGN KEY (ledger_id, possible_existing_source_id) REFERENCES import_source_record(ledger_id, source_id),
  FOREIGN KEY (ledger_id, creation_request_id) REFERENCES import_request(ledger_id, request_id),
  CHECK ((kind = 'EXACT_BUSINESS_TUPLE' AND possible_existing_source_id IS NOT NULL) OR (kind = 'CLOSED_OR_FAILED_NO_FUNDS' AND possible_existing_source_id IS NULL))
);
CREATE UNIQUE INDEX import_duplicate_exact_unique ON import_duplicate_candidate(ledger_id, subject_source_id, possible_existing_source_id, kind, comparison_fingerprint) WHERE kind = 'EXACT_BUSINESS_TUPLE';
CREATE UNIQUE INDEX import_duplicate_no_funds_unique ON import_duplicate_candidate(ledger_id, subject_source_id, kind) WHERE kind = 'CLOSED_OR_FAILED_NO_FUNDS';
CREATE TABLE import_duplicate_status_history (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, sequence INTEGER NOT NULL CHECK (sequence >= 1), history_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('DEFERRED', 'CONFIRMED_DUPLICATE', 'CONFIRMED_DISTINCT', 'DISMISSED_LOOKALIKE', 'REJECTED')),
  request_id TEXT NOT NULL, operation_class TEXT NOT NULL CHECK (operation_class IN ('creation', 'status_transition')),
  PRIMARY KEY (ledger_id, candidate_id, sequence), UNIQUE (ledger_id, history_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_duplicate_candidate(ledger_id, candidate_id)
);
CREATE TABLE import_duplicate_review_request (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, operation TEXT NOT NULL CHECK (operation = 'review_duplicate'),
  input_fingerprint TEXT NOT NULL, outcome TEXT NOT NULL CHECK (outcome IN ('PENDING', 'ACCEPTED', 'CONFLICT')), reason_code TEXT,
  PRIMARY KEY (ledger_id, request_id)
);
CREATE TABLE import_duplicate_review_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, candidate_id TEXT NOT NULL, expected_comparison_fingerprint TEXT NOT NULL,
  decision TEXT NOT NULL CHECK (decision IN ('CONFIRMED_DUPLICATE', 'CONFIRMED_DISTINCT', 'DISMISSED_LOOKALIKE', 'REJECTED')),
  reason_token TEXT NOT NULL, reviewed_at TEXT NOT NULL, reviewer_reference TEXT NOT NULL, generated_at TEXT NOT NULL, review_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id), UNIQUE (ledger_id, review_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES import_duplicate_review_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_duplicate_candidate(ledger_id, candidate_id)
);
CREATE TABLE import_duplicate_review_receipt (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, candidate_id TEXT NOT NULL, review_id TEXT NOT NULL, history_id TEXT NOT NULL, outcome TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES import_duplicate_review_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES import_duplicate_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, review_id) REFERENCES import_duplicate_review_snapshot(ledger_id, review_id),
  FOREIGN KEY (ledger_id, history_id) REFERENCES import_duplicate_status_history(ledger_id, history_id)
);
CREATE TRIGGER import_duplicate_candidate_guard_update BEFORE UPDATE ON import_duplicate_candidate BEGIN SELECT RAISE(ABORT, 'cannot update duplicate candidate'); END;
CREATE TRIGGER import_duplicate_candidate_guard_delete BEFORE DELETE ON import_duplicate_candidate BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate candidate'); END;
CREATE TRIGGER import_duplicate_history_guard_update BEFORE UPDATE ON import_duplicate_status_history BEGIN SELECT RAISE(ABORT, 'cannot update duplicate history'); END;
CREATE TRIGGER import_duplicate_history_guard_delete BEFORE DELETE ON import_duplicate_status_history BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate history'); END;
CREATE TRIGGER import_duplicate_review_request_guard_update BEFORE UPDATE ON import_duplicate_review_request BEGIN
 SELECT CASE WHEN old.outcome != 'PENDING' OR new.ledger_id != old.ledger_id OR new.request_id != old.request_id
 OR new.operation != old.operation OR new.input_fingerprint != old.input_fingerprint OR new.outcome != 'ACCEPTED'
 THEN RAISE(ABORT, 'cannot update duplicate review request') END;
END;
CREATE TRIGGER import_duplicate_review_request_guard_delete BEFORE DELETE ON import_duplicate_review_request BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate review request'); END;
CREATE TRIGGER import_duplicate_review_snapshot_guard_update BEFORE UPDATE ON import_duplicate_review_snapshot BEGIN SELECT RAISE(ABORT, 'cannot update duplicate review snapshot'); END;
CREATE TRIGGER import_duplicate_review_snapshot_guard_delete BEFORE DELETE ON import_duplicate_review_snapshot BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate review snapshot'); END;
CREATE TRIGGER import_duplicate_review_receipt_guard_update BEFORE UPDATE ON import_duplicate_review_receipt BEGIN SELECT RAISE(ABORT, 'cannot update duplicate review receipt'); END;
CREATE TRIGGER import_duplicate_review_receipt_guard_delete BEFORE DELETE ON import_duplicate_review_receipt BEGIN SELECT RAISE(ABORT, 'cannot delete duplicate review receipt'); END;
CREATE TRIGGER import_duplicate_history_sequence BEFORE INSERT ON import_duplicate_status_history BEGIN
 SELECT CASE WHEN (SELECT COALESCE(MAX(sequence), 0) FROM import_duplicate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id) + 1 != new.sequence
 OR (new.sequence = 1 AND (new.status != 'DEFERRED' OR new.operation_class != 'creation'))
 OR (new.sequence > 1 AND (new.status = 'DEFERRED' OR new.operation_class != 'status_transition'))
 THEN RAISE(ABORT, 'duplicate history sequence') END;
END;
CREATE TRIGGER import_duplicate_history_terminal BEFORE INSERT ON import_duplicate_status_history BEGIN
 SELECT CASE WHEN EXISTS (SELECT 1 FROM import_duplicate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id AND status != 'DEFERRED') THEN RAISE(ABORT, 'duplicate history terminal') END;
END;
CREATE TRIGGER import_duplicate_history_creation_owner BEFORE INSERT ON import_duplicate_status_history WHEN new.operation_class = 'creation' BEGIN
 SELECT CASE WHEN NOT EXISTS (
   SELECT 1 FROM import_duplicate_candidate candidate
   JOIN import_request request ON request.ledger_id = candidate.ledger_id AND request.request_id = candidate.creation_request_id
   WHERE candidate.ledger_id = new.ledger_id AND candidate.candidate_id = new.candidate_id
     AND candidate.creation_request_id = new.request_id
 ) THEN RAISE(ABORT, 'duplicate history creation owner') END;
END;
CREATE TRIGGER import_duplicate_history_review_owner BEFORE INSERT ON import_duplicate_status_history WHEN new.operation_class = 'status_transition' BEGIN
 SELECT CASE WHEN NOT EXISTS (
   SELECT 1 FROM import_duplicate_review_request request
   JOIN import_duplicate_review_snapshot snapshot
     ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
   WHERE request.ledger_id = new.ledger_id AND request.request_id = new.request_id
     AND request.outcome = 'ACCEPTED'
     AND snapshot.candidate_id = new.candidate_id AND snapshot.decision = new.status
 ) THEN RAISE(ABORT, 'duplicate history review owner') END;
END;
CREATE TRIGGER import_duplicate_review_receipt_consistency BEFORE INSERT ON import_duplicate_review_receipt BEGIN
 SELECT CASE WHEN NOT EXISTS (
   SELECT 1 FROM import_duplicate_review_request request
   JOIN import_duplicate_review_snapshot snapshot
     ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
   JOIN import_duplicate_status_history history
     ON history.ledger_id = new.ledger_id AND history.history_id = new.history_id
   WHERE request.ledger_id = new.ledger_id AND request.request_id = new.request_id
     AND request.outcome = 'ACCEPTED'
     AND snapshot.candidate_id = new.candidate_id AND snapshot.review_id = new.review_id
     AND history.candidate_id = new.candidate_id AND history.request_id = new.request_id
     AND history.status = new.outcome
 ) THEN RAISE(ABORT, 'duplicate review receipt consistency') END;
END;

-- P4-08 shared reconciliation surface. Scenario cardinality is enforced by the
-- confirmation port; these shared tables deliberately have no global evidence or
-- posting uniqueness beyond the one current reconciliation projection per posting.
CREATE TABLE reconciliation_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  operation TEXT NOT NULL CHECK (operation IN ('confirm_link', 'invalidate_link', 'migration_seed')),
  input_fingerprint TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('PENDING', 'ACCEPTED', 'NO_CHANGE', 'REJECTED', 'CONFLICT')),
  reason_code TEXT,
  PRIMARY KEY (ledger_id, request_id)
);

CREATE TABLE reconciliation_request_snapshot (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL,
  posting_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  direction TEXT NOT NULL CHECK (direction IN ('in', 'out')),
  account_id TEXT NOT NULL,
  responsibility TEXT NOT NULL CHECK (responsibility IN ('real_account_posting', 'destination_asset_posting')),
  basis_version INTEGER NOT NULL CHECK (basis_version = 1),
  match_basis TEXT NOT NULL,
  window_days INTEGER NOT NULL CHECK (window_days >= 0),
  natural_day_distance INTEGER NOT NULL CHECK (natural_day_distance >= 0),
  source_occurred_at TEXT NOT NULL,
  confirmed_at TEXT NOT NULL,
  human_decision TEXT NOT NULL CHECK (human_decision = 'confirm_match'),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES reconciliation_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES import_evidence(ledger_id, evidence_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE reconciliation_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('ACCEPTED', 'NO_CHANGE')),
  link_id TEXT,
  reconciliation_id TEXT,
  history_sequence INTEGER,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES reconciliation_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, link_id) REFERENCES evidence_link(ledger_id, link_id),
  FOREIGN KEY (ledger_id, reconciliation_id) REFERENCES posting_reconciliation(ledger_id, reconciliation_id)
);

CREATE TABLE evidence_link (
  ledger_id TEXT NOT NULL,
  link_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL,
  posting_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  responsibility TEXT NOT NULL CHECK (responsibility IN ('real_account_posting', 'destination_asset_posting')),
  basis_version INTEGER NOT NULL CHECK (basis_version = 1),
  match_basis TEXT NOT NULL,
  candidate_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  created_at TEXT NOT NULL,
  PRIMARY KEY (ledger_id, link_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES import_evidence(ledger_id, evidence_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, request_id) REFERENCES reconciliation_request(ledger_id, request_id)
);
CREATE INDEX evidence_link_by_evidence ON evidence_link(ledger_id, evidence_id);
CREATE INDEX evidence_link_by_posting ON evidence_link(ledger_id, posting_id);

CREATE TABLE evidence_link_history (
  ledger_id TEXT NOT NULL,
  link_id TEXT NOT NULL,
  sequence INTEGER NOT NULL CHECK (sequence >= 1),
  state TEXT NOT NULL CHECK (state IN ('active', 'invalidated')),
  reason TEXT NOT NULL CHECK (reason IN ('confirmed', 'posting_replaced', 'corrected')),
  request_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL,
  PRIMARY KEY (ledger_id, link_id, sequence),
  FOREIGN KEY (ledger_id, link_id) REFERENCES evidence_link(ledger_id, link_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES reconciliation_request(ledger_id, request_id)
);

CREATE TABLE posting_reconciliation (
  ledger_id TEXT NOT NULL,
  reconciliation_id TEXT NOT NULL,
  posting_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'PARTIAL', 'DIFFERENCE', 'MISSING', 'CHECKED')),
  latest_sequence INTEGER NOT NULL CHECK (latest_sequence >= 1),
  PRIMARY KEY (ledger_id, reconciliation_id),
  UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE posting_reconciliation_history (
  ledger_id TEXT NOT NULL,
  reconciliation_id TEXT NOT NULL,
  sequence INTEGER NOT NULL CHECK (sequence >= 1),
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'PARTIAL', 'DIFFERENCE', 'MISSING', 'CHECKED')),
  evidence_link_id TEXT,
  request_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL,
  PRIMARY KEY (ledger_id, reconciliation_id, sequence),
  FOREIGN KEY (ledger_id, reconciliation_id) REFERENCES posting_reconciliation(ledger_id, reconciliation_id),
  FOREIGN KEY (ledger_id, evidence_link_id) REFERENCES evidence_link(ledger_id, link_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES reconciliation_request(ledger_id, request_id)
);
CREATE INDEX posting_reconciliation_history_by_link ON posting_reconciliation_history(ledger_id, evidence_link_id);

CREATE TRIGGER reconciliation_request_guard_update BEFORE UPDATE ON reconciliation_request BEGIN
  SELECT CASE WHEN old.outcome != 'PENDING'
      OR new.ledger_id != old.ledger_id OR new.request_id != old.request_id
      OR new.operation != old.operation OR new.input_fingerprint != old.input_fingerprint
      OR new.outcome NOT IN ('ACCEPTED', 'NO_CHANGE', 'REJECTED', 'CONFLICT')
    THEN RAISE(ABORT, 'cannot update reconciliation request') END;
END;
CREATE TRIGGER reconciliation_request_guard_delete BEFORE DELETE ON reconciliation_request BEGIN SELECT RAISE(ABORT, 'cannot delete reconciliation request'); END;
CREATE TRIGGER reconciliation_snapshot_guard_update BEFORE UPDATE ON reconciliation_request_snapshot BEGIN SELECT RAISE(ABORT, 'cannot update reconciliation snapshot'); END;
CREATE TRIGGER reconciliation_snapshot_guard_delete BEFORE DELETE ON reconciliation_request_snapshot BEGIN SELECT RAISE(ABORT, 'cannot delete reconciliation snapshot'); END;
CREATE TRIGGER reconciliation_receipt_guard_update BEFORE UPDATE ON reconciliation_receipt BEGIN SELECT RAISE(ABORT, 'cannot update reconciliation receipt'); END;
CREATE TRIGGER reconciliation_receipt_guard_delete BEFORE DELETE ON reconciliation_receipt BEGIN SELECT RAISE(ABORT, 'cannot delete reconciliation receipt'); END;
CREATE TRIGGER evidence_link_guard_update BEFORE UPDATE ON evidence_link BEGIN SELECT RAISE(ABORT, 'cannot update evidence link'); END;
CREATE TRIGGER evidence_link_guard_delete BEFORE DELETE ON evidence_link BEGIN SELECT RAISE(ABORT, 'cannot delete evidence link'); END;
CREATE TRIGGER evidence_link_history_guard_update BEFORE UPDATE ON evidence_link_history BEGIN SELECT RAISE(ABORT, 'cannot update evidence link history'); END;
CREATE TRIGGER evidence_link_history_guard_delete BEFORE DELETE ON evidence_link_history BEGIN SELECT RAISE(ABORT, 'cannot delete evidence link history'); END;
CREATE TRIGGER posting_reconciliation_guard_delete BEFORE DELETE ON posting_reconciliation BEGIN SELECT RAISE(ABORT, 'cannot delete posting reconciliation'); END;
CREATE TRIGGER posting_reconciliation_history_guard_update BEFORE UPDATE ON posting_reconciliation_history BEGIN SELECT RAISE(ABORT, 'cannot update posting reconciliation history'); END;
CREATE TRIGGER posting_reconciliation_history_guard_delete BEFORE DELETE ON posting_reconciliation_history BEGIN SELECT RAISE(ABORT, 'cannot delete posting reconciliation history'); END;
CREATE TRIGGER evidence_link_history_sequence_guard BEFORE INSERT ON evidence_link_history BEGIN
  SELECT CASE WHEN (SELECT COALESCE(MAX(sequence), 0) FROM evidence_link_history WHERE ledger_id = new.ledger_id AND link_id = new.link_id) + 1 != new.sequence
    OR (new.sequence = 1 AND new.state != 'active')
  THEN RAISE(ABORT, 'evidence link history sequence') END;
END;
CREATE TRIGGER evidence_link_history_transition_guard BEFORE INSERT ON evidence_link_history BEGIN
  SELECT CASE WHEN EXISTS (
    SELECT 1 FROM evidence_link_history latest
    WHERE latest.ledger_id = new.ledger_id AND latest.link_id = new.link_id
      AND latest.sequence = (SELECT max(previous.sequence) FROM evidence_link_history previous
        WHERE previous.ledger_id = new.ledger_id AND previous.link_id = new.link_id)
      AND (latest.state = 'invalidated' OR (latest.state = 'active' AND new.state != 'invalidated'))
  ) THEN RAISE(ABORT, 'evidence link history transition') END;
END;
CREATE TRIGGER posting_reconciliation_history_sequence_guard BEFORE INSERT ON posting_reconciliation_history BEGIN
  SELECT CASE WHEN (SELECT COALESCE(MAX(sequence), 0) FROM posting_reconciliation_history WHERE ledger_id = new.ledger_id AND reconciliation_id = new.reconciliation_id) + 1 != new.sequence
  THEN RAISE(ABORT, 'posting reconciliation sequence') END;
END;
CREATE TRIGGER posting_reconciliation_history_link_guard BEFORE INSERT ON posting_reconciliation_history BEGIN
  SELECT CASE WHEN new.evidence_link_id IS NOT NULL AND NOT EXISTS (
    SELECT 1
    FROM evidence_link link
    JOIN posting_reconciliation reconciliation
      ON reconciliation.ledger_id = link.ledger_id AND reconciliation.posting_id = link.posting_id
    WHERE link.ledger_id = new.ledger_id AND link.link_id = new.evidence_link_id
      AND reconciliation.reconciliation_id = new.reconciliation_id
  ) THEN RAISE(ABORT, 'posting reconciliation evidence link target') END;
END;
CREATE TRIGGER posting_reconciliation_update_guard BEFORE UPDATE ON posting_reconciliation BEGIN
  SELECT CASE WHEN new.ledger_id != old.ledger_id OR new.reconciliation_id != old.reconciliation_id OR new.posting_id != old.posting_id
      OR new.latest_sequence != old.latest_sequence + 1
      OR NOT EXISTS (SELECT 1 FROM posting_reconciliation_history h
        WHERE h.ledger_id = new.ledger_id AND h.reconciliation_id = new.reconciliation_id
          AND h.sequence = new.latest_sequence AND h.status = new.status)
    THEN RAISE(ABORT, 'posting reconciliation current projection') END;
END;

CREATE TRIGGER import_request_guard_update BEFORE UPDATE ON import_request BEGIN SELECT RAISE(ABORT, 'cannot update import request'); END;
CREATE TRIGGER import_request_guard_delete BEFORE DELETE ON import_request BEGIN SELECT RAISE(ABORT, 'cannot delete import request'); END;
CREATE TRIGGER import_source_record_guard_update BEFORE UPDATE ON import_source_record BEGIN SELECT RAISE(ABORT, 'cannot update import source record'); END;
CREATE TRIGGER import_source_record_guard_delete BEFORE DELETE ON import_source_record BEGIN SELECT RAISE(ABORT, 'cannot delete import source record'); END;
CREATE TRIGGER import_evidence_guard_update BEFORE UPDATE ON import_evidence BEGIN SELECT RAISE(ABORT, 'cannot update import evidence'); END;
CREATE TRIGGER import_evidence_guard_delete BEFORE DELETE ON import_evidence BEGIN SELECT RAISE(ABORT, 'cannot delete import evidence'); END;
CREATE TRIGGER import_candidate_guard_update BEFORE UPDATE ON import_candidate BEGIN SELECT RAISE(ABORT, 'cannot update import candidate'); END;
CREATE TRIGGER import_candidate_guard_delete BEFORE DELETE ON import_candidate BEGIN SELECT RAISE(ABORT, 'cannot delete import candidate'); END;
CREATE TRIGGER import_candidate_requires_confirmation_guard_update BEFORE UPDATE ON import_candidate_requires_confirmation BEGIN SELECT RAISE(ABORT, 'cannot update import candidate requirement'); END;
CREATE TRIGGER import_candidate_requires_confirmation_guard_delete BEFORE DELETE ON import_candidate_requires_confirmation BEGIN SELECT RAISE(ABORT, 'cannot delete import candidate requirement'); END;
CREATE TRIGGER import_candidate_status_history_guard_update BEFORE UPDATE ON import_candidate_status_history BEGIN SELECT RAISE(ABORT, 'cannot update import candidate status history'); END;
CREATE TRIGGER import_candidate_status_history_guard_delete BEFORE DELETE ON import_candidate_status_history BEGIN SELECT RAISE(ABORT, 'cannot delete import candidate status history'); END;
CREATE TRIGGER import_candidate_decision_snapshot_guard_update BEFORE UPDATE ON import_candidate_decision_snapshot BEGIN SELECT RAISE(ABORT, 'cannot update import decision snapshot'); END;
CREATE TRIGGER import_candidate_decision_snapshot_guard_delete BEFORE DELETE ON import_candidate_decision_snapshot BEGIN SELECT RAISE(ABORT, 'cannot delete import decision snapshot'); END;
CREATE TRIGGER import_confirmation_guard_update BEFORE UPDATE ON import_confirmation BEGIN SELECT RAISE(ABORT, 'cannot update import confirmation'); END;
CREATE TRIGGER import_confirmation_guard_delete BEFORE DELETE ON import_confirmation BEGIN SELECT RAISE(ABORT, 'cannot delete import confirmation'); END;
CREATE TRIGGER import_receipt_guard_update BEFORE UPDATE ON import_receipt BEGIN SELECT RAISE(ABORT, 'cannot update import receipt'); END;
CREATE TRIGGER import_receipt_guard_delete BEFORE DELETE ON import_receipt BEGIN SELECT RAISE(ABORT, 'cannot delete import receipt'); END;
CREATE TRIGGER import_status_history_sequence_guard BEFORE INSERT ON import_candidate_status_history BEGIN
  SELECT CASE WHEN
    (SELECT COALESCE(MAX(sequence), 0) FROM import_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id) + 1 != new.sequence
  THEN RAISE(ABORT, 'spine status sequence') END;
END;
CREATE TRIGGER import_status_history_transition_guard BEFORE INSERT ON import_candidate_status_history BEGIN
  SELECT CASE
    WHEN (SELECT status FROM import_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id ORDER BY sequence DESC LIMIT 1) IS NULL
      AND new.status NOT IN ('pending_confirmation', 'incomplete') THEN RAISE(ABORT, 'spine status transition')
    WHEN (SELECT status FROM import_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id ORDER BY sequence DESC LIMIT 1) = 'pending_confirmation'
      AND new.status NOT IN ('confirmed', 'rejected') THEN RAISE(ABORT, 'spine status transition')
    WHEN (SELECT status FROM import_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id ORDER BY sequence DESC LIMIT 1) IN ('confirmed', 'rejected', 'incomplete')
      THEN RAISE(ABORT, 'spine status terminal')
  END;
END;

claimImportRequest:
INSERT INTO import_request(
  ledger_id,
  request_id,
  operation
) VALUES (?, ?, ?)
ON CONFLICT (ledger_id, request_id) DO NOTHING;

insertImportSourceRecord:
INSERT INTO import_source_record(
  ledger_id, source_id, owner_request_id, input_ref, record_ordinal, record_kind,
  content_hash, contract_version, completeness, amount_minor, currency_code,
  currency_precision, occurred_at, direction_token, status_token, funding_state, funding_rule_id, funding_rule_version, candidate_generated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertDuplicateCandidate:
INSERT INTO import_duplicate_candidate(ledger_id, candidate_id, subject_source_id, possible_existing_source_id, kind, comparison_fingerprint, comparison_snapshot, provenance, confidence, rule_id, rule_version, generated_at, creation_request_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'exact', 'p407_exact_business_tuple_v1', 1, ?, ?)
ON CONFLICT DO NOTHING;
insertDuplicateStatus:
INSERT INTO import_duplicate_status_history(ledger_id, candidate_id, sequence, history_id, status, request_id, operation_class)
VALUES (?, ?, 1, ?, 'DEFERRED', ?, 'creation') ON CONFLICT DO NOTHING;
selectDuplicateMatches:
SELECT source_id FROM import_source_record WHERE ledger_id = ? AND source_id != ? AND record_kind = ? AND contract_version = ?
 AND amount_minor = ? AND currency_code = ? AND currency_precision = ? AND occurred_at = ? AND direction_token = ?
 AND (status_token = ? OR (status_token IS NULL AND ? = 1))
 AND funding_state = 'SETTLED'
 AND completeness = 'valid_complete' AND (status_token IS NULL OR status_token != 'unresolved') ORDER BY source_id;
selectDuplicateReviewRequest:
SELECT input_fingerprint, outcome FROM import_duplicate_review_request WHERE ledger_id = ? AND request_id = ?;
claimDuplicateReviewRequest:
INSERT INTO import_duplicate_review_request(ledger_id, request_id, operation, input_fingerprint, outcome) VALUES (?, ?, 'review_duplicate', ?, 'PENDING') ON CONFLICT DO NOTHING;
selectDuplicateCandidate:
SELECT kind, comparison_fingerprint FROM import_duplicate_candidate WHERE ledger_id = ? AND candidate_id = ?;
insertDuplicateReviewSnapshot:
INSERT INTO import_duplicate_review_snapshot(ledger_id, request_id, candidate_id, expected_comparison_fingerprint, decision, reason_token, reviewed_at, reviewer_reference, generated_at, review_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
insertDuplicateReviewReceipt:
INSERT INTO import_duplicate_review_receipt(ledger_id, request_id, candidate_id, review_id, history_id, outcome) VALUES (?, ?, ?, ?, ?, ?);
updateDuplicateReviewRequest:
UPDATE import_duplicate_review_request SET outcome = 'ACCEPTED' WHERE ledger_id = ? AND request_id = ?;
selectDuplicateReviewReceipt:
SELECT request_id, candidate_id, review_id, history_id, outcome FROM import_duplicate_review_receipt WHERE ledger_id = ? AND request_id = ?;
selectDuplicateLatestSequence:
SELECT COALESCE(MAX(sequence), 0) FROM import_duplicate_status_history WHERE ledger_id = ? AND candidate_id = ?;
selectDuplicateCurrentStatus:
SELECT status FROM import_duplicate_status_history WHERE ledger_id = ? AND candidate_id = ? ORDER BY sequence DESC LIMIT 1;
insertDuplicateReviewStatus:
INSERT INTO import_duplicate_status_history(ledger_id, candidate_id, sequence, history_id, status, request_id, operation_class) VALUES (?, ?, ?, ?, ?, ?, 'status_transition');

insertImportEvidence:
INSERT INTO import_evidence(ledger_id, evidence_id, source_id, evidence_kind, observed_at)
VALUES (?, ?, ?, ?, ?);

insertImportCandidate:
INSERT INTO import_candidate(ledger_id, candidate_id, source_id, candidate_kind, confidence, rule, rule_version)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertImportCandidateRequirement:
INSERT INTO import_candidate_requires_confirmation(ledger_id, candidate_id, requirement_index, requirement)
VALUES (?, ?, ?, ?);

insertImportStatusHistory:
INSERT INTO import_candidate_status_history(ledger_id, candidate_id, sequence, status_id, status, request_id, operation_class)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertImportDecisionSnapshot:
INSERT INTO import_candidate_decision_snapshot(ledger_id, request_id, decision, candidate_id, expected_content_hash, category_id, funding_account_id, from_account_id, to_account_id, explicit_confirmed_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertImportConfirmation:
INSERT INTO import_confirmation(ledger_id, confirmation_id, request_id, candidate_id, status_id, transaction_id, operation_class, confirmed_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertImportReceipt:
INSERT INTO import_receipt(ledger_id, request_id, outcome, source_id, evidence_id, candidate_id, confirmation_id, transaction_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectImportSourceByIdentity:
SELECT source_id, owner_request_id, input_ref, record_ordinal, record_kind, content_hash,
  contract_version, completeness, amount_minor, currency_code, currency_precision,
  occurred_at, direction_token, status_token, funding_state, funding_rule_id,
  funding_rule_version, candidate_generated_at
FROM import_source_record
WHERE ledger_id = ? AND input_ref = ? AND record_ordinal = ?;

selectImportSourceByOwnerRequest:
SELECT source_id, owner_request_id, input_ref, record_ordinal, record_kind, content_hash,
  contract_version, completeness, amount_minor, currency_code, currency_precision,
  occurred_at, direction_token, status_token, funding_state, funding_rule_id,
  funding_rule_version, candidate_generated_at
FROM import_source_record
WHERE ledger_id = ? AND owner_request_id = ?;

selectImportSourceForCandidate:
SELECT source.source_id, source.content_hash, source.completeness, source.amount_minor,
  source.currency_code, source.currency_precision, source.occurred_at, source.direction_token,
  source.status_token
FROM import_candidate AS candidate
JOIN import_source_record AS source
  ON source.ledger_id = candidate.ledger_id AND source.source_id = candidate.source_id
WHERE candidate.ledger_id = ? AND candidate.candidate_id = ?;

selectImportEvidenceForSource:
SELECT evidence_id FROM import_evidence WHERE ledger_id = ? AND source_id = ?;

selectImportCandidateBySource:
SELECT candidate_id FROM import_candidate WHERE ledger_id = ? AND source_id = ?;

selectImportCandidateCurrentStatus:
SELECT candidate.candidate_id, candidate.source_id, candidate.candidate_kind, status.status
FROM import_candidate AS candidate
JOIN import_candidate_status_history AS status
  ON status.ledger_id = candidate.ledger_id AND status.candidate_id = candidate.candidate_id
WHERE candidate.ledger_id = ? AND candidate.candidate_id = ?
ORDER BY status.sequence DESC LIMIT 1;

hasConfirmedDuplicateForSource:
SELECT EXISTS(
  SELECT 1 FROM import_duplicate_candidate c JOIN import_duplicate_status_history h
    ON h.ledger_id = c.ledger_id AND h.candidate_id = c.candidate_id
  WHERE c.ledger_id = ? AND c.subject_source_id = ? AND h.status = 'CONFIRMED_DUPLICATE'
    AND h.sequence = (SELECT max(h2.sequence) FROM import_duplicate_status_history h2 WHERE h2.ledger_id = c.ledger_id AND h2.candidate_id = c.candidate_id)
);

selectImportCandidateLatestSequence:
SELECT COALESCE(MAX(sequence), 0) FROM import_candidate_status_history WHERE ledger_id = ? AND candidate_id = ?;

selectImportDecisionSnapshotByRequest:
SELECT decision, candidate_id, expected_content_hash, category_id, funding_account_id, from_account_id, to_account_id, explicit_confirmed_at
FROM import_candidate_decision_snapshot
WHERE ledger_id = ? AND request_id = ?;

selectImportReceiptByRequest:
SELECT request_id, source_id, evidence_id, candidate_id, confirmation_id, transaction_id
FROM import_receipt
WHERE ledger_id = ? AND request_id = ?;

selectImportStatusHistoryByCandidate:
SELECT sequence, status_id, status, request_id, operation_class
FROM import_candidate_status_history
WHERE ledger_id = ? AND candidate_id = ?
ORDER BY sequence;

selectImportConfirmationByRequest:
SELECT confirmation_id, request_id, candidate_id, status_id, transaction_id, operation_class, confirmed_at
FROM import_confirmation
WHERE ledger_id = ? AND request_id = ?;

countImportRequests:
SELECT count(*) FROM import_request;
countImportSourceRecords:
SELECT count(*) FROM import_source_record;
countImportEvidence:
SELECT count(*) FROM import_evidence;
countImportCandidates:
SELECT count(*) FROM import_candidate;
countImportCandidateStatusHistory:
SELECT count(*) FROM import_candidate_status_history;
countImportDecisionSnapshots:
SELECT count(*) FROM import_candidate_decision_snapshot;
countImportConfirmations:
SELECT count(*) FROM import_confirmation;
countImportReceipts:
SELECT count(*) FROM import_receipt;

-- P4-08 reconciliation operation queries.
claimP408ReconciliationRequest:
INSERT INTO reconciliation_request(ledger_id, request_id, operation, input_fingerprint, outcome)
VALUES (?, ?, ?, ?, 'PENDING') ON CONFLICT (ledger_id, request_id) DO NOTHING;

selectP408ReconciliationRequest:
SELECT ledger_id, request_id, operation, input_fingerprint, outcome, reason_code
FROM reconciliation_request WHERE ledger_id = ? AND request_id = ?;

insertP408ReconciliationSnapshot:
INSERT INTO reconciliation_request_snapshot(
  ledger_id, request_id, evidence_id, candidate_id, posting_id, transaction_id, amount_minor,
  currency_code, currency_precision, direction, account_id, responsibility,
  basis_version, match_basis, window_days, natural_day_distance,
  source_occurred_at, confirmed_at, human_decision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertP408EvidenceLink:
INSERT INTO evidence_link(
  ledger_id, link_id, evidence_id, posting_id, transaction_id, responsibility, basis_version,
  match_basis, candidate_id, request_id, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertP408EvidenceLinkHistory:
INSERT INTO evidence_link_history(
  ledger_id, link_id, sequence, state, reason, request_id, occurred_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertP408PostingReconciliation:
INSERT INTO posting_reconciliation(ledger_id, reconciliation_id, posting_id, status, latest_sequence)
VALUES (?, ?, ?, 'PENDING', 1) ON CONFLICT (ledger_id, posting_id) DO NOTHING;

insertP408PostingReconciliationHistory:
INSERT INTO posting_reconciliation_history(
  ledger_id, reconciliation_id, sequence, status, evidence_link_id, request_id, occurred_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

updateP408PostingReconciliation:
UPDATE posting_reconciliation SET status = ?, latest_sequence = ?
WHERE ledger_id = ? AND reconciliation_id = ?;

updateP408ReconciliationRequest:
UPDATE reconciliation_request SET outcome = ?, reason_code = ?
WHERE ledger_id = ? AND request_id = ?;

insertP408ReconciliationReceipt:
INSERT INTO reconciliation_receipt(
  ledger_id, request_id, outcome, link_id, reconciliation_id, history_sequence
) VALUES (?, ?, ?, ?, ?, ?);

selectP408ReconciliationReceipt:
SELECT ledger_id, request_id, outcome, link_id, reconciliation_id, history_sequence
FROM reconciliation_receipt WHERE ledger_id = ? AND request_id = ?;

selectP408EvidenceLinksForEvidence:
SELECT ledger_id, link_id, evidence_id, posting_id, transaction_id, responsibility, basis_version,
  match_basis, candidate_id, request_id, created_at
FROM evidence_link WHERE ledger_id = ? AND evidence_id = ? ORDER BY link_id;

selectP408EvidenceSourceFacts:
SELECT evidence.evidence_id, source.source_id, source.amount_minor, source.currency_code,
  source.currency_precision, source.occurred_at, source.direction_token, source.status_token
FROM import_evidence AS evidence
JOIN import_source_record AS source
  ON source.ledger_id = evidence.ledger_id AND source.source_id = evidence.source_id
WHERE evidence.ledger_id = ? AND evidence.evidence_id = ?;

selectP408PostingIntegrity:
SELECT DISTINCT p.posting_id, p.ledger_id, p.amount_minor, p.currency_code, p.currency_precision,
  p.account_id, v.transaction_id, cv.current_version_id, v.occurred_at
FROM posting AS p
JOIN transaction_version AS v
  ON v.ledger_id = p.ledger_id AND v.posting_set_id = p.posting_set_id
JOIN ledger_transaction_current_version AS cv
  ON cv.ledger_id = v.ledger_id AND cv.transaction_id = v.transaction_id
 AND cv.current_version_id = v.version_id
JOIN ledger_transaction AS tx
  ON tx.ledger_id = v.ledger_id AND tx.transaction_id = v.transaction_id
 AND COALESCE(tx.canonical_kind, tx.kind) = 'ACCOUNT_TRANSFER'
WHERE p.ledger_id = ? AND p.posting_id = ?;

selectP408ActiveLinksForEvidence:
SELECT link.link_id, link.posting_id, link.transaction_id, link.responsibility,
  link.candidate_id, link.request_id
FROM evidence_link AS link
JOIN evidence_link_history AS history
  ON history.ledger_id = link.ledger_id AND history.link_id = link.link_id
WHERE link.ledger_id = ? AND link.evidence_id = ?
  AND history.sequence = (SELECT max(h2.sequence) FROM evidence_link_history h2
    WHERE h2.ledger_id = link.ledger_id AND h2.link_id = link.link_id)
  AND history.state = 'active'
ORDER BY link.link_id;

selectP408ActiveLinksForPostingResponsibility:
SELECT link.link_id, link.evidence_id, link.transaction_id, link.candidate_id, link.request_id
FROM evidence_link AS link
JOIN evidence_link_history AS history
  ON history.ledger_id = link.ledger_id AND history.link_id = link.link_id
WHERE link.ledger_id = ? AND link.posting_id = ? AND link.responsibility = ?
  AND history.sequence = (SELECT max(h2.sequence) FROM evidence_link_history h2
    WHERE h2.ledger_id = link.ledger_id AND h2.link_id = link.link_id)
  AND history.state = 'active'
ORDER BY link.link_id;

selectP408PostingReconciliation:
SELECT ledger_id, reconciliation_id, posting_id, status, latest_sequence
FROM posting_reconciliation WHERE ledger_id = ? AND posting_id = ?;

selectP408PostingReconciliationHistory:
SELECT ledger_id, reconciliation_id, sequence, status, evidence_link_id, request_id, occurred_at
FROM posting_reconciliation_history WHERE ledger_id = ? AND reconciliation_id = ?
ORDER BY sequence;

selectP408ReconciliationReport:
SELECT p.posting_id, v.transaction_id, p.account_id,
  COALESCE(reconciliation.status, 'PENDING') AS status,
  link.link_id AS active_link_id,
  link.transaction_id AS active_link_transaction_id
FROM posting AS p
JOIN transaction_version AS v
  ON v.ledger_id = p.ledger_id AND v.posting_set_id = p.posting_set_id
JOIN ledger_transaction_current_version AS current_version
  ON current_version.ledger_id = v.ledger_id
 AND current_version.transaction_id = v.transaction_id
 AND current_version.current_version_id = v.version_id
JOIN ledger_transaction AS tx
  ON tx.ledger_id = v.ledger_id AND tx.transaction_id = v.transaction_id
 AND COALESCE(tx.canonical_kind, tx.kind) = 'ACCOUNT_TRANSFER'
LEFT JOIN posting_reconciliation AS reconciliation
  ON reconciliation.ledger_id = p.ledger_id AND reconciliation.posting_id = p.posting_id
LEFT JOIN evidence_link AS link
  ON link.ledger_id = p.ledger_id AND link.posting_id = p.posting_id
 AND EXISTS (
   SELECT 1 FROM evidence_link_history AS link_history
   WHERE link_history.ledger_id = link.ledger_id AND link_history.link_id = link.link_id
     AND link_history.sequence = (SELECT max(h2.sequence) FROM evidence_link_history h2
       WHERE h2.ledger_id = link.ledger_id AND h2.link_id = link.link_id)
     AND link_history.state = 'active'
 )
WHERE p.ledger_id = ?
ORDER BY p.posting_id, active_link_id;

-- Fresh-schema counterpart of the v22->v23 migration seed. This runs after all
-- formal tables have been declared, so fresh and migrated v23 start with the same
-- qualified current-ACCOUNT_TRANSFER posting PENDING projection.
INSERT INTO reconciliation_request(ledger_id, request_id, operation, input_fingerprint, outcome)
SELECT DISTINCT p.ledger_id, 'migration-v23-seed', 'migration_seed', 'schema-v23-seed', 'ACCEPTED'
FROM posting p
JOIN transaction_version v ON v.ledger_id = p.ledger_id AND v.posting_set_id = p.posting_set_id
JOIN ledger_transaction_current_version cv ON cv.ledger_id = v.ledger_id AND cv.transaction_id = v.transaction_id AND cv.current_version_id = v.version_id
JOIN ledger_transaction tx ON tx.ledger_id = v.ledger_id AND tx.transaction_id = v.transaction_id
  AND COALESCE(tx.canonical_kind, tx.kind) = 'ACCOUNT_TRANSFER';
INSERT INTO posting_reconciliation(ledger_id, reconciliation_id, posting_id, status, latest_sequence)
SELECT p.ledger_id, 'reconciliation-' || p.posting_id, p.posting_id, 'PENDING', 1
FROM posting p
JOIN transaction_version v ON v.ledger_id = p.ledger_id AND v.posting_set_id = p.posting_set_id
JOIN ledger_transaction_current_version cv ON cv.ledger_id = v.ledger_id AND cv.transaction_id = v.transaction_id AND cv.current_version_id = v.version_id
JOIN ledger_transaction tx ON tx.ledger_id = v.ledger_id AND tx.transaction_id = v.transaction_id
  AND COALESCE(tx.canonical_kind, tx.kind) = 'ACCOUNT_TRANSFER';
INSERT INTO posting_reconciliation_history(ledger_id, reconciliation_id, sequence, status, evidence_link_id, request_id, occurred_at)
SELECT ledger_id, reconciliation_id, 1, 'PENDING', NULL, 'migration-v23-seed', 'schema-v23'
FROM posting_reconciliation;
