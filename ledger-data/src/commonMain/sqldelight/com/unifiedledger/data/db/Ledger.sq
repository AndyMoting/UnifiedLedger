CREATE TABLE ledger_transaction (
  transaction_id TEXT NOT NULL PRIMARY KEY,
  ledger_id TEXT NOT NULL,
  kind TEXT NOT NULL CHECK (kind IN ('OPENING_BALANCE', 'EXPENSE', 'INCOME', 'ACCOUNT_TRANSFER')),
  UNIQUE (transaction_id, ledger_id)
);

CREATE TABLE posting_set (
  posting_set_id TEXT NOT NULL PRIMARY KEY,
  ledger_id TEXT NOT NULL,
  UNIQUE (posting_set_id, ledger_id)
);

CREATE TABLE transaction_version (
  version_id TEXT NOT NULL PRIMARY KEY,
  transaction_id TEXT NOT NULL,
  ledger_id TEXT NOT NULL,
  version_number INTEGER NOT NULL CHECK (version_number > 0),
  posting_set_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL,
  statistics_at TEXT NOT NULL,
  effective_at TEXT NOT NULL,
  note TEXT,
  UNIQUE (transaction_id, version_number),
  UNIQUE (transaction_id, version_id, ledger_id),
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (posting_set_id, ledger_id)
    REFERENCES posting_set(posting_set_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE posting (
  posting_id TEXT NOT NULL PRIMARY KEY,
  posting_set_id TEXT NOT NULL,
  ledger_id TEXT NOT NULL,
  posting_index INTEGER NOT NULL CHECK (posting_index >= 0),
  account_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  UNIQUE (posting_set_id, posting_index),
  UNIQUE (posting_id, ledger_id),
  FOREIGN KEY (posting_set_id, ledger_id)
    REFERENCES posting_set(posting_set_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE ledger_transaction_current_version (
  transaction_id TEXT NOT NULL,
  ledger_id TEXT NOT NULL,
  current_version_id TEXT NOT NULL,
  PRIMARY KEY (transaction_id, ledger_id),
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, current_version_id, ledger_id)
    REFERENCES transaction_version(transaction_id, version_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE manual_expense_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  category_id TEXT NOT NULL,
  payment_account_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL,
  note TEXT NOT NULL,
  confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id)
);

CREATE TABLE confirmed_expense_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL UNIQUE,
  transaction_id TEXT NOT NULL UNIQUE,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id)
    REFERENCES manual_expense_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE transaction_note_update_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  note TEXT NOT NULL,
  confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id),
  UNIQUE (ledger_id, request_id, transaction_id),
  FOREIGN KEY (transaction_id, ledger_id)
    REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE confirmed_transaction_note_update_receipt (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL UNIQUE,
  transaction_id TEXT NOT NULL,
  version_id TEXT NOT NULL UNIQUE,
  expected_current_version_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id)
    REFERENCES transaction_note_update_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (ledger_id, request_id, transaction_id)
    REFERENCES transaction_note_update_request(ledger_id, request_id, transaction_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, version_id, ledger_id)
    REFERENCES transaction_version(transaction_id, version_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (transaction_id, expected_current_version_id, ledger_id)
    REFERENCES transaction_version(transaction_id, version_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE manual_income_request (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  category_id TEXT NOT NULL, receiving_account_id TEXT NOT NULL, occurred_at TEXT NOT NULL,
  note TEXT NOT NULL, confirmation_marker TEXT NOT NULL CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id)
);
CREATE TABLE confirmed_income_receipt (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, confirmation_id TEXT NOT NULL UNIQUE,
  transaction_id TEXT NOT NULL UNIQUE, PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES manual_income_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg03_operation_request (
  ledger_id TEXT NOT NULL,
  request_id TEXT NOT NULL,
  action_type TEXT NOT NULL CHECK (action_type IN (
    'MANUAL_ACCOUNT_TRANSFER', 'IMPORT_SOURCE_RECORD',
    'EXPLICIT_CANDIDATE_CONFIRMATION', 'IMPORT_MIRROR_RECORD'
  )),
  PRIMARY KEY (ledger_id, request_id)
);

CREATE TABLE rg03_manual_transfer_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, occurred_at TEXT NOT NULL,
  source_account_id TEXT NOT NULL, destination_account_id TEXT NOT NULL,
  source_debit_minor INTEGER NOT NULL, destination_credit_minor INTEGER NOT NULL,
  fee_minor INTEGER NOT NULL, currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  fee_category_id TEXT NOT NULL, confirmation_marker TEXT NOT NULL
    CHECK (confirmation_marker = 'explicit_manual_save'),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_source_intake_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, source_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL, observed_at TEXT NOT NULL, source_account_id TEXT NOT NULL,
  source_debit_minor INTEGER NOT NULL, currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  completeness TEXT NOT NULL CHECK (completeness IN ('COMPLETE', 'MISSING_DESTINATION')),
  fee_category_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_complete_source_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, destination_account_id TEXT NOT NULL,
  destination_credit_minor INTEGER NOT NULL, fee_minor INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_source_intake_request_snapshot(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_candidate_confirmation_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, candidate_id TEXT NOT NULL,
  confirmed INTEGER NOT NULL CHECK (confirmed = 1),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_mirror_request_snapshot (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, source_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL, observed_at TEXT NOT NULL, account_id TEXT NOT NULL,
  credit_minor INTEGER NOT NULL, currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE
);

CREATE TABLE rg03_source_record (
  ledger_id TEXT NOT NULL, source_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  source_kind TEXT NOT NULL CHECK (source_kind IN ('COMPLETE_TRANSFER_SOURCE', 'INCOMPLETE_TRANSFER_SOURCE', 'ACCOUNT_CREDIT_OBSERVATION')),
  observed_at TEXT NOT NULL, observed_account_id TEXT NOT NULL, observed_amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  PRIMARY KEY (ledger_id, source_id), UNIQUE (ledger_id, source_id, evidence_id)
);

CREATE TABLE rg03_complete_transfer_source_detail (
  ledger_id TEXT NOT NULL, source_id TEXT NOT NULL, destination_account_id TEXT NOT NULL,
  destination_credit_minor INTEGER NOT NULL, fee_minor INTEGER NOT NULL, fee_category_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, source_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg03_source_record(ledger_id, source_id) ON DELETE CASCADE
);

CREATE TABLE rg03_evidence (
  ledger_id TEXT NOT NULL, evidence_id TEXT NOT NULL, source_id TEXT NOT NULL,
  observed_at TEXT NOT NULL, evidence_role TEXT NOT NULL CHECK (evidence_role IN ('SOURCE_DEBIT', 'DESTINATION_MIRROR')),
  PRIMARY KEY (ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, source_id, evidence_id) REFERENCES rg03_source_record(ledger_id, source_id, evidence_id)
);

CREATE TABLE rg03_transfer_candidate (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, source_id TEXT NOT NULL,
  candidate_kind TEXT NOT NULL CHECK (candidate_kind IN ('ACCOUNT_TRANSFER_WITH_FEE', 'ONE_SIDED_DEBIT')),
  fee_category_id TEXT NOT NULL, confidence TEXT NOT NULL, rule_name TEXT NOT NULL, rule_version INTEGER NOT NULL,
  PRIMARY KEY (ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg03_source_record(ledger_id, source_id)
);

CREATE TABLE rg03_candidate_status_history (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, status_sequence INTEGER NOT NULL, status_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION', 'CONFIRMED')),
  request_id TEXT NOT NULL, PRIMARY KEY (ledger_id, candidate_id, status_sequence), UNIQUE (ledger_id, status_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg03_transfer_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id)
);

CREATE TABLE rg03_confirmation (
  ledger_id TEXT NOT NULL, confirmation_id TEXT NOT NULL, request_id TEXT NOT NULL,
  candidate_id TEXT, transaction_id TEXT NOT NULL, confirmation_kind TEXT NOT NULL,
  PRIMARY KEY (ledger_id, confirmation_id), UNIQUE (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg03_transfer_candidate(ledger_id, candidate_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg03_operation_receipt (
  ledger_id TEXT NOT NULL, request_id TEXT NOT NULL, outcome TEXT NOT NULL CHECK (outcome = 'ACCEPTED'),
  confirmation_id TEXT, candidate_id TEXT, transaction_id TEXT, source_id TEXT, evidence_id TEXT,
  PRIMARY KEY (ledger_id, request_id),
  FOREIGN KEY (ledger_id, request_id) REFERENCES rg03_operation_request(ledger_id, request_id) ON DELETE CASCADE,
  FOREIGN KEY (ledger_id, confirmation_id) REFERENCES rg03_confirmation(ledger_id, confirmation_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg03_transfer_candidate(ledger_id, candidate_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg03_evidence_link (
  ledger_id TEXT NOT NULL, link_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  posting_id TEXT NOT NULL, target_kind TEXT NOT NULL CHECK (target_kind = 'POSTING'),
  target_role TEXT NOT NULL CHECK (target_role IN ('REAL_ACCOUNT_POSTING', 'DESTINATION_ASSET_POSTING')),
  status TEXT NOT NULL CHECK (status = 'MATCHED'),
  PRIMARY KEY (ledger_id, link_id), UNIQUE (ledger_id, evidence_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg03_evidence(ledger_id, evidence_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg03_transfer_posting_semantic (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('TRANSFER_PRINCIPAL_OUT', 'TRANSFER_PRINCIPAL_IN', 'TRANSFER_FEE')),
  category_id TEXT,
  reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)),
  PRIMARY KEY (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  CHECK ((role = 'TRANSFER_FEE' AND category_id IS NOT NULL AND reconciliation_eligible = 0)
      OR (role != 'TRANSFER_FEE' AND category_id IS NULL AND reconciliation_eligible = 1))
);

CREATE TABLE rg03_posting_reconciliation (
  ledger_id TEXT NOT NULL, reconciliation_id TEXT NOT NULL, posting_id TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'MATCHED')),
  PRIMARY KEY (ledger_id, reconciliation_id), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

selectCommittedRequest:
SELECT
  request.amount_minor,
  request.currency_code,
  request.currency_precision,
  request.category_id,
  request.payment_account_id,
  request.occurred_at,
  request.note,
  request.confirmation_marker,
  receipt.confirmation_id,
  receipt.transaction_id
FROM manual_expense_request AS request
JOIN confirmed_expense_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id
 AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

selectCommittedManualIncomeRequest:
SELECT request.amount_minor, request.currency_code, request.currency_precision, request.category_id,
  request.receiving_account_id, request.occurred_at, request.note, request.confirmation_marker,
  receipt.confirmation_id, receipt.transaction_id
FROM manual_income_request AS request JOIN confirmed_income_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

insertTransaction:
INSERT INTO ledger_transaction(
  transaction_id,
  ledger_id,
  kind
) VALUES (?, ?, ?);

insertTransactionCurrentVersion:
INSERT INTO ledger_transaction_current_version(
  transaction_id,
  ledger_id,
  current_version_id
) VALUES (?, ?, ?);

insertPostingSet:
INSERT INTO posting_set(posting_set_id, ledger_id) VALUES (?, ?);

insertTransactionVersion:
INSERT INTO transaction_version(
  version_id,
  transaction_id,
  ledger_id,
  version_number,
  posting_set_id,
  occurred_at,
  statistics_at,
  effective_at,
  note
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertPosting:
INSERT INTO posting(
  posting_id,
  posting_set_id,
  ledger_id,
  posting_index,
  account_id,
  amount_minor,
  currency_code,
  currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

claimManualExpenseRequest:
INSERT INTO manual_expense_request(
  ledger_id,
  request_id,
  amount_minor,
  currency_code,
  currency_precision,
  category_id,
  payment_account_id,
  occurred_at,
  note,
  confirmation_marker
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (ledger_id, request_id) DO NOTHING;

claimManualIncomeRequest:
INSERT INTO manual_income_request(ledger_id, request_id, amount_minor, currency_code, currency_precision,
 category_id, receiving_account_id, occurred_at, note, confirmation_marker)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT (ledger_id, request_id) DO NOTHING;

lastStatementChangedRowCount:
SELECT changes();

deleteManualExpenseRequest:
DELETE FROM manual_expense_request
WHERE ledger_id = :ledger_id AND request_id = :request_id;

deleteManualIncomeRequest:
DELETE FROM manual_income_request WHERE ledger_id = :ledger_id AND request_id = :request_id;

insertConfirmedIncomeReceipt:
INSERT INTO confirmed_income_receipt(ledger_id, request_id, confirmation_id, transaction_id) VALUES (?, ?, ?, ?);

insertConfirmedExpenseReceipt:
INSERT INTO confirmed_expense_receipt(
  ledger_id,
  request_id,
  confirmation_id,
  transaction_id
) VALUES (?, ?, ?, ?);

updateCurrentVersion:
UPDATE ledger_transaction_current_version
SET current_version_id = :current_version_id
WHERE transaction_id = :transaction_id;

claimTransactionNoteUpdateRequest:
INSERT INTO transaction_note_update_request(
  ledger_id, request_id, transaction_id, note, confirmation_marker
) VALUES (?, ?, ?, ?, ?)
ON CONFLICT (ledger_id, request_id) DO NOTHING;

deleteTransactionNoteUpdateRequest:
DELETE FROM transaction_note_update_request
WHERE ledger_id = :ledger_id AND request_id = :request_id;

selectCommittedTransactionNoteUpdateRequest:
SELECT request.transaction_id, request.note, request.confirmation_marker,
  receipt.confirmation_id, receipt.version_id, receipt.expected_current_version_id
FROM transaction_note_update_request AS request
JOIN confirmed_transaction_note_update_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

copyCurrentVersionWithNewNote:
INSERT INTO transaction_version(
  version_id, transaction_id, ledger_id, version_number, posting_set_id,
  occurred_at, statistics_at, effective_at, note
)
SELECT :version_id, version.transaction_id, version.ledger_id, version.version_number + 1,
  version.posting_set_id, version.occurred_at, version.statistics_at, version.effective_at, :note
FROM transaction_version AS version
JOIN ledger_transaction_current_version AS current_version
  ON current_version.transaction_id = version.transaction_id
 AND current_version.ledger_id = version.ledger_id
 AND current_version.current_version_id = version.version_id
WHERE version.transaction_id = :transaction_id
  AND version.ledger_id = :ledger_id
  AND version.version_id = :expected_current_version_id;

compareAndSetCurrentVersion:
UPDATE ledger_transaction_current_version
SET current_version_id = :replacement_version_id
WHERE transaction_id = :transaction_id
  AND ledger_id = :ledger_id
  AND current_version_id = :expected_current_version_id;

insertConfirmedTransactionNoteUpdateReceipt:
INSERT INTO confirmed_transaction_note_update_receipt(
  ledger_id, request_id, confirmation_id, transaction_id, version_id, expected_current_version_id
) VALUES (?, ?, ?, ?, ?, ?);

countTransactionNoteUpdateRequests:
SELECT count(*) FROM transaction_note_update_request;

countTransactionNoteUpdateReceipts:
SELECT count(*) FROM confirmed_transaction_note_update_receipt;

countRequests:
SELECT count(*) FROM manual_expense_request;

countReceipts:
SELECT count(*) FROM confirmed_expense_receipt;

countManualIncomeRequests:
SELECT count(*) FROM manual_income_request;

countIncomeReceipts:
SELECT count(*) FROM confirmed_income_receipt;

claimRg03OperationRequest:
INSERT INTO rg03_operation_request(ledger_id, request_id, action_type) VALUES (?, ?, ?)
ON CONFLICT (ledger_id, request_id) DO NOTHING;

insertRg03ManualTransferSnapshot:
INSERT INTO rg03_manual_transfer_request_snapshot(
  ledger_id, request_id, occurred_at, source_account_id, destination_account_id,
  source_debit_minor, destination_credit_minor, fee_minor, currency_code,
  currency_precision, fee_category_id, confirmation_marker
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectRg03ManualCommit:
SELECT request.action_type, snapshot.occurred_at, snapshot.source_account_id,
  snapshot.destination_account_id, snapshot.source_debit_minor,
  snapshot.destination_credit_minor, snapshot.fee_minor, snapshot.currency_code,
  snapshot.currency_precision, snapshot.fee_category_id, snapshot.confirmation_marker,
  receipt.confirmation_id, receipt.transaction_id
FROM rg03_operation_request AS request
JOIN rg03_manual_transfer_request_snapshot AS snapshot
  ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
JOIN rg03_operation_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

insertRg03Confirmation:
INSERT INTO rg03_confirmation(
  ledger_id, confirmation_id, request_id, candidate_id, transaction_id, confirmation_kind
) VALUES (?, ?, ?, ?, ?, ?);

insertRg03OperationReceipt:
INSERT INTO rg03_operation_receipt(
  ledger_id, request_id, outcome, confirmation_id, candidate_id, transaction_id, source_id, evidence_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg03CandidateConfirmationSnapshot:
INSERT INTO rg03_candidate_confirmation_request_snapshot(ledger_id, request_id, candidate_id, confirmed)
VALUES (?, ?, ?, ?);

insertRg03MirrorSnapshot:
INSERT INTO rg03_mirror_request_snapshot(
  ledger_id, request_id, source_id, evidence_id, observed_at, account_id,
  credit_minor, currency_code, currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg03EvidenceLink:
INSERT INTO rg03_evidence_link(ledger_id, link_id, evidence_id, posting_id, target_kind, target_role, status)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg03TransferPostingSemantic:
INSERT INTO rg03_transfer_posting_semantic(
  ledger_id, posting_id, role, category_id, reconciliation_eligible
) VALUES (?, ?, ?, ?, ?);

updateRg03PostingReconciliationStatus:
UPDATE rg03_posting_reconciliation SET status = :status
WHERE ledger_id = :ledger_id AND posting_id = :posting_id;

deleteRg03OperationRequest:
DELETE FROM rg03_operation_request WHERE ledger_id = :ledger_id AND request_id = :request_id;

countRg03OperationRequests:
SELECT count(*) FROM rg03_operation_request;

countRg03OperationReceipts:
SELECT count(*) FROM rg03_operation_receipt;

countRg03Confirmations:
SELECT count(*) FROM rg03_confirmation;

countRg03SourceRecords:
SELECT count(*) FROM rg03_source_record;

countRg03CompleteSourceDetails:
SELECT count(*) FROM rg03_complete_transfer_source_detail;

countRg03Candidates:
SELECT count(*) FROM rg03_transfer_candidate;

countRg03CandidateStatuses:
SELECT count(*) FROM rg03_candidate_status_history;

countRg03Evidence:
SELECT count(*) FROM rg03_evidence;

countRg03EvidenceLinks:
SELECT count(*) FROM rg03_evidence_link;

countRg03PostingReconciliations:
SELECT count(*) FROM rg03_posting_reconciliation;

selectRg03PostingReconciliations:
SELECT posting_id, status
FROM rg03_posting_reconciliation
ORDER BY CASE WHEN posting_id LIKE '%source%' THEN 0 ELSE 1 END, posting_id;

insertRg03PostingReconciliation:
INSERT INTO rg03_posting_reconciliation(ledger_id, reconciliation_id, posting_id, status)
VALUES (?, ?, ?, ?);

insertRg03SourceRecord:
INSERT INTO rg03_source_record(
  ledger_id, source_id, evidence_id, source_kind, observed_at, observed_account_id,
  observed_amount_minor, currency_code, currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg03SourceIntakeRequestSnapshot:
INSERT INTO rg03_source_intake_request_snapshot(
  ledger_id, request_id, source_id, evidence_id, observed_at, source_account_id,
  source_debit_minor, currency_code, currency_precision, completeness, fee_category_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg03CompleteSourceRequestSnapshot:
INSERT INTO rg03_complete_source_request_snapshot(
  ledger_id, request_id, destination_account_id, destination_credit_minor, fee_minor
) VALUES (?, ?, ?, ?, ?);

insertRg03CompleteSourceDetail:
INSERT INTO rg03_complete_transfer_source_detail(
  ledger_id, source_id, destination_account_id, destination_credit_minor, fee_minor, fee_category_id
) VALUES (?, ?, ?, ?, ?, ?);

insertRg03Evidence:
INSERT INTO rg03_evidence(ledger_id, evidence_id, source_id, observed_at, evidence_role)
VALUES (?, ?, ?, ?, ?);

insertRg03Candidate:
INSERT INTO rg03_transfer_candidate(
  ledger_id, candidate_id, source_id, candidate_kind, fee_category_id, confidence, rule_name, rule_version
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg03CandidateStatus:
INSERT INTO rg03_candidate_status_history(ledger_id, candidate_id, status_sequence, status_id, status, request_id)
VALUES (?, ?, ?, ?, ?, ?);

selectRg03OperationReceipt:
SELECT outcome, confirmation_id, candidate_id, transaction_id, source_id, evidence_id
FROM rg03_operation_receipt
WHERE ledger_id = :ledger_id AND request_id = :request_id;

selectRg03Candidate:
SELECT candidate.candidate_id,
  (SELECT status FROM rg03_candidate_status_history AS history
   WHERE history.ledger_id = candidate.ledger_id AND history.candidate_id = candidate.candidate_id
   ORDER BY status_sequence DESC LIMIT 1),
  source.source_id, source.evidence_id,
  source.observed_at, source.observed_account_id, source.observed_amount_minor,
  source.currency_code, source.currency_precision, source.source_kind,
  detail.destination_account_id, detail.destination_credit_minor, detail.fee_minor,
  candidate.fee_category_id
FROM rg03_transfer_candidate AS candidate
JOIN rg03_source_record AS source
  ON source.ledger_id = candidate.ledger_id AND source.source_id = candidate.source_id
LEFT JOIN rg03_complete_transfer_source_detail AS detail
  ON detail.ledger_id = source.ledger_id AND detail.source_id = source.source_id
WHERE candidate.ledger_id = :ledger_id AND candidate.candidate_id = :candidate_id
ORDER BY candidate.candidate_id;

selectRg03SourceCommit:
SELECT request.action_type,
  snapshot.source_id, snapshot.evidence_id, snapshot.observed_at,
  snapshot.source_account_id, snapshot.source_debit_minor,
  snapshot.currency_code, snapshot.currency_precision, snapshot.completeness,
  snapshot.fee_category_id,
  detail.destination_account_id, detail.destination_credit_minor, detail.fee_minor,
  receipt.candidate_id, receipt.source_id, receipt.evidence_id
FROM rg03_operation_request AS request
JOIN rg03_source_intake_request_snapshot AS snapshot
  ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
LEFT JOIN rg03_complete_source_request_snapshot AS detail
  ON detail.ledger_id = request.ledger_id AND detail.request_id = request.request_id
JOIN rg03_operation_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

selectRg03ConfirmationCommit:
SELECT request.action_type, snapshot.candidate_id, snapshot.confirmed,
  receipt.confirmation_id, receipt.candidate_id, receipt.transaction_id,
  receipt.source_id, receipt.evidence_id
FROM rg03_operation_request AS request
JOIN rg03_candidate_confirmation_request_snapshot AS snapshot
  ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
JOIN rg03_operation_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

selectRg03MirrorCommit:
SELECT request.action_type,
  snapshot.source_id, snapshot.evidence_id, snapshot.observed_at,
  snapshot.account_id, snapshot.credit_minor, snapshot.currency_code,
  snapshot.currency_precision,
  receipt.candidate_id, receipt.transaction_id, receipt.source_id, receipt.evidence_id,
  link.link_id, link.posting_id
FROM rg03_operation_request AS request
JOIN rg03_mirror_request_snapshot AS snapshot
  ON snapshot.ledger_id = request.ledger_id AND snapshot.request_id = request.request_id
JOIN rg03_operation_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id AND receipt.request_id = request.request_id
JOIN rg03_evidence_link AS link
  ON link.ledger_id = request.ledger_id AND link.evidence_id = snapshot.evidence_id
WHERE request.ledger_id = :ledger_id AND request.request_id = :request_id;

selectRg03MirrorBindings:
SELECT confirmation.candidate_id, confirmation.transaction_id,
  posting.posting_id, detail.destination_account_id,
  detail.destination_credit_minor, source.currency_code, source.currency_precision
FROM rg03_confirmation AS confirmation
JOIN rg03_transfer_candidate AS candidate
  ON candidate.ledger_id = confirmation.ledger_id AND candidate.candidate_id = confirmation.candidate_id
JOIN rg03_source_record AS source
  ON source.ledger_id = candidate.ledger_id AND source.source_id = candidate.source_id
JOIN rg03_complete_transfer_source_detail AS detail
  ON detail.ledger_id = source.ledger_id AND detail.source_id = source.source_id
JOIN ledger_transaction_current_version AS current_version
  ON current_version.ledger_id = confirmation.ledger_id AND current_version.transaction_id = confirmation.transaction_id
JOIN transaction_version AS version
  ON version.ledger_id = current_version.ledger_id
 AND version.transaction_id = current_version.transaction_id
 AND version.version_id = current_version.current_version_id
JOIN posting
  ON posting.ledger_id = version.ledger_id
 AND posting.posting_set_id = version.posting_set_id
 AND posting.account_id = detail.destination_account_id
 AND posting.amount_minor = detail.destination_credit_minor
 AND posting.currency_code = source.currency_code
 AND posting.currency_precision = source.currency_precision
JOIN rg03_posting_reconciliation AS reconciliation
  ON reconciliation.ledger_id = posting.ledger_id
 AND reconciliation.posting_id = posting.posting_id
 AND reconciliation.status = 'PENDING'
WHERE confirmation.ledger_id = :ledger_id
  AND confirmation.candidate_id = :candidate_id
  AND confirmation.candidate_id IS NOT NULL
  AND (SELECT status FROM rg03_candidate_status_history AS history
       WHERE history.ledger_id = candidate.ledger_id AND history.candidate_id = candidate.candidate_id
       ORDER BY status_sequence DESC LIMIT 1) = 'CONFIRMED'
ORDER BY confirmation.candidate_id, posting.posting_id;

updateRg03CandidateStatus:
INSERT INTO rg03_candidate_status_history(ledger_id, candidate_id, status_sequence, status_id, status, request_id)
SELECT :ledger_id, :candidate_id, COALESCE(MAX(status_sequence), 0) + 1, :status_id, :status, :request_id
FROM rg03_candidate_status_history
WHERE ledger_id = :ledger_id AND candidate_id = :candidate_id;

selectRg03TransferPostingSemantics:
SELECT posting_id, role, category_id, reconciliation_eligible
FROM rg03_transfer_posting_semantic
ORDER BY posting_id;

selectRg03EvidenceLinkTargets:
SELECT link_id, target_kind, target_role, posting_id
FROM rg03_evidence_link
ORDER BY link_id;

selectRg03AllTransactions:
SELECT ledger_tx.transaction_id, ledger_tx.kind, current_row.current_version_id
FROM ledger_transaction AS ledger_tx
JOIN ledger_transaction_current_version AS current_row
  ON current_row.ledger_id = ledger_tx.ledger_id
 AND current_row.transaction_id = ledger_tx.transaction_id
WHERE ledger_tx.ledger_id = :ledger_id
ORDER BY ledger_tx.transaction_id;

selectRg03AllVersions:
SELECT version_id, transaction_id, version_number, posting_set_id,
  occurred_at, statistics_at, effective_at
FROM transaction_version
WHERE ledger_id = :ledger_id
ORDER BY version_id;

selectRg03AllPostingSets:
SELECT posting_set.posting_set_id, posting.posting_id
FROM posting_set
JOIN posting
  ON posting.ledger_id = posting_set.ledger_id
 AND posting.posting_set_id = posting_set.posting_set_id
WHERE posting_set.ledger_id = :ledger_id
ORDER BY posting_set.posting_set_id, posting.posting_id;

selectRg03AllPostings:
SELECT posting.posting_id, posting.posting_set_id, posting.account_id,
  posting.amount_minor, posting.currency_code, posting.currency_precision,
  semantic.role, semantic.category_id, semantic.reconciliation_eligible
FROM posting
LEFT JOIN rg03_transfer_posting_semantic AS semantic
  ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
WHERE posting.ledger_id = :ledger_id
ORDER BY posting.posting_set_id, posting.posting_id;

selectRg03AllSources:
SELECT source.source_id, source.evidence_id, source.source_kind, source.observed_at,
  source.observed_account_id, source.observed_amount_minor, source.currency_code,
  source.currency_precision, detail.destination_account_id,
  detail.destination_credit_minor, detail.fee_minor, detail.fee_category_id
FROM rg03_source_record AS source
LEFT JOIN rg03_complete_transfer_source_detail AS detail
  ON detail.ledger_id = source.ledger_id AND detail.source_id = source.source_id
WHERE source.ledger_id = :ledger_id
ORDER BY source.source_id;

selectRg03AllCandidates:
SELECT candidate.candidate_id, candidate.source_id, candidate.candidate_kind,
  candidate.fee_category_id, candidate.confidence, candidate.rule_name,
  candidate.rule_version, confirmation.transaction_id
FROM rg03_transfer_candidate AS candidate
LEFT JOIN rg03_confirmation AS confirmation
  ON confirmation.ledger_id = candidate.ledger_id AND confirmation.candidate_id = candidate.candidate_id
WHERE candidate.ledger_id = :ledger_id
ORDER BY candidate.candidate_id;

selectRg03AllCandidateStatuses:
SELECT candidate_id, status_sequence, status_id, status
FROM rg03_candidate_status_history
WHERE ledger_id = :ledger_id
ORDER BY candidate_id, status_sequence;

selectRg03AllConfirmations:
SELECT confirmation_id, request_id, candidate_id, transaction_id, confirmation_kind
FROM rg03_confirmation
WHERE ledger_id = :ledger_id
ORDER BY confirmation_id;

selectRg03AllEvidence:
SELECT evidence_id, source_id, observed_at
FROM rg03_evidence
WHERE ledger_id = :ledger_id
ORDER BY evidence_id;

selectRg03AllEvidenceLinks:
SELECT link_id, evidence_id, posting_id, target_kind, target_role
FROM rg03_evidence_link
WHERE ledger_id = :ledger_id
ORDER BY link_id;

selectRg03AllReconciliations:
SELECT reconciliation_id, posting_id, status
FROM rg03_posting_reconciliation
WHERE ledger_id = :ledger_id
ORDER BY reconciliation_id;

countTransactions:
SELECT count(*) FROM ledger_transaction;

countVersions:
SELECT count(*) FROM transaction_version;

countPostingSets:
SELECT count(*) FROM posting_set;

countPostings:
SELECT count(*) FROM posting;

selectPersistedRequest:
SELECT
  request.ledger_id,
  request.request_id,
  request.amount_minor,
  request.currency_code,
  request.currency_precision,
  request.category_id,
  request.payment_account_id,
  request.occurred_at,
  request.note,
  request.confirmation_marker,
  receipt.confirmation_id,
  receipt.transaction_id
FROM manual_expense_request AS request
JOIN confirmed_expense_receipt AS receipt
  ON receipt.ledger_id = request.ledger_id
 AND receipt.request_id = request.request_id
ORDER BY request.ledger_id, request.request_id;

selectPersistedTransaction:
SELECT tx_record.transaction_id, tx_record.ledger_id, tx_record.kind,
  current_version_record.current_version_id
FROM ledger_transaction AS tx_record
JOIN ledger_transaction_current_version AS current_version_record
  ON current_version_record.transaction_id = tx_record.transaction_id
 AND current_version_record.ledger_id = tx_record.ledger_id
ORDER BY tx_record.transaction_id;

selectPersistedVersions:
SELECT
  version_id,
  transaction_id,
  version_number,
  posting_set_id,
  occurred_at,
  statistics_at,
  effective_at,
  note
FROM transaction_version
ORDER BY transaction_id, version_number;

selectPersistedPostings:
SELECT
  posting_id,
  posting_index,
  account_id,
  amount_minor,
  currency_code,
  currency_precision
FROM posting
ORDER BY posting_set_id, posting_index;

selectCurrentVersionId:
SELECT current_version_id
FROM ledger_transaction_current_version;

selectCurrentNote:
SELECT version.note
FROM ledger_transaction_current_version AS transaction_record
JOIN transaction_version AS version
  ON version.version_id = transaction_record.current_version_id;

foreignKeysEnabled:
PRAGMA foreign_keys;
