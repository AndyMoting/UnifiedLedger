CREATE TRIGGER rg06_reconciliation_history_guard_delete BEFORE DELETE ON rg06_reconciliation_history BEGIN SELECT RAISE(ABORT, 'rg06 immutable'); END;

claimRg06Operation:
INSERT INTO rg06_operation VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT (ledger_id, identity_value) DO NOTHING;
selectRg06Operation:
SELECT * FROM rg06_operation WHERE ledger_id = ? AND identity_value = ?;
insertRg06Receipt:
INSERT INTO rg06_operation_receipt VALUES (?, ?, ?, ?, ?);
selectRg06Receipts:
SELECT id_kind, id_value FROM rg06_operation_receipt WHERE ledger_id = ? AND identity_value = ? ORDER BY receipt_index;
selectRg06ReceiptKinds:
SELECT id_kind FROM rg06_operation_receipt WHERE ledger_id = ? AND identity_value = ? ORDER BY receipt_index;
insertRg06Relation:
INSERT INTO rg06_relation VALUES (?, ?, 'staged_payment', '{}');
insertRg06RelationMember:
INSERT INTO rg06_relation_member VALUES (?, ?, ?, ?, ?);
insertRg06Lifecycle:
INSERT INTO rg06_lifecycle VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
updateRg06Lifecycle:
UPDATE rg06_lifecycle SET paid_minor = ?, due_minor = ?, latest_sequence = ? WHERE ledger_id = ? AND lifecycle_id = ? AND latest_sequence = ?;
insertRg06History:
INSERT INTO rg06_lifecycle_history VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
insertRg06Installment:
INSERT INTO rg06_installment VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
insertRg06PostingSemantic:
INSERT INTO rg06_posting_semantic VALUES (?, ?, ?, ?, ?, ?);
insertRg06Source:
INSERT INTO rg06_source VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
insertRg06Evidence:
INSERT INTO rg06_evidence VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
updateRg06EvidenceBinding:
UPDATE rg06_evidence SET evidence_kind = 'BOUND', payment_id = ? WHERE ledger_id = ? AND evidence_id = ? AND evidence_kind = 'PENDING' AND payment_id IS NULL;
insertRg06Candidate:
INSERT INTO rg06_candidate VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
insertRg06CandidateRequirement:
INSERT INTO rg06_candidate_requirement VALUES (?, ?, ?, ?);
insertRg06CandidateStatus:
INSERT INTO rg06_candidate_status_history VALUES (?, ?, ?, ?, ?);
insertRg06Confirmation:
INSERT INTO rg06_confirmation(
  ledger_id, confirmation_id, identity_value, confirmation_kind, candidate_id, relation_id,
  payment_id, payment_role, category_id, funding_account_id, confirmed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
insertRg06EvidenceLink:
INSERT INTO rg06_evidence_link VALUES (?, ?, ?, ?, ?, ?);
insertRg06Reconciliation:
INSERT INTO rg06_posting_reconciliation VALUES (?, ?, ?, ?, ?);
insertRg06ReconciliationHistory:
INSERT INTO rg06_reconciliation_history VALUES (?, ?, ?, ?, ?);
matchRg06Reconciliation:
UPDATE rg06_posting_reconciliation SET status = 'MATCHED', latest_sequence = latest_sequence + 1 WHERE ledger_id = ? AND posting_id = ? AND status = 'PENDING';
selectRg06RelationOwner:
SELECT ledger_id FROM rg06_relation WHERE relation_id = ?;
selectRg06PaymentOwner:
SELECT ledger_id FROM rg06_installment WHERE payment_id = ?;
selectRg06AggregateLifecycle:
SELECT * FROM rg06_lifecycle WHERE ledger_id = ? AND relation_id = ?;
selectRg06RelationMembers:
SELECT member_kind, member_id FROM rg06_relation_member WHERE ledger_id = ? AND relation_id = ? ORDER BY member_index;
selectRg06History:
SELECT * FROM rg06_lifecycle_history WHERE ledger_id = ? AND lifecycle_id = ? ORDER BY history_sequence;
selectRg06Installments:
SELECT * FROM rg06_installment WHERE ledger_id = ? AND relation_id = ? ORDER BY installment_index;
selectRg06FormalTransaction:
SELECT t.transaction_id, t.ledger_id, COALESCE(t.canonical_kind, t.kind) AS kind, c.current_version_id FROM ledger_transaction t JOIN ledger_transaction_current_version c ON c.transaction_id = t.transaction_id AND c.ledger_id = t.ledger_id WHERE t.ledger_id = ? AND t.transaction_id = ?;
selectRg06FormalVersions:
SELECT * FROM transaction_version WHERE ledger_id = ? AND transaction_id = ? ORDER BY version_number;
selectRg06FormalPostingSets:
SELECT DISTINCT ps.posting_set_id FROM posting_set ps JOIN transaction_version v ON v.posting_set_id = ps.posting_set_id AND v.ledger_id = ps.ledger_id WHERE v.ledger_id = ? AND v.transaction_id = ? ORDER BY ps.posting_set_id;
selectRg06FormalPostings:
SELECT * FROM posting WHERE ledger_id = ? AND posting_set_id = ? ORDER BY posting_index;
selectRg06Candidate:
SELECT * FROM rg06_candidate WHERE ledger_id = ? AND candidate_id = ?;
selectRg06CandidateOwner:
SELECT ledger_id FROM rg06_candidate WHERE candidate_id = ?;
selectRg06CandidateStatuses:
SELECT status_id, status_sequence, status FROM rg06_candidate_status_history WHERE ledger_id = ? AND candidate_id = ? ORDER BY status_sequence;
selectRg06Evidence:
SELECT * FROM rg06_evidence WHERE evidence_id = ?;
selectRg06Source:
SELECT * FROM rg06_source WHERE source_id = ?;
selectRg06Payment:
SELECT * FROM rg06_installment WHERE payment_id = ?;
selectRg06EvidenceLinkForPayment:
SELECT * FROM rg06_evidence_link WHERE ledger_id = ? AND payment_id = ? AND posting_id = ?;
selectRg06ConfirmationForIdentity:
SELECT * FROM rg06_confirmation WHERE ledger_id = ? AND identity_value = ?;
selectRg06ReconciliationForPosting:
SELECT * FROM rg06_posting_reconciliation WHERE ledger_id = ? AND posting_id = ?;
countRg06Operations:
SELECT count(*) FROM rg06_operation;
countRg06Relations:
SELECT count(*) FROM rg06_relation;
countRg06RelationMembers:
SELECT count(*) FROM rg06_relation_member;
countRg06Lifecycles:
SELECT count(*) FROM rg06_lifecycle;
countRg06History:
SELECT count(*) FROM rg06_lifecycle_history;
countRg06Installments:
SELECT count(*) FROM rg06_installment;
countRg06Sources:
SELECT count(*) FROM rg06_source;
countRg06Evidence:
SELECT count(*) FROM rg06_evidence;
countRg06Candidates:
SELECT count(*) FROM rg06_candidate;
countRg06CandidateRequirements:
SELECT count(*) FROM rg06_candidate_requirement;
countRg06CandidateStatuses:
SELECT count(*) FROM rg06_candidate_status_history;
countRg06Confirmations:
SELECT count(*) FROM rg06_confirmation;
countRg06EvidenceLinks:
SELECT count(*) FROM rg06_evidence_link;
countRg06Reconciliations:
SELECT count(*) FROM rg06_posting_reconciliation;
countRg06ReconciliationHistory:
SELECT count(*) FROM rg06_reconciliation_history;
countRg06OperationReceipts:
SELECT count(*) FROM rg06_operation_receipt;
countRg06PostingSemantics:
SELECT count(*) FROM rg06_posting_semantic;

rg06IdentityCount:
SELECT count(*) FROM (
  SELECT relation_id AS value, 'relation' AS kind FROM rg06_relation UNION ALL
  SELECT lifecycle_id, 'lifecycle' FROM rg06_lifecycle UNION ALL
  SELECT history_id, 'history' FROM rg06_lifecycle_history UNION ALL
  SELECT payment_id, 'payment' FROM rg06_installment UNION ALL
  SELECT transaction_id, 'transaction' FROM ledger_transaction UNION ALL
  SELECT version_id, 'version' FROM transaction_version UNION ALL
  SELECT posting_set_id, 'posting_set' FROM posting_set UNION ALL
  SELECT posting_id, 'posting' FROM posting UNION ALL
  SELECT source_id, 'source' FROM rg06_source UNION ALL
  SELECT evidence_id, 'evidence' FROM rg06_evidence UNION ALL
  SELECT candidate_id, 'candidate' FROM rg06_candidate UNION ALL
  SELECT status_id, 'candidate_status' FROM rg06_candidate_status_history UNION ALL
  SELECT confirmation_id, 'confirmation' FROM rg06_confirmation UNION ALL
  SELECT link_id, 'link' FROM rg06_evidence_link UNION ALL
  SELECT reconciliation_id, 'reconciliation' FROM rg06_posting_reconciliation
  UNION ALL SELECT relation_id, 'relation' FROM formal_relation
  UNION ALL SELECT relation_id, 'relation' FROM rg05_relation
  UNION ALL SELECT confirmation_id, 'confirmation' FROM rg03_confirmation
  UNION ALL SELECT confirmation_id, 'confirmation' FROM rg04_confirmation
  UNION ALL SELECT confirmation_id, 'confirmation' FROM confirmed_expense_receipt
  UNION ALL SELECT confirmation_id, 'confirmation' FROM confirmed_transaction_note_update_receipt
  UNION ALL SELECT confirmation_id, 'confirmation' FROM confirmed_income_receipt
  UNION ALL SELECT confirmation_id, 'confirmation' FROM rg04_import_confirmation
  UNION ALL SELECT confirmation_id, 'confirmation' FROM rg05_confirmation
  UNION ALL SELECT source_id, 'source' FROM rg03_source_record
  UNION ALL SELECT source_id, 'source' FROM rg04_import_source
  UNION ALL SELECT source_id, 'source' FROM rg05_source_record
  UNION ALL SELECT evidence_id, 'evidence' FROM rg03_evidence
  UNION ALL SELECT evidence_id, 'evidence' FROM rg04_import_evidence
  UNION ALL SELECT evidence_id, 'evidence' FROM rg05_evidence
  UNION ALL SELECT candidate_id, 'candidate' FROM rg03_transfer_candidate
  UNION ALL SELECT candidate_id, 'candidate' FROM rg04_import_candidate
  UNION ALL SELECT candidate_id, 'candidate' FROM rg05_candidate
  UNION ALL SELECT status_id, 'candidate_status' FROM rg03_candidate_status_history
  UNION ALL SELECT status_id, 'candidate_status' FROM rg04_import_candidate_status_fact
  UNION ALL SELECT status_id, 'candidate_status' FROM rg05_candidate_status_history
  UNION ALL SELECT link_id, 'link' FROM rg03_evidence_link
  UNION ALL SELECT match_id, 'link' FROM rg04_import_evidence_match
  UNION ALL SELECT link_id, 'link' FROM rg05_evidence_link
  UNION ALL SELECT reconciliation_id, 'reconciliation' FROM rg03_posting_reconciliation
  UNION ALL SELECT reconciliation_id, 'reconciliation' FROM rg04_posting_reconciliation
  UNION ALL SELECT reconciliation_id, 'reconciliation' FROM rg05_posting_reconciliation
) WHERE kind = ? AND value = ?;

CREATE TABLE rg07_operation (
  ledger_id TEXT NOT NULL,
  identity_value TEXT NOT NULL,
  action TEXT NOT NULL,
  operation_class TEXT NOT NULL,
  fingerprint TEXT NOT NULL,
  outcome TEXT NOT NULL,
  transaction_id TEXT,
  relation_id TEXT,
  CHECK (operation_class IN ('STATUS_TRANSITION','CREATION','RECONCILIATION','REJECTION')),
  CHECK (outcome IN ('ACCEPTED','NO_CHANGE','REJECTED')),
  CHECK (length(fingerprint) > 0),
  PRIMARY KEY (ledger_id, identity_value)
);

CREATE TABLE rg07_rejection (
  ledger_id TEXT NOT NULL,
  identity_value TEXT NOT NULL,
  reason_code TEXT NOT NULL,
  field_path TEXT NOT NULL,
  PRIMARY KEY (ledger_id, identity_value),
  FOREIGN KEY (ledger_id, identity_value) REFERENCES rg07_operation(ledger_id, identity_value) ON DELETE CASCADE
);

CREATE TABLE rg07_relation (
  ledger_id TEXT NOT NULL,
  relation_id TEXT NOT NULL PRIMARY KEY,
  relation_type TEXT NOT NULL CHECK (relation_type = 'refund'),
  payload_marker TEXT NOT NULL CHECK (payload_marker = '{}'),
  UNIQUE (ledger_id, relation_id)
);

CREATE TABLE rg07_relation_member (
  ledger_id TEXT NOT NULL,
  relation_id TEXT NOT NULL,
  member_kind TEXT NOT NULL CHECK (member_kind IN ('TRANSACTION')),
  member_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, relation_id, member_kind, member_id),
  FOREIGN KEY (ledger_id, relation_id) REFERENCES rg07_relation(ledger_id, relation_id) ON DELETE CASCADE
);

CREATE TABLE rg07_refund_relationship (
  ledger_id TEXT NOT NULL,
  entity_id TEXT NOT NULL PRIMARY KEY,
  relation_id TEXT NOT NULL UNIQUE,
  original_transaction_id TEXT NOT NULL,
  refund_transaction_id TEXT,
  category_id TEXT NOT NULL,
  requested_amount_minor INTEGER NOT NULL CHECK (requested_amount_minor > 0),
  received_amount_minor INTEGER NOT NULL CHECK (received_amount_minor >= 0),
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  destination_account_id TEXT,
  requested_at TEXT,
  approved_at TEXT,
  processor_reported_at TEXT,
  source_observed_at TEXT,
  booking_at TEXT,
  value_at TEXT,
  confirmed_at TEXT,
  arrived_at TEXT,
  UNIQUE (ledger_id, entity_id),
  UNIQUE (ledger_id, relation_id),
  FOREIGN KEY (ledger_id, relation_id) REFERENCES rg07_relation(ledger_id, relation_id)
);

CREATE TABLE rg07_refund_relationship_history (
  ledger_id TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  history_sequence INTEGER NOT NULL CHECK (history_sequence > 0),
  history_id TEXT NOT NULL UNIQUE,
  operation_identity TEXT NOT NULL,
  refund_state TEXT NOT NULL CHECK (refund_state IN ('REQUESTED','APPROVED','PROCESSING','RECEIVED')),
  occurred_at TEXT NOT NULL,
  transaction_id TEXT,
  formal_effect_count INTEGER NOT NULL CHECK (formal_effect_count IN (0, 1)),
  PRIMARY KEY (ledger_id, entity_id, history_sequence),
  UNIQUE (ledger_id, history_id),
  CHECK ((refund_state = 'RECEIVED' AND transaction_id IS NOT NULL AND formal_effect_count = 1)
      OR (refund_state != 'RECEIVED' AND transaction_id IS NULL AND formal_effect_count = 0)),
  FOREIGN KEY (ledger_id, entity_id) REFERENCES rg07_refund_relationship(ledger_id, entity_id),
  FOREIGN KEY (ledger_id, operation_identity) REFERENCES rg07_operation(ledger_id, identity_value)
);

CREATE TABLE rg07_source (
  ledger_id TEXT NOT NULL,
  source_id TEXT NOT NULL PRIMARY KEY,
  source_kind TEXT NOT NULL CHECK (source_kind IN ('bank_debit','merchant_refund_notice','wallet_credit','combined_refund_statement','wallet_credit_mirror')),
  source_record_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL,
  immutable_payload_hash TEXT NOT NULL,
  observed_at TEXT NOT NULL,
  observed_at_text TEXT NOT NULL,
  amount_minor INTEGER,
  currency_code TEXT,
  currency_precision INTEGER CHECK (currency_precision IS NULL OR currency_precision >= 0),
  account_id TEXT,
  reported_state TEXT,
  proves_arrival INTEGER CHECK (proves_arrival IS NULL OR proves_arrival IN (0,1)),
  processor_reported_at TEXT,
  source_observed_at TEXT,
  booking_at TEXT,
  value_at TEXT,
  original_source_payload_hash TEXT,
  mirror_of_source_id TEXT,
  UNIQUE (ledger_id, source_id),
  CHECK (source_kind != 'merchant_refund_notice' OR (reported_state IN ('REQUESTED','APPROVED','PROCESSING') AND proves_arrival = 0)),
  CHECK (source_kind != 'wallet_credit_mirror' OR mirror_of_source_id IS NOT NULL),
  CHECK (source_kind = 'wallet_credit_mirror' OR mirror_of_source_id IS NULL)
);

CREATE TABLE rg07_evidence (
  ledger_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL PRIMARY KEY,
  source_id TEXT NOT NULL,
  evidence_kind TEXT NOT NULL CHECK (evidence_kind IN ('asset_debit','refund_notice','asset_credit','combined_refund_statement','asset_credit_mirror')),
  observed_at TEXT NOT NULL,
  observed_at_text TEXT NOT NULL,
  mirror_of_evidence_id TEXT,
  merged_into_evidence_link_id TEXT,
  UNIQUE (ledger_id, evidence_id),
  UNIQUE (ledger_id, source_id),
  CHECK ((evidence_kind = 'asset_credit_mirror' AND mirror_of_evidence_id IS NOT NULL AND merged_into_evidence_link_id IS NOT NULL)
      OR (evidence_kind != 'asset_credit_mirror' AND mirror_of_evidence_id IS NULL AND merged_into_evidence_link_id IS NULL)),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg07_source(ledger_id, source_id)
);

CREATE TABLE rg07_evidence_link (
  ledger_id TEXT NOT NULL,
  link_id TEXT NOT NULL PRIMARY KEY,
  evidence_id TEXT NOT NULL,
  target_kind TEXT NOT NULL CHECK (target_kind IN ('posting','relation')),
  target_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('payment_asset_posting','destination_asset_posting','refund_relationship')),
  UNIQUE (ledger_id, link_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg07_evidence(ledger_id, evidence_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg07_candidate (
  ledger_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL PRIMARY KEY,
  source_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL,
  confidence TEXT NOT NULL CHECK (confidence IN ('1.00','0.50','0.97')),
  proposed_amount_minor INTEGER NOT NULL CHECK (proposed_amount_minor > 0),
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  proposed_original_transaction_id TEXT,
  proposed_category_id TEXT,
  proposed_destination_account_id TEXT,
  proposed_arrived_at TEXT,
  original_source_payload_hash TEXT NOT NULL,
  rule_version INTEGER NOT NULL CHECK (rule_version = 1),
  UNIQUE (ledger_id, candidate_id),
  UNIQUE (ledger_id, source_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg07_source(ledger_id, source_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg07_evidence(ledger_id, evidence_id)
);

CREATE TABLE rg07_candidate_status_history (
  ledger_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL,
  status_sequence INTEGER NOT NULL CHECK (status_sequence IN (1,2)),
  status_id TEXT NOT NULL UNIQUE,
  status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION','CONFIRMED')),
  occurred_at TEXT NOT NULL,
  formal_effect_count INTEGER NOT NULL CHECK (formal_effect_count IN (0,1)),
  PRIMARY KEY (ledger_id, candidate_id, status_sequence),
  UNIQUE (ledger_id, status_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg07_candidate(ledger_id, candidate_id)
);

CREATE TABLE rg07_confirmation (
  ledger_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL PRIMARY KEY,
  operation_id TEXT NOT NULL,
  subject_kind TEXT NOT NULL CHECK (subject_kind IN ('relation')),
  subject_id TEXT NOT NULL,
  confirmed_at TEXT NOT NULL,
  original_transaction_id TEXT NOT NULL,
  UNIQUE (ledger_id, confirmation_id),
  UNIQUE (ledger_id, operation_id),
  UNIQUE (ledger_id, subject_id),
  FOREIGN KEY (ledger_id, subject_id) REFERENCES rg07_relation(ledger_id, relation_id)
);

CREATE TABLE rg07_operation_confirmation (
  ledger_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL PRIMARY KEY,
  operation_id TEXT NOT NULL,
  subject_kind TEXT NOT NULL CHECK (subject_kind = 'operation'),
  subject_id TEXT NOT NULL,
  confirmed_at TEXT,
  original_transaction_id TEXT NOT NULL,
  UNIQUE (ledger_id, confirmation_id),
  UNIQUE (ledger_id, operation_id),
  UNIQUE (ledger_id, subject_id)
);

CREATE TABLE rg07_transaction_version_metadata (
  ledger_id TEXT NOT NULL,
  version_id TEXT NOT NULL,
  created_at TEXT NOT NULL,
  confirmation_id TEXT,
  PRIMARY KEY (ledger_id, version_id),
  FOREIGN KEY (version_id) REFERENCES transaction_version(version_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg07_posting_reconciliation (
  ledger_id TEXT NOT NULL,
  reconciliation_id TEXT NOT NULL PRIMARY KEY,
  posting_id TEXT NOT NULL,
  UNIQUE (ledger_id, reconciliation_id),
  UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg07_posting_semantic (
  ledger_id TEXT NOT NULL,
  posting_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('expense','payment_asset','destination_asset')),
  category_id TEXT,
  reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)),
  PRIMARY KEY (ledger_id, posting_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  CHECK ((role = 'expense' AND category_id IS NOT NULL AND reconciliation_eligible = 0)
      OR (role != 'expense' AND category_id IS NULL AND reconciliation_eligible = 1))
);

CREATE TABLE rg07_reconciliation_history (
  ledger_id TEXT NOT NULL,
  reconciliation_id TEXT NOT NULL,
  status_sequence INTEGER NOT NULL CHECK (status_sequence > 0),
  status TEXT NOT NULL CHECK (status IN ('PENDING','MATCHED')),
  evidence_link_id TEXT,
  PRIMARY KEY (ledger_id, reconciliation_id, status_sequence),
  FOREIGN KEY (ledger_id, reconciliation_id) REFERENCES rg07_posting_reconciliation(ledger_id, reconciliation_id),
  FOREIGN KEY (ledger_id, evidence_link_id) REFERENCES rg07_evidence_link(ledger_id, link_id) DEFERRABLE INITIALLY DEFERRED
);

claimRg07Operation:
INSERT INTO rg07_operation(ledger_id, identity_value, action, operation_class, fingerprint, outcome, transaction_id, relation_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (ledger_id, identity_value) DO NOTHING;

selectRg07Operation:
SELECT * FROM rg07_operation WHERE ledger_id = ? AND identity_value = ?;

insertRg07Rejection:
INSERT INTO rg07_rejection(ledger_id, identity_value, reason_code, field_path)
VALUES (?, ?, ?, ?);

selectRg07Rejection:
SELECT * FROM rg07_rejection WHERE ledger_id = ? AND identity_value = ?;

updateRg07Outcome:
UPDATE rg07_operation SET outcome = ? WHERE ledger_id = ? AND identity_value = ? AND outcome = 'ACCEPTED';

insertRg07Relation:
INSERT INTO rg07_relation(ledger_id, relation_id, relation_type, payload_marker)
VALUES (?, ?, 'refund', '{}');

insertRg07RelationMember:
INSERT INTO rg07_relation_member(ledger_id, relation_id, member_kind, member_id)
VALUES (?, ?, 'TRANSACTION', ?);

insertRg07RefundRelationship:
INSERT INTO rg07_refund_relationship(
  ledger_id, entity_id, relation_id, original_transaction_id, refund_transaction_id,
  category_id, requested_amount_minor, received_amount_minor, currency_code, currency_precision,
  destination_account_id, requested_at, approved_at, processor_reported_at,
  source_observed_at, booking_at, value_at, confirmed_at, arrived_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg07PostingSemantic:
INSERT INTO rg07_posting_semantic(ledger_id, posting_id, role, category_id, reconciliation_eligible)
VALUES (?, ?, ?, ?, ?);

selectRg07OriginalExpense:
SELECT tx.transaction_id, posting.posting_id, posting.account_id, posting.amount_minor,
       posting.currency_code, posting.currency_precision, semantic.category_id
FROM ledger_transaction AS tx
JOIN ledger_transaction_current_version AS cv
  ON cv.ledger_id = tx.ledger_id AND cv.transaction_id = tx.transaction_id
JOIN transaction_version AS version
  ON version.ledger_id = cv.ledger_id AND version.transaction_id = cv.transaction_id
  AND version.version_id = cv.current_version_id
JOIN posting
  ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
JOIN rg07_posting_semantic AS semantic
  ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
WHERE tx.ledger_id = ? AND tx.transaction_id = ?
  AND tx.kind = 'EXPENSE' AND semantic.role = 'expense' AND posting.amount_minor > 0
LIMIT 2;

selectRg07RelationsForOriginal:
SELECT member.relation_id
FROM rg07_relation_member AS member
JOIN rg07_relation AS rel
  ON rel.ledger_id = member.ledger_id AND rel.relation_id = member.relation_id
WHERE member.ledger_id = ? AND member.member_kind = 'TRANSACTION' AND member.member_id = ?;

selectRg07EntityByRelation:
SELECT * FROM rg07_refund_relationship WHERE ledger_id = ? AND relation_id = ?;

updateRg07RefundRelationshipReceipt:
UPDATE rg07_refund_relationship
SET refund_transaction_id = ?, received_amount_minor = ?, destination_account_id = ?,
    source_observed_at = ?, booking_at = ?, value_at = ?, confirmed_at = ?, arrived_at = ?
WHERE ledger_id = ? AND entity_id = ?;

selectRg07Candidate:
SELECT * FROM rg07_candidate WHERE ledger_id = ? AND candidate_id = ?;

selectRg07CandidateLatestStatus:
SELECT status FROM rg07_candidate_status_history
WHERE ledger_id = ? AND candidate_id = ?
ORDER BY status_sequence DESC LIMIT 1;

selectRg07Source:
SELECT * FROM rg07_source WHERE ledger_id = ? AND source_id = ?;

selectRg07Evidence:
SELECT * FROM rg07_evidence WHERE ledger_id = ? AND evidence_id = ?;

selectRg07EvidenceLinkForRole:
SELECT * FROM rg07_evidence_link WHERE ledger_id = ? AND evidence_id = ? AND role = ?;

selectRg07DestinationPostings:
SELECT posting.posting_id
FROM posting
JOIN rg07_posting_semantic AS semantic
  ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
JOIN transaction_version AS version
  ON version.ledger_id = posting.ledger_id AND version.posting_set_id = posting.posting_set_id
JOIN ledger_transaction_current_version AS current
  ON current.ledger_id = version.ledger_id AND current.current_version_id = version.version_id
JOIN rg07_refund_relationship AS entity
  ON entity.ledger_id = current.ledger_id AND entity.refund_transaction_id = current.transaction_id
WHERE posting.ledger_id = ? AND posting.account_id = ? AND posting.amount_minor = ?
  AND posting.currency_code = ? AND posting.currency_precision = ?
  AND semantic.role = 'destination_asset' AND entity.refund_transaction_id IS NOT NULL;

selectRg07ExactRefundAssetPosting:
SELECT posting.posting_id
FROM rg07_refund_relationship AS entity
JOIN ledger_transaction_current_version AS current
  ON current.ledger_id = entity.ledger_id AND current.transaction_id = entity.refund_transaction_id
JOIN transaction_version AS version
  ON version.ledger_id = current.ledger_id AND version.transaction_id = current.transaction_id
  AND version.version_id = current.current_version_id
JOIN posting
  ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
JOIN rg07_posting_semantic AS semantic
  ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
WHERE entity.ledger_id = ? AND entity.relation_id = ? AND posting.posting_id = ?
  AND posting.account_id = ? AND posting.amount_minor = ? AND posting.currency_code = ?
  AND posting.currency_precision = ? AND semantic.role = 'destination_asset';

selectRg07RefundAssetPosting:
SELECT posting.posting_id
FROM rg07_refund_relationship AS entity
JOIN ledger_transaction_current_version AS current
  ON current.ledger_id = entity.ledger_id AND current.transaction_id = entity.refund_transaction_id
JOIN transaction_version AS version
  ON version.ledger_id = current.ledger_id AND version.transaction_id = current.transaction_id
  AND version.version_id = current.current_version_id
JOIN posting
  ON posting.ledger_id = version.ledger_id AND posting.posting_set_id = version.posting_set_id
JOIN rg07_posting_semantic AS semantic
  ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
WHERE entity.ledger_id = ? AND entity.relation_id = ? AND entity.refund_transaction_id IS NOT NULL
  AND semantic.role = 'destination_asset';

selectRg07ReconciliationLatest:
SELECT history.status_sequence, history.status, history.evidence_link_id
FROM rg07_reconciliation_history AS history
WHERE ledger_id = ? AND reconciliation_id = ?
ORDER BY status_sequence DESC LIMIT 1;

selectRg07ConfirmationForSubject:
SELECT * FROM rg07_confirmation WHERE ledger_id = ? AND subject_id = ?;

selectRg07RefundRelation:
SELECT relation_id FROM rg07_refund_relationship WHERE ledger_id = ? LIMIT 1;

selectRg07EntitiesForOriginal:
SELECT * FROM rg07_refund_relationship WHERE ledger_id = ? AND original_transaction_id = ?;

selectRg07Posting:
SELECT * FROM posting WHERE ledger_id = ? AND posting_id = ?;

selectRg07AssetPosting:
SELECT posting.posting_id, posting.posting_set_id, posting.ledger_id, posting.posting_index,
       posting.account_id, posting.amount_minor, posting.currency_code, posting.currency_precision
FROM posting
JOIN rg07_posting_semantic AS semantic
  ON semantic.ledger_id = posting.ledger_id AND semantic.posting_id = posting.posting_id
WHERE posting.ledger_id = ? AND posting.posting_id = ?
  AND semantic.role = 'payment_asset' AND semantic.reconciliation_eligible = 1;

insertRg07RefundRelationshipHistory:
INSERT INTO rg07_refund_relationship_history(
  ledger_id, entity_id, history_sequence, history_id, operation_identity,
  refund_state, occurred_at, transaction_id, formal_effect_count
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectRg07RefundStatus:
SELECT history.refund_state
FROM rg07_refund_relationship_history AS history
JOIN rg07_refund_relationship AS entity
  ON entity.ledger_id = history.ledger_id AND entity.entity_id = history.entity_id
WHERE entity.ledger_id = ? AND entity.relation_id = ?
ORDER BY history.history_sequence DESC LIMIT 1;

selectRg07LatestHistorySequence:
SELECT history_sequence FROM rg07_refund_relationship_history
WHERE ledger_id = ? AND entity_id = ?
ORDER BY history_sequence DESC LIMIT 1;

insertRg07Source:
INSERT INTO rg07_source(
  ledger_id, source_id, source_kind, source_record_id, evidence_id, immutable_payload_hash,
  observed_at, observed_at_text, amount_minor, currency_code, currency_precision, account_id,
  reported_state, proves_arrival, processor_reported_at, source_observed_at, booking_at, value_at,
  original_source_payload_hash, mirror_of_source_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg07Evidence:
INSERT INTO rg07_evidence(
  ledger_id, evidence_id, source_id, evidence_kind, observed_at, observed_at_text,
  mirror_of_evidence_id, merged_into_evidence_link_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateRg07EvidenceMergedInto:
UPDATE rg07_evidence SET merged_into_evidence_link_id = ?
WHERE ledger_id = ? AND evidence_id = ? AND merged_into_evidence_link_id IS NULL;

insertRg07EvidenceLink:
INSERT INTO rg07_evidence_link(ledger_id, link_id, evidence_id, target_kind, target_id, role)
VALUES (?, ?, ?, ?, ?, ?);

insertRg07Candidate:
INSERT INTO rg07_candidate(
  ledger_id, candidate_id, source_id, evidence_id, confidence,
  proposed_amount_minor, currency_code, currency_precision,
  proposed_original_transaction_id, proposed_category_id, proposed_destination_account_id, proposed_arrived_at,
  original_source_payload_hash, rule_version
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg07CandidateStatus:
INSERT INTO rg07_candidate_status_history(ledger_id, candidate_id, status_sequence, status_id, status, occurred_at, formal_effect_count)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg07Confirmation:
INSERT INTO rg07_confirmation(ledger_id, confirmation_id, operation_id, subject_kind, subject_id, confirmed_at, original_transaction_id)
VALUES (?, ?, ?, 'relation', ?, ?, ?);

insertRg07OperationConfirmation:
INSERT INTO rg07_operation_confirmation(ledger_id, confirmation_id, operation_id, subject_kind, subject_id, confirmed_at, original_transaction_id)
VALUES (?, ?, ?, 'operation', ?, ?, ?);

insertRg07TransactionVersionMetadata:
INSERT INTO rg07_transaction_version_metadata(ledger_id, version_id, created_at, confirmation_id)
VALUES (?, ?, ?, ?);

insertRg07Reconciliation:
INSERT INTO rg07_posting_reconciliation(ledger_id, reconciliation_id, posting_id)
VALUES (?, ?, ?);

insertRg07ReconciliationHistory:
INSERT INTO rg07_reconciliation_history(ledger_id, reconciliation_id, status_sequence, status, evidence_link_id)
VALUES (?, ?, ?, ?, ?);

selectRg07ReconciliationForPosting:
SELECT * FROM rg07_posting_reconciliation WHERE ledger_id = ? AND posting_id = ?;

selectRg07Relation:
SELECT relation_id FROM rg07_relation WHERE ledger_id = ? AND relation_id = ?;

selectRg07AllSources:
SELECT * FROM rg07_source ORDER BY source_id;

selectRg07AllEvidence:
SELECT evidence_id, source_id, evidence_kind, observed_at, observed_at_text, mirror_of_evidence_id, merged_into_evidence_link_id FROM rg07_evidence ORDER BY evidence_id;

selectRg07OriginalTransaction:
SELECT member_id FROM rg07_relation_member
WHERE ledger_id = ? AND relation_id = ? AND member_kind = 'TRANSACTION'
ORDER BY member_id;

rg07OperationGuardUpdate:
UPDATE rg07_operation SET outcome = outcome WHERE 1 = 0;

rg07OperationGuardDelete:
DELETE FROM rg07_operation WHERE 1 = 0;

CREATE TRIGGER rg07_operation_outcome_update BEFORE UPDATE ON rg07_operation BEGIN SELECT CASE WHEN old.outcome = 'ACCEPTED' AND new.outcome = 'REJECTED' AND new.action = old.action AND new.operation_class = old.operation_class AND new.fingerprint = old.fingerprint AND new.ledger_id = old.ledger_id AND new.identity_value = old.identity_value AND new.transaction_id IS old.transaction_id AND new.relation_id IS old.relation_id THEN NULL ELSE RAISE(ABORT, 'rg07 operation immutable') END; END;
CREATE TRIGGER rg07_rejection_guard_update BEFORE UPDATE ON rg07_rejection BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_rejection_guard_delete BEFORE DELETE ON rg07_rejection BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_transaction_version_metadata_guard_update BEFORE UPDATE ON rg07_transaction_version_metadata BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_transaction_version_metadata_guard_delete BEFORE DELETE ON rg07_transaction_version_metadata BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_transaction_version_metadata_owner_insert BEFORE INSERT ON rg07_transaction_version_metadata BEGIN SELECT CASE WHEN NOT EXISTS (SELECT 1 FROM transaction_version WHERE version_id = new.version_id AND ledger_id = new.ledger_id) THEN RAISE(ABORT, 'rg07 transaction version ownership') END; END;
CREATE TRIGGER rg07_operation_immutable_delete BEFORE DELETE ON rg07_operation BEGIN SELECT RAISE(ABORT, 'rg07 operation immutable'); END;
CREATE TRIGGER rg07_relation_guard_update BEFORE UPDATE ON rg07_relation BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_relation_guard_delete BEFORE DELETE ON rg07_relation BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_relation_member_guard_update BEFORE UPDATE ON rg07_relation_member BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_relation_member_guard_delete BEFORE DELETE ON rg07_relation_member BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_refund_relationship_guard_update BEFORE UPDATE ON rg07_refund_relationship BEGIN SELECT CASE WHEN old.refund_transaction_id IS NULL AND new.refund_transaction_id IS NOT NULL AND old.received_amount_minor = 0 AND new.received_amount_minor = old.requested_amount_minor AND old.destination_account_id IS NULL AND new.destination_account_id IS NOT NULL AND old.source_observed_at IS NULL AND new.source_observed_at IS NOT NULL AND old.booking_at IS NULL AND new.booking_at IS NOT NULL AND old.value_at IS NULL AND new.value_at IS NOT NULL AND old.confirmed_at IS NULL AND new.confirmed_at IS NOT NULL AND old.arrived_at IS NULL AND new.arrived_at IS NOT NULL AND new.ledger_id = old.ledger_id AND new.entity_id = old.entity_id AND new.relation_id = old.relation_id AND new.original_transaction_id = old.original_transaction_id AND new.category_id = old.category_id AND new.requested_amount_minor = old.requested_amount_minor AND new.currency_code = old.currency_code AND new.currency_precision = old.currency_precision AND new.requested_at IS old.requested_at AND new.approved_at IS old.approved_at AND new.processor_reported_at IS old.processor_reported_at THEN NULL ELSE RAISE(ABORT, 'rg07 immutable') END; END;
CREATE TRIGGER rg07_refund_relationship_guard_delete BEFORE DELETE ON rg07_refund_relationship BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_refund_relationship_history_guard_update BEFORE UPDATE ON rg07_refund_relationship_history BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_refund_relationship_history_guard_delete BEFORE DELETE ON rg07_refund_relationship_history BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_source_guard_update BEFORE UPDATE ON rg07_source BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_source_guard_delete BEFORE DELETE ON rg07_source BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_source_lineage_insert BEFORE INSERT ON rg07_source BEGIN SELECT CASE WHEN new.mirror_of_source_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM rg07_source WHERE ledger_id = new.ledger_id AND source_id = new.mirror_of_source_id) THEN RAISE(ABORT, 'rg07 source lineage ownership') END; END;
CREATE TRIGGER rg07_evidence_lineage_insert BEFORE INSERT ON rg07_evidence BEGIN SELECT CASE WHEN new.mirror_of_evidence_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM rg07_evidence WHERE ledger_id = new.ledger_id AND evidence_id = new.mirror_of_evidence_id) THEN RAISE(ABORT, 'rg07 evidence lineage ownership') END; SELECT CASE WHEN new.merged_into_evidence_link_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM rg07_evidence_link WHERE ledger_id = new.ledger_id AND link_id = new.merged_into_evidence_link_id) THEN RAISE(ABORT, 'rg07 evidence link lineage ownership') END; END;
CREATE TRIGGER rg07_refund_history_sequence_insert BEFORE INSERT ON rg07_refund_relationship_history BEGIN SELECT CASE WHEN (new.history_sequence = 1 AND EXISTS (SELECT 1 FROM rg07_refund_relationship_history WHERE ledger_id = new.ledger_id AND entity_id = new.entity_id)) OR (new.history_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg07_refund_relationship_history WHERE ledger_id = new.ledger_id AND entity_id = new.entity_id AND history_sequence = new.history_sequence - 1)) THEN RAISE(ABORT, 'rg07 refund history sequence') END; END;
CREATE TRIGGER rg07_candidate_status_sequence_insert BEFORE INSERT ON rg07_candidate_status_history BEGIN SELECT CASE WHEN (new.status_sequence = 1 AND (new.status != 'PENDING_CONFIRMATION' OR EXISTS (SELECT 1 FROM rg07_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id))) OR (new.status_sequence = 2 AND (new.status != 'CONFIRMED' OR NOT EXISTS (SELECT 1 FROM rg07_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id AND status_sequence = 1 AND status = 'PENDING_CONFIRMATION'))) THEN RAISE(ABORT, 'rg07 candidate status sequence') END; END;
CREATE TRIGGER rg07_reconciliation_history_sequence_insert BEFORE INSERT ON rg07_reconciliation_history BEGIN SELECT CASE WHEN (new.status_sequence = 1 AND EXISTS (SELECT 1 FROM rg07_reconciliation_history WHERE ledger_id = new.ledger_id AND reconciliation_id = new.reconciliation_id)) OR (new.status_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg07_reconciliation_history WHERE ledger_id = new.ledger_id AND reconciliation_id = new.reconciliation_id AND status_sequence = new.status_sequence - 1)) THEN RAISE(ABORT, 'rg07 reconciliation history sequence') END; END;
CREATE TRIGGER rg07_evidence_guard_update BEFORE UPDATE ON rg07_evidence BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_evidence_guard_delete BEFORE DELETE ON rg07_evidence BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_evidence_link_guard_update BEFORE UPDATE ON rg07_evidence_link BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_evidence_link_guard_delete BEFORE DELETE ON rg07_evidence_link BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_candidate_guard_update BEFORE UPDATE ON rg07_candidate BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_candidate_guard_delete BEFORE DELETE ON rg07_candidate BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_candidate_status_guard_update BEFORE UPDATE ON rg07_candidate_status_history BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_candidate_status_guard_delete BEFORE DELETE ON rg07_candidate_status_history BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_confirmation_guard_update BEFORE UPDATE ON rg07_confirmation BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_confirmation_guard_delete BEFORE DELETE ON rg07_confirmation BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_operation_confirmation_guard_update BEFORE UPDATE ON rg07_operation_confirmation BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_operation_confirmation_guard_delete BEFORE DELETE ON rg07_operation_confirmation BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_reconciliation_guard_update BEFORE UPDATE ON rg07_posting_reconciliation BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_reconciliation_guard_delete BEFORE DELETE ON rg07_posting_reconciliation BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_reconciliation_history_guard_update BEFORE UPDATE ON rg07_reconciliation_history BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_reconciliation_history_guard_delete BEFORE DELETE ON rg07_reconciliation_history BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_posting_semantic_guard_update BEFORE UPDATE ON rg07_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;
CREATE TRIGGER rg07_posting_semantic_guard_delete BEFORE DELETE ON rg07_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg07 immutable'); END;

-- RG-09 target-balance adjustment owner. The formal ledger remains in the shared
-- transaction/version/posting chain; these tables own RG-09 provenance and lifecycle facts.
CREATE TABLE rg09_operation (
  ledger_id TEXT NOT NULL,
  identity_value TEXT NOT NULL,
  action TEXT NOT NULL,
  operation_class TEXT NOT NULL,
  input_fingerprint TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('PENDING', 'ACCEPTED', 'NO_CHANGE', 'REJECTED')),
  reason_code TEXT,
  field_path TEXT,
  preview_fingerprint TEXT,
  current_fingerprint TEXT,
  recomputed_replay_minor INTEGER,
  recomputed_delta_minor INTEGER,
  currency_code TEXT,
  currency_precision INTEGER CHECK (currency_precision IS NULL OR currency_precision >= 0),
  PRIMARY KEY (ledger_id, identity_value)
);

CREATE TABLE rg09_returned_id (
  ledger_id TEXT NOT NULL,
  identity_value TEXT NOT NULL,
  sequence INTEGER NOT NULL CHECK (sequence >= 0),
  id_kind TEXT NOT NULL,
  id_value TEXT NOT NULL,
  PRIMARY KEY (ledger_id, identity_value, sequence),
  FOREIGN KEY (ledger_id, identity_value) REFERENCES rg09_operation(ledger_id, identity_value) ON DELETE CASCADE
);

CREATE TABLE rg09_observation (
  ledger_id TEXT NOT NULL,
  observation_id TEXT NOT NULL PRIMARY KEY,
  source_id TEXT NOT NULL UNIQUE,
  account_id TEXT NOT NULL,
  target_amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  target_observed_at TEXT NOT NULL,
  target_observed_at_text TEXT NOT NULL,
  saved_at TEXT NOT NULL,
  saved_at_text TEXT NOT NULL,
  UNIQUE (ledger_id, observation_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg09_source(ledger_id, source_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg09_source (
  ledger_id TEXT NOT NULL,
  source_id TEXT NOT NULL PRIMARY KEY,
  source_type TEXT NOT NULL,
  observed_at TEXT NOT NULL,
  observed_at_text TEXT NOT NULL,
  account_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  counter_account_id TEXT,
  actual_at TEXT,
  actual_at_text TEXT,
  booking_at TEXT,
  booking_at_text TEXT,
  immutable_payload_digest TEXT NOT NULL,
  UNIQUE (ledger_id, source_id)
);

CREATE TABLE rg09_evidence (
  ledger_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL PRIMARY KEY,
  source_id TEXT NOT NULL,
  evidence_type TEXT NOT NULL,
  observed_at TEXT NOT NULL,
  observed_at_text TEXT NOT NULL,
  UNIQUE (ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg09_source(ledger_id, source_id)
);

CREATE TABLE rg09_evidence_link (
  ledger_id TEXT NOT NULL,
  link_id TEXT NOT NULL PRIMARY KEY,
  source_id TEXT NOT NULL,
  evidence_id TEXT NOT NULL,
  target_kind TEXT NOT NULL CHECK (target_kind IN ('OBSERVATION', 'POSTING')),
  target_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('TARGET_BALANCE_OBSERVATION', 'REAL_ACCOUNT_POSTING')),
  status TEXT NOT NULL CHECK (status IN ('RECORDED', 'MATCHED')),
  UNIQUE (ledger_id, link_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg09_source(ledger_id, source_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg09_evidence(ledger_id, evidence_id)
);

CREATE TABLE rg09_candidate (
  ledger_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL PRIMARY KEY,
  observation_id TEXT,
  source_id TEXT NOT NULL,
  account_id TEXT NOT NULL,
  replayed_amount_minor INTEGER NOT NULL,
  target_amount_minor INTEGER NOT NULL,
  delta_minor INTEGER NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  target_observed_at TEXT NOT NULL,
  target_observed_at_text TEXT NOT NULL,
  ledger_fingerprint TEXT NOT NULL,
  candidate_type TEXT NOT NULL,
  confidence TEXT,
  status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION', 'CONFIRMED', 'INCOMPLETE')),
  adjustment_id TEXT,
  confirmation_request_id TEXT,
  UNIQUE (ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg09_source(ledger_id, source_id),
  FOREIGN KEY (ledger_id, observation_id) REFERENCES rg09_observation(ledger_id, observation_id)
);

CREATE TABLE rg09_candidate_status_history (
  ledger_id TEXT NOT NULL,
  candidate_id TEXT NOT NULL,
  status_sequence INTEGER NOT NULL CHECK (status_sequence > 0),
  status_id TEXT NOT NULL UNIQUE,
  status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION', 'CONFIRMED', 'INCOMPLETE')),
  occurred_at TEXT NOT NULL,
  adjustment_id TEXT,
  confirmation_request_id TEXT,
  operation_identity TEXT NOT NULL,
  PRIMARY KEY (ledger_id, candidate_id, status_sequence),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg09_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, operation_identity) REFERENCES rg09_operation(ledger_id, identity_value)
);

CREATE TABLE rg09_confirmation (
  ledger_id TEXT NOT NULL,
  confirmation_id TEXT NOT NULL PRIMARY KEY,
  request_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('BALANCE_ADJUSTMENT_CONFIRMATION', 'REAL_TRANSFER_CONFIRMATION', 'EXPLANATION_ALLOCATION_CONFIRMATION')),
  confirmed_at TEXT NOT NULL,
  confirmed_at_text TEXT NOT NULL,
  created_at TEXT NOT NULL,
  created_at_text TEXT NOT NULL,
  target_id TEXT NOT NULL,
  UNIQUE (ledger_id, confirmation_id),
  UNIQUE (ledger_id, request_id)
);

CREATE TABLE rg09_balance_adjustment (
  ledger_id TEXT NOT NULL,
  adjustment_id TEXT NOT NULL PRIMARY KEY,
  transaction_id TEXT NOT NULL UNIQUE,
  observation_id TEXT NOT NULL,
  target_account_id TEXT NOT NULL,
  equity_account_id TEXT NOT NULL,
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  target_observed_at TEXT NOT NULL,
  target_observed_at_text TEXT NOT NULL,
  replayed_amount_minor INTEGER NOT NULL,
  target_amount_minor INTEGER NOT NULL,
  original_delta_minor INTEGER NOT NULL CHECK (original_delta_minor != 0),
  UNIQUE (ledger_id, adjustment_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, observation_id) REFERENCES rg09_observation(ledger_id, observation_id)
);

CREATE TABLE rg09_adjustment_history (
  ledger_id TEXT NOT NULL,
  adjustment_id TEXT NOT NULL,
  history_sequence INTEGER NOT NULL CHECK (history_sequence > 0),
  history_id TEXT NOT NULL UNIQUE,
  state TEXT NOT NULL CHECK (state IN ('OPEN', 'PARTIALLY_EXPLAINED', 'FULLY_EXPLAINED')),
  occurred_at TEXT NOT NULL,
  occurred_at_text TEXT NOT NULL,
  created_at TEXT NOT NULL,
  created_at_text TEXT NOT NULL,
  allocation_id TEXT,
  remaining_amount_minor INTEGER NOT NULL CHECK (remaining_amount_minor >= 0),
  PRIMARY KEY (ledger_id, adjustment_id, history_sequence),
  FOREIGN KEY (ledger_id, adjustment_id) REFERENCES rg09_balance_adjustment(ledger_id, adjustment_id)
);

CREATE TABLE rg09_allocation (
  ledger_id TEXT NOT NULL,
  allocation_id TEXT NOT NULL PRIMARY KEY,
  adjustment_id TEXT NOT NULL,
  target_account_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
  currency_code TEXT NOT NULL,
  currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  real_transaction_id TEXT NOT NULL,
  reversal_transaction_id TEXT NOT NULL UNIQUE,
  confirmed_at TEXT NOT NULL,
  discovered_at TEXT NOT NULL,
  discovered_at_text TEXT NOT NULL,
  confirmed_at_text TEXT NOT NULL,
  created_at TEXT NOT NULL,
  created_at_text TEXT NOT NULL,
  UNIQUE (ledger_id, allocation_id),
  FOREIGN KEY (ledger_id, adjustment_id) REFERENCES rg09_balance_adjustment(ledger_id, adjustment_id),
  FOREIGN KEY (real_transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (reversal_transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg09_audit_link (
  ledger_id TEXT NOT NULL,
  audit_link_id TEXT NOT NULL PRIMARY KEY,
  allocation_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('ADJUSTMENT_TRANSACTION', 'EXPLANATION_TRANSACTION', 'ALLOCATION_REVERSAL')),
  target_id TEXT NOT NULL,
  created_at TEXT NOT NULL,
  created_at_text TEXT NOT NULL,
  UNIQUE (ledger_id, audit_link_id),
  FOREIGN KEY (ledger_id, allocation_id) REFERENCES rg09_allocation(ledger_id, allocation_id)
);

CREATE TABLE rg09_posting_semantic (
  ledger_id TEXT NOT NULL,
  posting_id TEXT NOT NULL PRIMARY KEY,
  role TEXT NOT NULL CHECK (role IN ('ADJUSTMENT_TARGET', 'ADJUSTMENT_EQUITY', 'TRANSFER_SOURCE', 'TRANSFER_DESTINATION', 'REVERSAL_TARGET', 'REVERSAL_EQUITY')),
  reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)),
  UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES posting(ledger_id, posting_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg09_posting_reconciliation (
  ledger_id TEXT NOT NULL,
  posting_id TEXT NOT NULL PRIMARY KEY,
  status TEXT NOT NULL CHECK (status IN ('PENDING_EVIDENCE', 'MATCHED')),
  latest_sequence INTEGER NOT NULL CHECK (latest_sequence > 0),
  UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES rg09_posting_semantic(ledger_id, posting_id)
);

CREATE TABLE rg09_reconciliation_history (
  ledger_id TEXT NOT NULL,
  posting_id TEXT NOT NULL,
  status_sequence INTEGER NOT NULL CHECK (status_sequence > 0),
  status TEXT NOT NULL CHECK (status IN ('PENDING_EVIDENCE', 'MATCHED')),
  evidence_link_id TEXT,
  PRIMARY KEY (ledger_id, posting_id, status_sequence),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES rg09_posting_reconciliation(ledger_id, posting_id),
  FOREIGN KEY (ledger_id, evidence_link_id) REFERENCES rg09_evidence_link(ledger_id, link_id)
);

CREATE TABLE rg09_formal_transaction_metadata (
  ledger_id TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  source_record_id TEXT,
  PRIMARY KEY (ledger_id, transaction_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id)
    DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, source_record_id) REFERENCES rg09_source(ledger_id, source_id)
    DEFERRABLE INITIALLY DEFERRED
);

CREATE TRIGGER rg09_observation_guard_update BEFORE UPDATE ON rg09_observation BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_observation_guard_delete BEFORE DELETE ON rg09_observation BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_source_guard_update BEFORE UPDATE ON rg09_source BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_source_guard_delete BEFORE DELETE ON rg09_source BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_evidence_guard_update BEFORE UPDATE ON rg09_evidence BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_evidence_guard_delete BEFORE DELETE ON rg09_evidence BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_evidence_link_guard_update BEFORE UPDATE ON rg09_evidence_link BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_evidence_link_guard_delete BEFORE DELETE ON rg09_evidence_link BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
-- Candidate facts are immutable; lifecycle ownership fields are a guarded current projection.
CREATE TRIGGER rg09_candidate_guard_update BEFORE UPDATE ON rg09_candidate
BEGIN
  SELECT CASE WHEN (
    old.ledger_id = new.ledger_id
    AND old.candidate_id = new.candidate_id
    AND old.observation_id IS new.observation_id
    AND old.source_id = new.source_id
    AND old.account_id = new.account_id
    AND old.replayed_amount_minor = new.replayed_amount_minor
    AND old.target_amount_minor = new.target_amount_minor
    AND old.delta_minor = new.delta_minor
    AND old.currency_code = new.currency_code
    AND old.currency_precision = new.currency_precision
    AND old.target_observed_at = new.target_observed_at
    AND old.target_observed_at_text = new.target_observed_at_text
    AND old.ledger_fingerprint = new.ledger_fingerprint
    AND old.candidate_type = new.candidate_type
    AND old.confidence IS new.confidence
    AND (
      (old.status = new.status
        AND old.adjustment_id IS new.adjustment_id
        AND old.confirmation_request_id IS new.confirmation_request_id)
      OR (
        old.status = 'PENDING_CONFIRMATION'
        AND new.status = 'CONFIRMED'
        AND new.adjustment_id IS NOT NULL
        AND new.confirmation_request_id IS NOT NULL
        AND EXISTS (
          SELECT 1 FROM rg09_balance_adjustment AS adjustment
          WHERE adjustment.ledger_id = new.ledger_id
            AND adjustment.adjustment_id = new.adjustment_id
        )
        AND EXISTS (
          SELECT 1 FROM rg09_candidate_status_history AS history
          WHERE history.ledger_id = new.ledger_id
            AND history.candidate_id = new.candidate_id
            AND history.status_sequence = (
              SELECT MAX(latest.status_sequence)
              FROM rg09_candidate_status_history AS latest
              WHERE latest.ledger_id = new.ledger_id
                AND latest.candidate_id = new.candidate_id
            )
            AND history.status = new.status
            AND history.adjustment_id IS new.adjustment_id
            AND history.confirmation_request_id IS new.confirmation_request_id
        )
      )
    )
  ) THEN NULL ELSE RAISE(ABORT, 'rg09 candidate current projection') END;
END;
CREATE TRIGGER rg09_candidate_guard_delete BEFORE DELETE ON rg09_candidate BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_adjustment_guard_update BEFORE UPDATE ON rg09_balance_adjustment BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_adjustment_guard_delete BEFORE DELETE ON rg09_balance_adjustment BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_allocation_guard_update BEFORE UPDATE ON rg09_allocation BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_allocation_guard_delete BEFORE DELETE ON rg09_allocation BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_audit_guard_update BEFORE UPDATE ON rg09_audit_link BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_audit_guard_delete BEFORE DELETE ON rg09_audit_link BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_candidate_history_sequence BEFORE INSERT ON rg09_candidate_status_history BEGIN SELECT CASE WHEN (new.status_sequence = 1 AND EXISTS (SELECT 1 FROM rg09_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id)) OR (new.status_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg09_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id AND status_sequence = new.status_sequence - 1)) THEN RAISE(ABORT, 'rg09 candidate history sequence') END; END;
CREATE TRIGGER rg09_adjustment_history_sequence BEFORE INSERT ON rg09_adjustment_history BEGIN SELECT CASE WHEN (new.history_sequence = 1 AND EXISTS (SELECT 1 FROM rg09_adjustment_history WHERE ledger_id = new.ledger_id AND adjustment_id = new.adjustment_id)) OR (new.history_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg09_adjustment_history WHERE ledger_id = new.ledger_id AND adjustment_id = new.adjustment_id AND history_sequence = new.history_sequence - 1)) THEN RAISE(ABORT, 'rg09 adjustment history sequence') END; END;
CREATE TRIGGER rg09_reconciliation_history_sequence BEFORE INSERT ON rg09_reconciliation_history BEGIN SELECT CASE WHEN (new.status_sequence = 1 AND EXISTS (SELECT 1 FROM rg09_reconciliation_history WHERE ledger_id = new.ledger_id AND posting_id = new.posting_id)) OR (new.status_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg09_reconciliation_history WHERE ledger_id = new.ledger_id AND posting_id = new.posting_id AND status_sequence = new.status_sequence - 1)) THEN RAISE(ABORT, 'rg09 reconciliation history sequence') END; END;
CREATE TRIGGER rg09_operation_guard_delete BEFORE DELETE ON rg09_operation BEGIN SELECT RAISE(ABORT, 'rg09 operation immutable'); END;
CREATE TRIGGER rg09_operation_guard_update BEFORE UPDATE ON rg09_operation BEGIN
  SELECT CASE WHEN old.outcome = 'PENDING'
    AND new.outcome IN ('ACCEPTED', 'NO_CHANGE', 'REJECTED')
    AND new.ledger_id = old.ledger_id
    AND new.identity_value = old.identity_value
    AND new.action = old.action
    AND new.operation_class = old.operation_class
    AND new.input_fingerprint = old.input_fingerprint
    THEN NULL ELSE RAISE(ABORT, 'rg09 operation immutable') END;
END;
CREATE TRIGGER rg09_returned_id_guard_update BEFORE UPDATE ON rg09_returned_id BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_returned_id_guard_delete BEFORE DELETE ON rg09_returned_id BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_confirmation_guard_update BEFORE UPDATE ON rg09_confirmation BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_confirmation_guard_delete BEFORE DELETE ON rg09_confirmation BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_semantic_guard_update BEFORE UPDATE ON rg09_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_semantic_guard_delete BEFORE DELETE ON rg09_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_candidate_status_guard_update BEFORE UPDATE ON rg09_candidate_status_history BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_candidate_status_guard_delete BEFORE DELETE ON rg09_candidate_status_history BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_adjustment_history_guard_update BEFORE UPDATE ON rg09_adjustment_history BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_adjustment_history_guard_delete BEFORE DELETE ON rg09_adjustment_history BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_reconciliation_history_guard_update BEFORE UPDATE ON rg09_reconciliation_history BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_reconciliation_history_guard_delete BEFORE DELETE ON rg09_reconciliation_history BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_formal_metadata_guard_update BEFORE UPDATE ON rg09_formal_transaction_metadata BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;
CREATE TRIGGER rg09_formal_metadata_guard_delete BEFORE DELETE ON rg09_formal_transaction_metadata BEGIN SELECT RAISE(ABORT, 'rg09 immutable'); END;

CREATE TRIGGER rg09_balance_adjustment_formal_owner_guard_insert
BEFORE INSERT ON rg09_balance_adjustment
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id
      AND transaction_row.transaction_id = new.transaction_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'BALANCE_ADJUSTMENT'
  ) THEN RAISE(ABORT, 'rg09 adjustment formal ownership') END;
END;

CREATE TRIGGER rg09_candidate_status_owner_guard_insert
BEFORE INSERT ON rg09_candidate_status_history
WHEN new.adjustment_id IS NOT NULL
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg09_balance_adjustment AS adjustment
    WHERE adjustment.ledger_id = new.ledger_id
      AND adjustment.adjustment_id = new.adjustment_id
  ) THEN RAISE(ABORT, 'rg09 candidate adjustment ownership') END;
END;

CREATE TRIGGER rg09_confirmation_target_guard_insert
BEFORE INSERT ON rg09_confirmation
BEGIN
  SELECT CASE
    WHEN new.role = 'BALANCE_ADJUSTMENT_CONFIRMATION'
      AND EXISTS (
        SELECT 1 FROM rg09_balance_adjustment AS adjustment
        WHERE adjustment.ledger_id = new.ledger_id
          AND adjustment.adjustment_id = new.target_id
      ) THEN NULL
    WHEN new.role = 'EXPLANATION_ALLOCATION_CONFIRMATION'
      AND EXISTS (
        SELECT 1 FROM rg09_allocation AS allocation
        WHERE allocation.ledger_id = new.ledger_id
          AND allocation.allocation_id = new.target_id
      ) THEN NULL
    WHEN new.role = 'REAL_TRANSFER_CONFIRMATION'
      AND EXISTS (
        SELECT 1 FROM ledger_transaction AS transaction_row
        WHERE transaction_row.ledger_id = new.ledger_id
          AND transaction_row.transaction_id = new.target_id
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'ACCOUNT_TRANSFER'
      ) THEN NULL
    ELSE RAISE(ABORT, 'rg09 confirmation target ownership')
  END;
END;

CREATE TRIGGER rg09_posting_semantic_formal_owner_guard_insert
BEFORE INSERT ON rg09_posting_semantic
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM posting AS posting_row
    JOIN transaction_version AS version_row
      ON version_row.ledger_id = posting_row.ledger_id
     AND version_row.posting_set_id = posting_row.posting_set_id
    JOIN ledger_transaction_current_version AS current_row
      ON current_row.ledger_id = version_row.ledger_id
     AND current_row.transaction_id = version_row.transaction_id
     AND current_row.current_version_id = version_row.version_id
    JOIN ledger_transaction AS transaction_row
      ON transaction_row.ledger_id = current_row.ledger_id
     AND transaction_row.transaction_id = current_row.transaction_id
    WHERE posting_row.ledger_id = new.ledger_id
      AND posting_row.posting_id = new.posting_id
      AND (
        (new.role IN ('ADJUSTMENT_TARGET', 'ADJUSTMENT_EQUITY')
          AND new.reconciliation_eligible = 0
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'BALANCE_ADJUSTMENT')
        OR
        (new.role IN ('REVERSAL_TARGET', 'REVERSAL_EQUITY')
          AND new.reconciliation_eligible = 0
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'BALANCE_ADJUSTMENT_REVERSAL')
        OR
        (new.role IN ('TRANSFER_SOURCE', 'TRANSFER_DESTINATION')
          AND new.reconciliation_eligible = 1
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'ACCOUNT_TRANSFER')
      )
  ) THEN RAISE(ABORT, 'rg09 posting formal ownership') END;
END;

CREATE TRIGGER rg09_reconciliation_current_guard_insert
BEFORE INSERT ON rg09_posting_reconciliation
BEGIN
  SELECT CASE WHEN new.status != 'PENDING_EVIDENCE'
    OR new.latest_sequence != 1
    OR NOT EXISTS (
      SELECT 1 FROM rg09_posting_semantic AS semantic
      WHERE semantic.ledger_id = new.ledger_id
        AND semantic.posting_id = new.posting_id
        AND semantic.role IN ('TRANSFER_SOURCE', 'TRANSFER_DESTINATION')
        AND semantic.reconciliation_eligible = 1
    ) THEN RAISE(ABORT, 'rg09 reconciliation current ownership') END;
END;

CREATE TRIGGER rg09_reconciliation_current_guard_update
BEFORE UPDATE ON rg09_posting_reconciliation
BEGIN
  SELECT CASE WHEN new.ledger_id = old.ledger_id
    AND new.posting_id = old.posting_id
    AND old.status = 'PENDING_EVIDENCE'
    AND new.status = 'MATCHED'
    AND new.latest_sequence = old.latest_sequence + 1
    AND EXISTS (
      SELECT 1 FROM rg09_reconciliation_history AS history
      WHERE history.ledger_id = new.ledger_id
        AND history.posting_id = new.posting_id
        AND history.status_sequence = new.latest_sequence
        AND history.status = new.status
        AND history.evidence_link_id IS NOT NULL
    ) THEN NULL ELSE RAISE(ABORT, 'rg09 reconciliation current transition') END;
END;

CREATE TRIGGER rg09_reconciliation_current_guard_delete
BEFORE DELETE ON rg09_posting_reconciliation
BEGIN
  SELECT RAISE(ABORT, 'rg09 reconciliation current immutable');
END;

-- Evidence links are typed edges, not free-form labels. Keep the target, role,
-- source lineage, and status consistent even when callers bypass the adapter.
CREATE TRIGGER rg09_evidence_link_target_guard_insert
BEFORE INSERT ON rg09_evidence_link
BEGIN
  SELECT CASE
    WHEN new.target_kind = 'OBSERVATION'
      AND new.role = 'TARGET_BALANCE_OBSERVATION'
      AND new.status = 'RECORDED'
      AND EXISTS (
        SELECT 1
        FROM rg09_observation AS observation
        WHERE observation.ledger_id = new.ledger_id
          AND observation.observation_id = new.target_id
          AND observation.source_id = new.source_id
      )
      THEN NULL
    WHEN new.target_kind = 'POSTING'
      AND new.role = 'REAL_ACCOUNT_POSTING'
      AND new.status = 'MATCHED'
      AND EXISTS (
        SELECT 1
        FROM rg09_posting_semantic AS semantic
        WHERE semantic.ledger_id = new.ledger_id
          AND semantic.posting_id = new.target_id
          AND semantic.role IN ('TRANSFER_SOURCE', 'TRANSFER_DESTINATION')
          AND semantic.reconciliation_eligible = 1
      )
      THEN NULL
    ELSE RAISE(ABORT, 'rg09 evidence link target mismatch')
  END;
END;

CREATE TRIGGER rg09_evidence_link_lineage_guard_insert
BEFORE INSERT ON rg09_evidence_link
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM rg09_evidence AS evidence
    WHERE evidence.ledger_id = new.ledger_id
      AND evidence.evidence_id = new.evidence_id
      AND evidence.source_id = new.source_id
  ) THEN RAISE(ABORT, 'rg09 evidence link lineage mismatch') END;
END;

CREATE TRIGGER rg09_reconciliation_history_evidence_guard_insert
BEFORE INSERT ON rg09_reconciliation_history
WHEN new.evidence_link_id IS NOT NULL
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM rg09_evidence_link AS link
    WHERE link.ledger_id = new.ledger_id
      AND link.link_id = new.evidence_link_id
      AND link.target_kind = 'POSTING'
      AND link.target_id = new.posting_id
      AND link.role = 'REAL_ACCOUNT_POSTING'
      AND link.status = 'MATCHED'
  ) THEN RAISE(ABORT, 'rg09 reconciliation evidence target mismatch') END;
END;

CREATE TRIGGER rg09_allocation_formal_target_guard_insert
BEFORE INSERT ON rg09_allocation
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id
      AND transaction_row.transaction_id = new.real_transaction_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'ACCOUNT_TRANSFER'
  ) THEN RAISE(ABORT, 'rg09 allocation real transaction mismatch') END;
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id
      AND transaction_row.transaction_id = new.reversal_transaction_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'BALANCE_ADJUSTMENT_REVERSAL'
  ) THEN RAISE(ABORT, 'rg09 allocation reversal transaction mismatch') END;
END;

CREATE TRIGGER rg09_audit_link_target_guard_insert
BEFORE INSERT ON rg09_audit_link
BEGIN
  SELECT CASE
    WHEN new.role = 'ADJUSTMENT_TRANSACTION'
      AND EXISTS (
        SELECT 1
        FROM rg09_allocation AS allocation
        JOIN rg09_balance_adjustment AS adjustment
          ON adjustment.ledger_id = allocation.ledger_id
         AND adjustment.adjustment_id = allocation.adjustment_id
        WHERE allocation.ledger_id = new.ledger_id
          AND allocation.allocation_id = new.allocation_id
          AND new.target_id = adjustment.transaction_id
      ) THEN NULL
    WHEN new.role = 'EXPLANATION_TRANSACTION'
      AND EXISTS (
        SELECT 1 FROM rg09_allocation AS allocation
        WHERE allocation.ledger_id = new.ledger_id
          AND allocation.allocation_id = new.allocation_id
          AND new.target_id = allocation.real_transaction_id
      ) THEN NULL
    WHEN new.role = 'ALLOCATION_REVERSAL'
      AND EXISTS (
        SELECT 1 FROM rg09_allocation AS allocation
        WHERE allocation.ledger_id = new.ledger_id
          AND allocation.allocation_id = new.allocation_id
          AND new.target_id = allocation.reversal_transaction_id
      ) THEN NULL
    ELSE RAISE(ABORT, 'rg09 audit link target mismatch')
  END;
END;

selectRg09Operation:
SELECT * FROM rg09_operation WHERE ledger_id = ? AND identity_value = ?;

insertRg09Operation:
INSERT INTO rg09_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome,
  reason_code, field_path, preview_fingerprint, current_fingerprint,
  recomputed_replay_minor, recomputed_delta_minor, currency_code, currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

claimRg09Operation:
INSERT INTO rg09_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome
) VALUES (?, ?, ?, ?, ?, 'PENDING')
ON CONFLICT (ledger_id, identity_value) DO NOTHING;

updateRg09OperationResult:
UPDATE rg09_operation
SET outcome = ?, reason_code = ?, field_path = ?, preview_fingerprint = ?, current_fingerprint = ?,
    recomputed_replay_minor = ?, recomputed_delta_minor = ?, currency_code = ?, currency_precision = ?
WHERE ledger_id = ? AND identity_value = ?;

insertRg09ReturnedId:
INSERT INTO rg09_returned_id(ledger_id, identity_value, sequence, id_kind, id_value)
VALUES (?, ?, ?, ?, ?);

selectRg09ReturnedIds:
SELECT id_kind, id_value FROM rg09_returned_id
WHERE ledger_id = ? AND identity_value = ? ORDER BY sequence;

insertRg09Source:
INSERT INTO rg09_source(
  ledger_id, source_id, source_type, observed_at, observed_at_text, account_id,
  amount_minor, currency_code, currency_precision, counter_account_id,
  actual_at, actual_at_text, booking_at, booking_at_text, immutable_payload_digest
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg09Evidence:
INSERT INTO rg09_evidence(ledger_id, evidence_id, source_id, evidence_type, observed_at, observed_at_text)
VALUES (?, ?, ?, ?, ?, ?);

insertRg09EvidenceLink:
INSERT INTO rg09_evidence_link(
  ledger_id, link_id, source_id, evidence_id, target_kind, target_id, role, status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertRg09Observation:
INSERT INTO rg09_observation(
  ledger_id, observation_id, source_id, account_id, target_amount_minor,
  currency_code, currency_precision, target_observed_at, target_observed_at_text, saved_at, saved_at_text
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg09Candidate:
INSERT INTO rg09_candidate(
  ledger_id, candidate_id, observation_id, source_id, account_id,
  replayed_amount_minor, target_amount_minor, delta_minor, currency_code,
  currency_precision, target_observed_at, target_observed_at_text,
  ledger_fingerprint, candidate_type, confidence, status, adjustment_id, confirmation_request_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRg09CandidateCurrent:
UPDATE rg09_candidate
SET status = ?, adjustment_id = ?, confirmation_request_id = ?
WHERE ledger_id = ? AND candidate_id = ?;

insertRg09CandidateStatus:
INSERT INTO rg09_candidate_status_history(
  ledger_id, candidate_id, status_sequence, status_id, status, occurred_at,
  adjustment_id, confirmation_request_id, operation_identity
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectRg09Candidate:
SELECT * FROM rg09_candidate WHERE ledger_id = ? AND candidate_id = ?;

selectRg09CandidateStatus:
SELECT status FROM rg09_candidate_status_history
WHERE ledger_id = ? AND candidate_id = ? ORDER BY status_sequence DESC LIMIT 1;

insertRg09Confirmation:
INSERT INTO rg09_confirmation(
  ledger_id, confirmation_id, request_id, role, confirmed_at, confirmed_at_text,
  created_at, created_at_text, target_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg09BalanceAdjustment:
INSERT INTO rg09_balance_adjustment(
  ledger_id, adjustment_id, transaction_id, observation_id, target_account_id,
  equity_account_id, currency_code, currency_precision, target_observed_at,
  target_observed_at_text, replayed_amount_minor, target_amount_minor,
  original_delta_minor
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg09AdjustmentHistory:
INSERT INTO rg09_adjustment_history(
  ledger_id, adjustment_id, history_sequence, history_id, state, occurred_at,
  occurred_at_text, created_at, created_at_text, allocation_id, remaining_amount_minor
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg09Allocation:
INSERT INTO rg09_allocation(
  ledger_id, allocation_id, adjustment_id, target_account_id, amount_minor,
  currency_code, currency_precision, real_transaction_id, reversal_transaction_id,
  confirmed_at, discovered_at, discovered_at_text, confirmed_at_text, created_at, created_at_text
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg09AuditLink:
INSERT INTO rg09_audit_link(
  ledger_id, audit_link_id, allocation_id, role, target_id, created_at, created_at_text
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg09PostingSemantic:
INSERT INTO rg09_posting_semantic(ledger_id, posting_id, role, reconciliation_eligible)
VALUES (?, ?, ?, ?);

insertRg09PostingReconciliation:
INSERT INTO rg09_posting_reconciliation(ledger_id, posting_id, status, latest_sequence)
VALUES (?, ?, ?, ?);

insertRg09ReconciliationHistory:
INSERT INTO rg09_reconciliation_history(
  ledger_id, posting_id, status_sequence, status, evidence_link_id
) VALUES (?, ?, ?, ?, ?);

updateRg09PostingReconciliation:
UPDATE rg09_posting_reconciliation
SET status = ?, latest_sequence = ?
WHERE ledger_id = ? AND posting_id = ?;

insertRg09FormalTransactionSource:
INSERT INTO rg09_formal_transaction_metadata(ledger_id, transaction_id, source_record_id)
VALUES (?, ?, ?)
ON CONFLICT (ledger_id, transaction_id) DO NOTHING;

selectRg09FormalTransactionSources:
SELECT transaction_id, source_record_id
FROM rg09_formal_transaction_metadata WHERE ledger_id = ?;

selectRg09AllOperations:
SELECT * FROM rg09_operation WHERE ledger_id = ? ORDER BY identity_value;

selectRg09AllSources:
SELECT * FROM rg09_source WHERE ledger_id = ? ORDER BY source_id;

selectRg09AllEvidence:
SELECT * FROM rg09_evidence WHERE ledger_id = ? ORDER BY evidence_id;

selectRg09AllEvidenceLinks:
SELECT * FROM rg09_evidence_link WHERE ledger_id = ? ORDER BY link_id;

selectRg09AllObservations:
SELECT * FROM rg09_observation WHERE ledger_id = ? ORDER BY observation_id;

selectRg09AllCandidates:
SELECT candidate.*, (
  SELECT status FROM rg09_candidate_status_history AS history
  WHERE history.ledger_id = candidate.ledger_id AND history.candidate_id = candidate.candidate_id
  ORDER BY status_sequence DESC LIMIT 1
) AS latest_status
FROM rg09_candidate AS candidate
WHERE candidate.ledger_id = ? ORDER BY candidate_id;

selectRg09AllCandidateHistory:
SELECT * FROM rg09_candidate_status_history WHERE ledger_id = ? ORDER BY candidate_id, status_sequence;

selectRg09AllConfirmations:
SELECT * FROM rg09_confirmation WHERE ledger_id = ? ORDER BY confirmation_id;

selectRg09AllAdjustments:
SELECT * FROM rg09_balance_adjustment WHERE ledger_id = ? ORDER BY adjustment_id;

selectRg09AllAdjustmentHistory:
SELECT * FROM rg09_adjustment_history WHERE ledger_id = ? ORDER BY adjustment_id, history_sequence;

selectRg09AllAllocations:
SELECT * FROM rg09_allocation WHERE ledger_id = ? ORDER BY allocation_id;

selectRg09AllAuditLinks:
SELECT * FROM rg09_audit_link WHERE ledger_id = ? ORDER BY audit_link_id;

selectRg09AllPostingSemantics:
SELECT * FROM rg09_posting_semantic WHERE ledger_id = ? ORDER BY posting_id;

selectRg09AllPostingReconciliations:
SELECT * FROM rg09_posting_reconciliation WHERE ledger_id = ? ORDER BY posting_id;

selectRg09AllReconciliationHistory:
SELECT * FROM rg09_reconciliation_history WHERE ledger_id = ? ORDER BY posting_id, status_sequence;

countRg09Operations:
SELECT count(*) FROM rg09_operation WHERE ledger_id = ?;

countRg09FormalTransactions:
SELECT count(*) FROM ledger_transaction WHERE ledger_id = ?;

selectRg09FormalTransactions:
SELECT tx.transaction_id, tx.ledger_id, COALESCE(tx.canonical_kind, tx.kind) AS kind,
       current_row.current_version_id
FROM ledger_transaction AS tx
JOIN ledger_transaction_current_version AS current_row
  ON current_row.ledger_id = tx.ledger_id AND current_row.transaction_id = tx.transaction_id
WHERE tx.ledger_id = ? ORDER BY tx.transaction_id;

selectRg09FormalVersions:
SELECT version_id, transaction_id, version_number, posting_set_id,
       occurred_at, statistics_at, effective_at, note
FROM transaction_version WHERE ledger_id = ? AND transaction_id = ? ORDER BY version_number;

selectRg09FormalPostingSets:
SELECT posting_set_id FROM posting_set WHERE ledger_id = ? ORDER BY posting_set_id;

selectRg09FormalPostings:
SELECT posting_id, posting_set_id, posting_index, account_id, amount_minor, currency_code, currency_precision
FROM posting WHERE ledger_id = ? AND posting_set_id = ? ORDER BY posting_index;

-- ============================================================
-- RG-10 additive owner tables (current-schema mirror of 12.sqm)
-- ============================================================
-- RG-10 additive owner: v12 -> v13. Existing formal rows and all prior
-- RG owners remain untouched.
CREATE TABLE rg10_operation (
  ledger_id TEXT NOT NULL,
  identity_value TEXT NOT NULL,
  action TEXT NOT NULL,
  operation_class TEXT NOT NULL,
  input_fingerprint TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('PENDING', 'ACCEPTED', 'NO_CHANGE', 'REJECTED')),
  reason_code TEXT,
  field_path TEXT,
  PRIMARY KEY (ledger_id, identity_value)
);
CREATE TABLE rg10_returned_id (
  ledger_id TEXT NOT NULL, identity_value TEXT NOT NULL, sequence INTEGER NOT NULL CHECK (sequence >= 0),
  id_kind TEXT NOT NULL, id_value TEXT NOT NULL,
  PRIMARY KEY (ledger_id, identity_value, sequence),
  FOREIGN KEY (ledger_id, identity_value) REFERENCES rg10_operation(ledger_id, identity_value) ON DELETE CASCADE
);
CREATE TABLE rg10_lot (
  ledger_id TEXT NOT NULL, lot_id TEXT NOT NULL PRIMARY KEY,
  recharge_transaction_id TEXT,
  loaded_at TEXT NOT NULL, loaded_at_text TEXT NOT NULL,
  expires_at TEXT NOT NULL, expires_at_text TEXT NOT NULL,
  face_value_minor INTEGER NOT NULL CHECK (face_value_minor > 0),
  remaining_face_value_minor INTEGER NOT NULL CHECK (remaining_face_value_minor >= 0),
  paid_amount_minor INTEGER CHECK (paid_amount_minor IS NULL OR paid_amount_minor > 0),
  bonus_amount_minor INTEGER CHECK (bonus_amount_minor IS NULL OR bonus_amount_minor >= 0),
  remaining_paid_amount_minor INTEGER,
  remaining_bonus_amount_minor INTEGER,
  composition_status TEXT NOT NULL CHECK (composition_status IN ('KNOWN', 'UNKNOWN', 'UNKNOWN_AFTER_UNALLOCATED_CONSUMPTION')),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  merchant_id TEXT,
  UNIQUE (ledger_id, lot_id),
  FOREIGN KEY (recharge_transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg10_lot_history (
  ledger_id TEXT NOT NULL, lot_id TEXT NOT NULL, history_sequence INTEGER NOT NULL CHECK (history_sequence > 0),
  history_id TEXT NOT NULL UNIQUE, event TEXT NOT NULL CHECK (event IN ('LOADED', 'SPENT', 'EXPIRED')),
  transaction_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL, remaining_face_value_minor INTEGER NOT NULL CHECK (remaining_face_value_minor >= 0),
  occurred_at TEXT NOT NULL, occurred_at_text TEXT NOT NULL,
  created_at TEXT NOT NULL, created_at_text TEXT NOT NULL,
  composition_status TEXT,
  PRIMARY KEY (ledger_id, lot_id, history_sequence),
  FOREIGN KEY (ledger_id, lot_id) REFERENCES rg10_lot(ledger_id, lot_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE rg10_source (
  ledger_id TEXT NOT NULL, source_id TEXT NOT NULL PRIMARY KEY, source_type TEXT NOT NULL,
  observed_at TEXT NOT NULL, observed_at_text TEXT NOT NULL,
  account_id TEXT, amount_minor INTEGER, lot_id TEXT,
  currency_code TEXT, currency_precision INTEGER CHECK (currency_precision IS NULL OR currency_precision >= 0),
  immutable_payload_digest TEXT NOT NULL,
  UNIQUE (ledger_id, source_id),
  FOREIGN KEY (ledger_id, lot_id) REFERENCES rg10_lot(ledger_id, lot_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg10_evidence (
  ledger_id TEXT NOT NULL, evidence_id TEXT NOT NULL PRIMARY KEY, source_id TEXT NOT NULL,
  evidence_type TEXT NOT NULL, observed_at TEXT NOT NULL, observed_at_text TEXT NOT NULL, UNIQUE (ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg10_source(ledger_id, source_id)
);
CREATE TABLE rg10_evidence_link (
  ledger_id TEXT NOT NULL, link_id TEXT NOT NULL PRIMARY KEY, source_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  target_kind TEXT NOT NULL CHECK (target_kind IN ('POSTING', 'DOMAIN_ENTITY', 'TRANSACTION')),
  target_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('BANK_PAYMENT_POSTING', 'STORED_VALUE_ASSET_POSTING', 'STORED_VALUE_LOT_FACT', 'STORED_VALUE_BONUS_COMPONENT', 'STORED_VALUE_EXPIRY_CONFIRMATION', 'STORED_VALUE_ACTIVATION_BALANCE_FACT')),
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'MATCHED')),
  lot_id TEXT,
  UNIQUE (ledger_id, link_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg10_source(ledger_id, source_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg10_evidence(ledger_id, evidence_id)
);
CREATE TABLE rg10_consumption (
  ledger_id TEXT NOT NULL, consumption_id TEXT NOT NULL PRIMARY KEY,
  allocation_id TEXT, source_id TEXT, evidence_id TEXT,
  lot_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
  resulting_remaining_face_value_minor INTEGER NOT NULL CHECK (resulting_remaining_face_value_minor >= 0),
  paid_bonus_composition TEXT NOT NULL CHECK (paid_bonus_composition IN ('UNKNOWN')),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  UNIQUE (ledger_id, consumption_id),
  FOREIGN KEY (ledger_id, lot_id) REFERENCES rg10_lot(ledger_id, lot_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg10_source(ledger_id, source_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg10_evidence(ledger_id, evidence_id)
);
CREATE TABLE rg10_allocation (
  ledger_id TEXT NOT NULL, allocation_id TEXT NOT NULL PRIMARY KEY,
  request_id TEXT NOT NULL, source_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  lot_id TEXT NOT NULL, consumption_id TEXT NOT NULL,
  amount_minor INTEGER NOT NULL CHECK (amount_minor > 0),
  allocation_source TEXT NOT NULL CHECK (allocation_source IN ('MERCHANT_EVIDENCE')),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  UNIQUE (ledger_id, allocation_id),
  FOREIGN KEY (ledger_id, lot_id) REFERENCES rg10_lot(ledger_id, lot_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg10_source(ledger_id, source_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg10_evidence(ledger_id, evidence_id)
);
CREATE TABLE rg10_confirmation (
  ledger_id TEXT NOT NULL, confirmation_id TEXT NOT NULL PRIMARY KEY, request_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('STORED_VALUE_RECHARGE_CONFIRMATION', 'STORED_VALUE_SPEND_CONFIRMATION', 'STORED_VALUE_EXPIRY_CONFIRMATION', 'STORED_VALUE_ACTIVATION_BALANCE_CONFIRMATION')),
  transaction_id TEXT NOT NULL,
  source_id TEXT, evidence_id TEXT, audit_link_id TEXT,
  confirmed_at TEXT NOT NULL, confirmed_at_text TEXT NOT NULL,
  explicit_confirmation INTEGER,
  confirms_actual_expiry INTEGER,
  UNIQUE (ledger_id, confirmation_id), UNIQUE (ledger_id, request_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg10_source(ledger_id, source_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg10_evidence(ledger_id, evidence_id)
);
CREATE TABLE rg10_activation_adjustment (
  ledger_id TEXT NOT NULL, adjustment_id TEXT NOT NULL PRIMARY KEY,
  transaction_id TEXT NOT NULL UNIQUE,
  activation_at TEXT NOT NULL, activation_at_text TEXT NOT NULL,
  existing_balance_minor INTEGER NOT NULL CHECK (existing_balance_minor > 0),
  composition_status TEXT NOT NULL CHECK (composition_status IN ('UNKNOWN')),
  replacement_status TEXT NOT NULL CHECK (replacement_status IN ('ACTIVE_UNTIL_REPLACED')),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  UNIQUE (ledger_id, adjustment_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg10_activation_adjustment_history (
  ledger_id TEXT NOT NULL, adjustment_id TEXT NOT NULL, history_sequence INTEGER NOT NULL CHECK (history_sequence > 0),
  history_id TEXT NOT NULL UNIQUE, event TEXT NOT NULL CHECK (event IN ('CREATED')),
  transaction_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL, occurred_at_text TEXT NOT NULL,
  created_at TEXT NOT NULL, created_at_text TEXT NOT NULL,
  PRIMARY KEY (ledger_id, adjustment_id, history_sequence),
  FOREIGN KEY (ledger_id, adjustment_id) REFERENCES rg10_activation_adjustment(ledger_id, adjustment_id)
);
CREATE TABLE rg10_reconstruction (
  ledger_id TEXT NOT NULL, reconstruction_id TEXT NOT NULL PRIMARY KEY,
  replacement_group_id TEXT NOT NULL,
  adjustment_transaction_id TEXT NOT NULL,
  active_mode TEXT NOT NULL CHECK (active_mode IN ('ADJUSTMENT', 'RECONSTRUCTED')),
  UNIQUE (ledger_id, reconstruction_id),
  FOREIGN KEY (adjustment_transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg10_reconstruction_history (
  ledger_id TEXT NOT NULL, reconstruction_id TEXT NOT NULL, history_sequence INTEGER NOT NULL CHECK (history_sequence > 0),
  history_id TEXT NOT NULL UNIQUE, event TEXT NOT NULL CHECK (event IN ('CREATED', 'ACTIVATED')),
  active_mode TEXT NOT NULL CHECK (active_mode IN ('ADJUSTMENT', 'RECONSTRUCTED')),
  occurred_at TEXT NOT NULL, occurred_at_text TEXT NOT NULL,
  created_at TEXT NOT NULL, created_at_text TEXT NOT NULL,
  PRIMARY KEY (ledger_id, reconstruction_id, history_sequence),
  FOREIGN KEY (ledger_id, reconstruction_id) REFERENCES rg10_reconstruction(ledger_id, reconstruction_id)
);
CREATE TABLE rg10_audit_link (
  ledger_id TEXT NOT NULL, audit_link_id TEXT NOT NULL PRIMARY KEY,
  role TEXT NOT NULL CHECK (role IN ('EXPLICIT_CONFIRMATION_PROVENANCE')),
  source_id TEXT, evidence_id TEXT, confirmation_id TEXT, transaction_id TEXT,
  UNIQUE (ledger_id, audit_link_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg10_source(ledger_id, source_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg10_evidence(ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, confirmation_id) REFERENCES rg10_confirmation(ledger_id, confirmation_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg10_candidate (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL PRIMARY KEY, request_id TEXT NOT NULL,
  candidate_type TEXT NOT NULL CHECK (candidate_type IN ('STORED_VALUE_RECHARGE', 'STORED_VALUE_SPEND')),
  status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION')),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  paid_amount_minor INTEGER, credited_amount_minor INTEGER, bonus_amount_minor INTEGER, amount_minor INTEGER,
  occurred_at TEXT, occurred_at_text TEXT,
  UNIQUE (ledger_id, candidate_id)
);
CREATE TABLE rg10_posting_semantic (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL PRIMARY KEY,
  role TEXT NOT NULL CHECK (role IN ('STORED_VALUE_ASSET', 'PAYMENT_OUT', 'BONUS_INCOME', 'STORED_VALUE_DEBIT', 'EXPENSE_OUT', 'EXPIRY_LOSS', 'PRE_ACTIVATION_ADJUSTMENT_EQUITY')),
  reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES posting(ledger_id, posting_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg10_posting_reconciliation (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL PRIMARY KEY,
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'MATCHED')), latest_sequence INTEGER NOT NULL CHECK (latest_sequence > 0),
  UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES rg10_posting_semantic(ledger_id, posting_id)
);
CREATE TABLE rg10_reconciliation_history (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL, status_sequence INTEGER NOT NULL CHECK (status_sequence > 0),
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'MATCHED')), evidence_link_id TEXT,
  PRIMARY KEY (ledger_id, posting_id, status_sequence),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES rg10_posting_reconciliation(ledger_id, posting_id),
  FOREIGN KEY (ledger_id, evidence_link_id) REFERENCES rg10_evidence_link(ledger_id, link_id)
);
CREATE TABLE rg10_formal_transaction_metadata (
  ledger_id TEXT NOT NULL, transaction_id TEXT NOT NULL, source_record_id TEXT,
  PRIMARY KEY (ledger_id, transaction_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, source_record_id) REFERENCES rg10_source(ledger_id, source_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TRIGGER rg10_source_guard_update BEFORE UPDATE ON rg10_source BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_source_guard_delete BEFORE DELETE ON rg10_source BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_evidence_guard_update BEFORE UPDATE ON rg10_evidence BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_evidence_guard_delete BEFORE DELETE ON rg10_evidence BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
-- Evidence links are typed edges; only the pending -> matched status transition is legal.
CREATE TRIGGER rg10_evidence_link_guard_update BEFORE UPDATE ON rg10_evidence_link BEGIN
  SELECT CASE WHEN old.status = 'PENDING' AND new.status = 'MATCHED'
    AND new.ledger_id = old.ledger_id AND new.link_id = old.link_id
    AND new.source_id = old.source_id AND new.evidence_id = old.evidence_id
    AND new.target_kind = old.target_kind AND new.target_id = old.target_id
    AND new.role = old.role AND new.lot_id IS old.lot_id
    THEN NULL ELSE RAISE(ABORT, 'rg10 evidence link immutable') END;
END;
CREATE TRIGGER rg10_evidence_link_guard_delete BEFORE DELETE ON rg10_evidence_link BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_lot_history_guard_update BEFORE UPDATE ON rg10_lot_history BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_lot_history_guard_delete BEFORE DELETE ON rg10_lot_history BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_consumption_guard_update BEFORE UPDATE ON rg10_consumption BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_consumption_guard_delete BEFORE DELETE ON rg10_consumption BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_allocation_guard_update BEFORE UPDATE ON rg10_allocation BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_allocation_guard_delete BEFORE DELETE ON rg10_allocation BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_confirmation_guard_update BEFORE UPDATE ON rg10_confirmation BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_confirmation_guard_delete BEFORE DELETE ON rg10_confirmation BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_audit_guard_update BEFORE UPDATE ON rg10_audit_link BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_audit_guard_delete BEFORE DELETE ON rg10_audit_link BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_candidate_guard_update BEFORE UPDATE ON rg10_candidate BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_candidate_guard_delete BEFORE DELETE ON rg10_candidate BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_activation_adjustment_guard_update BEFORE UPDATE ON rg10_activation_adjustment BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_activation_adjustment_guard_delete BEFORE DELETE ON rg10_activation_adjustment BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_activation_adjustment_history_guard_update BEFORE UPDATE ON rg10_activation_adjustment_history BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_activation_adjustment_history_guard_delete BEFORE DELETE ON rg10_activation_adjustment_history BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_reconstruction_guard_update BEFORE UPDATE ON rg10_reconstruction BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_reconstruction_guard_delete BEFORE DELETE ON rg10_reconstruction BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_reconstruction_history_guard_update BEFORE UPDATE ON rg10_reconstruction_history BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_reconstruction_history_guard_delete BEFORE DELETE ON rg10_reconstruction_history BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_operation_guard_delete BEFORE DELETE ON rg10_operation BEGIN SELECT RAISE(ABORT, 'rg10 operation immutable'); END;
CREATE TRIGGER rg10_operation_guard_update BEFORE UPDATE ON rg10_operation BEGIN
  SELECT CASE WHEN old.outcome = 'PENDING' AND new.outcome IN ('ACCEPTED', 'NO_CHANGE', 'REJECTED')
    AND new.ledger_id = old.ledger_id AND new.identity_value = old.identity_value
    AND new.action = old.action AND new.operation_class = old.operation_class
    AND new.input_fingerprint = old.input_fingerprint
    THEN NULL ELSE RAISE(ABORT, 'rg10 operation immutable') END;
END;
CREATE TRIGGER rg10_returned_id_guard_update BEFORE UPDATE ON rg10_returned_id BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_returned_id_guard_delete BEFORE DELETE ON rg10_returned_id BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_semantic_guard_update BEFORE UPDATE ON rg10_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_semantic_guard_delete BEFORE DELETE ON rg10_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_formal_metadata_guard_update BEFORE UPDATE ON rg10_formal_transaction_metadata BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_formal_metadata_guard_delete BEFORE DELETE ON rg10_formal_transaction_metadata BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
-- Lot facts are immutable; the remaining face value and composition are a guarded
-- current projection that must agree with the newest history row or a once-only
-- consumption row (each consumption records the remaining after it is applied).
CREATE TRIGGER rg10_lot_guard_update BEFORE UPDATE ON rg10_lot BEGIN
  SELECT CASE WHEN (
    old.ledger_id = new.ledger_id AND old.lot_id = new.lot_id
    AND old.recharge_transaction_id IS new.recharge_transaction_id
    AND old.loaded_at = new.loaded_at AND old.loaded_at_text = new.loaded_at_text
    AND old.expires_at = new.expires_at AND old.expires_at_text = new.expires_at_text
    AND old.face_value_minor = new.face_value_minor
    AND old.paid_amount_minor IS new.paid_amount_minor
    AND old.bonus_amount_minor IS new.bonus_amount_minor
    AND old.currency_code = new.currency_code AND old.currency_precision = new.currency_precision
    AND old.merchant_id IS new.merchant_id
    AND new.remaining_face_value_minor <= old.remaining_face_value_minor
    AND (
      (old.composition_status = new.composition_status
        AND old.remaining_paid_amount_minor IS new.remaining_paid_amount_minor
        AND old.remaining_bonus_amount_minor IS new.remaining_bonus_amount_minor)
      OR
      (old.composition_status = 'KNOWN' AND new.composition_status IN ('UNKNOWN', 'UNKNOWN_AFTER_UNALLOCATED_CONSUMPTION')
        AND new.remaining_paid_amount_minor IS NULL AND new.remaining_bonus_amount_minor IS NULL)
      OR
      (old.composition_status IN ('UNKNOWN', 'UNKNOWN_AFTER_UNALLOCATED_CONSUMPTION')
        AND new.composition_status = old.composition_status
        AND new.remaining_paid_amount_minor IS NULL AND new.remaining_bonus_amount_minor IS NULL)
    )
    AND (
      new.remaining_face_value_minor = old.remaining_face_value_minor
      OR EXISTS (
        SELECT 1 FROM rg10_lot_history AS history
        WHERE history.ledger_id = new.ledger_id AND history.lot_id = new.lot_id
          AND history.history_sequence = (SELECT MAX(latest.history_sequence) FROM rg10_lot_history AS latest WHERE latest.ledger_id = new.ledger_id AND latest.lot_id = new.lot_id)
          AND history.remaining_face_value_minor = new.remaining_face_value_minor
          AND history.event IN ('SPENT', 'EXPIRED')
      )
      OR EXISTS (
        SELECT 1 FROM rg10_consumption AS consumption
        WHERE consumption.ledger_id = new.ledger_id AND consumption.lot_id = new.lot_id
          AND consumption.resulting_remaining_face_value_minor = new.remaining_face_value_minor
          AND old.remaining_face_value_minor - consumption.amount_minor = new.remaining_face_value_minor
      )
    )
  ) THEN NULL ELSE RAISE(ABORT, 'rg10 lot current projection') END;
END;
CREATE TRIGGER rg10_lot_guard_delete BEFORE DELETE ON rg10_lot BEGIN SELECT RAISE(ABORT, 'rg10 immutable'); END;
CREATE TRIGGER rg10_lot_history_sequence BEFORE INSERT ON rg10_lot_history BEGIN SELECT CASE WHEN (new.history_sequence = 1 AND EXISTS (SELECT 1 FROM rg10_lot_history WHERE ledger_id = new.ledger_id AND lot_id = new.lot_id)) OR (new.history_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg10_lot_history WHERE ledger_id = new.ledger_id AND lot_id = new.lot_id AND history_sequence = new.history_sequence - 1)) THEN RAISE(ABORT, 'rg10 lot history sequence') END; END;
CREATE TRIGGER rg10_activation_adjustment_history_sequence BEFORE INSERT ON rg10_activation_adjustment_history BEGIN SELECT CASE WHEN (new.history_sequence = 1 AND EXISTS (SELECT 1 FROM rg10_activation_adjustment_history WHERE ledger_id = new.ledger_id AND adjustment_id = new.adjustment_id)) OR (new.history_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg10_activation_adjustment_history WHERE ledger_id = new.ledger_id AND adjustment_id = new.adjustment_id AND history_sequence = new.history_sequence - 1)) THEN RAISE(ABORT, 'rg10 activation history sequence') END; END;
CREATE TRIGGER rg10_reconstruction_history_sequence BEFORE INSERT ON rg10_reconstruction_history BEGIN SELECT CASE WHEN (new.history_sequence = 1 AND EXISTS (SELECT 1 FROM rg10_reconstruction_history WHERE ledger_id = new.ledger_id AND reconstruction_id = new.reconstruction_id)) OR (new.history_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg10_reconstruction_history WHERE ledger_id = new.ledger_id AND reconstruction_id = new.reconstruction_id AND history_sequence = new.history_sequence - 1)) THEN RAISE(ABORT, 'rg10 reconstruction history sequence') END; END;
CREATE TRIGGER rg10_reconciliation_history_sequence BEFORE INSERT ON rg10_reconciliation_history BEGIN SELECT CASE WHEN (new.status_sequence = 1 AND EXISTS (SELECT 1 FROM rg10_reconciliation_history WHERE ledger_id = new.ledger_id AND posting_id = new.posting_id)) OR (new.status_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg10_reconciliation_history WHERE ledger_id = new.ledger_id AND posting_id = new.posting_id AND status_sequence = new.status_sequence - 1)) THEN RAISE(ABORT, 'rg10 reconciliation history sequence') END; END;
CREATE TRIGGER rg10_lot_formal_owner_guard_insert BEFORE INSERT ON rg10_lot WHEN new.recharge_transaction_id IS NOT NULL BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.recharge_transaction_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_RECHARGE'
  ) THEN RAISE(ABORT, 'rg10 lot formal ownership') END;
END;
CREATE TRIGGER rg10_consumption_lot_guard_insert BEFORE INSERT ON rg10_consumption BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg10_lot AS lot WHERE lot.ledger_id = new.ledger_id AND lot.lot_id = new.lot_id
  ) THEN RAISE(ABORT, 'rg10 consumption lot ownership') END;
  SELECT CASE WHEN new.allocation_id IS NOT NULL AND NOT EXISTS (
    SELECT 1 FROM rg10_allocation AS allocation
    WHERE allocation.ledger_id = new.ledger_id AND allocation.allocation_id = new.allocation_id
      AND allocation.consumption_id = new.consumption_id
      AND allocation.lot_id = new.lot_id
      AND allocation.amount_minor = new.amount_minor
  ) THEN RAISE(ABORT, 'rg10 consumption allocation ownership') END;
  SELECT CASE WHEN (new.source_id IS NULL AND new.evidence_id IS NOT NULL) OR (new.source_id IS NOT NULL AND new.evidence_id IS NULL)
    THEN RAISE(ABORT, 'rg10 consumption provenance') END;
END;
-- A consumption records the remaining face value left after it is applied, so a lot
-- deduction can be validated against the row exactly once; a repeated deduction of the
-- same consumption row never matches a recorded resulting remaining.
CREATE TRIGGER rg10_consumption_resulting_guard_insert BEFORE INSERT ON rg10_consumption BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg10_lot AS lot
    WHERE lot.ledger_id = new.ledger_id AND lot.lot_id = new.lot_id
      AND lot.remaining_face_value_minor - new.amount_minor = new.resulting_remaining_face_value_minor
  ) THEN RAISE(ABORT, 'rg10 consumption resulting remaining mismatch') END;
END;
CREATE TRIGGER rg10_allocation_guard_insert BEFORE INSERT ON rg10_allocation BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg10_lot AS lot WHERE lot.ledger_id = new.ledger_id AND lot.lot_id = new.lot_id
  ) THEN RAISE(ABORT, 'rg10 allocation lot ownership') END;
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg10_source AS source WHERE source.ledger_id = new.ledger_id AND source.source_id = new.source_id
  ) THEN RAISE(ABORT, 'rg10 allocation source ownership') END;
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg10_evidence AS evidence
    WHERE evidence.ledger_id = new.ledger_id AND evidence.evidence_id = new.evidence_id AND evidence.source_id = new.source_id
  ) THEN RAISE(ABORT, 'rg10 allocation evidence ownership') END;
END;
CREATE TRIGGER rg10_confirmation_target_guard_insert BEFORE INSERT ON rg10_confirmation BEGIN
  SELECT CASE
    WHEN new.role = 'STORED_VALUE_RECHARGE_CONFIRMATION' AND EXISTS (
      SELECT 1 FROM ledger_transaction AS transaction_row
      WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
        AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_RECHARGE'
    ) THEN NULL
    WHEN new.role = 'STORED_VALUE_SPEND_CONFIRMATION' AND EXISTS (
      SELECT 1 FROM ledger_transaction AS transaction_row
      WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
        AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_SPEND'
    ) THEN NULL
    WHEN new.role = 'STORED_VALUE_EXPIRY_CONFIRMATION' AND new.confirms_actual_expiry = 1 AND EXISTS (
      SELECT 1 FROM ledger_transaction AS transaction_row
      WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
        AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_EXPIRY_LOSS'
    ) THEN NULL
    WHEN new.role = 'STORED_VALUE_ACTIVATION_BALANCE_CONFIRMATION' AND EXISTS (
      SELECT 1 FROM ledger_transaction AS transaction_row
      JOIN rg10_activation_adjustment AS adjustment
        ON adjustment.ledger_id = transaction_row.ledger_id AND adjustment.transaction_id = transaction_row.transaction_id
      WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
        AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_PRE_ACTIVATION_BALANCE_ADJUSTMENT'
    ) THEN NULL
    ELSE RAISE(ABORT, 'rg10 confirmation target ownership')
  END;
END;
CREATE TRIGGER rg10_activation_adjustment_formal_owner_guard_insert BEFORE INSERT ON rg10_activation_adjustment BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_PRE_ACTIVATION_BALANCE_ADJUSTMENT'
  ) THEN RAISE(ABORT, 'rg10 activation formal ownership') END;
END;
CREATE TRIGGER rg10_reconstruction_formal_owner_guard_insert BEFORE INSERT ON rg10_reconstruction BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.adjustment_transaction_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_PRE_ACTIVATION_BALANCE_ADJUSTMENT'
  ) THEN RAISE(ABORT, 'rg10 reconstruction formal ownership') END;
END;
CREATE TRIGGER rg10_audit_link_target_guard_insert BEFORE INSERT ON rg10_audit_link BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg10_confirmation AS confirmation
    WHERE confirmation.ledger_id = new.ledger_id AND confirmation.confirmation_id = new.confirmation_id
      AND confirmation.audit_link_id = new.audit_link_id
      AND confirmation.source_id IS new.source_id AND confirmation.evidence_id IS new.evidence_id
      AND confirmation.transaction_id IS new.transaction_id
  ) THEN RAISE(ABORT, 'rg10 audit link target mismatch') END;
END;
CREATE TRIGGER rg10_posting_semantic_formal_owner_guard_insert BEFORE INSERT ON rg10_posting_semantic BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM posting AS posting_row
    JOIN transaction_version AS version_row
      ON version_row.ledger_id = posting_row.ledger_id AND version_row.posting_set_id = posting_row.posting_set_id
    JOIN ledger_transaction_current_version AS current_row
      ON current_row.ledger_id = version_row.ledger_id AND current_row.transaction_id = version_row.transaction_id
     AND current_row.current_version_id = version_row.version_id
    JOIN ledger_transaction AS transaction_row
      ON transaction_row.ledger_id = current_row.ledger_id AND transaction_row.transaction_id = current_row.transaction_id
    WHERE posting_row.ledger_id = new.ledger_id AND posting_row.posting_id = new.posting_id
      AND (
        (new.role = 'STORED_VALUE_ASSET' AND new.reconciliation_eligible = 1
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) IN ('STORED_VALUE_RECHARGE', 'STORED_VALUE_PRE_ACTIVATION_BALANCE_ADJUSTMENT'))
        OR (new.role = 'PAYMENT_OUT' AND new.reconciliation_eligible = 1
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_RECHARGE')
        OR (new.role = 'BONUS_INCOME' AND new.reconciliation_eligible = 0
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_RECHARGE')
        OR (new.role = 'STORED_VALUE_DEBIT' AND new.reconciliation_eligible = 1
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) IN ('STORED_VALUE_SPEND', 'STORED_VALUE_EXPIRY_LOSS'))
        OR (new.role = 'EXPENSE_OUT' AND new.reconciliation_eligible = 0
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_SPEND')
        OR (new.role = 'EXPIRY_LOSS' AND new.reconciliation_eligible = 0
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_EXPIRY_LOSS')
        OR (new.role = 'PRE_ACTIVATION_ADJUSTMENT_EQUITY' AND new.reconciliation_eligible = 0
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_PRE_ACTIVATION_BALANCE_ADJUSTMENT')
      )
  ) THEN RAISE(ABORT, 'rg10 posting formal ownership') END;
END;
CREATE TRIGGER rg10_reconciliation_current_guard_insert BEFORE INSERT ON rg10_posting_reconciliation BEGIN
  SELECT CASE WHEN new.status != 'PENDING' OR new.latest_sequence != 1 OR NOT EXISTS (
    SELECT 1 FROM rg10_posting_semantic AS semantic
    WHERE semantic.ledger_id = new.ledger_id AND semantic.posting_id = new.posting_id
      AND semantic.role IN ('STORED_VALUE_ASSET', 'PAYMENT_OUT', 'STORED_VALUE_DEBIT')
      AND semantic.reconciliation_eligible = 1
  ) THEN RAISE(ABORT, 'rg10 reconciliation current ownership') END;
END;
CREATE TRIGGER rg10_reconciliation_current_guard_update BEFORE UPDATE ON rg10_posting_reconciliation BEGIN
  SELECT CASE WHEN new.ledger_id = old.ledger_id AND new.posting_id = old.posting_id
    AND old.status = 'PENDING' AND new.status = 'MATCHED'
    AND new.latest_sequence = old.latest_sequence + 1
    AND EXISTS (
      SELECT 1 FROM rg10_reconciliation_history AS history
      WHERE history.ledger_id = new.ledger_id AND history.posting_id = new.posting_id
        AND history.status_sequence = new.latest_sequence
        AND history.status = new.status
        AND history.evidence_link_id IS NOT NULL
    ) THEN NULL ELSE RAISE(ABORT, 'rg10 reconciliation current transition') END;
END;
CREATE TRIGGER rg10_reconciliation_current_guard_delete BEFORE DELETE ON rg10_posting_reconciliation BEGIN SELECT RAISE(ABORT, 'rg10 reconciliation current immutable'); END;
-- Evidence links are typed edges, not free-form labels. Keep the target, role,
-- source lineage, and status consistent even when callers bypass the adapter.
CREATE TRIGGER rg10_evidence_link_target_guard_insert BEFORE INSERT ON rg10_evidence_link BEGIN
  SELECT CASE
    WHEN new.target_kind = 'POSTING' AND new.role = 'BANK_PAYMENT_POSTING' AND new.status IN ('PENDING', 'MATCHED')
      AND EXISTS (
        SELECT 1 FROM rg10_posting_semantic AS semantic
        WHERE semantic.ledger_id = new.ledger_id AND semantic.posting_id = new.target_id
          AND semantic.role = 'PAYMENT_OUT' AND semantic.reconciliation_eligible = 1
      ) THEN NULL
    WHEN new.target_kind = 'POSTING' AND new.role = 'STORED_VALUE_ASSET_POSTING' AND new.status IN ('PENDING', 'MATCHED')
      AND EXISTS (
        SELECT 1 FROM rg10_posting_semantic AS semantic
        WHERE semantic.ledger_id = new.ledger_id AND semantic.posting_id = new.target_id
          AND semantic.role = 'STORED_VALUE_ASSET' AND semantic.reconciliation_eligible = 1
      ) THEN NULL
    WHEN new.target_kind = 'DOMAIN_ENTITY' AND new.role = 'STORED_VALUE_LOT_FACT' AND new.status = 'PENDING'
      AND new.lot_id = new.target_id
      AND EXISTS (
        SELECT 1 FROM rg10_lot AS lot WHERE lot.ledger_id = new.ledger_id AND lot.lot_id = new.target_id
      ) THEN NULL
    WHEN new.target_kind = 'DOMAIN_ENTITY' AND new.role = 'STORED_VALUE_BONUS_COMPONENT' AND new.status = 'PENDING'
      AND new.lot_id = new.target_id
      AND EXISTS (
        SELECT 1 FROM rg10_lot AS lot WHERE lot.ledger_id = new.ledger_id AND lot.lot_id = new.target_id
      ) THEN NULL
    WHEN new.target_kind = 'TRANSACTION' AND new.role = 'STORED_VALUE_EXPIRY_CONFIRMATION' AND new.status = 'PENDING'
      AND EXISTS (
        SELECT 1 FROM ledger_transaction AS transaction_row
        WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.target_id
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'STORED_VALUE_EXPIRY_LOSS'
      ) THEN NULL
    WHEN new.target_kind = 'DOMAIN_ENTITY' AND new.role = 'STORED_VALUE_ACTIVATION_BALANCE_FACT' AND new.status = 'PENDING'
      AND EXISTS (
        SELECT 1 FROM rg10_activation_adjustment AS adjustment
        WHERE adjustment.ledger_id = new.ledger_id AND adjustment.adjustment_id = new.target_id
      ) THEN NULL
    ELSE RAISE(ABORT, 'rg10 evidence link target mismatch')
  END;
END;
CREATE TRIGGER rg10_evidence_link_lineage_guard_insert BEFORE INSERT ON rg10_evidence_link BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg10_evidence AS evidence
    WHERE evidence.ledger_id = new.ledger_id AND evidence.evidence_id = new.evidence_id
      AND evidence.source_id = new.source_id
  ) THEN RAISE(ABORT, 'rg10 evidence link lineage mismatch') END;
END;
CREATE TRIGGER rg10_reconciliation_history_evidence_guard_insert BEFORE INSERT ON rg10_reconciliation_history WHEN new.evidence_link_id IS NOT NULL BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg10_evidence_link AS link
    WHERE link.ledger_id = new.ledger_id AND link.link_id = new.evidence_link_id
      AND link.target_kind = 'POSTING' AND link.target_id = new.posting_id
      AND link.role IN ('BANK_PAYMENT_POSTING', 'STORED_VALUE_ASSET_POSTING')
      AND link.status = 'MATCHED'
  ) THEN RAISE(ABORT, 'rg10 reconciliation evidence target mismatch') END;
END;

selectRg10Operation:
SELECT * FROM rg10_operation WHERE ledger_id = ? AND identity_value = ?;

insertRg10Operation:
INSERT INTO rg10_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome,
  reason_code, field_path
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

claimRg10Operation:
INSERT INTO rg10_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome
) VALUES (?, ?, ?, ?, ?, 'PENDING')
ON CONFLICT (ledger_id, identity_value) DO NOTHING;

updateRg10OperationResult:
UPDATE rg10_operation
SET outcome = ?, reason_code = ?, field_path = ?
WHERE ledger_id = ? AND identity_value = ?;

insertRg10ReturnedId:
INSERT INTO rg10_returned_id(ledger_id, identity_value, sequence, id_kind, id_value)
VALUES (?, ?, ?, ?, ?);

selectRg10ReturnedIds:
SELECT id_kind, id_value FROM rg10_returned_id
WHERE ledger_id = ? AND identity_value = ? ORDER BY sequence;

insertRg10Source:
INSERT INTO rg10_source(
  ledger_id, source_id, source_type, observed_at, observed_at_text,
  account_id, amount_minor, lot_id, currency_code, currency_precision, immutable_payload_digest
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg10Evidence:
INSERT INTO rg10_evidence(ledger_id, evidence_id, source_id, evidence_type, observed_at, observed_at_text)
VALUES (?, ?, ?, ?, ?, ?);

insertRg10EvidenceLink:
INSERT INTO rg10_evidence_link(
  ledger_id, link_id, source_id, evidence_id, target_kind, target_id, role, status, lot_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRg10EvidenceLinkStatus:
UPDATE rg10_evidence_link SET status = ? WHERE ledger_id = ? AND link_id = ?;

insertRg10Lot:
INSERT INTO rg10_lot(
  ledger_id, lot_id, recharge_transaction_id, loaded_at, loaded_at_text,
  expires_at, expires_at_text, face_value_minor, remaining_face_value_minor,
  paid_amount_minor, bonus_amount_minor, remaining_paid_amount_minor,
  remaining_bonus_amount_minor, composition_status, currency_code, currency_precision, merchant_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg10LotHistory:
INSERT INTO rg10_lot_history(
  ledger_id, lot_id, history_sequence, history_id, event, transaction_id,
  amount_minor, remaining_face_value_minor, occurred_at, occurred_at_text,
  created_at, created_at_text, composition_status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateRg10LotRemaining:
UPDATE rg10_lot
SET remaining_face_value_minor = ?, remaining_paid_amount_minor = ?,
    remaining_bonus_amount_minor = ?, composition_status = ?
WHERE ledger_id = ? AND lot_id = ?;

insertRg10Consumption:
INSERT INTO rg10_consumption(
  ledger_id, consumption_id, allocation_id, source_id, evidence_id, lot_id,
  amount_minor, resulting_remaining_face_value_minor, paid_bonus_composition, currency_code, currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg10Allocation:
INSERT INTO rg10_allocation(
  ledger_id, allocation_id, request_id, source_id, evidence_id, lot_id,
  consumption_id, amount_minor, allocation_source, currency_code, currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg10Confirmation:
INSERT INTO rg10_confirmation(
  ledger_id, confirmation_id, request_id, role, transaction_id,
  source_id, evidence_id, audit_link_id, confirmed_at, confirmed_at_text,
  explicit_confirmation, confirms_actual_expiry
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg10ActivationAdjustment:
INSERT INTO rg10_activation_adjustment(
  ledger_id, adjustment_id, transaction_id, activation_at, activation_at_text,
  existing_balance_minor, composition_status, replacement_status,
  currency_code, currency_precision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg10ActivationAdjustmentHistory:
INSERT INTO rg10_activation_adjustment_history(
  ledger_id, adjustment_id, history_sequence, history_id, event, transaction_id,
  occurred_at, occurred_at_text, created_at, created_at_text
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg10Reconstruction:
INSERT INTO rg10_reconstruction(
  ledger_id, reconstruction_id, replacement_group_id, adjustment_transaction_id, active_mode
) VALUES (?, ?, ?, ?, ?);

insertRg10ReconstructionHistory:
INSERT INTO rg10_reconstruction_history(
  ledger_id, reconstruction_id, history_sequence, history_id, event, active_mode,
  occurred_at, occurred_at_text, created_at, created_at_text
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg10AuditLink:
INSERT INTO rg10_audit_link(
  ledger_id, audit_link_id, role, source_id, evidence_id, confirmation_id, transaction_id
) VALUES (?, ?, ?, ?, ?, ?, ?);

insertRg10Candidate:
INSERT INTO rg10_candidate(
  ledger_id, candidate_id, request_id, candidate_type, status,
  currency_code, currency_precision, paid_amount_minor, credited_amount_minor,
  bonus_amount_minor, amount_minor, occurred_at, occurred_at_text
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertRg10PostingSemantic:
INSERT INTO rg10_posting_semantic(ledger_id, posting_id, role, reconciliation_eligible)
VALUES (?, ?, ?, ?);

insertRg10PostingReconciliation:
INSERT INTO rg10_posting_reconciliation(ledger_id, posting_id, status, latest_sequence)
VALUES (?, ?, ?, ?);

insertRg10ReconciliationHistory:
INSERT INTO rg10_reconciliation_history(
  ledger_id, posting_id, status_sequence, status, evidence_link_id
) VALUES (?, ?, ?, ?, ?);

updateRg10PostingReconciliation:
UPDATE rg10_posting_reconciliation
SET status = ?, latest_sequence = ?
WHERE ledger_id = ? AND posting_id = ?;

insertRg10FormalTransactionSource:
INSERT INTO rg10_formal_transaction_metadata(ledger_id, transaction_id, source_record_id)
VALUES (?, ?, ?)
ON CONFLICT (ledger_id, transaction_id) DO NOTHING;

selectRg10FormalTransactionSources:
SELECT transaction_id, source_record_id
FROM rg10_formal_transaction_metadata WHERE ledger_id = ?;

selectRg10AllOperations:
SELECT * FROM rg10_operation WHERE ledger_id = ? ORDER BY identity_value;

selectRg10AllSources:
SELECT * FROM rg10_source WHERE ledger_id = ? ORDER BY source_id;

selectRg10AllEvidence:
SELECT * FROM rg10_evidence WHERE ledger_id = ? ORDER BY evidence_id;

selectRg10AllEvidenceLinks:
SELECT * FROM rg10_evidence_link WHERE ledger_id = ? ORDER BY link_id;

selectRg10AllLots:
SELECT * FROM rg10_lot WHERE ledger_id = ? ORDER BY lot_id;

selectRg10AllLotHistory:
SELECT * FROM rg10_lot_history WHERE ledger_id = ? ORDER BY lot_id, history_sequence;

selectRg10AllConsumptions:
SELECT * FROM rg10_consumption WHERE ledger_id = ? ORDER BY consumption_id;

selectRg10AllAllocations:
SELECT * FROM rg10_allocation WHERE ledger_id = ? ORDER BY allocation_id;

selectRg10AllConfirmations:
SELECT * FROM rg10_confirmation WHERE ledger_id = ? ORDER BY confirmation_id;

selectRg10AllActivationAdjustments:
SELECT * FROM rg10_activation_adjustment WHERE ledger_id = ? ORDER BY adjustment_id;

selectRg10AllActivationAdjustmentHistory:
SELECT * FROM rg10_activation_adjustment_history WHERE ledger_id = ? ORDER BY adjustment_id, history_sequence;

selectRg10AllReconstructions:
SELECT * FROM rg10_reconstruction WHERE ledger_id = ? ORDER BY reconstruction_id;

selectRg10AllReconstructionHistory:
SELECT * FROM rg10_reconstruction_history WHERE ledger_id = ? ORDER BY reconstruction_id, history_sequence;

selectRg10AllAuditLinks:
SELECT * FROM rg10_audit_link WHERE ledger_id = ? ORDER BY audit_link_id;

selectRg10AllCandidates:
SELECT * FROM rg10_candidate WHERE ledger_id = ? ORDER BY candidate_id;

selectRg10AllPostingSemantics:
SELECT * FROM rg10_posting_semantic WHERE ledger_id = ? ORDER BY posting_id;

selectRg10AllPostingReconciliations:
SELECT * FROM rg10_posting_reconciliation WHERE ledger_id = ? ORDER BY posting_id;

selectRg10AllReconciliationHistory:
SELECT * FROM rg10_reconciliation_history WHERE ledger_id = ? ORDER BY posting_id, status_sequence;

countRg10Operations:
SELECT count(*) FROM rg10_operation WHERE ledger_id = ?;

countRg10FormalTransactions:
SELECT count(*)
FROM ledger_transaction WHERE ledger_id = ?;

selectRg10FormalTransactions:
SELECT tx.transaction_id, tx.ledger_id, COALESCE(tx.canonical_kind, tx.kind) AS kind,
       current_row.current_version_id
FROM ledger_transaction AS tx
JOIN ledger_transaction_current_version AS current_row
  ON current_row.ledger_id = tx.ledger_id AND current_row.transaction_id = tx.transaction_id
WHERE tx.ledger_id = ? ORDER BY tx.transaction_id;

selectRg10FormalVersions:
SELECT version_id, transaction_id, version_number, posting_set_id,
       occurred_at, statistics_at, effective_at, note
FROM transaction_version WHERE ledger_id = ? AND transaction_id = ? ORDER BY version_number;

selectRg10FormalPostingSets:
SELECT posting_set_id FROM posting_set WHERE ledger_id = ? ORDER BY posting_set_id;

selectRg10FormalPostings:
SELECT posting_id, posting_set_id, posting_index, account_id, amount_minor, currency_code, currency_precision
FROM posting WHERE ledger_id = ? AND posting_set_id = ? ORDER BY posting_index;

-- ============================================================
-- RG-08 additive owner tables (current-schema mirror of 14.sqm)
-- ============================================================
-- RG-08 additive owner: v14 -> v15. Existing formal rows and all prior
-- RG owners remain untouched (D-084, aligned with the RG-10 additive pattern).
CREATE TABLE rg08_operation (
  ledger_id TEXT NOT NULL,
  identity_value TEXT NOT NULL,
  action TEXT NOT NULL,
  operation_class TEXT NOT NULL,
  input_fingerprint TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('PENDING', 'ACCEPTED', 'NO_CHANGE', 'REJECTED')),
  reason_code TEXT,
  field_path TEXT,
  PRIMARY KEY (ledger_id, identity_value)
);
CREATE TABLE rg08_returned_id (
  ledger_id TEXT NOT NULL, identity_value TEXT NOT NULL, sequence INTEGER NOT NULL CHECK (sequence >= 0),
  id_kind TEXT NOT NULL, id_value TEXT NOT NULL,
  PRIMARY KEY (ledger_id, identity_value, sequence),
  FOREIGN KEY (ledger_id, identity_value) REFERENCES rg08_operation(ledger_id, identity_value) ON DELETE CASCADE
);
CREATE TABLE rg08_position (
  ledger_id TEXT NOT NULL, position_id TEXT NOT NULL PRIMARY KEY,
  counterparty_id TEXT NOT NULL,
  receivable_account_id TEXT NOT NULL,
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  principal_balance_minor INTEGER NOT NULL CHECK (principal_balance_minor >= 0),
  allocation_scope TEXT NOT NULL CHECK (allocation_scope IN ('PERSON_LEVEL_NET_POSITION')),
  contract_allocation_enabled INTEGER NOT NULL CHECK (contract_allocation_enabled = 0),
  UNIQUE (ledger_id, position_id)
);
CREATE TABLE rg08_position_history (
  ledger_id TEXT NOT NULL, position_id TEXT NOT NULL, history_sequence INTEGER NOT NULL CHECK (history_sequence > 0),
  history_id TEXT NOT NULL UNIQUE,
  behavior_code TEXT NOT NULL CHECK (behavior_code IN ('LEND', 'COLLECT')),
  amount_minor INTEGER NOT NULL,
  principal_balance_after_minor INTEGER NOT NULL CHECK (principal_balance_after_minor >= 0),
  transaction_id TEXT NOT NULL,
  occurred_at TEXT NOT NULL,
  PRIMARY KEY (ledger_id, position_id, history_sequence),
  FOREIGN KEY (ledger_id, position_id) REFERENCES rg08_position(ledger_id, position_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg08_settlement (
  ledger_id TEXT NOT NULL, settlement_id TEXT NOT NULL PRIMARY KEY,
  behavior_code TEXT NOT NULL CHECK (behavior_code IN ('COLLECT')),
  counterparty_id TEXT NOT NULL,
  linked_position_id TEXT NOT NULL,
  allocated_lend_transaction_id TEXT CHECK (allocated_lend_transaction_id IS NULL),
  transaction_id TEXT NOT NULL,
  destination_account_id TEXT NOT NULL,
  interest_category_id TEXT NOT NULL,
  total_received_minor INTEGER NOT NULL CHECK (total_received_minor > 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  actual_receipt_at TEXT NOT NULL,
  confirmed_at TEXT NOT NULL,
  UNIQUE (ledger_id, settlement_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, linked_position_id) REFERENCES rg08_position(ledger_id, position_id)
);
CREATE TABLE rg08_settlement_component (
  ledger_id TEXT NOT NULL, settlement_id TEXT NOT NULL, component_index INTEGER NOT NULL CHECK (component_index >= 0),
  component_id TEXT NOT NULL,
  kind TEXT NOT NULL CHECK (kind IN ('PRINCIPAL', 'INTEREST', 'FEE')),
  amount_minor INTEGER NOT NULL CHECK (amount_minor >= 0),
  posting_id TEXT,
  PRIMARY KEY (ledger_id, settlement_id, component_index),
  UNIQUE (ledger_id, component_id),
  UNIQUE (ledger_id, settlement_id, kind),
  FOREIGN KEY (ledger_id, settlement_id) REFERENCES rg08_settlement(ledger_id, settlement_id),
  FOREIGN KEY (posting_id, ledger_id) REFERENCES posting(posting_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg08_settlement_history (
  ledger_id TEXT NOT NULL, settlement_id TEXT NOT NULL, history_sequence INTEGER NOT NULL CHECK (history_sequence > 0),
  history_id TEXT NOT NULL UNIQUE,
  status TEXT NOT NULL CHECK (status IN ('CONFIRMED')),
  occurred_at TEXT NOT NULL,
  transaction_id TEXT NOT NULL,
  formal_effect_count INTEGER NOT NULL CHECK (formal_effect_count >= 0),
  PRIMARY KEY (ledger_id, settlement_id, history_sequence),
  FOREIGN KEY (ledger_id, settlement_id) REFERENCES rg08_settlement(ledger_id, settlement_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg08_candidate (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL PRIMARY KEY,
  type TEXT NOT NULL,
  status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION', 'CONFIRMED')),
  proposed_total_received_minor INTEGER NOT NULL CHECK (proposed_total_received_minor > 0),
  proposed_principal_amount_minor INTEGER CHECK (proposed_principal_amount_minor IS NULL OR proposed_principal_amount_minor >= 0),
  proposed_interest_amount_minor INTEGER CHECK (proposed_interest_amount_minor IS NULL OR proposed_interest_amount_minor >= 0),
  proposed_fee_amount_minor INTEGER CHECK (proposed_fee_amount_minor IS NULL OR proposed_fee_amount_minor >= 0),
  currency_code TEXT NOT NULL, currency_precision INTEGER NOT NULL CHECK (currency_precision >= 0),
  proposed_destination_account_id TEXT,
  proposed_actual_receipt_at TEXT,
  proposed_behavior_code TEXT,
  proposed_counterparty_id TEXT,
  bank_evidence_proves_component_split INTEGER NOT NULL CHECK (bank_evidence_proves_component_split = 0),
  expected_interest_may_confirm_split INTEGER NOT NULL CHECK (expected_interest_may_confirm_split = 0),
  name_match_may_confirm_counterparty INTEGER NOT NULL CHECK (name_match_may_confirm_counterparty = 0),
  rule_version INTEGER NOT NULL,
  confidence TEXT NOT NULL,
  UNIQUE (ledger_id, candidate_id)
);
CREATE TABLE rg08_candidate_status_history (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, status_sequence INTEGER NOT NULL CHECK (status_sequence > 0),
  history_id TEXT NOT NULL UNIQUE,
  status TEXT NOT NULL CHECK (status IN ('PENDING_CONFIRMATION', 'CONFIRMED')),
  occurred_at TEXT NOT NULL,
  formal_effect_count INTEGER NOT NULL CHECK (formal_effect_count >= 0),
  PRIMARY KEY (ledger_id, candidate_id, status_sequence),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg08_candidate(ledger_id, candidate_id)
);
CREATE TABLE rg08_source_record (
  ledger_id TEXT NOT NULL, source_id TEXT NOT NULL PRIMARY KEY,
  source_record_id TEXT NOT NULL,
  kind TEXT NOT NULL CHECK (kind IN ('BANK_DEBIT', 'BANK_CREDIT', 'BANK_CREDIT_MIRROR', 'LENDING_AGREEMENT', 'EXPLICIT_MANUAL_LENDING_CONFIRMATION')),
  observed_at TEXT NOT NULL,
  booking_at TEXT, value_at TEXT,
  account_id TEXT,
  counterparty_id TEXT,
  amount_minor INTEGER,
  currency_code TEXT, currency_precision INTEGER CHECK (currency_precision IS NULL OR currency_precision >= 0),
  original_source_payload_hash TEXT,
  immutable_payload_hash TEXT NOT NULL,
  mirror_of_source_id TEXT,
  UNIQUE (ledger_id, source_id),
  CHECK (kind NOT IN ('BANK_DEBIT', 'BANK_CREDIT') OR (booking_at IS NOT NULL AND value_at IS NOT NULL AND amount_minor IS NOT NULL AND currency_code IS NOT NULL AND currency_precision IS NOT NULL)),
  CHECK (amount_minor IS NULL OR currency_code IS NOT NULL),
  CHECK (original_source_payload_hash IS NULL OR original_source_payload_hash = immutable_payload_hash),
  CHECK (kind != 'LENDING_AGREEMENT' OR counterparty_id IS NOT NULL)
);
CREATE TABLE rg08_candidate_source (
  ledger_id TEXT NOT NULL, candidate_id TEXT NOT NULL, source_index INTEGER NOT NULL CHECK (source_index >= 0),
  source_id TEXT NOT NULL,
  PRIMARY KEY (ledger_id, candidate_id, source_index),
  UNIQUE (ledger_id, candidate_id, source_id),
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg08_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg08_source_record(ledger_id, source_id)
);
CREATE TABLE rg08_confirmation (
  ledger_id TEXT NOT NULL, confirmation_id TEXT NOT NULL PRIMARY KEY, confirmation_request_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('LENDING_EVENT_CONFIRMATION', 'LENDING_SETTLEMENT_CONFIRMATION')),
  transaction_id TEXT NOT NULL,
  counterparty_id TEXT NOT NULL,
  confirmed_at TEXT NOT NULL,
  candidate_id TEXT,
  settlement_id TEXT,
  UNIQUE (ledger_id, confirmation_id), UNIQUE (ledger_id, confirmation_request_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, candidate_id) REFERENCES rg08_candidate(ledger_id, candidate_id),
  FOREIGN KEY (ledger_id, settlement_id) REFERENCES rg08_settlement(ledger_id, settlement_id)
);
CREATE TABLE rg08_evidence (
  ledger_id TEXT NOT NULL, evidence_id TEXT NOT NULL PRIMARY KEY, source_id TEXT NOT NULL,
  evidence_type TEXT NOT NULL CHECK (evidence_type IN ('ASSET_DEBIT', 'ASSET_CREDIT', 'ASSET_CREDIT_MIRROR', 'LENDING_AGREEMENT')),
  observed_at TEXT NOT NULL,
  UNIQUE (ledger_id, evidence_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg08_source_record(ledger_id, source_id)
);
CREATE TABLE rg08_evidence_link (
  ledger_id TEXT NOT NULL, link_id TEXT NOT NULL PRIMARY KEY, source_id TEXT NOT NULL, evidence_id TEXT NOT NULL,
  target_kind TEXT NOT NULL CHECK (target_kind IN ('POSTING', 'POSITION')),
  target_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('DESTINATION_ASSET_POSTING', 'FUNDING_ASSET_POSTING', 'COUNTERPARTY_LENDING_RELATIONSHIP')),
  status TEXT NOT NULL CHECK (status IN ('MATCHED', 'SUPPORTED', 'MERGED')),
  UNIQUE (ledger_id, link_id),
  FOREIGN KEY (ledger_id, source_id) REFERENCES rg08_source_record(ledger_id, source_id),
  FOREIGN KEY (ledger_id, evidence_id) REFERENCES rg08_evidence(ledger_id, evidence_id)
);
CREATE TABLE rg08_audit_link (
  ledger_id TEXT NOT NULL, audit_link_id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('MIRROR_OF_EVIDENCE', 'MERGED_INTO_EVIDENCE_LINK')),
  from_id TEXT NOT NULL,
  to_id TEXT NOT NULL,
  UNIQUE (ledger_id, audit_link_id)
);
CREATE TABLE rg08_posting_semantic (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL PRIMARY KEY,
  role TEXT NOT NULL CHECK (role IN ('RECEIVABLE', 'FUNDING_OUT', 'DESTINATION_IN', 'PRINCIPAL_OUT', 'INTEREST_OUT')),
  reconciliation_eligible INTEGER NOT NULL CHECK (reconciliation_eligible IN (0, 1)), UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES posting(ledger_id, posting_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg08_posting_reconciliation (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL PRIMARY KEY,
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'MATCHED')), latest_sequence INTEGER NOT NULL CHECK (latest_sequence > 0),
  UNIQUE (ledger_id, posting_id),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES rg08_posting_semantic(ledger_id, posting_id)
);
CREATE TABLE rg08_reconciliation_history (
  ledger_id TEXT NOT NULL, posting_id TEXT NOT NULL, status_sequence INTEGER NOT NULL CHECK (status_sequence > 0),
  status TEXT NOT NULL CHECK (status IN ('PENDING', 'MATCHED')), evidence_link_id TEXT,
  PRIMARY KEY (ledger_id, posting_id, status_sequence),
  FOREIGN KEY (ledger_id, posting_id) REFERENCES rg08_posting_reconciliation(ledger_id, posting_id),
  FOREIGN KEY (ledger_id, evidence_link_id) REFERENCES rg08_evidence_link(ledger_id, link_id)
);
CREATE TABLE rg08_formal_transaction_metadata (
  ledger_id TEXT NOT NULL, transaction_id TEXT NOT NULL, source_record_id TEXT,
  PRIMARY KEY (ledger_id, transaction_id),
  FOREIGN KEY (transaction_id, ledger_id) REFERENCES ledger_transaction(transaction_id, ledger_id) DEFERRABLE INITIALLY DEFERRED,
  FOREIGN KEY (ledger_id, source_record_id) REFERENCES rg08_source_record(ledger_id, source_id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE rg08_name_history (
  ledger_id TEXT NOT NULL, counterparty_id TEXT NOT NULL, history_sequence INTEGER NOT NULL CHECK (history_sequence > 0),
  name_history_id TEXT NOT NULL UNIQUE,
  display_name TEXT NOT NULL,
  PRIMARY KEY (ledger_id, counterparty_id, history_sequence)
);
CREATE TRIGGER rg08_source_record_guard_update BEFORE UPDATE ON rg08_source_record BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_source_record_guard_delete BEFORE DELETE ON rg08_source_record BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_evidence_guard_update BEFORE UPDATE ON rg08_evidence BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_evidence_guard_delete BEFORE DELETE ON rg08_evidence BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
-- Evidence links are typed edges with their final status at creation; RG-08
-- never transitions a link (unlike RG-10) so the row is fully immutable.
CREATE TRIGGER rg08_evidence_link_guard_update BEFORE UPDATE ON rg08_evidence_link BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_evidence_link_guard_delete BEFORE DELETE ON rg08_evidence_link BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_audit_guard_update BEFORE UPDATE ON rg08_audit_link BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_audit_guard_delete BEFORE DELETE ON rg08_audit_link BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_settlement_guard_update BEFORE UPDATE ON rg08_settlement BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_settlement_guard_delete BEFORE DELETE ON rg08_settlement BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_settlement_component_guard_update BEFORE UPDATE ON rg08_settlement_component BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_settlement_component_guard_delete BEFORE DELETE ON rg08_settlement_component BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_settlement_history_guard_update BEFORE UPDATE ON rg08_settlement_history BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_settlement_history_guard_delete BEFORE DELETE ON rg08_settlement_history BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_candidate_status_history_guard_update BEFORE UPDATE ON rg08_candidate_status_history BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_candidate_status_history_guard_delete BEFORE DELETE ON rg08_candidate_status_history BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_candidate_source_guard_update BEFORE UPDATE ON rg08_candidate_source BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_candidate_source_guard_delete BEFORE DELETE ON rg08_candidate_source BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_confirmation_guard_update BEFORE UPDATE ON rg08_confirmation BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_confirmation_guard_delete BEFORE DELETE ON rg08_confirmation BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_name_history_guard_update BEFORE UPDATE ON rg08_name_history BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_name_history_guard_delete BEFORE DELETE ON rg08_name_history BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_operation_guard_delete BEFORE DELETE ON rg08_operation BEGIN SELECT RAISE(ABORT, 'rg08 operation immutable'); END;
CREATE TRIGGER rg08_operation_guard_update BEFORE UPDATE ON rg08_operation BEGIN
  SELECT CASE WHEN old.outcome = 'PENDING' AND new.outcome IN ('ACCEPTED', 'NO_CHANGE', 'REJECTED')
    AND new.ledger_id = old.ledger_id AND new.identity_value = old.identity_value
    AND new.action = old.action AND new.operation_class = old.operation_class
    AND new.input_fingerprint = old.input_fingerprint
    THEN NULL ELSE RAISE(ABORT, 'rg08 operation immutable') END;
END;
CREATE TRIGGER rg08_returned_id_guard_update BEFORE UPDATE ON rg08_returned_id BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_returned_id_guard_delete BEFORE DELETE ON rg08_returned_id BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_semantic_guard_update BEFORE UPDATE ON rg08_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_semantic_guard_delete BEFORE DELETE ON rg08_posting_semantic BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_formal_metadata_guard_update BEFORE UPDATE ON rg08_formal_transaction_metadata BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_formal_metadata_guard_delete BEFORE DELETE ON rg08_formal_transaction_metadata BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
-- Position facts are append-only; the principal balance is a guarded current
-- projection that must agree with the newest history row exactly once.
CREATE TRIGGER rg08_position_guard_update BEFORE UPDATE ON rg08_position BEGIN
  SELECT CASE WHEN (
    old.ledger_id = new.ledger_id AND old.position_id = new.position_id
    AND old.counterparty_id = new.counterparty_id
    AND old.receivable_account_id = new.receivable_account_id
    AND old.currency_code = new.currency_code AND old.currency_precision = new.currency_precision
    AND old.allocation_scope = new.allocation_scope
    AND old.contract_allocation_enabled = new.contract_allocation_enabled
    AND new.principal_balance_minor <= old.principal_balance_minor
    AND EXISTS (
      SELECT 1 FROM rg08_position_history AS history
      WHERE history.ledger_id = new.ledger_id AND history.position_id = new.position_id
        AND history.history_sequence = (SELECT MAX(latest.history_sequence) FROM rg08_position_history AS latest
          WHERE latest.ledger_id = new.ledger_id AND latest.position_id = new.position_id)
        AND history.principal_balance_after_minor = new.principal_balance_minor
        AND history.behavior_code = 'COLLECT'
    )
  ) THEN NULL ELSE RAISE(ABORT, 'rg08 position current projection') END;
END;
CREATE TRIGGER rg08_position_guard_delete BEFORE DELETE ON rg08_position BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_position_history_guard_update BEFORE UPDATE ON rg08_position_history BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_position_history_guard_delete BEFORE DELETE ON rg08_position_history BEGIN SELECT RAISE(ABORT, 'rg08 immutable'); END;
CREATE TRIGGER rg08_position_history_sequence BEFORE INSERT ON rg08_position_history BEGIN SELECT CASE WHEN (new.history_sequence = 1 AND EXISTS (SELECT 1 FROM rg08_position_history WHERE ledger_id = new.ledger_id AND position_id = new.position_id)) OR (new.history_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg08_position_history WHERE ledger_id = new.ledger_id AND position_id = new.position_id AND history_sequence = new.history_sequence - 1)) THEN RAISE(ABORT, 'rg08 position history sequence') END; END;
CREATE TRIGGER rg08_position_history_direction BEFORE INSERT ON rg08_position_history BEGIN
  SELECT CASE WHEN (new.behavior_code = 'LEND' AND new.amount_minor <= 0) OR (new.behavior_code = 'COLLECT' AND new.amount_minor >= 0)
    THEN RAISE(ABORT, 'rg08 position history direction') END;
END;
CREATE TRIGGER rg08_settlement_history_sequence BEFORE INSERT ON rg08_settlement_history BEGIN SELECT CASE WHEN (new.history_sequence = 1 AND EXISTS (SELECT 1 FROM rg08_settlement_history WHERE ledger_id = new.ledger_id AND settlement_id = new.settlement_id)) OR (new.history_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg08_settlement_history WHERE ledger_id = new.ledger_id AND settlement_id = new.settlement_id AND history_sequence = new.history_sequence - 1)) THEN RAISE(ABORT, 'rg08 settlement history sequence') END; END;
CREATE TRIGGER rg08_candidate_status_history_sequence BEFORE INSERT ON rg08_candidate_status_history BEGIN SELECT CASE WHEN (new.status_sequence = 1 AND EXISTS (SELECT 1 FROM rg08_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id)) OR (new.status_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg08_candidate_status_history WHERE ledger_id = new.ledger_id AND candidate_id = new.candidate_id AND status_sequence = new.status_sequence - 1)) THEN RAISE(ABORT, 'rg08 candidate status history sequence') END; END;
CREATE TRIGGER rg08_name_history_sequence BEFORE INSERT ON rg08_name_history BEGIN SELECT CASE WHEN (new.history_sequence = 1 AND EXISTS (SELECT 1 FROM rg08_name_history WHERE ledger_id = new.ledger_id AND counterparty_id = new.counterparty_id)) OR (new.history_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg08_name_history WHERE ledger_id = new.ledger_id AND counterparty_id = new.counterparty_id AND history_sequence = new.history_sequence - 1)) THEN RAISE(ABORT, 'rg08 name history sequence') END; END;
CREATE TRIGGER rg08_reconciliation_history_sequence BEFORE INSERT ON rg08_reconciliation_history BEGIN SELECT CASE WHEN (new.status_sequence = 1 AND EXISTS (SELECT 1 FROM rg08_reconciliation_history WHERE ledger_id = new.ledger_id AND posting_id = new.posting_id)) OR (new.status_sequence > 1 AND NOT EXISTS (SELECT 1 FROM rg08_reconciliation_history WHERE ledger_id = new.ledger_id AND posting_id = new.posting_id AND status_sequence = new.status_sequence - 1)) THEN RAISE(ABORT, 'rg08 reconciliation history sequence') END; END;
-- A settlement is a typed edge onto a collect transaction; the allocation
-- link stays null in v1 (D-084 RG08-GAP-02).
CREATE TRIGGER rg08_settlement_formal_owner_guard_insert BEFORE INSERT ON rg08_settlement BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM ledger_transaction AS transaction_row
    WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
      AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'COLLECT'
  ) THEN RAISE(ABORT, 'rg08 settlement formal ownership') END;
END;
-- Principal and interest components own their postings; the fee is fixed to
-- zero with no posting in RG-08 v1 (D-084 RG08-GAP-02).
CREATE TRIGGER rg08_settlement_component_guard_insert BEFORE INSERT ON rg08_settlement_component BEGIN
  SELECT CASE WHEN (new.kind IN ('PRINCIPAL', 'INTEREST') AND new.posting_id IS NULL)
    OR (new.kind = 'FEE' AND new.posting_id IS NOT NULL)
    THEN RAISE(ABORT, 'rg08 component posting ownership') END;
END;
-- The candidate lifecycle is append-only: only the pending -> confirmed
-- transition may update a row, and only to set the confirmed proposed facts.
CREATE TRIGGER rg08_candidate_guard_update BEFORE UPDATE ON rg08_candidate BEGIN
  SELECT CASE WHEN old.status = 'PENDING_CONFIRMATION' AND new.status = 'CONFIRMED'
    AND new.ledger_id = old.ledger_id AND new.candidate_id = old.candidate_id
    AND new.type = old.type
    AND new.proposed_total_received_minor = old.proposed_total_received_minor
    AND new.currency_code = old.currency_code AND new.currency_precision = old.currency_precision
    AND new.bank_evidence_proves_component_split = old.bank_evidence_proves_component_split
    AND new.expected_interest_may_confirm_split = old.expected_interest_may_confirm_split
    AND new.name_match_may_confirm_counterparty = old.name_match_may_confirm_counterparty
    AND new.rule_version = old.rule_version AND new.confidence = old.confidence
    AND (old.proposed_principal_amount_minor IS NULL OR new.proposed_principal_amount_minor = old.proposed_principal_amount_minor)
    AND (old.proposed_interest_amount_minor IS NULL OR new.proposed_interest_amount_minor = old.proposed_interest_amount_minor)
    AND (old.proposed_fee_amount_minor IS NULL OR new.proposed_fee_amount_minor = old.proposed_fee_amount_minor)
    AND (old.proposed_actual_receipt_at IS NULL OR new.proposed_actual_receipt_at = old.proposed_actual_receipt_at)
    AND (old.proposed_behavior_code IS NULL OR new.proposed_behavior_code = old.proposed_behavior_code)
    AND (old.proposed_counterparty_id IS NULL OR new.proposed_counterparty_id = old.proposed_counterparty_id)
    THEN NULL ELSE RAISE(ABORT, 'rg08 candidate immutable') END;
END;
CREATE TRIGGER rg08_candidate_guard_delete BEFORE DELETE ON rg08_candidate BEGIN SELECT RAISE(ABORT, 'rg08 candidate immutable'); END;
CREATE TRIGGER rg08_confirmation_target_guard_insert BEFORE INSERT ON rg08_confirmation BEGIN
  SELECT CASE
    WHEN new.role = 'LENDING_EVENT_CONFIRMATION' AND new.candidate_id IS NULL AND new.settlement_id IS NULL AND EXISTS (
      SELECT 1 FROM ledger_transaction AS transaction_row
      WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
        AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'LEND'
    ) THEN NULL
    WHEN new.role = 'LENDING_SETTLEMENT_CONFIRMATION' AND new.settlement_id IS NOT NULL AND EXISTS (
      SELECT 1 FROM ledger_transaction AS transaction_row
      WHERE transaction_row.ledger_id = new.ledger_id AND transaction_row.transaction_id = new.transaction_id
        AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'COLLECT'
    ) THEN NULL
    ELSE RAISE(ABORT, 'rg08 confirmation target ownership')
  END;
END;
-- Audit links are typed from/to references: evidence ids never mix with
-- evidence-link ids (RG08-GAP-03 mirror/merge).
CREATE TRIGGER rg08_audit_link_target_guard_insert BEFORE INSERT ON rg08_audit_link BEGIN
  SELECT CASE
    WHEN new.kind = 'MIRROR_OF_EVIDENCE' AND EXISTS (
      SELECT 1 FROM rg08_evidence AS from_evidence
      WHERE from_evidence.ledger_id = new.ledger_id AND from_evidence.evidence_id = new.from_id
    ) AND EXISTS (
      SELECT 1 FROM rg08_evidence AS to_evidence
      WHERE to_evidence.ledger_id = new.ledger_id AND to_evidence.evidence_id = new.to_id
    ) THEN NULL
    WHEN new.kind = 'MERGED_INTO_EVIDENCE_LINK' AND EXISTS (
      SELECT 1 FROM rg08_evidence_link AS from_link
      WHERE from_link.ledger_id = new.ledger_id AND from_link.link_id = new.from_id
    ) AND EXISTS (
      SELECT 1 FROM rg08_evidence_link AS to_link
      WHERE to_link.ledger_id = new.ledger_id AND to_link.link_id = new.to_id
    ) THEN NULL
    ELSE RAISE(ABORT, 'rg08 audit link target mismatch')
  END;
END;
CREATE TRIGGER rg08_posting_semantic_formal_owner_guard_insert BEFORE INSERT ON rg08_posting_semantic BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1
    FROM posting AS posting_row
    JOIN transaction_version AS version_row
      ON version_row.ledger_id = posting_row.ledger_id AND version_row.posting_set_id = posting_row.posting_set_id
    JOIN ledger_transaction_current_version AS current_row
      ON current_row.ledger_id = version_row.ledger_id AND current_row.transaction_id = version_row.transaction_id
     AND current_row.current_version_id = version_row.version_id
    JOIN ledger_transaction AS transaction_row
      ON transaction_row.ledger_id = current_row.ledger_id AND transaction_row.transaction_id = current_row.transaction_id
    WHERE posting_row.ledger_id = new.ledger_id AND posting_row.posting_id = new.posting_id
      AND (
        (new.role = 'RECEIVABLE' AND new.reconciliation_eligible = 0
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'LEND')
        OR (new.role = 'FUNDING_OUT' AND new.reconciliation_eligible = 1
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'LEND')
        OR (new.role = 'DESTINATION_IN' AND new.reconciliation_eligible = 1
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'COLLECT')
        OR (new.role = 'PRINCIPAL_OUT' AND new.reconciliation_eligible = 0
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'COLLECT')
        OR (new.role = 'INTEREST_OUT' AND new.reconciliation_eligible = 0
          AND COALESCE(transaction_row.canonical_kind, transaction_row.kind) = 'COLLECT')
      )
  ) THEN RAISE(ABORT, 'rg08 posting formal ownership') END;
END;
CREATE TRIGGER rg08_reconciliation_current_guard_insert BEFORE INSERT ON rg08_posting_reconciliation BEGIN
  SELECT CASE WHEN new.status != 'PENDING' OR new.latest_sequence != 1 OR NOT EXISTS (
    SELECT 1 FROM rg08_posting_semantic AS semantic
    WHERE semantic.ledger_id = new.ledger_id AND semantic.posting_id = new.posting_id
      AND semantic.role IN ('FUNDING_OUT', 'DESTINATION_IN')
      AND semantic.reconciliation_eligible = 1
  ) THEN RAISE(ABORT, 'rg08 reconciliation current ownership') END;
END;
CREATE TRIGGER rg08_reconciliation_current_guard_update BEFORE UPDATE ON rg08_posting_reconciliation BEGIN
  SELECT CASE WHEN new.ledger_id = old.ledger_id AND new.posting_id = old.posting_id
    AND old.status = 'PENDING' AND new.status = 'MATCHED'
    AND new.latest_sequence = old.latest_sequence + 1
    AND EXISTS (
      SELECT 1 FROM rg08_reconciliation_history AS history
      WHERE history.ledger_id = new.ledger_id AND history.posting_id = new.posting_id
        AND history.status_sequence = new.latest_sequence
        AND history.status = new.status
        AND history.evidence_link_id IS NOT NULL
    ) THEN NULL ELSE RAISE(ABORT, 'rg08 reconciliation current transition') END;
END;
CREATE TRIGGER rg08_reconciliation_current_guard_delete BEFORE DELETE ON rg08_posting_reconciliation BEGIN SELECT RAISE(ABORT, 'rg08 reconciliation current immutable'); END;
-- Evidence links are typed edges, not free-form labels. Keep the target, role,
-- source lineage, and status consistent even when callers bypass the adapter.
CREATE TRIGGER rg08_evidence_link_target_guard_insert BEFORE INSERT ON rg08_evidence_link BEGIN
  SELECT CASE
    WHEN new.target_kind = 'POSTING' AND new.role = 'FUNDING_ASSET_POSTING' AND new.status = 'MATCHED'
      AND EXISTS (
        SELECT 1 FROM rg08_posting_semantic AS semantic
        WHERE semantic.ledger_id = new.ledger_id AND semantic.posting_id = new.target_id
          AND semantic.role = 'FUNDING_OUT' AND semantic.reconciliation_eligible = 1
      ) THEN NULL
    WHEN new.target_kind = 'POSTING' AND new.role = 'DESTINATION_ASSET_POSTING' AND new.status IN ('MATCHED', 'MERGED')
      AND EXISTS (
        SELECT 1 FROM rg08_posting_semantic AS semantic
        WHERE semantic.ledger_id = new.ledger_id AND semantic.posting_id = new.target_id
          AND semantic.role = 'DESTINATION_IN' AND semantic.reconciliation_eligible = 1
      ) THEN NULL
    WHEN new.target_kind = 'POSITION' AND new.role = 'COUNTERPARTY_LENDING_RELATIONSHIP' AND new.status = 'SUPPORTED'
      AND EXISTS (
        SELECT 1 FROM rg08_position AS position_row
        WHERE position_row.ledger_id = new.ledger_id AND position_row.position_id = new.target_id
      ) THEN NULL
    ELSE RAISE(ABORT, 'rg08 evidence link target mismatch')
  END;
END;
CREATE TRIGGER rg08_evidence_link_lineage_guard_insert BEFORE INSERT ON rg08_evidence_link BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg08_evidence AS evidence
    WHERE evidence.ledger_id = new.ledger_id AND evidence.evidence_id = new.evidence_id
      AND evidence.source_id = new.source_id
  ) THEN RAISE(ABORT, 'rg08 evidence link lineage mismatch') END;
END;
CREATE TRIGGER rg08_reconciliation_history_evidence_guard_insert BEFORE INSERT ON rg08_reconciliation_history WHEN new.evidence_link_id IS NOT NULL BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg08_evidence_link AS link
    WHERE link.ledger_id = new.ledger_id AND link.link_id = new.evidence_link_id
      AND link.target_kind = 'POSTING' AND link.target_id = new.posting_id
      AND link.role IN ('FUNDING_ASSET_POSTING', 'DESTINATION_ASSET_POSTING')
      AND link.status = 'MATCHED'
  ) THEN RAISE(ABORT, 'rg08 reconciliation evidence target mismatch') END;
END;
-- Evidence subtypes are typed derivations of their source record kind and can
-- never disagree with the persisted source.
CREATE TRIGGER rg08_evidence_type_guard_insert BEFORE INSERT ON rg08_evidence BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg08_source_record AS source
    WHERE source.ledger_id = new.ledger_id AND source.source_id = new.source_id
      AND (
        (source.kind = 'BANK_DEBIT' AND new.evidence_type = 'ASSET_DEBIT')
        OR (source.kind = 'BANK_CREDIT' AND new.evidence_type = 'ASSET_CREDIT')
        OR (source.kind = 'BANK_CREDIT_MIRROR' AND new.evidence_type = 'ASSET_CREDIT_MIRROR')
        OR (source.kind = 'LENDING_AGREEMENT' AND new.evidence_type = 'LENDING_AGREEMENT')
      )
  ) THEN RAISE(ABORT, 'rg08 evidence type mismatch') END;
END;
-- A mirror source always references a different origin source (RG08-GAP-03).
CREATE TRIGGER rg08_source_record_mirror_guard_insert BEFORE INSERT ON rg08_source_record WHEN new.kind = 'BANK_CREDIT_MIRROR' BEGIN
  SELECT CASE WHEN new.mirror_of_source_id IS NULL OR new.mirror_of_source_id = new.source_id
    THEN RAISE(ABORT, 'rg08 source mirror ownership') END;
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM rg08_source_record AS origin
    WHERE origin.ledger_id = new.ledger_id AND origin.source_id = new.mirror_of_source_id
  ) THEN RAISE(ABORT, 'rg08 source mirror ownership') END;
END;
CREATE TRIGGER rg08_source_record_mirror_kind_guard_insert BEFORE INSERT ON rg08_source_record WHEN new.mirror_of_source_id IS NOT NULL BEGIN
  SELECT CASE WHEN new.kind != 'BANK_CREDIT_MIRROR' THEN RAISE(ABORT, 'rg08 source mirror ownership') END;
END;

selectRg08Operation:
SELECT * FROM rg08_operation WHERE ledger_id = ? AND identity_value = ?;

insertRg08Operation:
INSERT INTO rg08_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome,
  reason_code, field_path
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

claimRg08Operation:
INSERT INTO rg08_operation(
  ledger_id, identity_value, action, operation_class, input_fingerprint, outcome
) VALUES (?, ?, ?, ?, ?, 'PENDING')
ON CONFLICT (ledger_id, identity_value) DO NOTHING;

updateRg08OperationResult:
UPDATE rg08_operation
SET outcome = ?, reason_code = ?, field_path = ?
WHERE ledger_id = ? AND identity_value = ?;

insertRg08ReturnedId:
