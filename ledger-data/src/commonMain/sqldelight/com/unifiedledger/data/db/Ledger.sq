CREATE TRIGGER rg06_operation_guard_delete BEFORE DELETE ON rg06_operation BEGIN SELECT RAISE(ABORT, 'rg06 immutable'); END;
CREATE TRIGGER rg06_receipt_guard_update BEFORE UPDATE ON rg06_operation_receipt BEGIN SELECT RAISE(ABORT, 'rg06 immutable'); END;
CREATE TRIGGER rg06_receipt_guard_delete BEFORE DELETE ON rg06_operation_receipt BEGIN SELECT RAISE(ABORT, 'rg06 immutable'); END;
