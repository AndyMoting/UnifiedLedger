<?xml version="1.0" encoding="utf-8"?>
<!--
  P7-09 09.C monthly widget layout (D-225 Q20; spec sections 6.1/6.5).

  A minimal RemoteViews tree: a body TextView (the month, the status, and — only once the user has
  switched amounts on — the three exact amount lines) and a toggle TextView. The provider sets the
  body text/`contentDescription` and both click PendingIntents from `WidgetViewState`, so this file
  itself carries NO amount and no placeholder amount: a hidden widget has nothing amount-shaped to
  render. No personal identifier, no account name and no category name appears here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="start"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingTop="8dp"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
