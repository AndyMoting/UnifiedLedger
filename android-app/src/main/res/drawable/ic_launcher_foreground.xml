<?xml version="1.0" encoding="utf-8"?>
<!--
  D-369 D adaptive launcher foreground (spec section 7.3): a project-owned white ledger mark — one
  binding spine plus three entry rows, i.e. the unified single-ledger / unified-flow symbol. No
  third-party icon asset, no raster image and no icon dependency are involved.

  GEOMETRY (official adaptive-icon design guidance:
  https://developer.android.com/develop/ui/views/launch/icon_design_adaptive):
  - canvas 108x108dp; launchers show at most the centred 72dp square and keep only the central
    66dp-diameter circle across every mask shape;
  - every drawn endpoint below is within 30dp of the canvas centre (54,54), and the 6dp round
    stroke extends 3dp past each endpoint, so the whole painted mark stays inside the 33dp
    unmasked radius.
  One stroked path only, so the monochrome layer can reuse the exact geometry.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M36,38 L36,70 M44,41 L70,41 M44,54 L70,54 M44,67 L58,67"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
</vector>
