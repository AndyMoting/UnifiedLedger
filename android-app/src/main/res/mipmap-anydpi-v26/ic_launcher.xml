<?xml version="1.0" encoding="utf-8"?>
<!--
  D-369 D adaptive launcher icon (spec section 7.3). Three layers: the P8-blue background, the
  project-owned white ledger foreground and the monochrome silhouette for themed icons. Devices on
  API 26+ read this `mipmap-anydpi-v26` file; the app's minSdk is 34, so no density-PNG fallback is
  needed and no raster asset ships. `roundIcon` points at `ic_launcher_round.xml`, which carries the
  identical layers because the launcher — not the app — chooses the mask shape.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
