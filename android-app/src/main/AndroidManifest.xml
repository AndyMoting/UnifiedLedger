<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      P7-09 09.0 (spec section 6.3; D-225 Q19 P1): the process-scoped runtime owner holder lives
      on the Application subclass, so the whole process shares one owner/active graph.
    -->
    <application
        android:name=".UnifiedLedgerApplication"
        android:label="UnifiedLedger"
        android:theme="@style/Theme.UnifiedLedger">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              P7-09 09.A (spec sections 2.3/2.4; D-225 Q19): the single-file ACTION_SEND share
              entry. The share surface MUST be exported="true" for an external app to deliver into
              it, so the Intent validation face (ExternalNavigationIntake) is security-critical:
              an untrusted Intent is validated before use and every unknown/multi/conflicting/
              non-content/unreadable share is a typed rejection with zero formal effect.
              launchMode="singleTop" makes a hot share reuse the top instance through onNewIntent
              (which calls setIntent) instead of building a second Activity; a cold share still
              starts the Activity normally.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          P7-09 09.C monthly widget (D-225 Q20; spec sections 6.1/6.4). The AppWidgetProvider is a
          BroadcastReceiver the host system drives; it is the non-composition entry that reads the
          shared monthly snapshot through the process-scoped runtime owner's lease (spec section
          6.3) and renders RemoteViews.

          SECURITY FACE (spec section 8 open item 15): the frozen ruling for a widget provider's
          `exported`/`android:permission` is NOT made in this batch. It is declared `exported="false"`
          here as the conservative choice — an unexported receiver can never be triggered by an
          unauthorized external broadcast — while the per-entry ruling and its device evidence stay
          registered as an open item in the batch report. No `android:permission` is declared.

          `APPWIDGET_UPDATE` is the system action that drives onUpdate; the toggle action is this
          provider's own per-widget visibility broadcast. The provider info resource is the
          appwidget-provider metadata (30-minute update period, spec section 6.4).
        -->
        <receiver
            android:name=".LedgerWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.unifiedledger.android.widget.ACTION_TOGGLE_AMOUNTS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ledger_widget_info" />
        </receiver>
    </application>
</manifest>
