<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      P7-09 09.0 (spec section 6.3; D-225 Q19 P1): the process-scoped runtime owner holder lives
      on the Application subclass, so the whole process shares one owner/active graph.
    -->
    <application
        android:name=".UnifiedLedgerApplication"
        android:label="UnifiedLedger"
        android:theme="@style/Theme.UnifiedLedger">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              P7-09 09.A (spec sections 2.3/2.4; D-225 Q19): the single-file ACTION_SEND share
              entry. The share surface MUST be exported="true" for an external app to deliver into
              it, so the Intent validation face (ExternalNavigationIntake) is security-critical:
              an untrusted Intent is validated before use and every unknown/multi/conflicting/
              non-content/unreadable share is a typed rejection with zero formal effect.
              launchMode="singleTop" makes a hot share reuse the top instance through onNewIntent
              (which calls setIntent) instead of building a second Activity; a cold share still
              starts the Activity normally.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          P7-09 09.C monthly widget (D-225 Q20; spec sections 6.1/6.4). The AppWidgetProvider is a
          BroadcastReceiver the host system drives; it is the non-composition entry that reads the
          shared monthly snapshot through the process-scoped runtime owner's lease (spec section
          6.3) and renders RemoteViews.

          SECURITY FACE (spec section 8 open item 15). The per-entry `exported`/`android:permission`
          RULING belongs to the main session; this batch makes the conservative implementation choice
          declared below and registers the ruling as open. EVIDENCE for that choice (gathered this
          batch, from the local Android SDK and the official docs):
          (1) `res/values/attrs_manifest.xml` (platform attribute doc) states the default is TRUE for a
              receiver that DOES specify intent filters, and that an unexported component "can only be
              accessed by applications with its same user id" — so `exported="false"` is an explicit
              narrowing of that default, not a value the widget needs for its own traffic;
          (2) AOSP `AppWidgetServiceImpl.createUpdateIntentLocked` builds the update as an EXPLICIT
              `intent.setComponent(provider.id.componentName)` and sends it from the system server,
              whose uid `ActivityManager.checkComponentPermission` grants unconditionally
              (`canAccessUnexportedComponents` covers SYSTEM_UID/ROOT_UID);
          (3) the official Android widget guide's manifest snippet declares an AppWidgetProvider
              receiver with `android:exported="false"`.
          So `exported="false"` is functional for the system-driven APPWIDGET_UPDATE and for this
          provider's own explicit PendingIntent broadcasts, while refusing unauthorized external
          broadcasts. `android:permission` is intentionally NOT declared (the spec's BIND_APPWIDGET
          route is the HOST-side authorization, not a receiver attribute). The main session may rule
          otherwise on evidence; the KDoc here must not be read as that ruling.

          `APPWIDGET_UPDATE` is the system action that drives onUpdate; the toggle/refresh/open
          actions are this provider's own broadcasts, all delivered through explicit immutable
          PendingIntents. The provider info resource is the appwidget-provider metadata
          (30-minute update period, spec section 6.4).
        -->
        <receiver
            android:name=".LedgerWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.unifiedledger.android.widget.ACTION_TOGGLE_AMOUNTS" />
                <action android:name="com.unifiedledger.android.widget.ACTION_REFRESH" />
                <action android:name="com.unifiedledger.android.widget.ACTION_OPEN_CURRENT_MONTH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ledger_widget_info" />
        </receiver>
    </application>
</manifest>
