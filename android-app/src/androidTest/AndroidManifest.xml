<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      P7-06 06.C (D-179) androidTest-only provider for
      AndroidRestoreSourcePortInstrumentedTest: serves a fixed synthetic payload from openFile so
      the restore source port can be driven through the real ContentResolver on device. It holds no
      product data, is exported only so the instrumentation target (a different package from this
      test APK) can resolve it, and never ships in the product build.
    -->
    <application>
        <provider
            android:name="com.unifiedledger.android.FixedPayloadRestoreSourceProvider"
            android:authorities="com.unifiedledger.android.p706c.restoresource"
            android:exported="true" />

        <!--
          P7-06 06.D (D-182) androidTest-only provider for
          AndroidRestoreDocumentSizeInstrumentedTest: serves the OpenableColumns.SIZE shapes
          queryDocumentSize must distinguish (a reported size, a null value, a missing column, an
          empty cursor, a throwing provider) so the DocumentSize query runs against a REAL
          ContentResolver on device. Test-only, no product data, never in the product build.
        -->
        <provider
            android:name="com.unifiedledger.android.OpenableColumnsSizeFixtureProvider"
            android:authorities="com.unifiedledger.android.p706d.documentsize"
            android:exported="true" />

        <!--
          P706-A10 second half (D-239 item 4) androidTest-only provider for
          BackupExportSafMidWriteInstrumentedTest: accepts 1 MiB of a backup export and then closes
          its read end so every later write fails with EPIPE — a SAF-shaped failure that happens
          MID-STREAM. Exported only so the instrumentation target (a different package from this
          test APK) can resolve it; holds no product data and never ships in the product build.
        -->
        <provider
            android:name="com.unifiedledger.android.FailAfterBytesBackupTargetProvider"
            android:authorities="com.unifiedledger.android.p706a10.failtarget"
            android:exported="true" />

        <!--
          P7-09 A-03 / A-VIS device probe (test-only): sets ACCESSIBILITY focus on the values the
          ordinary TAB traversal cannot reach, so TalkBack's own utterance log can prove whether
          they are readable. Holds no product data, lives only in the androidTest APK.
        -->
        <service
            android:name="com.unifiedledger.android.A11yFocusProbeService"
            android:exported="true"
            android:label="UL a11y probe"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ul_a11y_probe_config" />
        </service>
    </application>
</manifest>
